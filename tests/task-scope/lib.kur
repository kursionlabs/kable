use std::option::Option;
use task::driver::{Pair, PairKind, Resolution, Resource, ScopeState!};

fn check_retirement_before_resolution() -> bool {
    let scope = ScopeState!::new();
    let first = (&scope.add_leaf()).unwrap();
    let second = (&scope.add_leaf()).unwrap();
    let root = &scope.add_pair(Pair.{ kind: PairKind::Join, first, second });
    let valid = &scope.begin(root);
    &scope.started(Resource::Leaf.(first));
    &scope.started(Resource::Leaf.(second));
    let first_resolved_root = &scope.complete(first);
    &scope.retired(Resource::Leaf.(first));
    let first_joined = &scope.joined();
    &scope.retired(Resource::Leaf.(second));
    let drained = !&scope.pending();
    let joined_early = &scope.joined();
    let hidden = (&scope.result(Option::Some.(first))).is_none() && (&scope.result(root)).is_none();
    let root_resolved = &scope.complete(second);
    let joined = &scope.joined();
    let result = &scope.result(root);
    let first_result = &scope.result(Option::Some.(first));
    scope.destroy();
    let root_ready = match result.unwrap() { Completed => true, _ => false };
    let first_ready = match first_result.unwrap() { Completed => true, _ => false };
    valid && !first_resolved_root && !first_joined && drained &&
        !joined_early && hidden && root_resolved && joined && root_ready && first_ready
}

fn main() -> i32 {
    if !check_retirement_before_resolution() { return 1; }
    let scope = ScopeState!::new();
    let first = (&scope.add_leaf()).unwrap();
    let second = (&scope.add_leaf()).unwrap();
    let missing_root_rejected = !&scope.begin(Option::None);
    let disconnected_root_rejected = !&scope.begin(Option::Some.(first));
    let rejected = (&scope.add_pair(Pair.{ kind: PairKind::Select, first, second: first })).is_none();
    let root = (&scope.add_pair(Pair.{ kind: PairKind::Select, first, second })).unwrap();
    let already_parented = Pair.{ kind: PairKind::Join, first, second: root };
    let refused_reparent = (&scope.add_pair(already_parented)).is_none();
    let valid = &scope.begin(Option::Some.(root));
    &scope.started(Resource::Leaf.(first));
    &scope.started(Resource::Leaf.(first));
    &scope.started(Resource::Leaf.(second));
    &scope.started(Resource::ParentTimer);
    let won = &scope.complete(first);
    let cancelled = &scope.take_cancel();
    &scope.retired(Resource::Leaf.(first));
    &scope.retired(Resource::Leaf.(first));
    &scope.retired(Resource::Leaf.(root));
    // A late event from the cancelled child cannot replace the winner.
    let late = &scope.complete(second);
    &scope.started(Resource::Leaf.(first));
    &scope.retired(Resource::Leaf.(second));
    let waiting_for_timer = &scope.pending() && !&scope.joined() &&
        (&scope.result(Option::Some.(root))).is_none();
    &scope.retired(Resource::ParentTimer);
    &scope.retired(Resource::ParentTimer);
    let scope_joined = &scope.joined();
    let missing_result = (&scope.result(Option::None)).is_none();
    let out_of_range = (&scope.result(Option::Some.(root + 1))).is_none();
    let result = &scope.result(Option::Some.(root));
    let winner = &scope.result(Option::Some.(first));
    let loser = &scope.result(Option::Some.(second));
    let next_stop = &scope.take_cancel();
    scope.destroy();
    let first_won = match result.unwrap() { First => true, _ => false, };
    let winner_completed = match winner.unwrap() { Completed => true, _ => false, };
    let loser_cancelled = match loser.unwrap() { Cancelled => true, _ => false, };
    if missing_root_rejected && disconnected_root_rejected && rejected && refused_reparent && valid &&
        won && cancelled.unwrap() == second && waiting_for_timer &&
        !late && scope_joined && missing_result && out_of_range && first_won && winner_completed && loser_cancelled &&
        next_stop.is_none() { 0i32 } else { 1i32 }
}
