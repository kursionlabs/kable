use async::Scope!;
use http::{Body!, Request!, Response!};
use server::{Action!, Server!};
use std::ascii::to_upper;
use std::buffer::Buffer!;
use std::io::{eprint_buffer, print_buffer};
use std::option::Option;
use std::process::trap;
use std::raw::Span;
use std::time::Duration;
use task::{Completion, Discard, Map!, PlanOutput, Sleep!, Stream, StreamOutcome, sleep};
use task::continuation::ChainPlan!;

struct Memory! { remaining: u8, may_pull: bool, report_discard: bool }

instance Discard[Memory!] {
    fn discard(memory: Memory!) {
        let { remaining, may_pull, report_discard } = memory;
        if report_discard { eprint_buffer(f"Discarded response source.\n"); }
    }
}

instance Stream[Memory! -> Map![Sleep!, Completion[()], (Memory!, StreamOutcome[Buffer!]), (u8, bool, bool)]] {
    fn next(memory: Memory!) -> Map![Sleep!, Completion[()], (Memory!, StreamOutcome[Buffer!]), (u8, bool, bool)] {
        let { remaining, may_pull, report_discard } = memory;
        if !may_pull { trap(); }
        sleep(Duration::from_nanos(0)).map(|status| {
            match status {
                Completion::Ready => (),
                _ => return (Memory!.{ remaining, may_pull, report_discard }, StreamOutcome::Cancelled),
            };
            if remaining == 0 { return (Memory!.{ remaining, may_pull, report_discard }, StreamOutcome::Eof); }
            let bytes = Buffer!::new().push_static(match remaining {
                3 => "abc",
                2 => "",
                _ => "def",
            });
            (Memory!.{ remaining: remaining - 1, may_pull, report_discard }, StreamOutcome::Item.(bytes))
        })
    }
}

fn discard_pull(bytes: Buffer!, result: (Body!, StreamOutcome[Buffer!])) {
    (bytes, result).discard();
    eprint_buffer(f"Discarded pending body pull.\n");
}

fn pull(body: Body!, bytes: Buffer!, chunks: usize) -> Action! {
    body.next().respond_owned_with(bytes, |bytes, result| {
        let (body, outcome) = result;
        match outcome {
            StreamOutcome::Item(item) => {
                eprint_buffer(f"Received body chunk.\n");
                pull(body, bytes.push_buffer(item), chunks + 1)
            },
            Eof => {
                body.discard();
                Response!::ok(f"{chunks}:".push_buffer(bytes)).reply()
            },
            _ => { (body, bytes).discard(); Response!::rejected(400).reply() },
        }
    }, discard_pull).reply()
}

fn uppercase(bytes: Buffer!) -> Buffer! {
    let exists 'k. (access, bytes, restore) = bytes.open();
    let span = Span::from_slice(bytes);
    var mapped = Buffer!::new_with_cap(span.len());
    var index = 0;
    while index < span.len() {
        mapped = mapped.push_byte(to_upper(span.at(&access, index)));
        index = index + 1;
    }
    restore.restore(access).destroy();
    mapped
}

fn collection_response(outcome: Completion[Buffer!]) -> Action! {
    let status = match outcome {
        Ready(bytes) => return Response!::ok(bytes).reply(),
        TimedOut | Cancelled => 408,
        Failed(failure) => match failure {
            Operation(code) => if code == 400 || code == 413 { code as u16 } else { 500 },
            _ => 500,
        },
    };
    Response!::rejected(status).reply()
}

fn pull_completion(result: (Body!, StreamOutcome[Buffer!])) -> Completion[Buffer!] {
    let (body, outcome) = result;
    body.discard();
    match outcome {
        Item(bytes) => Completion::Ready.(bytes),
        Eof => Completion::Ready.(Buffer!::new()),
        TimedOut => Completion::TimedOut,
        Cancelled => Completion::Cancelled,
        Failed(failure) => Completion::Failed.(failure),
    }
}

fn after_pull(bytes: Buffer!, status: Completion[()]) -> Completion[Buffer!] {
    match status {
        Ready => Completion::Ready.(bytes),
        TimedOut => { bytes.destroy(); Completion::TimedOut },
        Cancelled => { bytes.destroy(); Completion::Cancelled },
        Failed(failure) => { bytes.destroy(); Completion::Failed.(failure) },
    }
}

fn pull_plan(body: Body!) -> Action! {
    let task: ChainPlan![Completion[Buffer!], Scope!] = body.next().map(|result| pull_completion(result))
        .and_then(|bytes| sleep(Duration::from_nanos(0)).map(|status| after_pull(bytes, status)));
    task.respond(|result| collection_response(result)).reply()
}

fn collect(body: Body!, observed: bool) -> Action! {
    body.map_items(|bytes| {
        if observed { eprint_buffer(f"Transformed body chunk.\n"); }
        uppercase(bytes).push_static("!")
    }).collect(6).respond(|outcome| {
        if observed { eprint_buffer(f"Finished collecting body.\n"); }
        collection_response(outcome)
    }).reply()
}

fn serve(request: Request!) -> Action! {
    if &request.path_is("/pull-plan") {
        let { method, target, body } = request;
        target.destroy();
        return pull_plan(body);
    }
    if &request.path_is("/pull") {
        let { method, target, body } = request;
        target.destroy();
        return pull(body, Buffer!::new(), 0);
    }
    let observed = &request.path_is("/collect-observed");
    if observed || &request.path_is("/collect") {
        let { method, target, body } = request;
        target.destroy();
        return collect(body, observed);
    }
    if &request.path_is("/collect-shrink") {
        let { method, target, body } = request;
        target.destroy();
        return body.map_items(|bytes| bytes.truncate(0)).collect(0)
            .respond(|outcome| collection_response(outcome)).reply();
    }
    let upper = &request.path_is("/upper");
    if upper || &request.path_is("/relay") {
        let { method, target, body } = request;
        target.destroy();
        let length = &body.content_length();
        if upper {
            let source = body.map_items(|bytes| uppercase(bytes));
            return Response!::stream(200, "application/octet-stream", length, source).reply();
        }
        return Response!::stream(200, "application/octet-stream", length, body).reply();
    }
    let unknown_head = &request.path_is("/unknown-head");
    let head_only = &request.path_is("/head") || unknown_head;
    let empty = &request.path_is("/empty");
    let delayed = &request.path_is("/delayed");
    let cancelled = &request.path_is("/cancel-delayed");
    let collect_memory = &request.path_is("/collect-memory");
    let unknown = &request.path_is("/unknown") || unknown_head;
    let length = if unknown { Option::None }
        else if &request.path_is("/short") { Option::Some.(7) }
        else if &request.path_is("/over") { Option::Some.(5) }
        else if empty { Option::Some.(0) }
        else { Option::Some.(6) };
    request.destroy();
    let memory = Memory!.{ remaining: 3, may_pull: !head_only && !empty && !cancelled,
        report_discard: head_only || cancelled };
    if collect_memory {
        return memory.collect(6).respond(|outcome| collection_response(outcome)).reply();
    }
    let response: Response! = Response!::stream(200, "application/octet-stream", length, memory);
    if cancelled {
        eprint_buffer(f"Scheduled delayed response.\n");
        return response.after(Duration::from_secs(30));
    }
    if delayed { return response.after(Duration::from_millis(20)); }
    response.reply()
}

fn main() -> i32 {
    let server = Server!::bind(0, serve).unwrap();
    let port = &server.port();
    if print_buffer(f"Listening on http://127.0.0.1:{port}\n").is_err() {
        server.stop();
        return 1;
    }
    if server.run().is_ok() { 0 } else { 1 }
}
