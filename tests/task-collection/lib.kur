use async::{Scope!, run, run_sequence, run_with_deadline};
use task::continuation::ChainPlan!;
use std::buffer::Buffer!;
use std::option::Option;
use std::process::trap;
use std::time::Duration;
use task::{Completion, DeadlineStatus, Discard, Failure, Map!, PlanOutput, Sink, Sleep!, Stream, StreamOutcome,
    join, select, sleep};
use task::driver::{Pair, PairKind, Plan, PlanDriver, Resolution, Resource, ScopeState!};
use task::sequence::{Clock, SequenceOutcome, StageDriver, StageResult, drive_sequence_until};

struct ReverseSelect! { first: Sleep!, second: Sleep!, id: Option[usize] }

fn invalid_result(resolution: Resolution) -> bool {
    match resolution {
        Failed(failure) => match failure { InvalidResult => true, _ => false },
        _ => false,
    }
}

forall Driver where PlanDriver[Driver].
instance Plan[ReverseSelect!, Driver -> bool] {
    fn stage(&task: ReverseSelect!, &scope: Driver) -> Option[usize] {
        let { first, second, id: old } = task;
        let a = Plan[Sleep!, Driver -> Completion[()]]::stage(&first, &scope);
        let b = Plan[Sleep!, Driver -> Completion[()]]::stage(&second, &scope);
        let id = match a {
            Some(a) => match b {
                Some(b) => PlanDriver[Driver]::pair(&scope, Pair.{ kind: PairKind::Select, first: a, second: b }),
                None => Option::None,
            },
            None => Option::None,
        };
        task = ReverseSelect!.{ first, second, id };
        id
    }

    fn collect(task: ReverseSelect!, &scope: Driver) -> bool {
        let { first, second, id } = task;
        let selected = match PlanDriver[Driver]::result(&scope, id) {
            First => true,
            _ => false,
        };
        let status = Plan[Sleep!, Driver -> Completion[()]]::collect(second, &scope);
        let cancelled = match status {
            Cancelled => true,
            _ => false,
        };
        let status = Plan[Sleep!, Driver -> Completion[()]]::collect(first, &scope);
        let completed = match status {
            Ready => true,
            _ => false,
        };
        let missing = PlanDriver[Driver]::result(&scope, Option::None);
        let out_of_range = PlanDriver[Driver]::result(&scope, Option::Some.(id.unwrap() + 1));
        selected && cancelled && completed && invalid_result(missing) && invalid_result(out_of_range)
    }
}

struct InvalidRootTimer! { timer: Sleep!, bytes: Buffer!, missing_root: bool }

forall Driver where PlanDriver[Driver].
instance Plan[InvalidRootTimer!, Driver -> (Buffer!, Completion[()])] {
    fn stage(&task: InvalidRootTimer!, &scope: Driver) -> Option[usize] {
        let { timer, bytes, missing_root } = task;
        let root = Plan[Sleep!, Driver -> Completion[()]]::stage(&timer, &scope);
        task = InvalidRootTimer!.{ timer, bytes, missing_root };
        if missing_root { return Option::None; }
        // A second timer is disconnected from the staged root.
        PlanDriver[Driver]::timer(&scope, Duration::from_nanos(0));
        root
    }

    fn collect(task: InvalidRootTimer!, &scope: Driver) -> (Buffer!, Completion[()]) {
        let { timer, bytes, missing_root } = task;
        (bytes, Plan[Sleep!, Driver -> Completion[()]]::collect(timer, &scope))
    }
}

forall T where Copy[T].
fn invalid_plan(status: Completion[T]) -> bool {
    match status {
        Failed(failure) => match failure { InvalidPlan => true, _ => false },
        _ => false,
    }
}

fn check_invalid_root(missing_root: bool) -> bool {
    let first = InvalidRootTimer!.{
        timer: sleep(Duration::from_nanos(0)), bytes: Buffer!::new().push_static("first"), missing_root,
    };
    let bytes = Buffer!::new().push_static("second");
    let second = sleep(Duration::from_nanos(0)).map(|status| (bytes, status));
    let ((first, first_status), (second, second_status), race_status) = run(select(first, second));
    let lengths_ok = &first.len() == 5 && &second.len() == 6;
    first.destroy();
    second.destroy();
    lengths_ok && invalid_plan(first_status) && invalid_plan(second_status) && invalid_plan(race_status)
}

struct RejectedPair { root: Option[usize], rejected: bool }

forall Driver where PlanDriver[Driver].
instance Plan[RejectedPair, Driver -> bool] {
    fn stage(&task: RejectedPair, &scope: Driver) -> Option[usize] {
        let duration = Duration::from_nanos(0);
        let root = PlanDriver[Driver]::timer(&scope, duration);
        let child = root.unwrap();
        let pair = Pair.{ kind: PairKind::Join, first: child, second: child };
        let rejected = PlanDriver[Driver]::pair(&scope, pair).is_none();
        let later = PlanDriver[Driver]::timer(&scope, duration);
        task = RejectedPair.{ root, rejected: rejected && later.is_none() };
        root
    }

    fn collect(task: RejectedPair, &scope: Driver) -> bool {
        let { root, rejected } = task;
        let status = PlanDriver[Driver]::result(&scope, root).completion();
        rejected && invalid_plan(status)
    }
}

fn check_cancelled_join() -> bool {
    let first = Buffer!::new().push_static("first");
    let second = Buffer!::new().push_static("second");
    let suffix = Buffer!::new().push_static(" returned");
    let first = sleep(Duration::from_nanos(0)).map(|status| (first, status));
    let second = sleep(Duration::from_secs(30)).map(|status| (second.push_buffer(suffix), status));
    let ((first, first_status), (second, second_status), status) =
        run_with_deadline(join(first, second), Duration::from_millis(10));
    let lengths_ok = &first.len() == 5 && &second.len() == 15;
    first.destroy();
    second.destroy();
    let first_ready = match first_status { Ready => true, _ => false };
    let second_cancelled = match second_status { Cancelled => true, _ => false };
    let join_cancelled = match status { Cancelled => true, _ => false };
    lengths_ok && first_ready && second_cancelled && join_cancelled
}

struct DeadlineDriver! { state: ScopeState!, timer: Option[usize], timer_result: Resolution }

instance PlanDriver[DeadlineDriver!] {
    fn timer(&scope: DeadlineDriver!, duration: Duration) -> Option[usize] {
        let { state, timer, timer_result } = scope;
        let id = &state.add_leaf();
        let timer = if duration.is_zero() { id } else { timer };
        scope = DeadlineDriver!.{ state, timer, timer_result };
        id
    }

    fn pair(&scope: DeadlineDriver!, pair: Pair) -> Option[usize] {
        let { state, timer, timer_result } = scope;
        let id = &state.add_pair(pair);
        scope = DeadlineDriver!.{ state, timer, timer_result };
        id
    }

    fn result(&scope: DeadlineDriver!, id: Option[usize]) -> Resolution {
        let { state, timer, timer_result } = scope;
        let result = (&state.result(id)).unwrap();
        scope = DeadlineDriver!.{ state, timer, timer_result };
        if id.unwrap() == timer.unwrap() { timer_result } else { result }
    }
}

forall Task where Plan[Task, DeadlineDriver! -> ((Buffer!, Completion[()]), DeadlineStatus)].
fn run_deadline_test(plan: Task, timer_result: Resolution) -> DeadlineStatus {
    let driver = DeadlineDriver!.{ state: ScopeState!::new(), timer: Option::None, timer_result };
    let root = Plan[Task, DeadlineDriver! -> ((Buffer!, Completion[()]), DeadlineStatus)]::stage(&plan, &driver);
    let { state, timer, timer_result } = driver;
    if !&state.begin(root) { trap(); }
    &state.started(Resource::Leaf.(0));
    &state.started(Resource::Leaf.(1));
    let winner = timer.unwrap();
    if !&state.complete(winner) { trap(); }
    let loser = (&state.take_cancel()).unwrap();
    &state.retired(Resource::Leaf.(winner));
    &state.retired(Resource::Leaf.(loser));
    if !&state.joined() { trap(); }

    let driver = DeadlineDriver!.{ state, timer, timer_result };
    let ((bytes, status), deadline) =
        Plan[Task, DeadlineDriver! -> ((Buffer!, Completion[()]), DeadlineStatus)]::collect(plan, &driver);
    let { state, timer, timer_result } = driver;
    state.destroy();
    let length = &bytes.len();
    bytes.destroy();
    match status {
        Cancelled => { if length != 5 { trap(); } },
        _ => trap(),
    }
    deadline
}

fn deadline_with_timer_result(timer_result: Resolution) -> DeadlineStatus {
    let bytes = Buffer!::new().push_static("owned");
    let plan = sleep(Duration::from_secs(1)).map(|status| (bytes, status));
    run_deadline_test(plan.within(Duration::from_nanos(0)), timer_result)
}

fn check_deadline_timer_results() -> bool {
    let deadline = deadline_with_timer_result(Resolution::Failed.(Failure::Operation.(-42)));
    match deadline {
        Failed(failure) => match failure {
            Operation(code) => { if code != -42 { return false; } },
            _ => return false,
        },
        _ => return false,
    }
    match deadline_with_timer_result(Resolution::Cancelled) {
        Failed(failure) => match failure {
            InvalidResult => true,
            _ => false,
        },
        _ => false,
    }
}

struct EarlyDeadline {}
struct ExpiredStage! { output: Buffer! }

instance Clock[EarlyDeadline] {
    fn now(&engine: EarlyDeadline) -> Duration { Duration::from_nanos(0) }
}

instance PlanOutput[ExpiredStage! -> Buffer!] {}

instance StageDriver[ExpiredStage!, EarlyDeadline -> Buffer!] {
    fn drive(task: ExpiredStage!, &engine: EarlyDeadline, deadline: Option[Duration]) -> StageResult[Buffer!] {
        let { output } = task;
        StageResult.{ output, deadline_expired: true }
    }
}

fn unexpected_resume(state: Buffer!, output: Buffer!) -> Option[ExpiredStage!] {
    state.destroy();
    output.destroy();
    trap()
}

fn discard_expired(state: Buffer!, output: Option[Buffer!]) {
    let output = output.unwrap();
    let valid = &state.len() == 5 && &output.len() == 6;
    state.destroy();
    output.destroy();
    if !valid { trap(); }
}

fn check_reported_deadline() -> bool {
    let stage = ExpiredStage!.{ output: Buffer!::new().push_static("output") };
    let plan = stage.then_owned_with(Buffer!::new().push_static("state"),
        |state, output| unexpected_resume(state, output), discard_expired);
    let engine = EarlyDeadline.{};
    match drive_sequence_until(plan, &engine, Option::Some.(Duration::from_secs(1))) {
        Cancelled => true,
        Finished(output) => { output.destroy(); false },
        Stopped => false,
    }
}

fn check_local_timeout_handoff() -> bool {
    let immediate = Duration::from_nanos(0);
    let stage = sleep(Duration::from_secs(30)).within(immediate);
    let plan = stage.then(|outcome| {
        let (status, deadline) = outcome;
        match status { Completion::Cancelled => (), _ => trap() };
        match deadline {
            DeadlineStatus::TimedOut => Option::Some.(sleep(immediate)),
            _ => trap(),
        }
    });
    match run_sequence(plan, Option::None) {
        Finished(status) => match status { Ready => true, _ => false },
        _ => false,
    }
}

struct TestStream! { marker: Buffer!, delay: Duration }
struct TestItem! { bytes: Buffer! }

instance Discard[TestItem!] {
    fn discard(item: TestItem!) {
        let { bytes } = item;
        bytes.destroy();
    }
}

instance Stream[TestStream! -> Map![Sleep!, Completion[()], (TestStream!, StreamOutcome[TestItem!]), (TestStream!,)]] {
    fn next(source: TestStream!)
        -> Map![Sleep!, Completion[()], (TestStream!, StreamOutcome[TestItem!]), (TestStream!,)] {
        let { marker, delay } = source;
        let source = TestStream!.{ marker, delay };
        sleep(delay).map(|status| {
            let outcome = match status {
                Completion::Ready => StreamOutcome::Item.(TestItem!.{ bytes: Buffer!::new().push_static("item") }),
                TimedOut => StreamOutcome::TimedOut,
                Cancelled => StreamOutcome::Cancelled,
                Failed(failure) => StreamOutcome::Failed.(failure),
            };
            (source, outcome)
        })
    }
}

instance Sink[TestStream! -> TestItem!,
    Map![Sleep!, Completion[()], (TestStream!, TestItem!, Completion[()]), (TestStream!, TestItem!)]] {
    fn write(writer: TestStream!, item: TestItem!)
        -> Map![Sleep!, Completion[()], (TestStream!, TestItem!, Completion[()]), (TestStream!, TestItem!)] {
        let { marker, delay } = writer;
        let writer = TestStream!.{ marker, delay };
        sleep(delay).map(|status| (writer, item, status))
    }
}

fn test_stream(delay: Duration) -> TestStream! {
    TestStream!.{ marker: Buffer!::new().push_static("source"), delay }
}

fn check_returned_stream(source: TestStream!) -> bool {
    let { marker, delay } = source;
    let valid = &marker.len() == 6;
    marker.destroy();
    valid
}

fn check_timed_stream() -> bool {
    let immediate = Duration::from_millis(0);
    let pending = Duration::from_secs(30);
    let (source, outcome) = run(test_stream(immediate).next_within(pending));
    let ready = match outcome {
        Item(item) => {
            let { bytes } = item;
            let valid = &bytes.len() == 4;
            bytes.destroy();
            valid
        },
        _ => false,
    };
    let ready_source = check_returned_stream(source);

    let (source, outcome) = run(test_stream(pending).next_within(immediate));
    let timed_out = match outcome {
        TimedOut => true,
        Item(item) => { item.discard(); false },
        _ => false,
    };
    let timed_out_source = check_returned_stream(source);

    let (source, outcome) = run_with_deadline(test_stream(pending).next_within(pending), immediate);
    let cancelled = match outcome {
        Cancelled => true,
        Item(item) => { item.discard(); false },
        _ => false,
    };
    let cancelled_source = check_returned_stream(source);
    ready && ready_source && timed_out && timed_out_source && cancelled && cancelled_source
}

fn check_timed_send() -> bool {
    let immediate = Duration::from_millis(0);
    let pending = Duration::from_secs(30);
    let item = TestItem!.{ bytes: Buffer!::new().push_static("send") };
    let (writer, outcome) = run(test_stream(immediate).send(item));
    let returned = check_returned_stream(writer);
    match outcome { Ready => if !returned { return false; }, _ => return false };

    let item = TestItem!.{ bytes: Buffer!::new().push_static("send") };
    let send = test_stream(pending).send_within(item, immediate);
    let ((writer, outcome), sibling, status) = run(join(send, sleep(immediate)));
    let returned = check_returned_stream(writer);
    match outcome {
        TimedOut => (),
        _ => return false,
    };
    match sibling { Ready => (), _ => return false };
    match status { Ready => returned, _ => false }
}

fn check_dependent_plan() -> bool {
    let step = Duration::from_millis(15);
    let plan: ChainPlan![Completion[()], Scope!] = sleep(step).and_then(|unit| sleep(step));
    let (first, second, status) = run(select(plan, sleep(Duration::from_millis(100))));
    match first { Ready => (), _ => return false };
    match second { Cancelled => (), _ => return false };
    match status {
        Ready(side) => match side { First => true, Second => false },
        _ => false,
    }
}

fn check_sequence_plan() -> bool {
    let instant = Duration::from_nanos(0);
    let sequence = sleep(instant).then(|status| -> Option[Sleep!] { Option::None });
    let plan: ChainPlan![SequenceOutcome[Completion[()]], Scope!] = sequence.into_plan();
    match run(plan) { Stopped => true, _ => false }
}

fn main() -> i32 {
    let plan = ReverseSelect!.{ first: sleep(Duration::from_nanos(0)), second: sleep(Duration::from_secs(30)), id: Option::None };
    let rejected_pair = RejectedPair.{ root: Option::None, rejected: false };
    if run(plan) && check_invalid_root(true) && check_invalid_root(false) && run(rejected_pair) && check_cancelled_join() &&
        check_deadline_timer_results() && check_reported_deadline() && check_local_timeout_handoff() &&
        check_timed_stream() && check_timed_send() && check_dependent_plan() && check_sequence_plan() { 0 } else { 1 }
}
