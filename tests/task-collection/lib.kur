use async::run;
use std::buffer::Buffer!;
use std::option::Option;
use std::time::Duration;
use task::{Completion, Failure, PlanOutput, Sleep!, select, sleep};
use task::driver::{Pair, PairKind, Plan, PlanDriver, Resolution};

struct ReverseSelect! { first: Sleep![u8], second: Sleep![u8], id: Option[usize] }

instance PlanOutput[ReverseSelect! -> bool] {}

forall Driver where PlanDriver[Driver].
instance Plan[ReverseSelect!, Driver -> bool] {
    fn stage(&task: ReverseSelect!, &scope: Driver) -> Option[usize] {
        let { first, second, id: old } = task;
        let a = Plan[Sleep![u8], Driver -> (u8, Completion[()])]::stage(&first, &scope);
        let b = Plan[Sleep![u8], Driver -> (u8, Completion[()])]::stage(&second, &scope);
        let id = match a {
            Option::Some(a) => match b {
                Option::Some(b) => PlanDriver[Driver]::pair(&scope, Pair.{ kind: PairKind::Select, first: a, second: b }),
                Option::None => Option::None,
            },
            Option::None => Option::None,
        };
        task = ReverseSelect!.{ first, second, id };
        id
    }

    fn collect(task: ReverseSelect!, &scope: Driver) -> bool {
        let { first, second, id } = task;
        let selected = match PlanDriver[Driver]::result(&scope, id) {
            Resolution::First => true,
            _ => false,
        };
        let (value, status) = Plan[Sleep![u8], Driver -> (u8, Completion[()])]::collect(second, &scope);
        let cancelled = match status {
            Completion::Cancelled => value == 2u8,
            _ => false,
        };
        let (value, status) = Plan[Sleep![u8], Driver -> (u8, Completion[()])]::collect(first, &scope);
        let completed = match status {
            Completion::Ready => value == 1u8,
            _ => false,
        };
        selected && cancelled && completed
    }
}

struct UnrootedTimer! { timer: Sleep![Buffer!] }

instance PlanOutput[UnrootedTimer! -> (Buffer!, Completion[()])] {}

forall Driver where PlanDriver[Driver].
instance Plan[UnrootedTimer!, Driver -> (Buffer!, Completion[()])] {
    fn stage(&task: UnrootedTimer!, &scope: Driver) -> Option[usize] {
        let { timer } = task;
        Plan[Sleep![Buffer!], Driver -> (Buffer!, Completion[()])]::stage(&timer, &scope);
        task = UnrootedTimer!.{ timer };
        Option::None
    }

    fn collect(task: UnrootedTimer!, &scope: Driver) -> (Buffer!, Completion[()]) {
        let { timer } = task;
        Plan[Sleep![Buffer!], Driver -> (Buffer!, Completion[()])]::collect(timer, &scope)
    }
}

forall T where Copy[T].
fn invalid_plan(status: Completion[T]) -> bool {
    match status {
        Completion::Failed(failure) => match failure { Failure::InvalidPlan => true, _ => false },
        _ => false,
    }
}

fn check_unrooted_timer() -> bool {
    let first = UnrootedTimer!.{ timer: sleep(Duration::from_nanos(0), Buffer!::new().push_static("first")) };
    let second = sleep(Duration::from_nanos(0), Buffer!::new().push_static("second"));
    let ((first, first_status), (second, second_status), race_status) = run(select(first, second));
    let lengths_ok = &first.len() == 5 && &second.len() == 6;
    first.destroy();
    second.destroy();
    lengths_ok && invalid_plan(first_status) && invalid_plan(second_status) && invalid_plan(race_status)
}

fn main() -> i32 {
    let plan = ReverseSelect!.{ first: sleep(Duration::from_nanos(0), 1u8), second: sleep(Duration::from_secs(30), 2u8), id: Option::None };
    if run(plan) && check_unrooted_timer() { 0 } else { 1 }
}
