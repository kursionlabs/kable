use async::{run, run_sequence, run_with_deadline};
use std::buffer::Buffer!;
use std::option::Option;
use std::process::trap;
use std::time::Duration;
use task::{Completion, DeadlineStatus, Failure, PlanOutput, Sleep!, join, select, sleep};
use task::driver::{Branch, Pair, PairKind, Plan, PlanDriver, Resolution, Resource, ScopeState!};
use task::sequence::{Clock, SequenceOutcome, StageDriver, StageResult, drive_sequence, sequence};

struct ReverseSelect! { first: Sleep!, second: Sleep!, id: Option[usize] }

instance PlanOutput[ReverseSelect! -> bool] {}

forall Driver where PlanDriver[Driver].
instance Plan[ReverseSelect!, Driver -> bool] {
    fn stage(&task: ReverseSelect!, &scope: Driver) -> Option[usize] {
        let { first, second, id: old } = task;
        let a = Plan[Sleep!, Driver -> Completion[()]]::stage(&first, &scope);
        let b = Plan[Sleep!, Driver -> Completion[()]]::stage(&second, &scope);
        let id = match a {
            Option::Some(a) => match b {
                Option::Some(b) => PlanDriver[Driver]::pair(&scope, Pair.{ kind: PairKind::Select, first: a, second: b }),
                Option::None => Option::None,
            },
            Option::None => Option::None,
        };
        task = ReverseSelect!.{ first, second, id };
        id
    }

    fn collect(task: ReverseSelect!, &scope: Driver) -> bool {
        let { first, second, id } = task;
        let selected = match PlanDriver[Driver]::result(&scope, id) {
            Resolution::First => true,
            _ => false,
        };
        let status = Plan[Sleep!, Driver -> Completion[()]]::collect(second, &scope);
        let cancelled = match status {
            Completion::Cancelled => true,
            _ => false,
        };
        let status = Plan[Sleep!, Driver -> Completion[()]]::collect(first, &scope);
        let completed = match status {
            Completion::Ready => true,
            _ => false,
        };
        selected && cancelled && completed
    }
}

struct UnrootedTimer! { timer: Sleep!, bytes: Buffer! }

instance PlanOutput[UnrootedTimer! -> (Buffer!, Completion[()])] {}

forall Driver where PlanDriver[Driver].
instance Plan[UnrootedTimer!, Driver -> (Buffer!, Completion[()])] {
    fn stage(&task: UnrootedTimer!, &scope: Driver) -> Option[usize] {
        let { timer, bytes } = task;
        Plan[Sleep!, Driver -> Completion[()]]::stage(&timer, &scope);
        task = UnrootedTimer!.{ timer, bytes };
        Option::None
    }

    fn collect(task: UnrootedTimer!, &scope: Driver) -> (Buffer!, Completion[()]) {
        let { timer, bytes } = task;
        (bytes, Plan[Sleep!, Driver -> Completion[()]]::collect(timer, &scope))
    }
}

forall T where Copy[T].
fn invalid_plan(status: Completion[T]) -> bool {
    match status {
        Completion::Failed(failure) => match failure { Failure::InvalidPlan => true, _ => false },
        _ => false,
    }
}

fn check_unrooted_timer() -> bool {
    let first = UnrootedTimer!.{ timer: sleep(Duration::from_nanos(0)), bytes: Buffer!::new().push_static("first") };
    let bytes = Buffer!::new().push_static("second");
    let second = sleep(Duration::from_nanos(0)).map(|status| (bytes, status));
    let ((first, first_status), (second, second_status), race_status) = run(select(first, second));
    let lengths_ok = &first.len() == 5 && &second.len() == 6;
    first.destroy();
    second.destroy();
    lengths_ok && invalid_plan(first_status) && invalid_plan(second_status) && invalid_plan(race_status)
}

fn check_cancelled_join() -> bool {
    let first = Buffer!::new().push_static("first");
    let second = Buffer!::new().push_static("second");
    let suffix = Buffer!::new().push_static(" returned");
    let first = sleep(Duration::from_nanos(0)).map(|status| (first, status));
    let second = sleep(Duration::from_secs(30)).map(|status| (second.push_buffer(suffix), status));
    let ((first, first_status), (second, second_status), status) =
        run_with_deadline(join(first, second), Duration::from_millis(10));
    let lengths_ok = &first.len() == 5 && &second.len() == 15;
    first.destroy();
    second.destroy();
    let first_ready = match first_status { Completion::Ready => true, _ => false };
    let second_cancelled = match second_status { Completion::Cancelled => true, _ => false };
    let join_cancelled = match status { Completion::Cancelled => true, _ => false };
    lengths_ok && first_ready && second_cancelled && join_cancelled
}

struct DeadlineDriver! { state: ScopeState!, timer: Option[usize], timer_result: Resolution }

instance PlanDriver[DeadlineDriver!] {
    fn timer(&scope: DeadlineDriver!, duration: Duration) -> Option[usize] {
        let { state, timer, timer_result } = scope;
        let id = &state.add(Branch::Leaf);
        let timer = if duration.is_zero() { id } else { timer };
        scope = DeadlineDriver!.{ state, timer, timer_result };
        id
    }

    fn pair(&scope: DeadlineDriver!, pair: Pair) -> Option[usize] {
        let { state, timer, timer_result } = scope;
        let id = &state.add(Branch::Pair.(pair));
        scope = DeadlineDriver!.{ state, timer, timer_result };
        id
    }

    fn result(&scope: DeadlineDriver!, id: Option[usize]) -> Resolution {
        let { state, timer, timer_result } = scope;
        let id = id.unwrap();
        let result = (&state.result(id)).unwrap();
        scope = DeadlineDriver!.{ state, timer, timer_result };
        if id == timer.unwrap() { timer_result } else { result }
    }
}

forall Task where Plan[Task, DeadlineDriver! -> ((Buffer!, Completion[()]), DeadlineStatus)].
fn run_deadline_test(plan: Task, timer_result: Resolution) -> DeadlineStatus {
    let driver = DeadlineDriver!.{ state: ScopeState!::new(), timer: Option::None, timer_result };
    let root = Plan[Task, DeadlineDriver! -> ((Buffer!, Completion[()]), DeadlineStatus)]::stage(&plan, &driver);
    let { state, timer, timer_result } = driver;
    if !&state.begin(root.unwrap()) { trap(); }
    &state.started(Resource::Leaf.(0));
    &state.started(Resource::Leaf.(1));
    let winner = timer.unwrap();
    if !&state.complete(winner) { trap(); }
    let loser = (&state.take_cancel()).unwrap();
    &state.retired(Resource::Leaf.(winner));
    if !&state.retired(Resource::Leaf.(loser)) { trap(); }

    let driver = DeadlineDriver!.{ state, timer, timer_result };
    let ((bytes, status), deadline) =
        Plan[Task, DeadlineDriver! -> ((Buffer!, Completion[()]), DeadlineStatus)]::collect(plan, &driver);
    let { state, timer, timer_result } = driver;
    state.destroy();
    let length = &bytes.len();
    bytes.destroy();
    match status {
        Completion::Cancelled => { if length != 5 { trap(); } },
        _ => trap(),
    }
    deadline
}

fn deadline_with_timer_result(timer_result: Resolution) -> DeadlineStatus {
    let bytes = Buffer!::new().push_static("owned");
    let plan = sleep(Duration::from_secs(1)).map(|status| (bytes, status));
    run_deadline_test(plan.within(Duration::from_nanos(0)), timer_result)
}

fn check_deadline_timer_results() -> bool {
    let deadline = deadline_with_timer_result(Resolution::Failed.(Failure::Operation.(-42)));
    match deadline {
        DeadlineStatus::Failed(failure) => match failure {
            Failure::Operation(code) => { if code != -42 { return false; } },
            _ => return false,
        },
        _ => return false,
    }
    match deadline_with_timer_result(Resolution::Cancelled) {
        DeadlineStatus::Failed(failure) => match failure {
            Failure::InvalidResult => true,
            _ => false,
        },
        _ => false,
    }
}

struct EarlyDeadline {}
struct ExpiredStage! { output: Buffer! }

instance Clock[EarlyDeadline] {
    fn now(&engine: EarlyDeadline) -> Duration { Duration::from_nanos(0) }
}

instance PlanOutput[ExpiredStage! -> Buffer!] {}

instance StageDriver[ExpiredStage!, EarlyDeadline -> Buffer!] {
    fn drive(task: ExpiredStage!, &engine: EarlyDeadline, deadline: Option[Duration]) -> StageResult[Buffer!] {
        let { output } = task;
        StageResult.{ output, deadline_expired: true }
    }
}

fn unexpected_resume(state: Buffer!, output: Buffer!) -> Option[ExpiredStage!] {
    state.destroy();
    output.destroy();
    trap()
}

fn discard_expired(state: Buffer!, output: Option[Buffer!]) {
    let output = output.unwrap();
    let valid = &state.len() == 5 && &output.len() == 6;
    state.destroy();
    output.destroy();
    if !valid { trap(); }
}

fn check_reported_deadline() -> bool {
    let stage = ExpiredStage!.{ output: Buffer!::new().push_static("output") };
    let plan = sequence(stage).then_owned(Buffer!::new().push_static("state"),
        |state, output| unexpected_resume(state, output), discard_expired);
    let engine = EarlyDeadline.{};
    match drive_sequence(plan, &engine, Option::Some.(Duration::from_secs(1))) {
        SequenceOutcome::Cancelled => true,
        SequenceOutcome::Finished(output) => { output.destroy(); false },
        SequenceOutcome::Stopped => false,
    }
}

fn check_local_timeout_handoff() -> bool {
    let immediate = Duration::from_nanos(0);
    let stage = sleep(Duration::from_secs(30)).within(immediate);
    let plan = sequence(stage).then(|outcome| {
        let (status, deadline) = outcome;
        match status { Completion::Cancelled => (), _ => trap() };
        match deadline {
            DeadlineStatus::TimedOut => Option::Some.(sleep(immediate)),
            _ => trap(),
        }
    });
    match run_sequence(plan, Option::None) {
        SequenceOutcome::Finished(status) => match status { Completion::Ready => true, _ => false },
        _ => false,
    }
}

fn main() -> i32 {
    let plan = ReverseSelect!.{ first: sleep(Duration::from_nanos(0)), second: sleep(Duration::from_secs(30)), id: Option::None };
    if run(plan) && check_unrooted_timer() && check_cancelled_join() && check_deadline_timer_results() &&
        check_reported_deadline() && check_local_timeout_handoff() { 0 } else { 1 }
}
