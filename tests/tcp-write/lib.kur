use async::host::prepare_hosted;
use std::buffer::Buffer!;
use std::io::{eprint_buffer, print_buffer};
use std::mem::alloca;
use std::option::{Option, Result};
use std::process::{Args, trap};
use std::time::Duration;
use task::{Completion, DeadlineStatus, Failure, PlanOutput, Sink, Stream, StreamOutcome};
use tcp::{Action!, Connection!, Listener!};

const LARGE_WRITE: usize = 16 * 1024 * 1024;

fn finish_write(result: ((Connection!, Buffer!, Completion[()]), DeadlineStatus)) -> Action! {
    let ((connection, bytes, completion), deadline) = result;
    let length = &bytes.len();
    bytes.destroy();
    if length != LARGE_WRITE { trap(); }
    let reason = match deadline {
        Completed => "completed",
        TimedOut => "timeout",
        Cancelled => "shutdown",
        Failed => "scope failure",
    };
    let status = match completion {
        Ready => "written",
        TimedOut => "timed out",
        Cancelled => "cancelled",
        Failed => "failed",
    };
    eprint_buffer(f"write {reason}: {status}\n");
    connection.close()
}

fn finish_send(result: (Connection!, Completion[()])) -> Action! {
    let (connection, completion) = result;
    let status = match completion {
        Ready => "written",
        TimedOut => "timed out",
        Cancelled => "cancelled",
        Failed => "failed",
    };
    eprint_buffer(f"send {status}\n");
    connection.close()
}

fn discard_write(connection: Connection!) -> Connection! {
    let returned = unsafe alloca[Option[Connection!]]();
    unsafe *returned = Option::None;
    let write = connection.write(Buffer!::new().push_static("discarded"));
    let hosted = prepare_hosted(write, |result, host, state| {
        let (connection, bytes, status) = result;
        let length = &bytes.len();
        bytes.destroy();
        let unstarted = match status {
            Completion::Failed(failure) => match failure { NotStarted => true, _ => false },
            _ => false,
        };
        if !unstarted || length != 9 || state != 0 { trap(); }
        let returned = unsafe (host as *Option[Connection!]);
        unsafe *returned = Option::Some.(connection);
        0
    });
    unsafe hosted.discard(unsafe (returned as *u8));
    (unsafe *returned).unwrap()
}

fn send_after_eof(connection: Connection!, consuming: bool) -> Action! {
    let connection = discard_write(connection);
    connection.send(Buffer!::new_with_cap(0)).defer_tcp(|outcome| {
        let (connection, status) = outcome;
        match status { Completion::Ready => (), _ => return connection.close() };
        let bytes = Buffer!::new_zeroed(LARGE_WRITE);
        if consuming {
            return connection.send_within(bytes, Duration::from_millis(1500))
                .defer_tcp(|result| finish_send(result));
        }
        connection.write(bytes).within(Duration::from_millis(1500)).defer_tcp(|result| finish_write(result))
    })
}

fn serve(connection: Connection!, consuming: bool) -> Action! {
    connection.next().defer_tcp(|result| {
        let (connection, outcome) = result;
        match outcome {
            StreamOutcome::Eof => send_after_eof(connection, consuming),
            Item(bytes) => { bytes.destroy(); connection.close() },
            TimedOut | Cancelled | Failed => connection.close(),
        }
    })
}

fn serve_write(connection: Connection!) -> Action! { serve(connection, false) }

fn serve_send(connection: Connection!) -> Action! { serve(connection, true) }

fn main(args: Args) -> i32 {
    let accept: fn(Connection!) -> Action! = if args.len() > 1 { serve_send } else { serve_write };
    let listener = match Listener!::bind_connections(0, accept) {
        Ok(listener) => listener,
        Err(code) => return 1,
    };
    let port = &listener.port();
    if print_buffer(f"Listening on 127.0.0.1:{port}\n").is_err() {
        listener.stop();
        return 1;
    }
    if listener.run().is_ok() { 0 } else { 1 }
}
