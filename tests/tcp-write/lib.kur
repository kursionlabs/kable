use async::host::prepare_hosted;
use std::buffer::Buffer!;
use std::io::{eprint_buffer, print_buffer};
use std::mem::alloca;
use std::option::{Option, Result};
use std::process::trap;
use std::time::Duration;
use task::{Completion, DeadlineStatus, Failure, PlanOutput, Sink, Stream};
use tcp::{Action!, Connection!, Listener!, defer};

fn finish_write(result: ((Connection!, Buffer!, Completion[()]), DeadlineStatus)) -> Action! {
    let ((connection, bytes, completion), deadline) = result;
    let reason = match deadline {
        DeadlineStatus::Completed => "completed",
        DeadlineStatus::TimedOut => "timeout",
        DeadlineStatus::Cancelled => "shutdown",
        DeadlineStatus::Failed => "scope failure",
    };
    let status = match completion {
        Completion::Ready => "written",
        Completion::Cancelled => "cancelled",
        Completion::Failed => "failed",
    };
    let length = &bytes.len();
    bytes.destroy();
    eprint_buffer(f"{reason}: {status} {length}\n");
    connection.close()
}

fn discard_write(connection: Connection!) -> Connection! {
    let returned = unsafe alloca[Option[Connection!]]();
    unsafe *returned = Option::None;
    let write = connection.write(Buffer!::new().push_static("discarded"));
    let hosted = prepare_hosted(write, |result, host, state| {
        let (connection, bytes, status) = result;
        let length = &bytes.len();
        bytes.destroy();
        let unstarted = match status {
            Completion::Failed(failure) => match failure { Failure::NotStarted => true, _ => false },
            _ => false,
        };
        if !unstarted || length != 9 || state != 0 { trap(); }
        let returned = unsafe (host as *Option[Connection!]);
        unsafe *returned = Option::Some.(connection);
        0
    });
    unsafe hosted.discard(unsafe (returned as *u8));
    (unsafe *returned).unwrap()
}

fn send_after_eof(connection: Connection!) -> Action! {
    let connection = discard_write(connection);
    defer(connection.write(Buffer!::new_with_cap(0)), |outcome| {
        let (connection, bytes, status) = outcome;
        bytes.destroy();
        match status { Completion::Ready => (), _ => return connection.close() };
        let bytes = Buffer!::new_zeroed(16 * 1024 * 1024);
        defer(connection.write(bytes).within(Duration::from_millis(1500)), |result| finish_write(result))
    })
}

fn serve(connection: Connection!) -> Action! {
    defer(connection.next(), |result| {
        let (connection, outcome) = result;
        match outcome {
            Completion::Ready(chunk) => match chunk {
                Option::None => send_after_eof(connection),
                Option::Some(bytes) => { bytes.destroy(); connection.close() },
            },
            Completion::Cancelled | Completion::Failed => connection.close(),
        }
    })
}

fn main() -> i32 {
    let listener = match Listener!::bind_connections(0, serve) {
        Result::Ok(listener) => listener,
        Result::Err(code) => return 1,
    };
    let port = &listener.port();
    if print_buffer(f"Listening on 127.0.0.1:{port}\n").is_err() {
        listener.stop();
        return 1;
    }
    if listener.run().is_ok() { 0 } else { 1 }
}
