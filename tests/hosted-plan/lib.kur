use async::{Completion, DeadlineStatus, PlanOutput, join, sleep};
use async::host::{HostedPlan!, prepare_hosted};
use std::buffer::Buffer!;
use std::mem::alloca;
use std::option::Result;

fn failed(status: Completion[()]) -> bool {
    match status { Completion::Failed => true, _ => false }
}

fn pending() -> HostedPlan! {
    let bytes = Buffer!::new().push_static("owned");
    let plan = join(sleep(0, bytes), sleep(0, 7u8));
    prepare_hosted(plan.within(1000), |outcome, host, state| {
        let (((bytes, first), (value, second), status), deadline) = outcome;
        let length = &bytes.len();
        bytes.destroy();
        let count = unsafe (host as *usize);
        unsafe *count = (unsafe *count) + 1;
        let deadline_failed = match deadline { DeadlineStatus::Failed => true, _ => false };
        if deadline_failed && failed(status) && failed(first) && failed(second) && length == 5 && value == 7 && state == 0 {
            17
        } else {
            -1
        }
    })
}

fn main() -> i32 {
    let count = unsafe alloca[usize]();
    unsafe *count = 0;
    let host = unsafe (count as *u8);

    let submission = unsafe pending().submit(host, |scope, root, plan, finish| -42);
    match submission {
        Result::Ok => return 1,
        Result::Err(rejection) => {
            let (error, continued) = rejection;
            if error != -42 || continued != 17 || (unsafe *count) != 1 { return 1; }
        },
    };

    unsafe pending().discard(host);
    if (unsafe *count) == 2 { 0 } else { 1 }
}
