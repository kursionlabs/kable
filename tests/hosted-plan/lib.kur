use async::{Scope!, run, run_sequence, run_with_deadline, with_runner};
use async::host::{HostedPlan!, prepare_hosted};
use std::buffer::Buffer!;
use std::mem::alloca;
use std::option::{Option, Result};
use std::ptr::null;
use std::process::trap;
use std::time::Duration;
use task::{Completion, DeadlineStatus, Failure, PlanOutput, Sleep!, join, sleep};
use task::driver::Plan;
use task::sequence::SequenceOutcome;

extern "C" fn kable_test_loop_begin(error: i32) -> ();
extern "C" fn kable_test_loop_end(expected_closes: u32) -> u8;
extern "C" fn kable_test_advance_clock_on_init(nanoseconds: u64) -> ();
extern "C" fn kable_test_advance_clock_on_allocation(nanoseconds: u64) -> ();
extern "C" fn kable_test_advance_clock(nanoseconds: u64) -> ();
extern "C" fn kable_test_deferred_start(operation: *u8, loop: *u8,
    ready: unsafe fn(*u8) -> (), context: *u8) -> i32;
extern "C" fn kable_test_deferred_stop(operation: *u8) -> u8;
extern "C" fn kable_test_deferred_retired() -> u8;

fn never_started(failure: Failure) -> bool {
    match failure { Failure::NotStarted => true, _ => false }
}

fn not_started(status: Completion[()]) -> bool {
    match status { Completion::Failed(failure) => never_started(failure), _ => false }
}

struct FailStart { stage_nanos: u64 }

unsafe fn fail_start(operation: *u8, loop: *u8, ready: unsafe fn(*u8) -> (), context: *u8) -> i32 { -42 }
unsafe fn stop_unstarted(operation: *u8) -> u8 { trap() }

instance PlanOutput[FailStart -> ()] {}

instance Plan[FailStart, Scope! -> ()] {
    fn stage(&task: FailStart, &scope: Scope!) -> Option[usize] {
        let { stage_nanos } = task;
        task = FailStart.{ stage_nanos };
        unsafe kable_test_advance_clock(stage_nanos);
        unsafe &scope.add_operation(null(), fail_start, stop_unstarted)
    }
    fn collect(task: FailStart, &scope: Scope!) -> () { () }
}

fn startup_failed(status: Completion[()]) -> bool {
    match status {
        Completion::Failed(failure) => match failure {
            Failure::Startup(code) => code == -42,
            _ => false,
        },
        _ => false,
    }
}

fn check_startup_failure() -> bool {
    let first = Buffer!::new().push_static("first");
    let second = Buffer!::new().push_static("second");
    let first = sleep(Duration::from_secs(30)).map(|status| (first, status));
    let second = sleep(Duration::from_secs(30)).map(|status| (second, status));
    let plan = join(first, join(second, FailStart.{ stage_nanos: 0 }));
    let (((first, first_status), ((second, second_status), unit, inner), outer), deadline) = run(plan.within(Duration::from_secs(1)));
    let lengths_ok = &first.len() == 5 && &second.len() == 6;
    first.destroy();
    second.destroy();
    let deadline_failed = match deadline {
        DeadlineStatus::Failed(failure) => match failure {
            Failure::Startup(code) => code == -42,
            _ => false,
        },
        _ => false,
    };
    lengths_ok && startup_failed(first_status) && startup_failed(second_status)
        && startup_failed(inner) && startup_failed(outer) && deadline_failed
}

struct DeferredClose {}

instance PlanOutput[DeferredClose -> bool] {}

instance Plan[DeferredClose, Scope! -> bool] {
    fn stage(&task: DeferredClose, &scope: Scope!) -> Option[usize] {
        unsafe &scope.add_operation(null(), kable_test_deferred_start, kable_test_deferred_stop)
    }
    fn collect(task: DeferredClose, &scope: Scope!) -> bool {
        (unsafe kable_test_deferred_retired()) != 0
    }
}

fn check_partial_start_retirement() -> bool {
    let (retired, unit, status) = run(join(DeferredClose.{}, FailStart.{ stage_nanos: 0 }));
    retired && startup_failed(status)
}

fn discard_sequence(unit: (), prior: Option[(Buffer!, Completion[()])]) {
    match prior {
        Option::Some(outcome) => { let (bytes, status) = outcome; bytes.destroy(); },
        Option::None => (),
    }
}

fn sequence_stage_status(status: Completion[()], failed: bool) -> bool {
    if failed { return startup_failed(status); }
    match status { Completion::Ready => true, _ => false }
}

fn check_one_shot_loop(error: i32) -> bool {
    unsafe kable_test_loop_begin(error);
    let status = run(sleep(Duration::from_nanos(0)));
    let loop_matched = (unsafe kable_test_loop_end(if error == 0 { 1 } else { 0 })) != 0;
    loop_matched && sequence_stage_status(status, error != 0)
}

fn check_one_shot_deadline(budget: Duration, init_time: Duration, should_finish: bool) -> bool {
    let immediate = Duration::from_nanos(0);
    unsafe kable_test_loop_begin(0);
    unsafe kable_test_advance_clock_on_init(init_time.as_nanos());
    let status = run_with_deadline(sleep(immediate), budget);
    let loop_matched = (unsafe kable_test_loop_end(1)) != 0;
    let expected = match status {
        Completion::Ready => should_finish,
        Completion::Cancelled => !should_finish,
        Completion::Failed => false,
    };
    loop_matched && expected
}

fn check_sequence_loop(error: i32) -> bool {
    let immediate = Duration::from_nanos(0);
    let bytes = Buffer!::new().push_static("owned");
    let plan = sleep(immediate).map(|status| (bytes, status))
        .then_owned((), |unit, prior| Option::Some.(sleep(immediate).map(|status| (prior, status))), discard_sequence);
    unsafe kable_test_loop_begin(error);
    let result = run_sequence(plan, Option::None);
    let loop_matched = (unsafe kable_test_loop_end(if error == 0 { 1 } else { 0 })) != 0;
    match result {
        SequenceOutcome::Finished(outcome) => {
            let ((bytes, first), second) = outcome;
            let length = &bytes.len();
            bytes.destroy();
            loop_matched && length == 5 && sequence_stage_status(first, error != 0)
                && sequence_stage_status(second, error != 0)
        },
        _ => false,
    }
}

fn check_runner_reuse() -> bool {
    let immediate = Duration::from_nanos(0);
    unsafe kable_test_loop_begin(0);
    unsafe kable_test_advance_clock_on_init(0);
    let (bytes, first, second, timer, joined) = with_runner(|&runner| {
        let bytes = Buffer!::new().push_static("owned");
        let slow = sleep(Duration::from_secs(30)).map(|status| (bytes, status));
        let (bytes, first) = &runner.run_with_deadline(slow, immediate);
        let quick = sleep(immediate).map(|status| (bytes, status));
        let (bytes, second) = &runner.run(quick);
        let stage_time = Duration::from_millis(10);
        let budget = Duration::from_millis(5);
        let plan = join(sleep(immediate), FailStart.{ stage_nanos: stage_time.as_nanos() });
        let (timer, unit, joined) = &runner.run_with_deadline(plan, budget);
        (bytes, first, second, timer, joined)
    });
    let loop_matched = (unsafe kable_test_loop_end(1)) != 0;
    let length = &bytes.len();
    bytes.destroy();
    let cancelled = match first { Completion::Cancelled => true, _ => false };
    let ready = match second { Completion::Ready => true, _ => false };
    let timer_cancelled = match timer { Completion::Cancelled => true, _ => false };
    let scope_cancelled = match joined { Completion::Cancelled => true, _ => false };
    loop_matched && length == 5 && cancelled && ready && timer_cancelled && scope_cancelled
}

fn discard_runner_sequence(state: (Buffer!, *u8), prior: Option[(Buffer!, Completion[()])]) {
    let (state, cleaned) = state;
    let (bytes, status) = prior.unwrap();
    let valid = &state.len() == 5 && &bytes.len() == 6;
    state.destroy();
    bytes.destroy();
    if !valid { trap(); }
    match status { Completion::Cancelled => (), _ => trap() };
    unsafe *cleaned = (unsafe *cleaned) + 1;
}

fn check_runner_sequence() -> bool {
    let immediate = Duration::from_nanos(0);
    let cleaned = unsafe alloca[u8]();
    unsafe *cleaned = 0;
    unsafe kable_test_loop_begin(0);
    unsafe kable_test_advance_clock_on_init(0);
    let valid = with_runner(|&runner| {
        let before = &runner.run(sleep(immediate));
        let bytes = Buffer!::new().push_static("output");
        let first = sleep(Duration::from_secs(30)).map(|status| (bytes, status));
        let chain = first.then_owned((Buffer!::new().push_static("state"), cleaned), |state, prior| {
            let (state, cleaned) = state;
            state.destroy();
            let (bytes, status) = prior;
            bytes.destroy();
            Option::Some.(sleep(immediate))
        }, discard_runner_sequence);
        let result = &runner.run_sequence(chain, Option::Some.(Duration::from_millis(1)));
        let cancelled = match result { SequenceOutcome::Cancelled => true, _ => false };
        let cleanup_ran = (unsafe *cleaned) == 1;
        let after = &runner.run(sleep(immediate));
        cancelled && cleanup_ran && sequence_stage_status(before, false) && sequence_stage_status(after, false)
    });
    let loop_matched = (unsafe kable_test_loop_end(1)) != 0;
    valid && loop_matched
}

fn discard_setup_sequence(cleaned: *u8, prior: Option[((Buffer!, Completion[()]), (), Completion[()])]) {
    let ((bytes, timer), unit, joined) = prior.unwrap();
    let length = &bytes.len();
    bytes.destroy();
    match timer { Completion::Cancelled => (), _ => trap() };
    match joined { Completion::Cancelled => (), _ => trap() };
    if length != 5 { trap(); }
    unsafe *cleaned = (unsafe *cleaned) + 1;
}

fn check_sequence_expires_during_setup(allocation_time: Duration, init_time: Duration) -> bool {
    let cleaned = unsafe alloca[u8]();
    unsafe *cleaned = 0;
    let bytes = Buffer!::new().push_static("owned");
    let owned = sleep(Duration::from_nanos(0)).map(|status| (bytes, status));
    let first = join(owned, FailStart.{ stage_nanos: 0 });
    let plan = first.then_owned(cleaned, |cleaned, prior| -> Option[Sleep!] {
        let ((bytes, timer), unit, joined) = prior;
        bytes.destroy();
        trap()
    }, discard_setup_sequence);
    unsafe kable_test_loop_begin(0);
    unsafe kable_test_advance_clock_on_init(init_time.as_nanos());
    // The sequence allocates its runner before staging its first plan.
    unsafe kable_test_advance_clock_on_allocation(allocation_time.as_nanos());
    let result = run_sequence(plan, Option::Some.(Duration::from_millis(5)));
    let loop_matched = (unsafe kable_test_loop_end(1)) != 0;
    let cancelled = match result { SequenceOutcome::Cancelled => true, _ => false };
    loop_matched && cancelled && (unsafe *cleaned) == 1
}

fn pending() -> HostedPlan! {
    let bytes = Buffer!::new().push_static("owned");
    let first = sleep(Duration::from_nanos(0)).map(|status| (bytes, status));
    let plan = join(first, sleep(Duration::from_nanos(0)));
    prepare_hosted(plan.within(Duration::from_secs(1)), |outcome, host, state| {
        let (((bytes, first), second, status), deadline) = outcome;
        let length = &bytes.len();
        bytes.destroy();
        let count = unsafe (host as *usize);
        unsafe *count = (unsafe *count) + 1;
        let deadline_failed = match deadline {
            DeadlineStatus::Failed(failure) => never_started(failure),
            _ => false,
        };
        if deadline_failed && not_started(status) && not_started(first) && not_started(second)
            && length == 5 && state == 0 {
            17
        } else {
            -1
        }
    })
}

unsafe fn reject_submission(host: *u8, scope: *u8, root: usize, plan: *u8,
    finish: unsafe fn(*u8, *u8, u8) -> i32, flags: u8) -> i32 {
    let count = unsafe (host as *usize);
    if flags == 6 && (unsafe *count) == 0 { -42 } else { -1 }
}

fn main() -> i32 {
    let zero = Duration::from_nanos(0);
    let tiny = Duration::from_nanos(1);
    let setup_time = Duration::from_millis(10);
    if !check_startup_failure() || !check_partial_start_retirement() ||
        !check_one_shot_loop(0) || !check_one_shot_loop(-42) ||
        !check_one_shot_deadline(zero, zero, false) ||
        !check_one_shot_deadline(tiny, zero, true) ||
        !check_one_shot_deadline(tiny, Duration::from_millis(1), false) ||
        !check_sequence_loop(0) || !check_sequence_loop(-42) || !check_runner_reuse() || !check_runner_sequence() ||
        !check_sequence_expires_during_setup(setup_time, zero) ||
        !check_sequence_expires_during_setup(zero, setup_time) { return 1; }
    let count = unsafe alloca[usize]();
    unsafe *count = 0;
    let host = unsafe (count as *u8);

    let submission = unsafe pending().submit(host, 6, reject_submission);
    match submission {
        Result::Ok => return 1,
        Result::Err(rejection) => {
            let (error, continued) = rejection;
            if error != -42 || continued != 17 || (unsafe *count) != 1 { return 1; }
        },
    };

    unsafe pending().discard(host);
    if (unsafe *count) == 2 { 0 } else { 1 }
}
