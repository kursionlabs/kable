use async::{Scope!, run, run_sequence, with_runner};
use async::host::{HostedPlan!, prepare_hosted};
use std::buffer::Buffer!;
use std::mem::alloca;
use std::option::{Option, Result};
use std::ptr::null;
use std::process::trap;
use std::time::Duration;
use task::{Completion, DeadlineStatus, Failure, PlanOutput, join, sleep};
use task::driver::Plan;
use task::sequence::{SequenceOutcome, sequence};

extern "C" fn kable_test_loop_begin(error: i32) -> ();
extern "C" fn kable_test_loop_end(expected_closes: u32) -> u8;

fn never_started(failure: Failure) -> bool {
    match failure { Failure::NotStarted => true, _ => false }
}

fn not_started(status: Completion[()]) -> bool {
    match status { Completion::Failed(failure) => never_started(failure), _ => false }
}

struct FailStart {}

unsafe fn fail_start(operation: *u8, loop: *u8, ready: unsafe fn(*u8) -> (), context: *u8) -> i32 { -42 }
unsafe fn stop_unstarted(operation: *u8) -> u8 { trap() }

instance PlanOutput[FailStart -> ()] {}

instance Plan[FailStart, Scope! -> ()] {
    fn stage(&task: FailStart, &scope: Scope!) -> Option[usize] {
        unsafe &scope.add_operation(null(), fail_start, stop_unstarted)
    }
    fn collect(task: FailStart, &scope: Scope!) -> () { () }
}

fn startup_failed(status: Completion[()]) -> bool {
    match status {
        Completion::Failed(failure) => match failure {
            Failure::Startup(code) => code == -42,
            _ => false,
        },
        _ => false,
    }
}

fn check_startup_failure() -> bool {
    let first = sleep(Duration::from_secs(30), Buffer!::new().push_static("first"));
    let second = sleep(Duration::from_secs(30), Buffer!::new().push_static("second"));
    let plan = join(first, join(second, FailStart.{}));
    let (((first, first_status), ((second, second_status), unit, inner), outer), deadline) = run(plan.within(Duration::from_secs(1)));
    let lengths_ok = &first.len() == 5 && &second.len() == 6;
    first.destroy();
    second.destroy();
    let deadline_failed = match deadline {
        DeadlineStatus::Failed(failure) => match failure {
            Failure::Startup(code) => code == -42,
            _ => false,
        },
        _ => false,
    };
    lengths_ok && startup_failed(first_status) && startup_failed(second_status)
        && startup_failed(inner) && startup_failed(outer) && deadline_failed
}

fn discard_sequence(unit: (), prior: Option[(Buffer!, Completion[()])]) {
    match prior {
        Option::Some(outcome) => { let (bytes, status) = outcome; bytes.destroy(); },
        Option::None => (),
    }
}

fn sequence_stage_status(status: Completion[()], failed: bool) -> bool {
    if failed { return startup_failed(status); }
    match status { Completion::Ready => true, _ => false }
}

fn check_sequence_loop(error: i32) -> bool {
    let immediate = Duration::from_nanos(0);
    let bytes = Buffer!::new().push_static("owned");
    let plan = sequence(sleep(immediate, bytes))
        .then_owned((), |unit, prior| Option::Some.(sleep(immediate, prior)), discard_sequence);
    unsafe kable_test_loop_begin(error);
    let result = run_sequence(plan, Option::None);
    let loop_matched = (unsafe kable_test_loop_end(if error == 0 { 1 } else { 0 })) != 0;
    match result {
        SequenceOutcome::Finished(outcome) => {
            let ((bytes, first), second) = outcome;
            let length = &bytes.len();
            bytes.destroy();
            loop_matched && length == 5 && sequence_stage_status(first, error != 0)
                && sequence_stage_status(second, error != 0)
        },
        _ => false,
    }
}

fn check_runner_reuse() -> bool {
    let immediate = Duration::from_nanos(0);
    unsafe kable_test_loop_begin(0);
    let (bytes, first, second) = with_runner(|&runner| {
        let bytes = Buffer!::new().push_static("owned");
        let (bytes, first) = &runner.run(sleep(Duration::from_secs(30), bytes), Option::Some.(immediate));
        let (bytes, second) = &runner.run(sleep(immediate, bytes), Option::None);
        (bytes, first, second)
    });
    let loop_matched = (unsafe kable_test_loop_end(1)) != 0;
    let length = &bytes.len();
    bytes.destroy();
    let cancelled = match first { Completion::Cancelled => true, _ => false };
    let ready = match second { Completion::Ready => true, _ => false };
    loop_matched && length == 5 && cancelled && ready
}

fn pending() -> HostedPlan! {
    let bytes = Buffer!::new().push_static("owned");
    let plan = join(sleep(Duration::from_nanos(0), bytes), sleep(Duration::from_nanos(0), 7u8));
    prepare_hosted(plan.within(Duration::from_secs(1)), |outcome, host, state| {
        let (((bytes, first), (value, second), status), deadline) = outcome;
        let length = &bytes.len();
        bytes.destroy();
        let count = unsafe (host as *usize);
        unsafe *count = (unsafe *count) + 1;
        let deadline_failed = match deadline {
            DeadlineStatus::Failed(failure) => never_started(failure),
            _ => false,
        };
        if deadline_failed && not_started(status) && not_started(first) && not_started(second)
            && length == 5 && value == 7 && state == 0 {
            17
        } else {
            -1
        }
    })
}

fn main() -> i32 {
    if !check_startup_failure() || !check_sequence_loop(0) || !check_sequence_loop(-42) ||
        !check_runner_reuse() { return 1; }
    let count = unsafe alloca[usize]();
    unsafe *count = 0;
    let host = unsafe (count as *u8);

    let submission = unsafe pending().submit(host, |scope, root, plan, finish| -42);
    match submission {
        Result::Ok => return 1,
        Result::Err(rejection) => {
            let (error, continued) = rejection;
            if error != -42 || continued != 17 || (unsafe *count) != 1 { return 1; }
        },
    };

    unsafe pending().discard(host);
    if (unsafe *count) == 2 { 0 } else { 1 }
}
