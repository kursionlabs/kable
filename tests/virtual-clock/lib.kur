use std::buffer::Buffer!;
use std::mem::alloca;
use std::option::Option;
use std::process::trap;
use std::time::Duration;
use task::{Completion, Discard, PlanOutput, Sleep!, join, select, sleep};
use task::sequence::SequenceOutcome;
use task::continuation::ChainPlan!;
use virtual_clock::{Virtual!, run, run_sequence, run_with_deadline};

fn check_deadline_order() -> bool {
    let deadline = Duration::from_nanos(2);
    let earlier = sleep(Duration::from_nanos(1));
    let bytes = Buffer!::new().push_static("owned");
    let tied = sleep(deadline).map(|status| (bytes, status));
    let (earlier, (bytes, tied), scope) = run_with_deadline(join(earlier, tied), deadline);
    let valid_buffer = &bytes.len() == 5;
    bytes.destroy();
    let earlier_ready = match earlier { Ready => true, _ => false };
    let tied_cancelled = match tied { Cancelled => true, _ => false };
    let scope_cancelled = match scope { Cancelled => true, _ => false };
    valid_buffer && earlier_ready && tied_cancelled && scope_cancelled
}

struct Tracked! { discards: *usize }

instance Discard[Tracked!] {
    fn discard(value: Tracked!) {
        let { discards } = value;
        unsafe *discards = (unsafe *discards) + 1;
    }
}

fn check_skipped_handoffs(as_plan: bool) -> bool {
    let first_state = unsafe alloca[usize]();
    let later_state = unsafe alloca[usize]();
    let joined_output = unsafe alloca[usize]();
    unsafe *first_state = 0;
    unsafe *later_state = 0;
    unsafe *joined_output = 0;

    let plan = sleep(Duration::from_nanos(10))
        .map(|status| (Tracked!.{ discards: joined_output }, status))
        .then_owned(Tracked!.{ discards: first_state }, |state, output| -> Option[Sleep!] {
            (state, output).discard();
            trap()
        })
        .then_owned(Tracked!.{ discards: later_state }, |state, output| -> Option[Sleep!] {
            (state, output).discard();
            trap()
        });
    let budget = Duration::from_nanos(2);
    let result = if as_plan {
        let task: ChainPlan![SequenceOutcome[Completion[()]], Virtual!] = plan.into_plan();
        run_with_deadline(task, budget)
    } else { run_sequence(plan, Option::Some.(budget)) };
    let cancelled = match result {
        SequenceOutcome::Cancelled => true,
        _ => false,
    };
    cancelled && (unsafe *first_state) == 1 && (unsafe *later_state) == 1 && (unsafe *joined_output) == 1
}

fn check_cancelled_dependent_handoff() -> bool {
    let count = unsafe alloca[usize]();
    unsafe *count = 0;
    let deadline = Duration::from_nanos(2);
    let first = sleep(deadline).map(|status| Completion::Ready.(Tracked!.{ discards: count }));
    let task: ChainPlan![Completion[()], Virtual!] = first.and_then(|value| -> Sleep! {
        value.discard();
        trap()
    });
    match run_with_deadline(task, deadline) {
        Cancelled => (unsafe *count) == 1,
        _ => false,
    }
}

fn check_second_stage_clock() -> bool {
    let task: ChainPlan![Completion[()], Virtual!] = sleep(Duration::from_nanos(2))
        .and_then(|unit| sleep(Duration::from_nanos(3)));
    let (task, timer, status) = run(select(task, sleep(Duration::from_nanos(4))));
    match task { Cancelled => (), _ => return false };
    match timer { Ready => (), _ => return false };
    match status { Ready(side) => match side { Second => true, First => false }, _ => false }
}

fn main() -> i32 {
    if check_deadline_order() && check_skipped_handoffs(false) && check_skipped_handoffs(true) &&
        check_cancelled_dependent_handoff() && check_second_stage_clock() { 0 } else { 1 }
}
