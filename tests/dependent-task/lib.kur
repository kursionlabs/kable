use async::{Scope!, read_file, run_with_deadline};
use std::buffer::Buffer!;
use std::io::eprint;
use std::slice::StaticRead;
use std::time::Duration;
use task::{Completion, Discard, PlanOutput};
use task::continuation::ChainPlan!;

extern "C" fn usleep(microseconds: u32) -> i32;

struct Prefix! { bytes: Buffer! }

instance Discard[Prefix!] {
    fn discard(prefix: Prefix!) {
        let { bytes } = prefix;
        bytes.destroy();
        eprint(f"Discarded the joined prefix.\n");
    }
}

fn hold_handoff(outcome: Completion[Buffer!]) -> Completion[Prefix!] {
    match outcome {
        Ready(bytes) => {
            // Hold the driver in collection until the enclosing budget expires.
            unsafe usleep(350_000);
            Completion::Ready.(Prefix!.{ bytes })
        },
        TimedOut => Completion::TimedOut,
        Cancelled => Completion::Cancelled,
        Failed(failure) => Completion::Failed.(failure),
    }
}

fn main() -> i32 {
    var access = StaticRead::new();
    let task: ChainPlan![Completion[Buffer!], Scope!] = read_file(&access, "example.txt", 1024)
        .map(|outcome| hold_handoff(outcome))
        .and_then(|prefix| {
            eprint(f"Started the footer continuation.\n");
            prefix.discard();
            var access = StaticRead::new();
            read_file(&access, "footer.txt", 1024)
        });
    match run_with_deadline(task, Duration::from_millis(250)) {
        Completion::Cancelled => 0,
        Ready(bytes) => { bytes.destroy(); 1 },
        _ => 1,
    }
}
