use std::buffer::Buffer!;
use std::mem::alloca;
use std::process::trap;
use thunk::{Step, delay, suspend};

fn check_force() -> bool {
    let calls = unsafe alloca[usize]();
    unsafe *calls = 0;
    let work = delay(Buffer!::new().push_static("owned"), |bytes| {
        unsafe *calls = (unsafe *calls) + 1;
        bytes
    }, Buffer!::destroy);
    let delayed = (unsafe *calls) == 0;
    let bytes = work.force();
    let length = &bytes.len();
    bytes.destroy();
    delayed && length == 5 && (unsafe *calls) == 1
}

fn discard_line(state: (Buffer!, *usize)) {
    let (bytes, released) = state;
    unsafe *released = (unsafe *released) + &bytes.len();
    bytes.destroy();
}

fn check_discard() -> bool {
    let released = unsafe alloca[usize]();
    unsafe *released = 0;
    let work = delay((Buffer!::new().push_static("delayed"), released), |state| -> () {
        discard_line(state);
        trap();
    }, discard_line);
    work.discard();
    (unsafe *released) == 7
}

fn read_byte(state: (Buffer!, *usize), byte: u8, delimiter: u8) -> Step[(Buffer!, *usize), Buffer!] {
    let (bytes, released) = state;
    if byte == delimiter { Step::Done.(bytes) }
    else { Step::Suspended.((bytes.push_byte(byte), released)) }
}

fn check_resume(finish: bool) -> bool {
    let released = unsafe alloca[usize]();
    unsafe *released = 0;
    let delimiter = b'\n';
    let line = suspend((Buffer!::new(), released),
        |state, byte| read_byte(state, byte, delimiter), discard_line);
    let line = match line.resume(b'a') {
        Step::Suspended(line) => line,
        Step::Done(bytes) => { bytes.destroy(); return false; },
    };
    let line = match line.resume(b'b') {
        Step::Suspended(line) => line,
        Step::Done(bytes) => { bytes.destroy(); return false; },
    };
    if !finish {
        line.discard();
        return (unsafe *released) == 2;
    }
    match line.resume(delimiter) {
        Step::Done(bytes) => {
            let length = &bytes.len();
            bytes.destroy();
            length == 2 && (unsafe *released) == 0
        },
        Step::Suspended(line) => { line.discard(); false },
    }
}

fn main() -> i32 {
    if check_force() && check_discard() && check_resume(true) && check_resume(false) { 0 } else { 1 }
}
