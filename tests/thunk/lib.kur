use std::buffer::Buffer!;
use std::mem::alloca;
use std::option::Option;
use std::process::trap;
use thunk::{Resumable, Step, defer, delay, suspend};

fn check_force() -> bool {
    let calls = unsafe alloca[usize]();
    unsafe *calls = 0;
    let work = delay(Buffer!::new().push_static("owned"), |bytes| {
        unsafe *calls = (unsafe *calls) + 1;
        bytes
    }, Buffer!::destroy);
    let delayed = (unsafe *calls) == 0;
    let bytes = work.force();
    let length = &bytes.len();
    bytes.destroy();
    delayed && length == 5 && (unsafe *calls) == 1
}

fn discard_line(state: (Buffer!, *usize)) {
    let (bytes, released) = state;
    unsafe *released = (unsafe *released) + &bytes.len();
    bytes.destroy();
}

fn check_discard() -> bool {
    let released = unsafe alloca[usize]();
    unsafe *released = 0;
    let work = delay((Buffer!::new().push_static("delayed"), released), |state| -> () {
        discard_line(state);
        trap();
    }, discard_line);
    work.discard();
    (unsafe *released) == 7
}

fn discard_handoff(state: (Buffer!, *usize), prior: Option[Buffer!]) {
    let (bytes, released) = state;
    discard_line((bytes, released));
    match prior {
        Some(bytes) => discard_line((bytes, released)),
        None => (),
    }
}

fn check_one_shot(resume: bool) -> bool {
    let released = unsafe alloca[usize]();
    unsafe *released = 0;
    let input = Buffer!::new().push_static("input");
    let work = defer((Buffer!::new().push_static("state"), released), |state, input| {
        let (bytes, released) = state;
        bytes.push_buffer(input)
    }, discard_handoff);
    if !resume {
        work.discard_with(Option::Some.(input));
        return (unsafe *released) == 10;
    }
    let bytes = work.resume(input);
    let length = &bytes.len();
    bytes.destroy();
    length == 10 && (unsafe *released) == 0
}

fn read_byte(state: (Buffer!, *usize), byte: u8, delimiter: u8) -> Step[(Buffer!, *usize), Buffer!] {
    let (bytes, released) = state;
    if byte == delimiter { Step::Done.(bytes) }
    else { Step::Suspended.((bytes.push_byte(byte), released)) }
}

fn check_resume(finish: bool) -> bool {
    let released = unsafe alloca[usize]();
    unsafe *released = 0;
    let delimiter = b'\n';
    let line = suspend((Buffer!::new(), released),
        |state, byte| read_byte(state, byte, delimiter), discard_line);
    let line = match line.resume(b'a') {
        Suspended(line) => line,
        Done(bytes) => { bytes.destroy(); return false; },
    };
    let line = match line.resume(b'b') {
        Suspended(line) => line,
        Done(bytes) => { bytes.destroy(); return false; },
    };
    if !finish {
        line.discard();
        return (unsafe *released) == 2;
    }
    match line.resume(delimiter) {
        Done(bytes) => {
            let length = &bytes.len();
            bytes.destroy();
            length == 2 && (unsafe *released) == 0
        },
        Suspended(line) => { line.discard(); false },
    }
}

fn main() -> i32 {
    if check_force() && check_discard() && check_one_shot(true) && check_one_shot(false) &&
        check_resume(true) && check_resume(false) { 0 } else { 1 }
}
