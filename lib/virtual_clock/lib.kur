//! Deterministic driver for timer plans. Each step advances to the next event.
use std::collections::vec::OwnedVec!;
use std::option::Option;
use std::process::trap;
use task::{Branch, JoinOutcome, Outcome, Plan, PlanDriver, RaceOutcome, ScopeState!, Sleep!, WithinOutcome,
    join, map, race, select, sleep, within};
use task::{Chain, Clock, Sequence!, StageDriver, drive_sequence, remaining_budget, sequence};

export JoinOutcome;
export Outcome;
export RaceOutcome;
export Sleep!;
export join;
export map;
export race;
export select;
export sleep;
export sequence;
export WithinOutcome;
export within;

struct Virtual! {
    state: ScopeState!,
    timers: OwnedVec![Option[u64]],
    cursor: usize,
}

instance PlanDriver[Virtual!] {
    fn timer(&scope: Virtual!, ms: u64) -> usize {
        let { state, timers, cursor } = scope;
        let id = &state.add(Branch::Leaf, 0usize, 0usize);
        let timers = if id == usize::MAX { timers } else { timers.push(Option::Some.(ms)) };
        scope = Virtual!.{ state, timers, cursor };
        id
    }

    fn pair(&scope: Virtual!, kind: Branch, first: usize, second: usize) -> usize {
        let { state, timers, cursor } = scope;
        let id = &state.add(kind, first, second);
        let timers = if id == usize::MAX { timers } else { timers.push(Option::None) };
        scope = Virtual!.{ state, timers, cursor };
        id
    }

    fn next(&scope: Virtual!) -> i32 {
        let { state, timers, cursor } = scope;
        let code = &state.result(cursor);
        scope = Virtual!.{ state, timers, cursor: cursor + 1usize };
        code
    }
}

fn earliest(&timers: OwnedVec![Option[u64]]) -> (usize, u64) {
    var id = usize::MAX;
    var earliest = u64::MAX;
    var i = 0usize;
    while i < &timers.len() {
        match &timers.at(i) {
            Option::Some(ms) => {
                if id == usize::MAX || ms < earliest {
                    id = i;
                    earliest = ms;
                }
            },
            Option::None => (),
        }
        i = i + 1usize;
    }
    (id, earliest)
}

fn advance(&scope: Virtual!, root: usize, deadline: Option[u64]) -> u64 {
    let { state, timers, cursor } = scope;
    if !&state.begin(root) {
        scope = Virtual!.{ state, timers, cursor };
        return 0u64;
    }
    let expired = match deadline { Option::Some(ms) => ms == 0u64, Option::None => false, };
    if expired {
        &state.cancel();
        scope = Virtual!.{ state, timers, cursor };
        return 0u64;
    }
    var limit = deadline;
    if limit.is_some() { &state.started(); }
    var i = 0usize;
    while i < &timers.len() {
        if (&timers.at(i)).is_some() { &state.started(); }
        i = i + 1usize;
    }

    var elapsed = 0u64;
    while &state.pending() {
        let (id, due) = earliest(&timers);
        let next_deadline = match limit {
            Option::Some(ms) => if ms <= due { Option::Some.(ms) } else { Option::None },
            Option::None => Option::None,
        };
        match next_deadline {
            Option::Some(ms) => {
                elapsed = ms;
                &state.cancel();
                &state.retired();
                limit = Option::None;
            },
            Option::None => {
                if id == usize::MAX { trap(); }
                elapsed = due;
                &timers.set(id, Option::None);
                let finished = &state.complete(id);
                &state.retired();
                if finished && limit.is_some() {
                    &state.retired();
                    limit = Option::None;
                }
            },
        }

        var cancelled = &state.take_cancel();
        while cancelled != usize::MAX {
            &timers.set(cancelled, Option::None);
            &state.retired();
            cancelled = &state.take_cancel();
        }
    }
    scope = Virtual!.{ state, timers, cursor };
    elapsed
}

fn ignore_timer(timer: Option[u64]) {}

forall Task, Output where Plan[Task, Output, Virtual!].
fn drive(task: Task, deadline: Option[u64]) -> Output {
    let (result, elapsed) = drive_timed(task, deadline);
    result
}

forall Task, Output where Plan[Task, Output, Virtual!].
fn drive_timed(task: Task, deadline: Option[u64]) -> (Output, u64) {
    var scope = Virtual!.{ state: ScopeState!::new(), timers: OwnedVec!::new(), cursor: 0usize };
    let root = Plan[Task, Output, Virtual!]::stage(&task, &scope);
    let elapsed = advance(&scope, root, deadline);
    let result = Plan[Task, Output, Virtual!]::collect(task, &scope);
    let { state, timers, cursor } = scope;
    state.destroy();
    timers.destroy(ignore_timer);
    (result, elapsed)
}

forall Task, Output where Plan[Task, Output, Virtual!].
fn run(task: Task) -> Output { drive(task, Option::None) }

forall Task, Output where Plan[Task, Output, Virtual!].
fn timeout(ms: u64, task: Task) -> Output { drive(task, Option::Some.(ms)) }

struct SequenceClock! { time: u64 }

instance Clock[SequenceClock!] {
    fn now(&engine: SequenceClock!) -> u64 {
        let { time } = engine;
        engine = SequenceClock!.{ time };
        time
    }
}

forall Task, Output where Plan[Task, Output, Virtual!].
instance StageDriver[Task, Output, SequenceClock!] {
    fn drive(task: Task, &engine: SequenceClock!, deadline: Option[u64]) -> Output {
        let remaining = remaining_budget(&engine, deadline);
        let { time } = engine;
        let (result, elapsed) = drive_timed(task, remaining);
        let time = if elapsed > u64::MAX - time { u64::MAX } else { time + elapsed };
        engine = SequenceClock!.{ time };
        result
    }
}

forall Stages, Output where Chain[Stages, Output, SequenceClock!].
fn run_sequence(plan: Sequence![Stages], budget: Option[u64]) -> Option[Output] {
    let clock = SequenceClock!.{ time: 0u64 };
    let result = drive_sequence(plan, &clock, budget);
    let { time } = clock;
    result
}
