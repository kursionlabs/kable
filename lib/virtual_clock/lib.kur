//! Deterministic driver for timer plans. Each step advances to the next event.
use std::collections::vec::OwnedVec!;
use std::option::Option;
use std::time::Duration;
use task::{Failure, PlanOutput};
use task::driver::{Branch, Pair, Plan, PlanDriver, Resolution, Resource, ScopeState!, drive_plan};
use task::sequence::{Chain, Clock, Sequence!, SequenceOutcome, StageDriver, StageResult, drive_sequence, remaining_budget};

struct Virtual! {
    state: ScopeState!,
    timers: OwnedVec![Option[Duration]],
    invalid_plan: bool,
}

instance PlanDriver[Virtual!] {
    fn timer(&scope: Virtual!, duration: Duration) -> Option[usize] {
        let { state, timers, invalid_plan } = scope;
        let id = &state.add(Branch::Leaf);
        let timers = if id.is_some() { timers.push(Option::Some.(duration)) } else { timers };
        scope = Virtual!.{ state, timers, invalid_plan: invalid_plan || id.is_none() };
        id
    }

    fn pair(&scope: Virtual!, pair: Pair) -> Option[usize] {
        let { state, timers, invalid_plan } = scope;
        let id = &state.add(Branch::Pair.(pair));
        let timers = if id.is_some() { timers.push(Option::None) } else { timers };
        scope = Virtual!.{ state, timers, invalid_plan: invalid_plan || id.is_none() };
        id
    }

    fn result(&scope: Virtual!, id: Option[usize]) -> Resolution {
        let { state, timers, invalid_plan } = scope;
        let result = match id {
            Option::Some(id) => &state.result(id),
            Option::None => Option::None,
        };
        scope = Virtual!.{ state, timers, invalid_plan };
        let failure = if invalid_plan { Failure::InvalidPlan } else { Failure::InvalidResult };
        result.unwrap_or(Resolution::Failed.(failure))
    }
}

fn earliest(&timers: OwnedVec![Option[Duration]]) -> Option[(usize, Duration)] {
    var next = Option::None;
    var i = 0usize;
    while i < &timers.len() {
        match &timers.at(i) {
            Option::Some(duration) => {
                let sooner = match next {
                    Option::Some(timer) => { let (id, due) = timer; duration.as_nanos() < due.as_nanos() },
                    Option::None => true,
                };
                if sooner { next = Option::Some.((i, duration)); }
            },
            Option::None => (),
        }
        i = i + 1usize;
    }
    next
}

fn advance(&scope: Virtual!, root: Option[usize], deadline: Option[Duration]) -> (Duration, bool) {
    let { state, timers, invalid_plan } = scope;
    let valid = match root {
        Option::Some(id) => !invalid_plan && &state.begin(id),
        Option::None => false,
    };
    if !valid {
        scope = Virtual!.{ state, timers, invalid_plan: true };
        return (Duration::from_nanos(0), false);
    }
    let expired = match deadline { Option::Some(duration) => duration.is_zero(), Option::None => false, };
    if expired {
        &state.cancel();
        scope = Virtual!.{ state, timers, invalid_plan };
        return (Duration::from_nanos(0), true);
    }
    var limit = deadline;
    if limit.is_some() { &state.started(Resource::ParentTimer); }
    var i = 0usize;
    while i < &timers.len() {
        if (&timers.at(i)).is_some() { &state.started(Resource::Leaf.(i)); }
        i = i + 1usize;
    }

    var elapsed = Duration::from_nanos(0);
    var deadline_expired = false;
    while &state.pending() {
        let timer = earliest(&timers);
        let next_deadline = match timer {
            Option::Some(entry) => {
                let (id, due) = entry;
                match limit {
                    Option::Some(duration) => if duration.as_nanos() <= due.as_nanos() { limit } else { Option::None },
                    Option::None => Option::None,
                }
            },
            Option::None => limit,
        };
        match next_deadline {
            Option::Some(duration) => {
                elapsed = duration;
                deadline_expired = true;
                &state.cancel();
                &state.retired(Resource::ParentTimer);
                limit = Option::None;
            },
            Option::None => {
                let (id, due) = timer.unwrap();
                elapsed = due;
                &timers.set(id, Option::None);
                let finished = &state.complete(id);
                &state.retired(Resource::Leaf.(id));
                if finished && limit.is_some() {
                    &state.retired(Resource::ParentTimer);
                    limit = Option::None;
                }
            },
        }

        var cancelled = &state.take_cancel();
        while cancelled.is_some() {
            let id = cancelled.unwrap();
            &timers.set(id, Option::None);
            &state.retired(Resource::Leaf.(id));
            cancelled = &state.take_cancel();
        }
    }
    scope = Virtual!.{ state, timers, invalid_plan };
    (elapsed, deadline_expired)
}

fn ignore_timer(timer: Option[Duration]) {}

fn close_scope(scope: Virtual!) {
    let { state, timers, invalid_plan } = scope;
    state.destroy();
    timers.destroy(ignore_timer);
}

forall Task, Output where Plan[Task, Virtual! -> Output].
fn drive(task: Task, deadline: Option[Duration]) -> Output {
    let ({ output, deadline_expired }, elapsed) = drive_timed(task, deadline);
    output
}

forall Task, Output where Plan[Task, Virtual! -> Output].
fn drive_timed(task: Task, deadline: Option[Duration]) -> (StageResult[Output], Duration) {
    let scope = Virtual!.{ state: ScopeState!::new(), timers: OwnedVec!::new(), invalid_plan: false };
    let (output, (elapsed, deadline_expired)) = drive_plan(task, scope,
        |&scope, root| advance(&scope, root, deadline), close_scope);
    (StageResult.{ output, deadline_expired }, elapsed)
}

forall Task, Output where PlanOutput[Task -> Output], Plan[Task, Virtual! -> Output].
fn run(task: Task) -> Output { drive(task, Option::None) }

forall Task, Output where PlanOutput[Task -> Output], Plan[Task, Virtual! -> Output].
fn run_with_deadline(task: Task, duration: Duration) -> Output { drive(task, Option::Some.(duration)) }

struct SequenceClock! { time: Duration }

instance Clock[SequenceClock!] {
    fn now(&engine: SequenceClock!) -> Duration {
        let { time } = engine;
        engine = SequenceClock!.{ time };
        time
    }
}

forall Task, Output where Plan[Task, Virtual! -> Output].
instance StageDriver[Task, SequenceClock! -> Output] {
    fn drive(task: Task, &engine: SequenceClock!, deadline: Option[Duration]) -> StageResult[Output] {
        let remaining = remaining_budget(&engine, deadline);
        let { time } = engine;
        let (result, elapsed) = drive_timed(task, remaining);
        let time = time.add(elapsed);
        engine = SequenceClock!.{ time };
        result
    }
}

forall Stages, Output where Chain[Stages, SequenceClock! -> Output].
fn run_sequence(plan: Sequence![Stages, Output], budget: Option[Duration]) -> SequenceOutcome[Output] {
    let clock = SequenceClock!.{ time: Duration::from_nanos(0) };
    let result = drive_sequence(plan, &clock, budget);
    let { time } = clock;
    result
}
