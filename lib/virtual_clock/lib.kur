//! Deterministic driver for timer plans. Each step advances to the next event.
use std::collections::vec::OwnedVec!;
use std::option::Option;
use task::{Branch, JoinOutcome, Outcome, Pair, Plan, PlanDriver, PlanOutput, RaceOutcome, Resolution, ScopeState!, Sleep!, WithinOutcome,
    join, map, race, select, sleep, within};
use task::{Chain, Clock, Sequence!, StageDriver, drive_sequence, remaining_budget, sequence};

export JoinOutcome;
export Outcome;
export PlanOutput;
export RaceOutcome;
export Sleep!;
export join;
export map;
export race;
export select;
export sleep;
export sequence;
export WithinOutcome;
export within;

struct Virtual! {
    state: ScopeState!,
    timers: OwnedVec![Option[u64]],
}

instance PlanDriver[Virtual!] {
    fn timer(&scope: Virtual!, ms: u64) -> Option[usize] {
        let { state, timers } = scope;
        let id = &state.add(Branch::Leaf);
        let timers = if id.is_some() { timers.push(Option::Some.(ms)) } else { timers };
        scope = Virtual!.{ state, timers };
        id
    }

    fn pair(&scope: Virtual!, pair: Pair) -> Option[usize] {
        let { state, timers } = scope;
        let id = &state.add(Branch::Pair.(pair));
        let timers = if id.is_some() { timers.push(Option::None) } else { timers };
        scope = Virtual!.{ state, timers };
        id
    }

    fn result(&scope: Virtual!, id: Option[usize]) -> Resolution {
        let { state, timers } = scope;
        let result = match id {
            Option::Some(id) => &state.result(id),
            Option::None => Option::None,
        };
        scope = Virtual!.{ state, timers };
        result.unwrap_or(Resolution::Failed.(-1i32))
    }
}

fn earliest(&timers: OwnedVec![Option[u64]]) -> Option[(usize, u64)] {
    var next = Option::None;
    var i = 0usize;
    while i < &timers.len() {
        match &timers.at(i) {
            Option::Some(ms) => {
                let sooner = match next {
                    Option::Some(timer) => { let (id, due) = timer; ms < due },
                    Option::None => true,
                };
                if sooner { next = Option::Some.((i, ms)); }
            },
            Option::None => (),
        }
        i = i + 1usize;
    }
    next
}

fn advance(&scope: Virtual!, root: Option[usize], deadline: Option[u64]) -> u64 {
    let { state, timers } = scope;
    let valid = match root {
        Option::Some(id) => &state.begin(id),
        Option::None => false,
    };
    if !valid {
        scope = Virtual!.{ state, timers };
        return 0u64;
    }
    let expired = match deadline { Option::Some(ms) => ms == 0u64, Option::None => false, };
    if expired {
        &state.cancel();
        scope = Virtual!.{ state, timers };
        return 0u64;
    }
    var limit = deadline;
    if limit.is_some() { &state.started(); }
    var i = 0usize;
    while i < &timers.len() {
        if (&timers.at(i)).is_some() { &state.started(); }
        i = i + 1usize;
    }

    var elapsed = 0u64;
    while &state.pending() {
        let timer = earliest(&timers);
        let next_deadline = match timer {
            Option::Some(entry) => {
                let (id, due) = entry;
                match limit {
                    Option::Some(ms) => if ms <= due { limit } else { Option::None },
                    Option::None => Option::None,
                }
            },
            Option::None => limit,
        };
        match next_deadline {
            Option::Some(ms) => {
                elapsed = ms;
                &state.cancel();
                &state.retired();
                limit = Option::None;
            },
            Option::None => {
                let (id, due) = timer.unwrap();
                elapsed = due;
                &timers.set(id, Option::None);
                let finished = &state.complete(id);
                &state.retired();
                if finished && limit.is_some() {
                    &state.retired();
                    limit = Option::None;
                }
            },
        }

        var cancelled = &state.take_cancel();
        while cancelled.is_some() {
            &timers.set(cancelled.unwrap(), Option::None);
            &state.retired();
            cancelled = &state.take_cancel();
        }
    }
    scope = Virtual!.{ state, timers };
    elapsed
}

fn ignore_timer(timer: Option[u64]) {}

forall Task, Output where PlanOutput[Task -> Output], Plan[Task, Virtual! -> Output].
fn drive(task: Task, deadline: Option[u64]) -> Output {
    let (result, elapsed) = drive_timed(task, deadline);
    result
}

forall Task, Output where PlanOutput[Task -> Output], Plan[Task, Virtual! -> Output].
fn drive_timed(task: Task, deadline: Option[u64]) -> (Output, u64) {
    var scope = Virtual!.{ state: ScopeState!::new(), timers: OwnedVec!::new() };
    let root = Plan[Task, Virtual! -> Output]::stage(&task, &scope);
    let elapsed = advance(&scope, root, deadline);
    let result = Plan[Task, Virtual! -> Output]::collect(task, &scope);
    let { state, timers } = scope;
    state.destroy();
    timers.destroy(ignore_timer);
    (result, elapsed)
}

forall Task, Output where PlanOutput[Task -> Output], Plan[Task, Virtual! -> Output].
fn run(task: Task) -> Output { drive(task, Option::None) }

forall Task, Output where PlanOutput[Task -> Output], Plan[Task, Virtual! -> Output].
fn timeout(ms: u64, task: Task) -> Output { drive(task, Option::Some.(ms)) }

struct SequenceClock! { time: u64 }

instance Clock[SequenceClock!] {
    fn now(&engine: SequenceClock!) -> u64 {
        let { time } = engine;
        engine = SequenceClock!.{ time };
        time
    }
}

forall Task, Output where PlanOutput[Task -> Output], Plan[Task, Virtual! -> Output].
instance StageDriver[Task, SequenceClock! -> Output] {
    fn drive(task: Task, &engine: SequenceClock!, deadline: Option[u64]) -> Output {
        let remaining = remaining_budget(&engine, deadline);
        let { time } = engine;
        let (result, elapsed) = drive_timed(task, remaining);
        let time = if elapsed > u64::MAX - time { u64::MAX } else { time + elapsed };
        engine = SequenceClock!.{ time };
        result
    }
}

forall Stages, Output where Chain[Stages, SequenceClock! -> Output].
fn run_sequence(plan: Sequence![Stages], budget: Option[u64]) -> Option[Output] {
    let clock = SequenceClock!.{ time: 0u64 };
    let result = drive_sequence(plan, &clock, budget);
    let { time } = clock;
    result
}
