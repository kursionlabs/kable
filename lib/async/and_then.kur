//! Registers dependent plans as child scopes on the enclosing libuv loop.
use package::{Scope!, kable_scope_add_operation, registered};
use std::option::Option;
use std::ptr::is_null;
use task::continuation::{Child, ContinuationDriver, Handoff};

extern "C" fn kable_scope_budget_expired(scope: *u8) -> u8;
extern "C" fn kable_chain_new(parent: *u8, state: *u8,
    advance: unsafe fn(*u8, u8, *(*u8), *usize) -> u8, child: *u8, root: usize) -> *u8;
extern "C" fn kable_chain_start(chain: *u8, loop: *u8, done: unsafe fn(*u8) -> (), context: *u8) -> i32;
extern "C" fn kable_chain_stop(chain: *u8) -> u8;
extern "C" fn kable_chain_free(chain: *u8) -> ();

instance ContinuationDriver[Scope!] {
    fn child_scope() -> Scope! { Scope!::new() }

    fn close_child(scope: Scope!) { scope.close(); }

    fn scope_address(&scope: Scope!) -> *u8 {
        var { raw } = scope;
        scope = Scope!.{ raw };
        raw
    }

    unsafe fn register(&parent: Scope!, child: Child, handoff: Handoff) -> (*u8, Option[usize]) {
        let raw = ContinuationDriver[Scope!]::scope_address(&parent);
        let chain = unsafe kable_chain_new(raw, handoff.context, handoff.advance, child.scope, child.root);
        let id = if is_null(chain) { Option::None }
            else { registered(unsafe kable_scope_add_operation(raw, chain, kable_chain_start, kable_chain_stop)) };
        (chain, id)
    }

    unsafe fn budget_expired(parent: *u8) -> bool { (unsafe kable_scope_budget_expired(parent)) != 0 }

    unsafe fn release(registration: *u8) { unsafe kable_chain_free(registration); }
}
