//! Runs a prepared libuv plan under a host that already owns an event loop.
use package::Scope!;
use std::heap::HeapAllocator;
use std::mem::sizeof;
use std::option::Result;
use task::driver::{Plan, Prepared!, prepare};

struct HostedPlan! {
    scope: *u8, root: usize, plan: *u8,
    finish: unsafe fn(*u8, *u8, u8) -> i32,
}

/// The scheduler error and the status returned by the cleanup continuation.
exposed struct SubmissionError {
    scheduler_error: i32,
    continuation_status: i32,
}

forall Task, Output, Env.
struct Pending! { prepared: Prepared![Task, Scope!], resume: closure[Env](Output, *u8, u8) -> i32 }

forall Task, Output, Env where Plan[Task, Scope! -> Output].
fn prepare_hosted(task: Task, resume: closure[Env](Output, *u8, u8) -> i32) -> HostedPlan! {
    let prepared = prepare(task, Scope!::new());
    // The prepared plan keeps the native scope alive through collection.
    let (scope, root) = &prepared.with_scope(|&scope, root| {
        let { raw } = scope;
        scope = Scope!.{ raw };
        (raw, root.unwrap_or(usize::MAX))
    });
    let plan = HeapAllocator::alloc(sizeof[Pending![Task, Output, Env]]()).into_raw();
    unsafe *(unsafe (plan as *Pending![Task, Output, Env])) = Pending!.{ prepared, resume };
    HostedPlan!.{ scope, root, plan, finish: finish_hosted[Task, Output, Env] }
}

forall Task, Output, Env where Plan[Task, Scope! -> Output].
unsafe fn finish_hosted(plan: *u8, host: *u8, state: u8) -> i32 {
    let { prepared, resume } = unsafe *(unsafe (plan as *Pending![Task, Output, Env]));
    HeapAllocator::drop(unsafe HeapAllocator::adopt_raw(plan));
    let (outcome, scope) = prepared.collect();
    scope.close();
    resume(outcome, host, state)
}

impl HostedPlan! {
    /// Finishes a plan discarded before submission with a valid host pointer.
    /// The continuation receives host state zero.
    unsafe fn discard(self, host: *u8) {
        let { scope, root, plan, finish } = self;
        unsafe finish(plan, host, 0);
    }

    /// Passes the host pointer and flags to the scheduler. On acceptance the
    /// scheduler owns the plan until it calls finish once with the same host
    /// pointer after the scope joins. It may finish before returning.
    /// On rejection, collects the plan with host state zero and returns both
    /// statuses after cleanup.
    unsafe fn submit(self, host: *u8, flags: u8,
        schedule: unsafe fn(*u8, *u8, usize, *u8, unsafe fn(*u8, *u8, u8) -> i32, u8) -> i32)
        -> Result[i32, SubmissionError] {
        let { scope, root, plan, finish } = self;
        let status = unsafe schedule(host, scope, root, plan, finish, flags);
        if status < 0 {
            let continuation_status = unsafe finish(plan, host, 0);
            Result::Err.(SubmissionError.{ scheduler_error: status, continuation_status })
        } else {
            Result::Ok.(status)
        }
    }
}
