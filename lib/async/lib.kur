//! Structured waits, joins, and bounded file operations on libuv.
use package::host;
use std::heap::HeapAllocator;
use std::buffer::Buffer!;
use std::mem::{alloca, sizeof};
use std::option::{Option, Result};
use std::ptr::is_null;
use std::slice::ReadBytes;
use std::time::Duration;
use task::{Completion, Failure, Map!, PlanOutput, Sink, Stream};
use task::driver::{Branch, Pair, PairKind, Plan, PlanDriver, Prepared!, Resolution, Resource, ScopeState!, drive_plan};
use task::sequence::{Chain, Clock, Sequence!, SequenceOutcome, StageDriver, StageResult, drive_sequence_until};

export host;

extern "C" fn kable_now_millis() -> u64;

extern "C" fn kable_scope_new(policy: *u8, add_leaf: unsafe fn(*u8) -> usize,
    add_pair: unsafe fn(*u8, u8, usize, usize) -> usize,
    event: unsafe fn(*u8, u8, usize) -> usize) -> *u8;
extern "C" fn kable_scope_add_timer(scope: *u8, ms: u64) -> usize;
extern "C" fn kable_scope_add_pair(scope: *u8, kind: u8, first: usize, second: usize) -> usize;
extern "C" fn kable_scope_add_file(scope: *u8, path: *u8, len: usize, limit: usize, mode: u8) -> usize;
extern "C" fn kable_scope_add_chunk(scope: *u8, fd: i32, offset: u64, limit: usize) -> usize;
extern "C" fn kable_scope_add_write(scope: *u8, fd: i32, offset: u64, bytes: *u8, len: usize) -> usize;
extern "C" fn kable_scope_add_operation(scope: *u8, context: *u8,
    start: unsafe fn(*u8, *u8, unsafe fn(*u8) -> (), *u8) -> i32,
    stop: unsafe fn(*u8) -> u8) -> usize;
extern "C" fn kable_scope_run(scope: *u8, root: usize, end_ms: u64, timed: u8) -> u8;
extern "C" fn kable_runner_new() -> *u8;
extern "C" fn kable_runner_run(loop: *u8, scope: *u8, root: usize, end_ms: u64, timed: u8) -> u8;
extern "C" fn kable_runner_free(loop: *u8) -> ();
extern "C" fn kable_scope_result(scope: *u8, id: usize) -> i32;
extern "C" fn kable_scope_file_result(scope: *u8, id: usize, bytes: *(*u8), len: *usize) -> i32;
extern "C" fn kable_scope_write_result(scope: *u8, id: usize, written: *usize) -> i32;
extern "C" fn kable_scope_take_file(scope: *u8, id: usize, len: *u64) -> i32;
extern "C" fn kable_scope_free(scope: *u8) -> ();
extern "C" fn kable_file_close_descriptor(fd: i32) -> i32;

forall Item.
struct FilePathPlan! {
    path: Buffer!, limit: usize, mode: u8, id: Option[usize],
    result: fn(&_: Scope!, Option[usize]) -> Completion[Item],
}

struct OpenedFile! { fd: i32, length: u64 }
struct OutputFile! { fd: i32, position: u64 }
struct WriteChunk! { file: OutputFile!, offset: u64, bytes: Buffer!, id: Option[usize] }
struct ReadChunk! { file: OpenedFile!, offset: u64, limit: usize, id: Option[usize] }
struct FileChunks! { file: OpenedFile!, offset: u64, remaining: u64 }

// Matches KableFileMode in native/file.h.
const READ_FILE: u8 = 0;
const READ_BENEATH: u8 = 1;
const OPEN_BENEATH: u8 = 2;
const OPEN_FILE: u8 = 3;
const CREATE_FILE: u8 = 4;
const FILE_CHUNK: u64 = 64 * 1024;

forall C, S, Item where ReadBytes[C, S], Copy[S].
fn file_path_plan(&cx: C, path: S, limit: usize, mode: u8,
    result: fn(&_: Scope!, Option[usize]) -> Completion[Item]) -> FilePathPlan![Item] {
    FilePathPlan!.{ path: Buffer!::new().push_bytes(&cx, path), limit, mode, id: Option::None, result }
}

/// Plans a read of a regular file. A file larger than limit fails.
forall C, S where ReadBytes[C, S], Copy[S].
fn read_file(&cx: C, path: S, limit: usize) -> FilePathPlan![Buffer!] {
    file_path_plan(&cx, path, limit, READ_FILE, Scope!::file_result)
}

/// Plans a regular-file read below the process's working directory.
/// Linux resolves the relative path without following symlinks.
forall C, S where ReadBytes[C, S], Copy[S].
fn read_file_beneath_cwd(&cx: C, path: S, limit: usize) -> FilePathPlan![Buffer!] {
    file_path_plan(&cx, path, limit, READ_BENEATH, Scope!::file_result)
}

/// Opens and measures a regular file.
forall C, S where ReadBytes[C, S], Copy[S].
fn open_file(&cx: C, path: S) -> FilePathPlan![OpenedFile!] {
    file_path_plan(&cx, path, 0, OPEN_FILE, collect_opened_file)
}

/// Opens a regular file beneath the working directory and measures its length.
forall C, S where ReadBytes[C, S], Copy[S].
fn open_file_beneath_cwd(&cx: C, path: S) -> FilePathPlan![OpenedFile!] {
    file_path_plan(&cx, path, 0, OPEN_BENEATH, collect_opened_file)
}

/// Creates a new regular file. An existing destination causes an error.
forall C, S where ReadBytes[C, S], Copy[S].
fn create_file(&cx: C, path: S) -> FilePathPlan![OutputFile!] {
    file_path_plan(&cx, path, 0, CREATE_FILE, collect_output_file)
}

impl OutputFile! {
    /// The next sequential write starts here, including after a partial write.
    fn position(&self) -> u64 {
        let { fd, position } = self;
        self = OutputFile!.{ fd, position };
        position
    }

    /// Writes the buffer at offset without advancing the sequential position.
    /// Returns (file, bytes, count, status). The count includes partial writes.
    fn write_chunk(self, offset: u64, bytes: Buffer!) -> WriteChunk! {
        WriteChunk!.{ file: self, offset, bytes, id: Option::None }
    }

    fn close(self) -> Result[(), i32] {
        let { fd, position } = self;
        let status = unsafe kable_file_close_descriptor(fd);
        if status < 0 { Result::Err.(status) } else { Result::Ok.(()) }
    }
}

instance Sink[OutputFile! -> Buffer!,
    Map![WriteChunk!, (OutputFile!, Buffer!, usize, Completion[()]), (OutputFile!, Buffer!, Completion[()]), ()]] {
    fn write(file: OutputFile!, bytes: Buffer!)
        -> Map![WriteChunk!, (OutputFile!, Buffer!, usize, Completion[()]), (OutputFile!, Buffer!, Completion[()]), ()] {
        let offset = &file.position();
        file.write_chunk(offset, bytes).map(|result| {
            let (file, bytes, count, status) = result;
            let { fd, position } = file;
            (OutputFile!.{ fd, position: position + count as u64 }, bytes, status)
        })
    }
}

impl OpenedFile! {
    fn len(&self) -> u64 {
        let { fd, length } = self;
        self = OpenedFile!.{ fd, length };
        length
    }

    /// Reads at most limit bytes from the measured file without changing its position.
    /// The joined outcome returns the file on success, failure, or cancellation.
    /// An empty buffer indicates the end of the file or a zero limit.
    fn read_chunk(self, offset: u64, limit: usize) -> ReadChunk! {
        let length = &self.len();
        let remaining = if offset < length { length - offset } else { 0 };
        let limit = if remaining < limit as u64 { remaining as usize } else { limit };
        ReadChunk!.{ file: self, offset, limit, id: Option::None }
    }

    /// Owns the file and reads up to length bytes starting at offset.
    fn chunks(self, offset: u64, length: u64) -> FileChunks! {
        FileChunks!.{ file: self, offset, remaining: length }
    }

    fn close(self) {
        let { fd, length } = self;
        unsafe kable_file_close_descriptor(fd);
    }

    /// Transfers responsibility for closing the descriptor to the caller.
    unsafe fn into_parts(self) -> (i32, u64) {
        let { fd, length } = self;
        (fd, length)
    }
}

impl FileChunks! {
    /// The number of requested bytes still unread, including after early EOF.
    fn remaining(&self) -> u64 {
        let { file, offset, remaining } = self;
        self = FileChunks!.{ file, offset, remaining };
        remaining
    }

    fn close(self) {
        let { file, offset, remaining } = self;
        file.close();
    }
}

instance Stream[FileChunks! ->
    Map![ReadChunk!, (OpenedFile!, Completion[Buffer!]), (FileChunks!, Completion[Option[Buffer!]]), (u64, u64)]] {
    /// Plans a read of at most 64 KiB and advances only by the bytes read.
    fn next(source: FileChunks!)
        -> Map![ReadChunk!, (OpenedFile!, Completion[Buffer!]), (FileChunks!, Completion[Option[Buffer!]]), (u64, u64)] {
        let { file, offset, remaining } = source;
        let limit = if remaining < FILE_CHUNK { remaining } else { FILE_CHUNK };
        file.read_chunk(offset, limit as usize).map(|result| {
            let (file, outcome) = result;
            let (outcome, count) = match outcome {
                Completion::Ready(bytes) => {
                    let count = &bytes.len() as u64;
                    let chunk = if count == 0 {
                        bytes.destroy();
                        Option::None
                    } else {
                        Option::Some.(bytes)
                    };
                    (Completion::Ready.(chunk), count)
                },
                Completion::Cancelled => (Completion::Cancelled, 0),
                Completion::Failed(failure) => (Completion::Failed.(failure), 0),
            };
            (FileChunks!.{ file, offset: offset + count, remaining: remaining - count }, outcome)
        })
    }
}

// The scope is lent only while staging operations or reading their outcomes.
// Owned payloads stay in Kursal throughout the native event loop.
struct Scope! { raw: *u8 }

enum RunLoop { Standalone, Reusable(*u8) }

fn monotonic_now() -> Duration { Duration::from_millis(unsafe kable_now_millis()) }

fn deadline_after(budget: Duration) -> Duration { monotonic_now().add(budget) }

// Scalar encoding used by the native scope adapter.
const CANCELLED: i32 = 0i32;
const COMPLETED: i32 = 1i32;
const FIRST: i32 = 2i32;
const SECOND: i32 = 3i32;
const NOT_STARTED: i32 = 4;
const INVALID_PLAN: i32 = 5;

unsafe fn add_branch(raw: *u8, branch: Branch) -> usize {
    let ptr = unsafe (raw as *ScopeState!);
    let state = unsafe *ptr;
    let id = &state.add(branch);
    unsafe *ptr = state;
    id.unwrap_or(usize::MAX)
}

unsafe fn add_leaf(raw: *u8) -> usize { unsafe add_branch(raw, Branch::Leaf) }

unsafe fn add_pair(raw: *u8, kind: u8, first: usize, second: usize) -> usize {
    let kind = match kind {
        0u8 => PairKind::Select,
        1u8 => PairKind::Join,
        _ => return usize::MAX,
    };
    unsafe add_branch(raw, Branch::Pair.(Pair.{ kind, first, second }))
}

fn resource_id(id: usize) -> Resource {
    if id == usize::MAX { Resource::ParentTimer } else { Resource::Leaf.(id) }
}

// Messages sent by the libuv adapter. Only the portable state decides which
// branch wins, what to cancel, and when all resources have retired.
unsafe fn scope_event(raw: *u8, event: u8, id: usize) -> usize {
    let ptr = unsafe (raw as *ScopeState!);
    let state = unsafe *ptr;
    if event == 8u8 {
        state.destroy();
        HeapAllocator::drop(unsafe HeapAllocator::adopt_raw(raw));
        return 0usize;
    }
    let result = match event {
        0u8 => if &state.begin(id) { 1usize } else { 0usize },
        1u8 => { &state.started(resource_id(id)); 0usize },
        2u8 => if &state.retired(resource_id(id)) { 1usize } else { 0usize },
        3u8 => if &state.pending() { 1usize } else { 0usize },
        4u8 => if &state.complete(id) { 1usize } else { 0usize },
        5u8 => { &state.cancel(); 0usize },
        6u8 => (&state.take_cancel()).unwrap_or(usize::MAX),
        7u8 => match &state.result(id) {
            Option::Some(result) => match result {
                Resolution::Cancelled => CANCELLED as usize,
                Resolution::Completed => COMPLETED as usize,
                Resolution::First => FIRST as usize,
                Resolution::Second => SECOND as usize,
                Resolution::Failed => usize::MAX,
            },
            Option::None => usize::MAX,
        },
        9u8 => if &state.joined() { 1usize } else { 0usize },
        _ => 0usize,
    };
    unsafe *ptr = state;
    result
}

fn registered(id: usize) -> Option[usize] {
    if id == usize::MAX { Option::None } else { Option::Some.(id) }
}

// Round up so a positive timeout never becomes an immediate deadline.
fn timer_millis(duration: Duration) -> u64 {
    let nanos = duration.as_nanos();
    let millis = duration.as_millis();
    if nanos % 1_000_000 == 0 { millis } else { millis + 1 }
}

impl Scope! {
    fn new() -> Scope! {
        let policy = HeapAllocator::alloc(sizeof[ScopeState!]()).into_raw();
        unsafe *(unsafe (policy as *ScopeState!)) = ScopeState!::new();
        let raw = unsafe kable_scope_new(policy, add_leaf, add_pair, scope_event);
        if is_null(raw) { unsafe scope_event(policy, 8u8, 0usize); }
        Scope!.{ raw }
    }

    fn add_file(&self, &path: Buffer!, limit: usize, mode: u8) -> Option[usize] {
        let { raw } = self;
        let bytes = unsafe &path.as_ptr();
        let len = &path.len();
        let id = unsafe kable_scope_add_file(raw, bytes, len, limit, mode);
        self = Scope!.{ raw };
        registered(id)
    }

    fn add_chunk(&self, &file: OpenedFile!, offset: u64, limit: usize) -> Option[usize] {
        let { raw } = self;
        let { fd, length } = file;
        let id = unsafe kable_scope_add_chunk(raw, fd, offset, limit);
        file = OpenedFile!.{ fd, length };
        self = Scope!.{ raw };
        registered(id)
    }

    fn add_write(&self, &file: OutputFile!, offset: u64, &bytes: Buffer!) -> Option[usize] {
        let { raw } = self;
        let { fd, position } = file;
        let id = unsafe kable_scope_add_write(raw, fd, offset, unsafe &bytes.as_ptr(), &bytes.len());
        file = OutputFile!.{ fd, position };
        self = Scope!.{ raw };
        registered(id)
    }

    /// The context lives through collection. Start schedules an asynchronous
    /// completion on the supplied loop. Stop returns zero to retire now or
    /// one to wait for the completion callback.
    unsafe fn add_operation(&self, context: *u8,
        start: unsafe fn(*u8, *u8, unsafe fn(*u8) -> (), *u8) -> i32,
        stop: unsafe fn(*u8) -> u8) -> Option[usize] {
        let { raw } = self;
        let id = unsafe kable_scope_add_operation(raw, context, start, stop);
        self = Scope!.{ raw };
        registered(id)
    }

    fn file_result(&self, id: Option[usize]) -> Completion[Buffer!] {
        let completion = (&self.result(id)).completion();
        let { raw } = self;
        self = Scope!.{ raw };
        completion.and_then(|unit| {
            let data = unsafe alloca[*u8]();
            let size = unsafe alloca[usize]();
            let code = unsafe kable_scope_file_result(raw, id.unwrap_or(usize::MAX), data, size);
            if code < 0 { return Completion::Failed.(Failure::Operation.(code)); }
            let bytes = unsafe *data;
            let len = unsafe *size;
            Completion::Ready.(unsafe Buffer!::new_with_cap(len).push_n(bytes, len))
        })
    }

    fn write_result(&self, id: Option[usize]) -> (usize, Completion[()]) {
        let resolution = &self.result(id);
        let { raw } = self;
        let size = unsafe alloca[usize]();
        let status = unsafe kable_scope_write_result(raw, id.unwrap_or(usize::MAX), size);
        let count = unsafe *size;
        self = Scope!.{ raw };
        let completion = resolution.completion().and_then(|unit| {
            if status < 0 { Completion::Failed.(Failure::Operation.(status)) } else { Completion::Ready.(unit) }
        });
        (count, completion)
    }

    forall File, Env where Copy[Env].
    fn collect_descriptor(&self, id: Option[usize], wrap: closure[Env](i32, u64) -> File) -> Completion[File] {
        let completion = (&self.result(id)).completion();
        let { raw } = self;
        self = Scope!.{ raw };
        completion.and_then(|unit| {
            let size = unsafe alloca[u64]();
            let fd = unsafe kable_scope_take_file(raw, id.unwrap_or(usize::MAX), size);
            if fd < 0 { Completion::Failed.(Failure::Operation.(fd)) } else { Completion::Ready.(wrap(fd, unsafe *size)) }
        })
    }

    fn run(&self, root: Option[usize], deadline: Option[Duration], loop: RunLoop) -> bool {
        let { raw } = self;
        let root = root.unwrap_or(usize::MAX);
        let (end_ms, timed) = match deadline {
            Option::None => (0u64, 0u8),
            Option::Some(end) => (timer_millis(end), 1u8),
        };
        let expired = match loop {
            RunLoop::Standalone => unsafe kable_scope_run(raw, root, end_ms, timed),
            RunLoop::Reusable(loop) => unsafe kable_runner_run(loop, raw, root, end_ms, timed),
        };
        self = Scope!.{ raw };
        expired != 0
    }

    fn result(&self, id: Option[usize]) -> Resolution {
        let { raw } = self;
        let code = unsafe kable_scope_result(raw, id.unwrap_or(usize::MAX));
        self = Scope!.{ raw };
        if code == CANCELLED { return Resolution::Cancelled; }
        if code == COMPLETED { return Resolution::Completed; }
        if code == FIRST { return Resolution::First; }
        if code == SECOND { return Resolution::Second; }
        if code == NOT_STARTED { return Resolution::Failed.(Failure::NotStarted); }
        if code == INVALID_PLAN { return Resolution::Failed.(Failure::InvalidPlan); }
        if code < 0 { return Resolution::Failed.(Failure::Startup.(code)); }
        Resolution::Failed.(Failure::InvalidResult)
    }

    fn close(self) {
        let { raw } = self;
        unsafe kable_scope_free(raw);
    }
}

fn collect_opened_file(&scope: Scope!, id: Option[usize]) -> Completion[OpenedFile!] {
    &scope.collect_descriptor(id, |fd, length| OpenedFile!.{ fd, length })
}

fn collect_output_file(&scope: Scope!, id: Option[usize]) -> Completion[OutputFile!] {
    &scope.collect_descriptor(id, |fd, length| OutputFile!.{ fd, position: 0 })
}

forall Item.
instance PlanOutput[FilePathPlan![Item] -> Completion[Item]] {}

forall Item.
instance Plan[FilePathPlan![Item], Scope! -> Completion[Item]] {
    fn stage(&task: FilePathPlan![Item], &scope: Scope!) -> Option[usize] {
        let { path, limit, mode, id, result } = task;
        let id = &scope.add_file(&path, limit, mode);
        task = FilePathPlan!.{ path, limit, mode, id, result };
        id
    }

    fn collect(task: FilePathPlan![Item], &scope: Scope!) -> Completion[Item] {
        let { path, limit, mode, id, result } = task;
        path.destroy();
        result(&scope, id)
    }
}

instance PlanOutput[ReadChunk! -> (OpenedFile!, Completion[Buffer!])] {}

instance Plan[ReadChunk!, Scope! -> (OpenedFile!, Completion[Buffer!])] {
    fn stage(&task: ReadChunk!, &scope: Scope!) -> Option[usize] {
        let { file, offset, limit, id } = task;
        let id = &scope.add_chunk(&file, offset, limit);
        task = ReadChunk!.{ file, offset, limit, id };
        id
    }

    fn collect(task: ReadChunk!, &scope: Scope!) -> (OpenedFile!, Completion[Buffer!]) {
        let { file, offset, limit, id } = task;
        (file, &scope.file_result(id))
    }
}

instance PlanOutput[WriteChunk! -> (OutputFile!, Buffer!, usize, Completion[()])] {}

instance Plan[WriteChunk!, Scope! -> (OutputFile!, Buffer!, usize, Completion[()])] {
    fn stage(&task: WriteChunk!, &scope: Scope!) -> Option[usize] {
        let { file, offset, bytes, id } = task;
        let id = &scope.add_write(&file, offset, &bytes);
        task = WriteChunk!.{ file, offset, bytes, id };
        id
    }

    fn collect(task: WriteChunk!, &scope: Scope!) -> (OutputFile!, Buffer!, usize, Completion[()]) {
        let { file, offset, bytes, id } = task;
        let (count, status) = &scope.write_result(id);
        (file, bytes, count, status)
    }
}

instance PlanDriver[Scope!] {
    fn timer(&scope: Scope!, duration: Duration) -> Option[usize] {
        let { raw } = scope;
        let id = unsafe kable_scope_add_timer(raw, timer_millis(duration));
        scope = Scope!.{ raw };
        registered(id)
    }

    fn pair(&scope: Scope!, pair: Pair) -> Option[usize] {
        let { kind, first, second } = pair;
        let tag = match kind {
            PairKind::Select => 0u8,
            PairKind::Join => 1u8,
        };
        let { raw } = scope;
        let id = unsafe kable_scope_add_pair(raw, tag, first, second);
        scope = Scope!.{ raw };
        registered(id)
    }

    fn result(&scope: Scope!, id: Option[usize]) -> Resolution { &scope.result(id) }
}

/// The host keeps the prepared plan alive until the native scope has joined.
forall Task.
unsafe fn native_scope(&prepared: Prepared![Task, Scope!]) -> (*u8, usize) {
    &prepared.with_scope(|&scope, root| {
        let { raw } = scope;
        scope = Scope!.{ raw };
        (raw, root.unwrap_or(usize::MAX))
    })
}

forall Task, Output where Plan[Task, Scope! -> Output].
fn collect(prepared: Prepared![Task, Scope!]) -> Output {
    let (result, scope) = prepared.collect();
    scope.close();
    result
}

forall Task, Output where Plan[Task, Scope! -> Output].
fn run_standalone(task: Task, deadline: Option[Duration]) -> Output {
    let { output, deadline_expired } = drive_on_loop(task, deadline, RunLoop::Standalone);
    output
}

forall Task, Output where Plan[Task, Scope! -> Output].
fn drive_on_loop(task: Task, deadline: Option[Duration], loop: RunLoop) -> StageResult[Output] {
    let (output, deadline_expired) = drive_plan(task, Scope!::new(),
        |&scope, root| &scope.run(root, deadline, loop), Scope!::close);
    StageResult.{ output, deadline_expired }
}

/// Drives the plan to completion and joins its children before returning.
forall Task, Output where Plan[Task, Scope! -> Output].
fn run(task: Task) -> Output { run_standalone(task, Option::None) }

/// Includes setup time in the parent budget and joins all children before returning.
forall Task, Output where Plan[Task, Scope! -> Output].
fn run_with_deadline(task: Task, duration: Duration) -> Output {
    let deadline = deadline_after(duration);
    run_standalone(task, Option::Some.(deadline))
}

/// Owns the libuv loop lent by with_runner.
struct Runner! { loop: *u8 }

impl Runner! {
    /// Runs and joins one plan on this loop.
    forall Task, Output where Plan[Task, Scope! -> Output].
    fn run(&self, task: Task) -> Output {
        let { output, deadline_expired } = &self.drive(task, Option::None);
        output
    }

    /// Includes setup time in the parent budget and joins all children before returning.
    forall Task, Output where Plan[Task, Scope! -> Output].
    fn run_with_deadline(&self, task: Task, duration: Duration) -> Output {
        let deadline = deadline_after(duration);
        let { output, deadline_expired } = &self.drive(task, Option::Some.(deadline));
        output
    }

    /// Runs a sequence on this loop with one optional budget for all stages.
    forall Stages, Output where Chain[Stages, Runner! -> Output].
    fn run_sequence(&self, plan: Sequence![Stages, Output], budget: Option[Duration]) -> SequenceOutcome[Output] {
        let deadline = budget.map(|duration| deadline_after(duration));
        drive_sequence_until(plan, &self, deadline)
    }

    forall Task, Output where Plan[Task, Scope! -> Output].
    fn drive(&self, task: Task, deadline: Option[Duration]) -> StageResult[Output] {
        let { loop } = self;
        self = Runner!.{ loop };
        drive_on_loop(task, deadline, RunLoop::Reusable.(loop))
    }
}

/// Lends one runner to the callback and closes it when the callback returns.
/// Loop startup failures are reported through the plans' outcomes.
forall Env, Output.
fn with_runner(body: closure[Env](&_: Runner!) -> Output) -> Output {
    let runner = Runner!.{ loop: unsafe kable_runner_new() };
    let output = body(&runner);
    let { loop } = runner;
    unsafe kable_runner_free(loop);
    output
}

instance Clock[Runner!] {
    fn now(&engine: Runner!) -> Duration { monotonic_now() }
}

forall Task, Output where Plan[Task, Scope! -> Output].
instance StageDriver[Task, Runner! -> Output] {
    fn drive(task: Task, &engine: Runner!, deadline: Option[Duration]) -> StageResult[Output] {
        &engine.drive(task, deadline)
    }
}

/// Runs a sequence with an optional shared time budget.
forall Stages, Output where Chain[Stages, Runner! -> Output].
fn run_sequence(plan: Sequence![Stages, Output], budget: Option[Duration]) -> SequenceOutcome[Output] {
    let deadline = budget.map(|duration| deadline_after(duration));
    with_runner(|&runner| drive_sequence_until(plan, &runner, deadline))
}
