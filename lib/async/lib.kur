//! Structured waits, joins, and bounded file reads on libuv.
use std::alloc::heap::HeapAllocator;
use std::bytes::buffer::Buffer!;
use std::mem::{alloca, sizeof};
use std::option::Option;
use std::ptr::is_null;
use std::slice::ReadBytes;
use task::{Join!, JoinOutcome, Outcome, PlanOutput, RaceOutcome, Select!, Sleep!, WithinOutcome,
    join, select, sleep};
use task::driver::{Branch, Pair, PairKind, Plan, PlanDriver, Resolution, ScopeState!};
use task::sequence::{Chain, Clock, Sequence!, StageDriver, drive_sequence, remaining_budget};

export Join!;
export JoinOutcome;
export Outcome;
export PlanOutput;
export RaceOutcome;
export Select!;
export Sleep!;
export join;
export select;
export sleep;
export WithinOutcome;

extern "C" fn uv_hrtime() -> u64;

extern "C" fn kable_scope_new(policy: *u8, add: unsafe fn(*u8, u8, usize, usize) -> usize,
    event: unsafe fn(*u8, u8, usize) -> usize) -> *u8;
extern "C" fn kable_scope_add(scope: *u8, kind: u8, ms: u64, first: usize, second: usize) -> usize;
extern "C" fn kable_scope_add_file(scope: *u8, path: *u8, len: usize, limit: usize, mode: u8) -> usize;
extern "C" fn kable_scope_add_chunk(scope: *u8, fd: i32, offset: u64, limit: usize) -> usize;
extern "C" fn kable_scope_add_operation(scope: *u8, context: *u8,
    start: unsafe fn(*u8, *u8, unsafe fn(*u8) -> (), *u8) -> i32,
    stop: unsafe fn(*u8) -> ()) -> usize;
extern "C" fn kable_scope_run(scope: *u8, root: usize, ms: u64, timed: u8) -> ();
extern "C" fn kable_scope_result(scope: *u8, id: usize) -> i32;
extern "C" fn kable_scope_file_result(scope: *u8, id: usize, bytes: *(*u8), len: *usize) -> i32;
extern "C" fn kable_scope_take_file(scope: *u8, id: usize, len: *u64) -> i32;
extern "C" fn kable_scope_free(scope: *u8) -> ();
extern "C" fn kable_file_close_descriptor(fd: i32) -> ();

struct ReadFile! { path: Buffer!, limit: usize, beneath: bool, id: Option[usize] }

/// Plans a read of a regular file. A file larger than limit fails.
forall C, S where ReadBytes[C, S], Copy[S].
fn read_file(&cx: C, path: S, limit: usize) -> ReadFile! {
    ReadFile!.{ path: Buffer!::new().push_bytes(&cx, path), limit, beneath: false, id: Option::None }
}

/// Plans a regular-file read below the process's working directory.
/// Linux resolves the relative path without following symlinks.
forall C, S where ReadBytes[C, S], Copy[S].
fn read_file_beneath_cwd(&cx: C, path: S, limit: usize) -> ReadFile! {
    ReadFile!.{ path: Buffer!::new().push_bytes(&cx, path), limit, beneath: true, id: Option::None }
}

exposed enum FileOutcome! {
    Read(Buffer!),
    Cancelled,
    Failed(i32),
}

struct OpenFile! { path: Buffer!, id: Option[usize] }
struct OpenedFile! { fd: i32, length: u64 }
struct ReadChunk! { file: OpenedFile!, offset: u64, limit: usize, id: Option[usize] }

exposed enum OpenOutcome! {
    Opened(OpenedFile!),
    Cancelled,
    Failed(i32),
}

/// Opens a regular file beneath the working directory and measures its length.
forall C, S where ReadBytes[C, S], Copy[S].
fn open_file_beneath_cwd(&cx: C, path: S) -> OpenFile! {
    OpenFile!.{ path: Buffer!::new().push_bytes(&cx, path), id: Option::None }
}

impl OpenedFile! {
    fn len(&self) -> u64 {
        let { fd, length } = self;
        self = OpenedFile!.{ fd, length };
        length
    }

    /// Reads at most limit bytes from the measured file without changing its position.
    /// The joined outcome returns the file on success, failure, or cancellation.
    /// An empty buffer indicates the end of the file or a zero limit.
    fn read_chunk(self, offset: u64, limit: usize) -> ReadChunk! {
        let length = &self.len();
        let remaining = if offset < length { length - offset } else { 0 };
        let limit = if remaining < limit as u64 { remaining as usize } else { limit };
        ReadChunk!.{ file: self, offset, limit, id: Option::None }
    }

    fn close(self) {
        let { fd, length } = self;
        unsafe kable_file_close_descriptor(fd);
    }

    /// Transfers responsibility for closing the descriptor to the caller.
    unsafe fn into_parts(self) -> (i32, u64) {
        let { fd, length } = self;
        (fd, length)
    }
}

// The scope is lent only while staging operations or reading their outcomes.
// Owned payloads stay in Kursal throughout the native event loop.
struct Scope! { raw: *u8 }

// Scalar encoding used by the native scope adapter.
const CANCELLED: i32 = 0i32;
const COMPLETED: i32 = 1i32;
const FIRST: i32 = 2i32;
const SECOND: i32 = 3i32;

unsafe fn add_branch(raw: *u8, kind: u8, first: usize, second: usize) -> usize {
    let branch = match kind {
        0u8 => Branch::Leaf,
        1u8 => Branch::Pair.(Pair.{ kind: PairKind::Select, first, second }),
        2u8 => Branch::Pair.(Pair.{ kind: PairKind::Join, first, second }),
        _ => return usize::MAX,
    };
    let ptr = unsafe (raw as *ScopeState!);
    let state = unsafe *ptr;
    let id = &state.add(branch);
    unsafe *ptr = state;
    id.unwrap_or(usize::MAX)
}

// Messages sent by the libuv adapter. Only the portable state decides which
// branch wins, what to cancel, and when all resources have retired.
unsafe fn scope_event(raw: *u8, event: u8, id: usize) -> usize {
    let ptr = unsafe (raw as *ScopeState!);
    let state = unsafe *ptr;
    if event == 8u8 {
        state.destroy();
        HeapAllocator::drop(unsafe HeapAllocator::adopt_raw(raw));
        return 0usize;
    }
    let result = match event {
        0u8 => if &state.begin(id) { 1usize } else { 0usize },
        1u8 => { &state.started(); 0usize },
        2u8 => if &state.retired() { 1usize } else { 0usize },
        3u8 => if &state.pending() { 1usize } else { 0usize },
        4u8 => if &state.complete(id) { 1usize } else { 0usize },
        5u8 => { &state.cancel(); 0usize },
        6u8 => (&state.take_cancel()).unwrap_or(usize::MAX),
        7u8 => match &state.result(id) {
            Option::Some(result) => match result {
                Resolution::Cancelled => CANCELLED as usize,
                Resolution::Completed => COMPLETED as usize,
                Resolution::First => FIRST as usize,
                Resolution::Second => SECOND as usize,
                Resolution::Failed(code) => usize::MAX,
            },
            Option::None => usize::MAX,
        },
        _ => 0usize,
    };
    unsafe *ptr = state;
    result
}

fn registered(id: usize) -> Option[usize] {
    if id == usize::MAX { Option::None } else { Option::Some.(id) }
}

impl Scope! {
    fn new() -> Scope! {
        let policy = HeapAllocator::alloc(sizeof[ScopeState!]()).into_raw();
        unsafe *(unsafe (policy as *ScopeState!)) = ScopeState!::new();
        let raw = unsafe kable_scope_new(policy, add_branch, scope_event);
        if is_null(raw) { unsafe scope_event(policy, 8u8, 0usize); }
        Scope!.{ raw }
    }

    fn add(&self, kind: u8, ms: u64, first: usize, second: usize) -> Option[usize] {
        let { raw } = self;
        let id = unsafe kable_scope_add(raw, kind, ms, first, second);
        self = Scope!.{ raw };
        registered(id)
    }

    fn add_file(&self, &path: Buffer!, limit: usize, mode: u8) -> Option[usize] {
        let { raw } = self;
        let bytes = unsafe &path.as_ptr();
        let len = &path.len();
        let id = unsafe kable_scope_add_file(raw, bytes, len, limit, mode);
        self = Scope!.{ raw };
        registered(id)
    }

    fn add_chunk(&self, &file: OpenedFile!, offset: u64, limit: usize) -> Option[usize] {
        let { raw } = self;
        let { fd, length } = file;
        let id = unsafe kable_scope_add_chunk(raw, fd, offset, limit);
        file = OpenedFile!.{ fd, length };
        self = Scope!.{ raw };
        registered(id)
    }

    /// The context lives through collection. Start schedules an asynchronous
    /// completion on the supplied loop. Stop retires it without a callback.
    unsafe fn add_operation(&self, context: *u8,
        start: unsafe fn(*u8, *u8, unsafe fn(*u8) -> (), *u8) -> i32,
        stop: unsafe fn(*u8) -> ()) -> Option[usize] {
        let { raw } = self;
        let id = unsafe kable_scope_add_operation(raw, context, start, stop);
        self = Scope!.{ raw };
        registered(id)
    }

    fn file_result(&self, id: Option[usize]) -> FileOutcome! {
        let { raw } = self;
        let data = unsafe alloca[*u8]();
        let size = unsafe alloca[usize]();
        let code = unsafe kable_scope_file_result(raw, id.unwrap_or(usize::MAX), data, size);
        self = Scope!.{ raw };
        if code < 0i32 { return FileOutcome!::Failed.(code); }
        let bytes = unsafe *data;
        let len = unsafe *size;
        FileOutcome!::Read.(unsafe Buffer!::new_with_cap(len).push_n(bytes, len))
    }

    fn take_file(&self, id: Option[usize]) -> OpenOutcome! {
        let { raw } = self;
        let size = unsafe alloca[u64]();
        let fd = unsafe kable_scope_take_file(raw, id.unwrap_or(usize::MAX), size);
        self = Scope!.{ raw };
        if fd < 0 { return OpenOutcome!::Failed.(fd); }
        OpenOutcome!::Opened.(OpenedFile!.{ fd, length: unsafe *size })
    }

    fn run(&self, root: Option[usize], deadline: Option[u64]) {
        let { raw } = self;
        let root = root.unwrap_or(usize::MAX);
        match deadline {
            Option::Some(ms) => unsafe kable_scope_run(raw, root, ms, 1u8),
            Option::None => unsafe kable_scope_run(raw, root, 0u64, 0u8),
        };
        self = Scope!.{ raw };
    }

    fn result(&self, id: Option[usize]) -> Resolution {
        let { raw } = self;
        let code = unsafe kable_scope_result(raw, id.unwrap_or(usize::MAX));
        self = Scope!.{ raw };
        if code == CANCELLED { return Resolution::Cancelled; }
        if code == COMPLETED { return Resolution::Completed; }
        if code == FIRST { return Resolution::First; }
        if code == SECOND { return Resolution::Second; }
        Resolution::Failed.(code)
    }

    fn close(self) {
        let { raw } = self;
        unsafe kable_scope_free(raw);
    }
}

fn collect_file(&scope: Scope!, id: Option[usize]) -> FileOutcome! {
    match &scope.result(id) {
        Resolution::Completed => &scope.file_result(id),
        Resolution::Cancelled => FileOutcome!::Cancelled,
        Resolution::Failed(code) => FileOutcome!::Failed.(code),
        Resolution::First | Resolution::Second => FileOutcome!::Failed.(-1i32),
    }
}

instance PlanOutput[ReadFile! -> FileOutcome!] {}

instance Plan[ReadFile!, Scope! -> FileOutcome!] {
    fn stage(&task: ReadFile!, &scope: Scope!) -> Option[usize] {
        let { path, limit, beneath, id } = task;
        let id = &scope.add_file(&path, limit, if beneath { 1 } else { 0 });
        task = ReadFile!.{ path, limit, beneath, id };
        id
    }

    fn collect(task: ReadFile!, &scope: Scope!) -> FileOutcome! {
        let { path, limit, beneath, id } = task;
        path.destroy();
        collect_file(&scope, id)
    }
}

instance PlanOutput[ReadChunk! -> (OpenedFile!, FileOutcome!)] {}

instance Plan[ReadChunk!, Scope! -> (OpenedFile!, FileOutcome!)] {
    fn stage(&task: ReadChunk!, &scope: Scope!) -> Option[usize] {
        let { file, offset, limit, id } = task;
        let id = &scope.add_chunk(&file, offset, limit);
        task = ReadChunk!.{ file, offset, limit, id };
        id
    }

    fn collect(task: ReadChunk!, &scope: Scope!) -> (OpenedFile!, FileOutcome!) {
        let { file, offset, limit, id } = task;
        (file, collect_file(&scope, id))
    }
}

instance PlanOutput[OpenFile! -> OpenOutcome!] {}

instance Plan[OpenFile!, Scope! -> OpenOutcome!] {
    fn stage(&task: OpenFile!, &scope: Scope!) -> Option[usize] {
        let { path, id } = task;
        let id = &scope.add_file(&path, 0, 2);
        task = OpenFile!.{ path, id };
        id
    }

    fn collect(task: OpenFile!, &scope: Scope!) -> OpenOutcome! {
        let { path, id } = task;
        path.destroy();
        match &scope.result(id) {
            Resolution::Completed => &scope.take_file(id),
            Resolution::Cancelled => OpenOutcome!::Cancelled,
            Resolution::Failed(code) => OpenOutcome!::Failed.(code),
            Resolution::First | Resolution::Second => OpenOutcome!::Failed.(-1i32),
        }
    }
}

instance PlanDriver[Scope!] {
    fn timer(&scope: Scope!, ms: u64) -> Option[usize] { &scope.add(0u8, ms, 0usize, 0usize) }

    fn pair(&scope: Scope!, pair: Pair) -> Option[usize] {
        let { kind, first, second } = pair;
        let tag = match kind {
            PairKind::Select => 1u8,
            PairKind::Join => 2u8,
        };
        &scope.add(tag, 0u64, first, second)
    }

    fn result(&scope: Scope!, id: Option[usize]) -> Resolution { &scope.result(id) }
}

forall Task.
struct Prepared! { scope: Scope!, task: Task, root: Option[usize] }

forall Task, Output where PlanOutput[Task -> Output], Plan[Task, Scope! -> Output].
fn prepare(task: Task) -> Prepared![Task] {
    var scope = Scope!::new();
    let root = Plan[Task, Scope! -> Output]::stage(&task, &scope);
    Prepared!.{ scope, task, root }
}

forall Task.
impl Prepared![Task] {
    /// The host must keep this plan alive until the native scope has joined.
    unsafe fn native(&self) -> (*u8, usize) {
        let { scope, task, root } = self;
        let { raw } = scope;
        self = Prepared!.{ scope: Scope!.{ raw }, task, root };
        (raw, root.unwrap_or(usize::MAX))
    }
}

forall Task, Output where PlanOutput[Task -> Output], Plan[Task, Scope! -> Output].
fn collect(prepared: Prepared![Task]) -> Output {
    let { scope, task, root } = prepared;
    let result = Plan[Task, Scope! -> Output]::collect(task, &scope);
    scope.close();
    result
}

forall Task, Output where PlanOutput[Task -> Output], Plan[Task, Scope! -> Output].
fn drive_plan(task: Task, deadline: Option[u64]) -> Output {
    run_prepared(prepare(task), deadline)
}

forall Task, Output where PlanOutput[Task -> Output], Plan[Task, Scope! -> Output].
fn run_prepared(prepared: Prepared![Task], deadline: Option[u64]) -> Output {
    let { scope, task, root } = prepared;
    &scope.run(root, deadline);
    collect(Prepared!.{ scope, task, root })
}

/// Drives the plan to completion and joins its children before returning.
forall Task, Output where PlanOutput[Task -> Output], Plan[Task, Scope! -> Output].
fn run(task: Task) -> Output { drive_plan(task, Option::None) }

/// Cancels unfinished children when the parent deadline expires, then joins them.
forall Task, Output where PlanOutput[Task -> Output], Plan[Task, Scope! -> Output].
fn run_with_deadline(task: Task, ms: u64) -> Output {
    drive_plan(task, Option::Some.(ms))
}

struct SequenceClock {}

instance Clock[SequenceClock] {
    fn now(&engine: SequenceClock) -> u64 { (unsafe uv_hrtime()) / 1_000_000u64 }
}

forall Task, Output where PlanOutput[Task -> Output], Plan[Task, Scope! -> Output].
instance StageDriver[Task, SequenceClock -> Output] {
    fn drive(task: Task, &engine: SequenceClock, deadline: Option[u64]) -> Output {
        let prepared = prepare(task);
        run_prepared(prepared, remaining_budget(&engine, deadline))
    }
}

/// Runs a sequence with an optional shared budget in milliseconds.
forall Stages, Output where Chain[Stages, SequenceClock -> Output].
fn run_sequence(plan: Sequence![Stages], budget: Option[u64]) -> Option[Output] {
    let clock = SequenceClock.{};
    drive_sequence(plan, &clock, budget)
}
