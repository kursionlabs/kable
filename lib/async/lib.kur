//! Structured waits, joins, and bounded file reads on libuv.
use std::alloc::heap::HeapAllocator;
use std::bytes::buffer::Buffer!;
use std::mem::{alloca, sizeof};
use std::option::Option;
use std::ptr::is_null;
use std::slice::ReadBytes;
use task::{Join!, JoinOutcome, Outcome, Plan as TaskPlan, PlanDriver, Race!, RaceOutcome, Select!, Sleep!,
    join, race, select, sleep};
use task::{Branch, Carry!, Map!, ScopeState!, map};
use task::{Chain, Clock, Sequence!, StageDriver, drive_sequence, remaining_budget, sequence};

export Join!;
export JoinOutcome;
export Outcome;
export Race!;
export RaceOutcome;
export Select!;
export Sleep!;
export join;
export map;
export race;
export select;
export sleep;
export sequence;

extern "C" fn uv_hrtime() -> u64;

extern "C" fn kable_scope_new(policy: *u8, add: unsafe fn(*u8, u8, usize, usize) -> usize,
    event: unsafe fn(*u8, u8, usize) -> usize) -> *u8;
extern "C" fn kable_scope_add(scope: *u8, kind: u8, ms: u64, first: usize, second: usize) -> usize;
extern "C" fn kable_scope_add_file(scope: *u8, path: *u8, len: usize, limit: usize) -> usize;
extern "C" fn kable_scope_run(scope: *u8, root: usize, ms: u64, timed: u8) -> ();
extern "C" fn kable_scope_next(scope: *u8) -> i32;
extern "C" fn kable_scope_file_result(scope: *u8, bytes: *(*u8), len: *usize) -> i32;
extern "C" fn kable_scope_free(scope: *u8) -> ();

struct ReadFile! { path: Buffer!, limit: usize }

/// Plans a read of a regular file. A file larger than limit fails.
forall C, S where ReadBytes[C, S], Copy[S].
fn read_file(&cx: C, path: S, limit: usize) -> ReadFile! {
    ReadFile!.{ path: Buffer!::new().push_bytes(&cx, path), limit }
}

exposed enum FileOutcome! {
    Read(Buffer!),
    Cancelled,
    Failed(i32),
}

forall Task, Output.
trait Runnable {
    fn drive(task: Task, deadline: Option[u64]) -> Output;
}

// The scope is lent only while staging operations or reading their outcomes.
// Owned payloads stay in Kursal throughout the native event loop.
struct Scope! { raw: *u8 }

unsafe fn add_branch(raw: *u8, kind: u8, first: usize, second: usize) -> usize {
    let branch = match kind {
        0u8 => Branch::Leaf,
        1u8 => Branch::Select,
        2u8 => Branch::Join,
        _ => return usize::MAX,
    };
    let ptr = unsafe (raw as *ScopeState!);
    let state = unsafe *ptr;
    let id = &state.add(branch, first, second);
    unsafe *ptr = state;
    id
}

// Messages sent by the libuv adapter. Only the portable state decides which
// branch wins, what to cancel, and when all resources have retired.
unsafe fn scope_event(raw: *u8, event: u8, id: usize) -> usize {
    let ptr = unsafe (raw as *ScopeState!);
    let state = unsafe *ptr;
    if event == 8u8 {
        state.destroy();
        HeapAllocator::drop(unsafe HeapAllocator::adopt_raw(raw));
        return 0usize;
    }
    let result = match event {
        0u8 => if &state.begin(id) { 1usize } else { 0usize },
        1u8 => { &state.started(); 0usize },
        2u8 => if &state.retired() { 1usize } else { 0usize },
        3u8 => if &state.pending() { 1usize } else { 0usize },
        4u8 => if &state.complete(id) { 1usize } else { 0usize },
        5u8 => { &state.cancel(); 0usize },
        6u8 => &state.take_cancel(),
        7u8 => {
            let code = &state.result(id);
            if code < 0i32 { usize::MAX } else { code as usize }
        },
        _ => 0usize,
    };
    unsafe *ptr = state;
    result
}

impl Scope! {
    fn new() -> Scope! {
        let policy = HeapAllocator::alloc(sizeof[ScopeState!]()).into_raw();
        unsafe *(unsafe (policy as *ScopeState!)) = ScopeState!::new();
        let raw = unsafe kable_scope_new(policy, add_branch, scope_event);
        if is_null(raw) { unsafe scope_event(policy, 8u8, 0usize); }
        Scope!.{ raw }
    }

    fn add(&self, kind: u8, ms: u64, first: usize, second: usize) -> usize {
        let { raw } = self;
        let id = unsafe kable_scope_add(raw, kind, ms, first, second);
        self = Scope!.{ raw };
        id
    }

    fn add_file(&self, &path: Buffer!, limit: usize) -> usize {
        let { raw } = self;
        let bytes = unsafe &path.as_ptr();
        let len = &path.len();
        let id = unsafe kable_scope_add_file(raw, bytes, len, limit);
        self = Scope!.{ raw };
        id
    }

    fn file_result(&self) -> FileOutcome! {
        let { raw } = self;
        let data = unsafe alloca[*u8]();
        let size = unsafe alloca[usize]();
        let code = unsafe kable_scope_file_result(raw, data, size);
        self = Scope!.{ raw };
        if code < 0i32 { return FileOutcome!::Failed.(code); }
        let bytes = unsafe *data;
        let len = unsafe *size;
        FileOutcome!::Read.(unsafe Buffer!::new_with_cap(len).push_n(bytes, len))
    }

    fn run(&self, root: usize, deadline: Option[u64]) {
        let { raw } = self;
        match deadline {
            Option::Some(ms) => unsafe kable_scope_run(raw, root, ms, 1u8),
            Option::None => unsafe kable_scope_run(raw, root, 0u64, 0u8),
        };
        self = Scope!.{ raw };
    }

    fn next(&self) -> i32 {
        let { raw } = self;
        let code = unsafe kable_scope_next(raw);
        self = Scope!.{ raw };
        code
    }

    fn close(self) {
        let { raw } = self;
        unsafe kable_scope_free(raw);
    }
}

forall Task, Output.
trait Plan {
    fn stage(&task: Task, &scope: Scope!) -> usize;
    fn collect(task: Task, &scope: Scope!) -> Output;
}

instance TaskPlan[ReadFile!, FileOutcome!, Scope!] {
    fn stage(&task: ReadFile!, &scope: Scope!) -> usize {
        let { path, limit } = task;
        let id = &scope.add_file(&path, limit);
        task = ReadFile!.{ path, limit };
        id
    }

    fn collect(task: ReadFile!, &scope: Scope!) -> FileOutcome! {
        let { path, limit } = task;
        path.destroy();
        let code = &scope.next();
        match code {
            1i32 => &scope.file_result(),
            0i32 => FileOutcome!::Cancelled,
            _ => FileOutcome!::Failed.(code),
        }
    }
}

instance PlanDriver[Scope!] {
    fn timer(&scope: Scope!, ms: u64) -> usize { &scope.add(0u8, ms, 0usize, 0usize) }

    fn pair(&scope: Scope!, kind: Branch, first: usize, second: usize) -> usize {
        let tag = match kind {
            Branch::Leaf => 0u8,
            Branch::Select => 1u8,
            Branch::Join => 2u8,
        };
        &scope.add(tag, 0u64, first, second)
    }

    fn next(&scope: Scope!) -> i32 { &scope.next() }
}

forall Task, Output where TaskPlan[Task, Output, Scope!].
instance Plan[Task, Output] {
    fn stage(&task: Task, &scope: Scope!) -> usize {
        TaskPlan[Task, Output, Scope!]::stage(&task, &scope)
    }

    fn collect(task: Task, &scope: Scope!) -> Output {
        TaskPlan[Task, Output, Scope!]::collect(task, &scope)
    }
}

forall Task.
struct Prepared! { scope: Scope!, task: Task, root: usize }

forall Task, Output where Plan[Task, Output].
fn prepare(task: Task) -> Prepared![Task] {
    var scope = Scope!::new();
    let root = Plan[Task, Output]::stage(&task, &scope);
    Prepared!.{ scope, task, root }
}

forall Task.
impl Prepared![Task] {
    /// The host must keep this plan alive until the native scope has joined.
    unsafe fn native(&self) -> (*u8, usize) {
        let { scope, task, root } = self;
        let { raw } = scope;
        self = Prepared!.{ scope: Scope!.{ raw }, task, root };
        (raw, root)
    }
}

forall Task, Output where Plan[Task, Output].
fn collect(prepared: Prepared![Task]) -> Output {
    let { scope, task, root } = prepared;
    let result = Plan[Task, Output]::collect(task, &scope);
    scope.close();
    result
}

forall Task, Output where Plan[Task, Output].
fn drive_plan(task: Task, deadline: Option[u64]) -> Output {
    run_prepared(prepare[Task, Output](task), deadline)
}

forall Task, Output where Plan[Task, Output].
fn run_prepared(prepared: Prepared![Task], deadline: Option[u64]) -> Output {
    let { scope, task, root } = prepared;
    &scope.run(root, deadline);
    collect[Task, Output](Prepared!.{ scope, task, root })
}

forall T.
instance Runnable[Sleep![T], Outcome[T]] {
    fn drive(task: Sleep![T], deadline: Option[u64]) -> Outcome[T] { drive_plan(task, deadline) }
}

instance Runnable[ReadFile!, FileOutcome!] {
    fn drive(task: ReadFile!, deadline: Option[u64]) -> FileOutcome! { drive_plan(task, deadline) }
}

forall Task, State, Output where TaskPlan[Task, Output, Scope!].
instance Runnable[Carry![Task, State], (State, Output)] {
    fn drive(task: Carry![Task, State], deadline: Option[u64]) -> (State, Output) {
        drive_plan(task, deadline)
    }
}

forall Task, Input, Output, Env where TaskPlan[Task, Input, Scope!].
instance Runnable[Map![Task, Input, Output, Env], Output] {
    fn drive(task: Map![Task, Input, Output, Env], deadline: Option[u64]) -> Output {
        drive_plan(task, deadline)
    }
}

forall A, B.
instance Runnable[Race![A, B], RaceOutcome[A, B]] {
    fn drive(task: Race![A, B], deadline: Option[u64]) -> RaceOutcome[A, B] { drive_plan(task, deadline) }
}

forall First, Second, A, B where TaskPlan[First, A, Scope!], TaskPlan[Second, B, Scope!].
instance Runnable[Select![First, Second], RaceOutcome[A, B]] {
    fn drive(task: Select![First, Second], deadline: Option[u64]) -> RaceOutcome[A, B] {
        drive_plan(task, deadline)
    }
}

forall First, Second, A, B where TaskPlan[First, A, Scope!], TaskPlan[Second, B, Scope!].
instance Runnable[Join![First, Second], JoinOutcome[A, B]] {
    fn drive(task: Join![First, Second], deadline: Option[u64]) -> JoinOutcome[A, B] {
        drive_plan(task, deadline)
    }
}

/// Drives the plan to completion and joins its children before returning.
forall Task, Output where Runnable[Task, Output].
fn run(task: Task) -> Output { Runnable[Task, Output]::drive(task, Option::None) }

/// Cancels unfinished children when the parent deadline expires, then joins them.
forall Task, Output where Runnable[Task, Output].
fn timeout(ms: u64, task: Task) -> Output {
    Runnable[Task, Output]::drive(task, Option::Some.(ms))
}

struct SequenceClock {}

instance Clock[SequenceClock] {
    fn now(&engine: SequenceClock) -> u64 { (unsafe uv_hrtime()) / 1_000_000u64 }
}

forall Task, Output where Plan[Task, Output].
instance StageDriver[Task, Output, SequenceClock] {
    fn drive(task: Task, &engine: SequenceClock, deadline: Option[u64]) -> Output {
        let prepared = prepare[Task, Output](task);
        run_prepared(prepared, remaining_budget(&engine, deadline))
    }
}

/// Runs a sequence with an optional shared budget in milliseconds.
forall Stages, Output where Chain[Stages, Output, SequenceClock].
fn run_sequence(plan: Sequence![Stages], budget: Option[u64]) -> Option[Output] {
    let clock = SequenceClock.{};
    drive_sequence(plan, &clock, budget)
}
