//! Structured waits, joins, and bounded file reads on libuv.
use std::bytes::buffer::Buffer!;
use std::mem::alloca;
use std::option::Option;
use std::slice::ReadBytes;

extern "C" fn kable_scope_new() -> *u8;
extern "C" fn kable_scope_add(scope: *u8, kind: u8, ms: u64, first: usize, second: usize) -> usize;
extern "C" fn kable_scope_add_file(scope: *u8, path: *u8, len: usize, limit: usize) -> usize;
extern "C" fn kable_scope_run(scope: *u8, root: usize, ms: u64, timed: u8) -> ();
extern "C" fn kable_scope_next(scope: *u8) -> i32;
extern "C" fn kable_scope_file_result(scope: *u8, bytes: *(*u8), len: *usize) -> i32;
extern "C" fn kable_scope_free(scope: *u8) -> ();

forall T.
struct Sleep! { ms: u64, value: T }

forall T.
impl Sleep![T] {
    /// Consumes a wait plan to schedule it on a host event loop.
    fn into_parts(self) -> (u64, T) {
        let { ms, value } = self;
        (ms, value)
    }
}

forall T.
fn sleep(ms: u64, value: T) -> Sleep![T] { Sleep!.{ ms, value } }

forall A, B.
struct Race! { first: Sleep![A], second: Sleep![B] }

forall A, B.
fn race(first: Sleep![A], second: Sleep![B]) -> Race![A, B] { Race!.{ first, second } }

forall First, Second.
struct Join! { first: First, second: Second }

/// Starts both plans in the same scope and waits for both to complete.
forall First, Second.
fn join(first: First, second: Second) -> Join![First, Second] { Join!.{ first, second } }

struct ReadFile! { path: Buffer!, limit: usize }

/// Plans a read of a regular file. A file larger than limit fails.
forall C, S where ReadBytes[C, S], Copy[S].
fn read_file(&cx: C, path: S, limit: usize) -> ReadFile! {
    ReadFile!.{ path: Buffer!::new().push_bytes(&cx, path), limit }
}

exposed enum FileOutcome! {
    Read(Buffer!),
    Cancelled,
    Failed(i32),
}

forall T.
exposed enum Outcome {
    Ready(T),
    Cancelled(T),
    Failed(T, i32),
}

/// Each branch hands ownership of both inputs back after the scope closes.
forall A, B.
exposed enum RaceOutcome {
    First(A, B),
    Second(A, B),
    Cancelled(A, B),
    Failed(A, B, i32),
}

/// Each branch carries both child outcomes, including children that completed
/// before a cancellation.
forall A, B.
exposed enum JoinOutcome {
    Ready(A, B),
    Cancelled(A, B),
    Failed(A, B, i32),
}

forall Task, Output.
trait Runnable {
    fn drive(task: Task, deadline: Option[u64]) -> Output;
}

// The scope is lent only while staging operations or reading their outcomes.
// Owned payloads stay in Kursal throughout the native event loop.
struct Scope! { raw: *u8 }

impl Scope! {
    fn add(&self, kind: u8, ms: u64, first: usize, second: usize) -> usize {
        let { raw } = self;
        let id = unsafe kable_scope_add(raw, kind, ms, first, second);
        self = Scope!.{ raw };
        id
    }

    fn add_file(&self, &path: Buffer!, limit: usize) -> usize {
        let { raw } = self;
        let bytes = unsafe &path.as_ptr();
        let len = &path.len();
        let id = unsafe kable_scope_add_file(raw, bytes, len, limit);
        self = Scope!.{ raw };
        id
    }

    fn file_result(&self) -> FileOutcome! {
        let { raw } = self;
        let data = unsafe alloca[*u8]();
        let size = unsafe alloca[usize]();
        let code = unsafe kable_scope_file_result(raw, data, size);
        self = Scope!.{ raw };
        if code < 0i32 { return FileOutcome!::Failed.(code); }
        let bytes = unsafe *data;
        let len = unsafe *size;
        FileOutcome!::Read.(unsafe Buffer!::new_with_cap(len).push_n(bytes, len))
    }

    fn run(&self, root: usize, deadline: Option[u64]) {
        let { raw } = self;
        match deadline {
            Option::Some(ms) => unsafe kable_scope_run(raw, root, ms, 1u8),
            Option::None => unsafe kable_scope_run(raw, root, 0u64, 0u8),
        };
        self = Scope!.{ raw };
    }

    fn next(&self) -> i32 {
        let { raw } = self;
        let code = unsafe kable_scope_next(raw);
        self = Scope!.{ raw };
        code
    }

    fn close(self) {
        let { raw } = self;
        unsafe kable_scope_free(raw);
    }
}

forall Task, Output.
trait Plan {
    fn stage(&task: Task, &scope: Scope!) -> usize;
    fn collect(task: Task, &scope: Scope!) -> Output;
}

instance Plan[ReadFile!, FileOutcome!] {
    fn stage(&task: ReadFile!, &scope: Scope!) -> usize {
        let { path, limit } = task;
        let id = &scope.add_file(&path, limit);
        task = ReadFile!.{ path, limit };
        id
    }

    fn collect(task: ReadFile!, &scope: Scope!) -> FileOutcome! {
        let { path, limit } = task;
        path.destroy();
        let code = &scope.next();
        match code {
            1i32 => &scope.file_result(),
            0i32 => FileOutcome!::Cancelled,
            _ => FileOutcome!::Failed.(code),
        }
    }
}

forall T.
fn stage_sleep(&task: Sleep![T], &scope: Scope!) -> usize {
    let { ms, value } = task;
    let id = &scope.add(0u8, ms, 0usize, 0usize);
    task = Sleep!.{ ms, value };
    id
}

forall T.
instance Plan[Sleep![T], Outcome[T]] {
    fn stage(&task: Sleep![T], &scope: Scope!) -> usize { stage_sleep(&task, &scope) }

    fn collect(task: Sleep![T], &scope: Scope!) -> Outcome[T] {
        let { ms, value } = task;
        let code = &scope.next();
        match code {
            1i32 => Outcome::Ready.(value),
            0i32 => Outcome::Cancelled.(value),
            _ => Outcome::Failed.(value, code),
        }
    }
}

forall A, B.
instance Plan[Race![A, B], RaceOutcome[A, B]] {
    fn stage(&task: Race![A, B], &scope: Scope!) -> usize {
        let { first, second } = task;
        let a = stage_sleep(&first, &scope);
        let b = stage_sleep(&second, &scope);
        let id = &scope.add(1u8, 0u64, a, b);
        task = Race!.{ first, second };
        id
    }

    fn collect(task: Race![A, B], &scope: Scope!) -> RaceOutcome[A, B] {
        let { first, second } = task;
        let (first_ms, a) = first.into_parts();
        let (second_ms, b) = second.into_parts();
        let first_code = &scope.next();
        let second_code = &scope.next();
        let code = &scope.next();
        match code {
            1i32 => RaceOutcome::First.(a, b),
            2i32 => RaceOutcome::Second.(a, b),
            0i32 => RaceOutcome::Cancelled.(a, b),
            _ => RaceOutcome::Failed.(a, b, code),
        }
    }
}

forall First, Second, A, B where Plan[First, A], Plan[Second, B].
instance Plan[Join![First, Second], JoinOutcome[A, B]] {
    fn stage(&task: Join![First, Second], &scope: Scope!) -> usize {
        let { first, second } = task;
        let a = Plan[First, A]::stage(&first, &scope);
        let b = Plan[Second, B]::stage(&second, &scope);
        let id = &scope.add(2u8, 0u64, a, b);
        task = Join!.{ first, second };
        id
    }

    fn collect(task: Join![First, Second], &scope: Scope!) -> JoinOutcome[A, B] {
        let { first, second } = task;
        let a = Plan[First, A]::collect(first, &scope);
        let b = Plan[Second, B]::collect(second, &scope);
        let code = &scope.next();
        match code {
            1i32 => JoinOutcome::Ready.(a, b),
            0i32 => JoinOutcome::Cancelled.(a, b),
            _ => JoinOutcome::Failed.(a, b, code),
        }
    }
}

forall Task.
struct Prepared! { scope: Scope!, task: Task, root: usize }

forall Task, Output where Plan[Task, Output].
fn prepare(task: Task) -> Prepared![Task] {
    var scope = Scope!.{ raw: unsafe kable_scope_new() };
    let root = Plan[Task, Output]::stage(&task, &scope);
    Prepared!.{ scope, task, root }
}

forall Task.
impl Prepared![Task] {
    /// The host must keep this plan alive until the native scope has joined.
    unsafe fn native(&self) -> (*u8, usize) {
        let { scope, task, root } = self;
        let { raw } = scope;
        self = Prepared!.{ scope: Scope!.{ raw }, task, root };
        (raw, root)
    }
}

forall Task, Output where Plan[Task, Output].
fn collect(prepared: Prepared![Task]) -> Output {
    let { scope, task, root } = prepared;
    let result = Plan[Task, Output]::collect(task, &scope);
    scope.close();
    result
}

forall Task, Output where Plan[Task, Output].
fn drive_plan(task: Task, deadline: Option[u64]) -> Output {
    let { scope, task, root } = prepare[Task, Output](task);
    &scope.run(root, deadline);
    collect[Task, Output](Prepared!.{ scope, task, root })
}

forall T.
instance Runnable[Sleep![T], Outcome[T]] {
    fn drive(task: Sleep![T], deadline: Option[u64]) -> Outcome[T] { drive_plan(task, deadline) }
}

instance Runnable[ReadFile!, FileOutcome!] {
    fn drive(task: ReadFile!, deadline: Option[u64]) -> FileOutcome! { drive_plan(task, deadline) }
}

forall A, B.
instance Runnable[Race![A, B], RaceOutcome[A, B]] {
    fn drive(task: Race![A, B], deadline: Option[u64]) -> RaceOutcome[A, B] { drive_plan(task, deadline) }
}

forall First, Second, A, B where Plan[First, A], Plan[Second, B].
instance Runnable[Join![First, Second], JoinOutcome[A, B]] {
    fn drive(task: Join![First, Second], deadline: Option[u64]) -> JoinOutcome[A, B] {
        drive_plan(task, deadline)
    }
}

/// Drives the plan to completion and joins its children before returning.
forall Task, Output where Runnable[Task, Output].
fn run(task: Task) -> Output { Runnable[Task, Output]::drive(task, Option::None) }

/// Cancels unfinished children when the parent deadline expires, then joins them.
forall Task, Output where Runnable[Task, Output].
fn timeout(ms: u64, task: Task) -> Output {
    Runnable[Task, Output]::drive(task, Option::Some.(ms))
}
