//! Bounded collection of an owned byte stream, one joined pull at a time.
use std::fmt::Writer;
use package::{Scope!, Task!};
use std::buffer::Buffer!;
use std::option::Option;
use task::{Completion, Discard, Failure, PlanOutput, Stream, StreamOutcome};
use task::continuation::{HandoffStep, repeat, resolve_completion};
use task::driver::Plan;

struct Collection! { bytes: Option[Buffer!], remaining: usize }

/// A stream of owned buffers that can be collected on the libuv driver.
forall Source -> Read.
trait CollectBytes {
    fn collect(source: Source, limit: usize) -> Task![Buffer!];
}

forall Source, Read where Stream[Source -> Read], PlanOutput[Read -> (Source, StreamOutcome[Buffer!])],
    Discard[Source], Plan[Read, Scope! -> (Source, StreamOutcome[Buffer!])].
instance CollectBytes[Source -> Read] {
    /// Collects the yielded bytes. Returns LimitExceeded if the total exceeds limit.
    fn collect(source: Source, limit: usize) -> Task![Buffer!] {
        repeat(source.next(), Collection!.{ bytes: Option::None, remaining: limit },
            collect_next[Source, Read], cancel[Source], resolve_completion[Buffer!])
    }
}

forall Source where Discard[Source].
fn cancel(state: Collection!, result: (Source, StreamOutcome[Buffer!])) -> Completion[Buffer!] {
    let { bytes, remaining } = state;
    (bytes, result).discard();
    Completion::Cancelled
}

forall Source, Read where Stream[Source -> Read], Discard[Source].
fn collect_next(state: Collection!, result: (Source, StreamOutcome[Buffer!]))
    -> HandoffStep[(Read, Collection!), Completion[Buffer!]] {
    let { bytes, remaining } = state;
    let (source, outcome) = result;
    let failure = match outcome {
        Item(item) => {
            var item = item;
            let length = &item.len();
            if length <= remaining {
                let bytes = match bytes { Some(bytes) => bytes.put(item), None => item };
                return HandoffStep::Start.((source.next(), Collection!.{
                    bytes: Option::Some.(bytes), remaining: remaining - length }));
            }
            item.destroy();
            Completion::Failed.(Failure::LimitExceeded)
        },
        Eof => {
            source.discard();
            let bytes = match bytes { Some(bytes) => bytes, None => Buffer!::new() };
            return HandoffStep::Finish.(Completion::Ready.(bytes));
        },
        TimedOut => Completion::TimedOut,
        Cancelled => Completion::Cancelled,
        Failed(failure) => Completion::Failed.(failure),
    };
    (source, bytes).discard();
    HandoffStep::Finish.(failure)
}
