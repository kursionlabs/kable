use std::time::Duration;
use package::{Completion, DeadlineStatus, Failure, PairPlan!, Side, Sleep!, select, sleep};

forall Task.
fn race(task: Task, duration: Duration) -> PairPlan![Sleep!, Task, Side] {
    select(sleep(duration), task)
}

forall Output.
fn resolve(result: (Completion[()], Output, Completion[Side])) -> (Output, DeadlineStatus) {
    let (timer, outcome, race) = result;
    (outcome, status(timer, race))
}

fn finish(completion: Completion[()], deadline: DeadlineStatus) -> Completion[()] {
    match deadline {
        DeadlineStatus::Completed => completion,
        DeadlineStatus::TimedOut => Completion::TimedOut,
        DeadlineStatus::Cancelled => Completion::Cancelled,
        DeadlineStatus::Failed(failure) => Completion::Failed.(failure),
    }
}

fn status(timer: Completion[()], race: Completion[Side]) -> DeadlineStatus {
    match race {
        Completion::Ready(side) => match side {
            Side::First => match timer {
                Completion::Ready | Completion::TimedOut => DeadlineStatus::TimedOut,
                Completion::Failed(failure) => DeadlineStatus::Failed.(failure),
                Completion::Cancelled => DeadlineStatus::Failed.(Failure::InvalidResult),
            },
            Side::Second => DeadlineStatus::Completed,
        },
        Completion::TimedOut | Completion::Cancelled => DeadlineStatus::Cancelled,
        Completion::Failed(failure) => DeadlineStatus::Failed.(failure),
    }
}
