//! Explicit sequential adapters. Engines drive one fully scoped stage at a time.
use package::{Discard, Map!, PlanOutput, discard_owned};
use package::continuation::{ChainPlan!, ContinuationDriver, HandoffStep, chain, erase};
use package::driver::{Plan, PlanDriver, Resolution};
use std::option::Option;
use std::time::Duration;
use thunk::Thunk!;

forall Engine.
trait Clock {
    /// Elapsed time since the engine's monotonic clock origin.
    fn now(&engine: Engine) -> Duration;
}

/// A joined stage and whether its parent deadline expired while driving it.
forall Output.
exposed struct StageResult { output: Output, deadline_expired: bool }

forall Task, Engine -> Output.
trait StageDriver {
    /// The deadline uses the same clock as now, so preparation time also
    /// counts against the budget.
    fn drive(task: Task, &engine: Engine, deadline: Option[Duration]) -> StageResult[Output];
}

forall Task.
struct First! { task: Task }

/// How the sequence ended. Finished carries the final stage's joined output.
/// Stopped means a continuation returned None. Cancelled means the shared
/// deadline prevented a handoff.
forall Output.
exposed enum SequenceOutcome {
    Finished(Output),
    Stopped,
    Cancelled,
}

forall Previous, State, Input, Task, Env.
struct Then! {
    previous: Previous,
    handoff: Thunk![State, Input, Option[Task], Env, fn(State, Option[Input]) -> ()],
}

/// A chain with the joined output type of its last plan.
forall Stages, Output.
struct Sequence! { stages: Stages }

forall Task, Input where PlanOutput[Task -> Input].
impl Task {
    /// Starts a sequence whose first handoff can be skipped by dropping its inputs.
    forall Env, Next, Output where PlanOutput[Next -> Output], Copy[Env], Copy[Input].
    fn then(self, resume: closure[Env](Input) -> Option[Next])
        -> Sequence![Then![First![Task], closure[Env](Input) -> Option[Next], Input, Next, ()], Output] {
        self.then_owned_with(resume, |resume, input| resume(input), skip_copy[Env, Input, Next])
    }

    /// Starts a sequence and discards the state and any prior output if skipped.
    forall State, Next, Output, Env where PlanOutput[Next -> Output], Copy[Env], Discard[State], Discard[Input].
    fn then_owned(self, state: State, resume: closure[Env](State, Input) -> Option[Next])
        -> Sequence![Then![First![Task], State, Input, Next, Env], Output] {
        self.then_owned_with(state, resume, discard_owned[State, Option[Input]])
    }

    /// Starts a sequence with explicit cleanup for a skipped first handoff.
    forall State, Next, Output, Env where PlanOutput[Next -> Output], Copy[Env].
    fn then_owned_with(self, state: State, resume: closure[Env](State, Input) -> Option[Next],
        cancel: fn(State, Option[Input]) -> ()) -> Sequence![Then![First![Task], State, Input, Next, Env], Output] {
        let start: Sequence![First![Task], Input] = Sequence!.{ stages: First!.{ task: self } };
        start.then_owned_with(state, resume, cancel)
    }
}

forall Env, Input, Task where Copy[Env], Copy[Input].
fn skip_copy(resume: closure[Env](Input) -> Option[Task], input: Option[Input]) {}

forall Stages, Input.
impl Sequence![Stages, Input] {
    /// Uses the sequence as a child of a regular plan on a continuation driver.
    forall Driver where SequencePlan[Stages, Driver -> Input].
    fn into_plan(self) -> ChainPlan![SequenceOutcome[Input], Driver] {
        let { stages } = self;
        SequencePlan[Stages, Driver -> Input]::build(stages)
    }

    /// The callback and its input can both be dropped if the handoff is skipped.
    forall Env, Task, Output where PlanOutput[Task -> Output], Copy[Env], Copy[Input].
    fn then(self, resume: closure[Env](Input) -> Option[Task])
        -> Sequence![Then![Stages, closure[Env](Input) -> Option[Task], Input, Task, ()], Output] {
        self.then_owned_with(resume, |resume, input| resume(input), skip_copy[Env, Input, Task])
    }

    /// Adds a handoff and discards its state and any prior output if skipped.
    forall State, Task, Output, Env where PlanOutput[Task -> Output], Copy[Env], Discard[State], Discard[Input].
    fn then_owned(self, state: State, resume: closure[Env](State, Input) -> Option[Task])
        -> Sequence![Then![Stages, State, Input, Task, Env], Output] {
        self.then_owned_with(state, resume, discard_owned[State, Option[Input]])
    }

    /// Transfers state to resume after the prior stage joins. If the deadline
    /// prevents the handoff, cancel receives the state and any prior outcome.
    /// Resume can consume its inputs and return None to stop explicitly.
    /// Its captures must be copyable because cancellation can skip it.
    forall State, Task, Output, Env where PlanOutput[Task -> Output], Copy[Env].
    fn then_owned_with(self, state: State, resume: closure[Env](State, Input) -> Option[Task],
        cancel: fn(State, Option[Input]) -> ()) -> Sequence![Then![Stages, State, Input, Task, Env], Output] {
        let { stages } = self;
        Sequence!.{ stages: Then!.{ previous: stages, handoff: thunk::defer(state, resume, cancel) } }
    }
}

forall Stages, Driver -> Output.
trait SequencePlan { fn build(stages: Stages) -> ChainPlan![SequenceOutcome[Output], Driver]; }

forall Task, Driver, Output where PlanOutput[Task -> Output], Plan[Task, Driver -> Output].
instance SequencePlan[First![Task], Driver -> Output] {
    fn build(stages: First![Task]) -> ChainPlan![SequenceOutcome[Output], Driver] {
        let { task } = stages;
        erase(task.map(|output| SequenceOutcome::Finished.(output)))
    }
}

forall Previous, State, Input, Next, Output, Env, Driver where Copy[Env],
    ContinuationDriver[Driver], PlanDriver[Driver], SequencePlan[Previous, Driver -> Input],
    Plan[Next, Driver -> Output], PlanOutput[Next -> Output].
instance SequencePlan[Then![Previous, State, Input, Next, Env], Driver -> Output] {
    fn build(stages: Then![Previous, State, Input, Next, Env]) -> ChainPlan![SequenceOutcome[Output], Driver] {
        let { previous, handoff } = stages;
        let prior = SequencePlan[Previous, Driver -> Input]::build(previous);
        chain(prior, handoff, |handoff, input| resume_handoff[State, Input, Next, Output, Env](handoff, input),
            cancel_handoff[State, Input, Next, Output, Env], resolve_sequence[Output])
    }
}

forall State, Input, Next, Output, Env where Copy[Env], PlanOutput[Next -> Output].
fn resume_handoff(handoff: Thunk![State, Input, Option[Next], Env, fn(State, Option[Input]) -> ()],
    prior: SequenceOutcome[Input]) -> HandoffStep[Map![Next, Output, SequenceOutcome[Output], ()], SequenceOutcome[Output]] {
    match prior {
        Finished(input) => match handoff.resume(input) {
            Some(task) => HandoffStep::Start.(task.map(|output| SequenceOutcome::Finished.(output))),
            None => HandoffStep::Finish.(SequenceOutcome::Stopped),
        },
        Stopped => {
            handoff.discard_with(Option::None);
            HandoffStep::Finish.(SequenceOutcome::Stopped)
        },
        Cancelled => {
            handoff.discard_with(Option::None);
            HandoffStep::Finish.(SequenceOutcome::Cancelled)
        },
    }
}

forall State, Input, Next, Output, Env where Copy[Env].
fn cancel_handoff(handoff: Thunk![State, Input, Option[Next], Env, fn(State, Option[Input]) -> ()],
    prior: SequenceOutcome[Input]) -> SequenceOutcome[Output] {
    match prior {
        Finished(input) => { handoff.discard_with(Option::Some.(input)); SequenceOutcome::Cancelled },
        Stopped => { handoff.discard_with(Option::None); SequenceOutcome::Stopped },
        Cancelled => { handoff.discard_with(Option::None); SequenceOutcome::Cancelled },
    }
}

forall Output.
fn resolve_sequence(result: SequenceOutcome[Output], status: Resolution) -> SequenceOutcome[Output] { result }

forall Stages, Engine -> Output.
trait Chain {
    fn drive(stages: Stages, &engine: Engine, deadline: Option[Duration]) -> SequenceOutcome[StageResult[Output]];
}

forall Engine where Clock[Engine].
fn remaining_budget(&engine: Engine, deadline: Option[Duration]) -> Option[Duration] {
    match deadline {
        Some(end) => {
            let now = Clock[Engine]::now(&engine);
            Option::Some.(end.sub(now))
        },
        None => Option::None,
    }
}

forall Task, Output, Engine where StageDriver[Task, Engine -> Output].
instance Chain[First![Task], Engine -> Output] {
    fn drive(stages: First![Task], &engine: Engine, deadline: Option[Duration]) -> SequenceOutcome[StageResult[Output]] {
        let { task } = stages;
        SequenceOutcome::Finished.(StageDriver[Task, Engine -> Output]::drive(task, &engine, deadline))
    }
}

forall Previous, State, Input, Task, Env, Output, Engine
    where Copy[Env], Clock[Engine], Chain[Previous, Engine -> Input], StageDriver[Task, Engine -> Output].
instance Chain[Then![Previous, State, Input, Task, Env], Engine -> Output] {
    fn drive(stages: Then![Previous, State, Input, Task, Env], &engine: Engine, deadline: Option[Duration])
        -> SequenceOutcome[StageResult[Output]] {
        let { previous, handoff } = stages;
        let stage = match Chain[Previous, Engine -> Input]::drive(previous, &engine, deadline) {
            Finished(stage) => stage,
            Stopped => {
                handoff.discard_with(Option::None);
                return SequenceOutcome::Stopped;
            },
            Cancelled => {
                handoff.discard_with(Option::None);
                return SequenceOutcome::Cancelled;
            },
        };
        let { output: input, deadline_expired } = stage;
        let expired = deadline_expired || (match remaining_budget(&engine, deadline) {
            Some(duration) => duration.is_zero(),
            None => false,
        });
        if expired {
            handoff.discard_with(Option::Some.(input));
            return SequenceOutcome::Cancelled;
        }
        match handoff.resume(input) {
            Some(task) => SequenceOutcome::Finished.(StageDriver[Task, Engine -> Output]::drive(task, &engine, deadline)),
            None => SequenceOutcome::Stopped,
        }
    }
}

/// Drives the chain with one absolute deadline for all stages and handoffs.
forall Stages, Output, Engine where Chain[Stages, Engine -> Output].
fn drive_sequence_until(sequence: Sequence![Stages, Output], &engine: Engine, deadline: Option[Duration]) -> SequenceOutcome[Output] {
    let { stages } = sequence;
    match Chain[Stages, Engine -> Output]::drive(stages, &engine, deadline) {
        Finished(stage) => {
            let { output, deadline_expired } = stage;
            SequenceOutcome::Finished.(output)
        },
        Stopped => SequenceOutcome::Stopped,
        Cancelled => SequenceOutcome::Cancelled,
    }
}
