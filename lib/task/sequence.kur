//! Explicit sequential adapters. Engines drive one fully scoped stage at a time.
use package::PlanOutput;
use std::option::Option;

forall Engine.
trait Clock {
    fn now(&engine: Engine) -> u64;
}

forall Task, Engine -> Output.
trait StageDriver {
    /// Joins the stage and returns its outcome. The deadline uses the same
    /// clock as now, so preparation time also counts against the budget.
    fn drive(task: Task, &engine: Engine, deadline: Option[u64]) -> Output;
}

forall Task.
struct First! { task: Task }

/// A joined stage can still have an operation-level cancellation outcome.
/// Cancelled here means the enclosing lifetime prevents another stage.
forall Output.
exposed enum StageResult {
    Joined(Output),
    Stopped,
    Cancelled(Option[Output]),
}

forall Task.
enum NextStage { Start(Task), Stop, Cancel }

forall State, Input, Task, Env.
struct Handoff! {
    state: State,
    resume: closure[Env](State, Input) -> Option[Task],
    cancel: fn(State, Option[Input]) -> (),
}

forall State, Input, Task, Env where Copy[Env].
impl Handoff![State, Input, Task, Env] {
    fn advance(self, result: StageResult[Input]) -> NextStage[Task] {
        let { state, resume, cancel } = self;
        match result {
            StageResult::Joined(input) => match resume(state, input) {
                Option::Some(task) => NextStage::Start.(task),
                Option::None => NextStage::Stop,
            },
            StageResult::Stopped => {
                cancel(state, Option::None);
                NextStage::Stop
            },
            StageResult::Cancelled(prior) => {
                cancel(state, prior);
                NextStage::Cancel
            },
        }
    }
}

forall Previous, State, Input, Task, Env.
struct Then! { previous: Previous, handoff: Handoff![State, Input, Task, Env] }

/// The outcome type of the last stage in a sequence.
forall Stages -> Output.
trait SequenceOutput {}

forall Task, Output where PlanOutput[Task -> Output].
instance SequenceOutput[First![Task] -> Output] {}

forall Previous, State, Input, Task, Env, Output where PlanOutput[Task -> Output].
instance SequenceOutput[Then![Previous, State, Input, Task, Env] -> Output] {}

forall Stages.
struct Sequence! { stages: Stages }

forall Task.
fn sequence(task: Task) -> Sequence![First![Task]] {
    Sequence!.{ stages: First!.{ task } }
}

forall Env, Input, Task where Copy[Env], Copy[Input].
fn skip_copy(resume: closure[Env](Input) -> Option[Task], input: Option[Input]) {}

forall Stages.
impl Sequence![Stages] {
    /// The callback and its input can both be dropped if the handoff is skipped.
    forall Env, Input, Task where SequenceOutput[Stages -> Input], Copy[Env], Copy[Input].
    fn then(self, resume: closure[Env](Input) -> Option[Task])
        -> Sequence![Then![Stages, closure[Env](Input) -> Option[Task], Input, Task, ()]] {
        self.then_owned(resume, |resume, input| resume(input), skip_copy[Env, Input, Task])
    }

    /// Transfers state to resume after the prior stage joins. If the deadline
    /// prevents the handoff, cancel receives the state and any prior outcome.
    /// Resume can consume its inputs and return None to stop explicitly.
    /// Its captures must be copyable because cancellation can skip it.
    forall State, Input, Task, Env where SequenceOutput[Stages -> Input], Copy[Env].
    fn then_owned(self, state: State, resume: closure[Env](State, Input) -> Option[Task],
        cancel: fn(State, Option[Input]) -> ()) -> Sequence![Then![Stages, State, Input, Task, Env]] {
        let { stages } = self;
        Sequence!.{ stages: Then!.{ previous: stages, handoff: Handoff!.{ state, resume, cancel } } }
    }
}

forall Stages, Engine -> Output.
trait Chain {
    fn drive(stages: Stages, &engine: Engine, deadline: Option[u64]) -> StageResult[Output];
}

forall Engine where Clock[Engine].
fn remaining_budget(&engine: Engine, deadline: Option[u64]) -> Option[u64] {
    match deadline {
        Option::Some(end) => {
            let now = Clock[Engine]::now(&engine);
            Option::Some.(if now < end { end - now } else { 0u64 })
        },
        Option::None => Option::None,
    }
}

forall Task, Output, Engine where Clock[Engine], StageDriver[Task, Engine -> Output].
instance Chain[First![Task], Engine -> Output] {
    fn drive(stages: First![Task], &engine: Engine, deadline: Option[u64]) -> StageResult[Output] {
        let { task } = stages;
        StageResult::Joined.(StageDriver[Task, Engine -> Output]::drive(task, &engine, deadline))
    }
}

forall Previous, State, Input, Task, Env, Output, Engine
    where Copy[Env], Clock[Engine], Chain[Previous, Engine -> Input], StageDriver[Task, Engine -> Output].
instance Chain[Then![Previous, State, Input, Task, Env], Engine -> Output] {
    fn drive(stages: Then![Previous, State, Input, Task, Env], &engine: Engine, deadline: Option[u64]) -> StageResult[Output] {
        let { previous, handoff } = stages;
        let result = Chain[Previous, Engine -> Input]::drive(previous, &engine, deadline);
        let result = match result {
            StageResult::Joined(output) => {
                let expired = match remaining_budget(&engine, deadline) {
                    Option::Some(ms) => ms == 0u64,
                    Option::None => false,
                };
                if expired { StageResult::Cancelled.(Option::Some.(output)) }
                else { StageResult::Joined.(output) }
            },
            StageResult::Stopped => StageResult::Stopped,
            StageResult::Cancelled(prior) => StageResult::Cancelled.(prior),
        };
        match handoff.advance(result) {
            NextStage::Start(task) => StageResult::Joined.(StageDriver[Task, Engine -> Output]::drive(task, &engine, deadline)),
            NextStage::Stop => StageResult::Stopped,
            NextStage::Cancel => StageResult::Cancelled.(Option::None),
        }
    }
}

/// Owns one continuation for a hosted stage. The host consumes it by
/// resuming or cancelling after that stage has joined.
/// Uses one absolute deadline for the whole chain. None means the final
/// stage was never constructed. Otherwise it returns that stage's outcome.
forall Stages, Output, Engine where Clock[Engine], Chain[Stages, Engine -> Output].
fn drive_sequence(sequence: Sequence![Stages], &engine: Engine, budget: Option[u64]) -> Option[Output] {
    let { stages } = sequence;
    let deadline = match budget {
        Option::Some(ms) => {
            let now = Clock[Engine]::now(&engine);
            Option::Some.(if ms > u64::MAX - now { u64::MAX } else { now + ms })
        },
        Option::None => Option::None,
    };
    match Chain[Stages, Engine -> Output]::drive(stages, &engine, deadline) {
        StageResult::Joined(output) => Option::Some.(output),
        StageResult::Stopped => Option::None,
        StageResult::Cancelled(prior) => prior,
    }
}
