//! Explicit sequential adapters. Engines drive one fully scoped stage at a time.
use std::alloc::heap::HeapAllocator;
use std::mem::sizeof;
use std::option::Option;

forall Engine.
trait Clock {
    fn now(&engine: Engine) -> u64;
}

forall Task, Output, Engine.
trait StageDriver {
    /// Joins the stage and returns its outcome. The deadline uses the same
    /// clock as now, so preparation time also counts against the budget.
    fn drive(task: Task, &engine: Engine, deadline: Option[u64]) -> Output;
}

forall Task.
struct First! { task: Task }

forall State, Input, Task.
struct Handoff! {
    state: State,
    resume: fn(State, Input) -> Option[Task],
    cancel: fn(State, Option[Input]) -> (),
}

forall State, Input, Task.
impl Handoff![State, Input, Task] {
    fn resume(self, prior: Option[Input]) -> Option[Task] {
        let { state, resume, cancel } = self;
        match prior {
            Option::Some(input) => resume(state, input),
            Option::None => { cancel(state, Option::None); Option::None },
        }
    }

    fn cancel(self, prior: Option[Input]) {
        let { state, resume, cancel } = self;
        cancel(state, prior);
    }
}

forall Previous, State, Input, Task.
struct Then! { previous: Previous, handoff: Handoff![State, Input, Task] }

forall Stages.
struct Sequence! { stages: Stages }

forall Task.
fn sequence(task: Task) -> Sequence![First![Task]] {
    Sequence!.{ stages: First!.{ task } }
}

forall Stages.
impl Sequence![Stages] {
    /// Transfers state to resume after the prior stage joins. If the deadline
    /// prevents the handoff, cancel receives the state and any prior outcome.
    /// Resume can consume its inputs and return None to stop explicitly.
    forall State, Input, Task.
    fn then(self, state: State, resume: fn(State, Input) -> Option[Task],
        cancel: fn(State, Option[Input]) -> ()) -> Sequence![Then![Stages, State, Input, Task]] {
        let { stages } = self;
        Sequence!.{ stages: Then!.{ previous: stages, handoff: Handoff!.{ state, resume, cancel } } }
    }
}

forall Stages, Output, Engine.
trait Chain {
    fn drive(stages: Stages, &engine: Engine, deadline: Option[u64]) -> Option[Output];
}

forall Engine where Clock[Engine].
fn remaining_budget(&engine: Engine, deadline: Option[u64]) -> Option[u64] {
    match deadline {
        Option::Some(end) => {
            let now = Clock[Engine]::now(&engine);
            Option::Some.(if now < end { end - now } else { 0u64 })
        },
        Option::None => Option::None,
    }
}

forall Task, Output, Engine where Clock[Engine], StageDriver[Task, Output, Engine].
instance Chain[First![Task], Output, Engine] {
    fn drive(stages: First![Task], &engine: Engine, deadline: Option[u64]) -> Option[Output] {
        let { task } = stages;
        Option::Some.(StageDriver[Task, Output, Engine]::drive(task, &engine, deadline))
    }
}

forall Previous, State, Input, Task, Output, Engine
    where Clock[Engine], Chain[Previous, Input, Engine], StageDriver[Task, Output, Engine].
instance Chain[Then![Previous, State, Input, Task], Output, Engine] {
    fn drive(stages: Then![Previous, State, Input, Task], &engine: Engine, deadline: Option[u64]) -> Option[Output] {
        let { previous, handoff } = stages;
        let result = Chain[Previous, Input, Engine]::drive(previous, &engine, deadline);
        let budget = remaining_budget(&engine, deadline);
        let expired = match budget { Option::Some(ms) => ms == 0u64, Option::None => false, };
        if expired {
            handoff.cancel(result);
            return Option::None;
        }
        match handoff.resume(result) {
            Option::Some(next) => Option::Some.(StageDriver[Task, Output, Engine]::drive(next, &engine, deadline)),
            Option::None => Option::None,
        }
    }
}

/// Owns one continuation for a hosted stage. The host consumes it by
/// resuming or cancelling after that stage has joined.
forall Input, Action.
struct Continuation! {
    raw: *u8,
    resume: unsafe fn(*u8, Option[Input]) -> Action,
    cancel: unsafe fn(*u8, Option[Input]) -> (),
}

forall State, Input, Action.
struct ContinuationState! {
    state: State,
    resume: fn(State, Option[Input]) -> Action,
    cancel: fn(State, Option[Input]) -> (),
}

forall State, Input, Action.
fn continuation(state: State, resume: fn(State, Option[Input]) -> Action,
    cancel: fn(State, Option[Input]) -> ()) -> Continuation![Input, Action] {
    let raw = HeapAllocator::alloc(sizeof[ContinuationState![State, Input, Action]]()).into_raw();
    unsafe *(unsafe (raw as *ContinuationState![State, Input, Action])) =
        ContinuationState!.{ state, resume, cancel };
    Continuation!.{ raw, resume: resume_continuation[State, Input, Action],
        cancel: cancel_continuation[State, Input, Action] }
}

forall State, Input, Action.
unsafe fn reclaim(raw: *u8) -> ContinuationState![State, Input, Action] {
    let boxed = unsafe *(unsafe (raw as *ContinuationState![State, Input, Action]));
    HeapAllocator::drop(unsafe HeapAllocator::adopt_raw(raw));
    boxed
}

forall State, Input, Action.
unsafe fn resume_continuation(raw: *u8, prior: Option[Input]) -> Action {
    let { state, resume, cancel } = unsafe reclaim[State, Input, Action](raw);
    resume(state, prior)
}

forall State, Input, Action.
unsafe fn cancel_continuation(raw: *u8, prior: Option[Input]) {
    let { state, resume, cancel } = unsafe reclaim[State, Input, Action](raw);
    cancel(state, prior);
}

forall Input, Action.
impl Continuation![Input, Action] {
    fn resume(self, prior: Option[Input]) -> Action {
        let { raw, resume, cancel } = self;
        unsafe resume(raw, prior)
    }

    fn cancel(self, prior: Option[Input]) {
        let { raw, resume, cancel } = self;
        unsafe cancel(raw, prior);
    }
}

/// Hosts schedule one plan at a time under the same enclosing lifetime.
forall Task, Output, Host, Action.
trait StageHost {
    fn schedule(task: Task, next: Continuation![Output, Action]) -> Action;
}

forall Stages, Output, Host, Action.
trait HostedChain {
    fn schedule(stages: Stages, next: Continuation![Output, Action]) -> Action;
}

forall Task, Output, Host, Action where StageHost[Task, Output, Host, Action].
instance HostedChain[First![Task], Output, Host, Action] {
    fn schedule(stages: First![Task], next: Continuation![Output, Action]) -> Action {
        let { task } = stages;
        StageHost[Task, Output, Host, Action]::schedule(task, next)
    }
}

forall State, Input, Task, Output, Action.
struct Next! { handoff: Handoff![State, Input, Task], tail: Continuation![Output, Action] }

forall State, Input, Task, Output, Host, Action where StageHost[Task, Output, Host, Action].
fn resume_next(next: Next![State, Input, Task, Output, Action], prior: Option[Input]) -> Action {
    let { handoff, tail } = next;
    match handoff.resume(prior) {
        Option::Some(task) => StageHost[Task, Output, Host, Action]::schedule(task, tail),
        Option::None => tail.resume(Option::None),
    }
}

forall State, Input, Task, Output, Action.
fn cancel_next(next: Next![State, Input, Task, Output, Action], prior: Option[Input]) {
    let { handoff, tail } = next;
    handoff.cancel(prior);
    tail.cancel(Option::None);
}

forall Previous, State, Input, Task, Output, Host, Action
    where HostedChain[Previous, Input, Host, Action], StageHost[Task, Output, Host, Action].
instance HostedChain[Then![Previous, State, Input, Task], Output, Host, Action] {
    fn schedule(stages: Then![Previous, State, Input, Task], next: Continuation![Output, Action]) -> Action {
        let { previous, handoff } = stages;
        let link = Next!.{ handoff, tail: next };
        let next = continuation(link, resume_next[State, Input, Task, Output, Host, Action],
            cancel_next[State, Input, Task, Output, Action]);
        HostedChain[Previous, Input, Host, Action]::schedule(previous, next)
    }
}

forall Stages, Output, Host, Action where HostedChain[Stages, Output, Host, Action].
fn host_sequence(plan: Sequence![Stages], next: Continuation![Output, Action]) -> Action {
    let { stages } = plan;
    HostedChain[Stages, Output, Host, Action]::schedule(stages, next)
}

/// Uses one absolute deadline for the whole chain. None means the final
/// stage was never constructed. Otherwise it returns that stage's outcome.
forall Stages, Output, Engine where Clock[Engine], Chain[Stages, Output, Engine].
fn drive_sequence(sequence: Sequence![Stages], &engine: Engine, budget: Option[u64]) -> Option[Output] {
    let { stages } = sequence;
    let deadline = match budget {
        Option::Some(ms) => {
            let now = Clock[Engine]::now(&engine);
            Option::Some.(if ms > u64::MAX - now { u64::MAX } else { now + ms })
        },
        Option::None => Option::None,
    };
    Chain[Stages, Output, Engine]::drive(stages, &engine, deadline)
}
