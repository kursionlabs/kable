//! Owned task plans and outcomes. Drivers supply primitive operations.
use package::scope::{Branch, ScopeState!};

export Branch;
export ScopeState!;

forall Driver.
trait PlanDriver {
    fn timer(&scope: Driver, ms: u64) -> usize;
    fn pair(&scope: Driver, kind: Branch, first: usize, second: usize) -> usize;
    /// Reads the next result in staging order after the engine has joined.
    /// Zero means cancelled, one means ready or first, and two means second.
    /// Negative codes report engine or staging failures.
    fn next(&scope: Driver) -> i32;
}

forall Task, Output, Driver.
trait Plan {
    fn stage(&task: Task, &scope: Driver) -> usize;
    fn collect(task: Task, &scope: Driver) -> Output;
}

forall T.
struct Sleep! { ms: u64, value: T }

forall T.
fn sleep(ms: u64, value: T) -> Sleep![T] { Sleep!.{ ms, value } }

forall First, Second.
struct Select! { first: First, second: Second }

/// Starts both plans and selects the first to complete, including a plan
/// whose operation reports an error. The losing plan is cancelled and joined.
forall First, Second.
fn select(first: First, second: Second) -> Select![First, Second] { Select!.{ first, second } }

forall First, Second.
struct Join! { first: First, second: Second }

/// Starts both plans in the same scope and waits for both to complete.
forall First, Second.
fn join(first: First, second: Second) -> Join![First, Second] { Join!.{ first, second } }

forall T.
exposed enum Outcome {
    Ready(T),
    Cancelled(T),
    Failed(T, i32),
}

/// Each branch returns both values in input order after the scope closes.
forall A, B.
exposed enum RaceOutcome {
    First(A, B),
    Second(A, B),
    Cancelled(A, B),
    Failed(A, B, i32),
}

/// Each branch carries both child outcomes, including children that completed
/// before a cancellation.
forall A, B.
exposed enum JoinOutcome {
    Ready(A, B),
    Cancelled(A, B),
    Failed(A, B, i32),
}

forall T, Driver where PlanDriver[Driver].
instance Plan[Sleep![T], Outcome[T], Driver] {
    fn stage(&task: Sleep![T], &scope: Driver) -> usize {
        let { ms, value } = task;
        let id = PlanDriver[Driver]::timer(&scope, ms);
        task = Sleep!.{ ms, value };
        id
    }

    fn collect(task: Sleep![T], &scope: Driver) -> Outcome[T] {
        let { ms, value } = task;
        let code = PlanDriver[Driver]::next(&scope);
        match code {
            1i32 => Outcome::Ready.(value),
            0i32 => Outcome::Cancelled.(value),
            _ => Outcome::Failed.(value, code),
        }
    }
}

forall First, Second, A, B, Driver where PlanDriver[Driver], Plan[First, A, Driver], Plan[Second, B, Driver].
fn stage_pair(&first: First, &second: Second, &scope: Driver, kind: Branch) -> usize {
    let a = Plan[First, A, Driver]::stage(&first, &scope);
    let b = Plan[Second, B, Driver]::stage(&second, &scope);
    PlanDriver[Driver]::pair(&scope, kind, a, b)
}

forall First, Second, A, B, Driver where PlanDriver[Driver], Plan[First, A, Driver], Plan[Second, B, Driver].
fn collect_pair(first: First, second: Second, &scope: Driver) -> (A, B, i32) {
    let a = Plan[First, A, Driver]::collect(first, &scope);
    let b = Plan[Second, B, Driver]::collect(second, &scope);
    let code = PlanDriver[Driver]::next(&scope);
    (a, b, code)
}

forall First, Second, A, B, Driver where PlanDriver[Driver], Plan[First, A, Driver], Plan[Second, B, Driver].
instance Plan[Select![First, Second], RaceOutcome[A, B], Driver] {
    fn stage(&task: Select![First, Second], &scope: Driver) -> usize {
        let { first, second } = task;
        let id = stage_pair[First, Second, A, B, Driver](&first, &second, &scope, Branch::Select);
        task = Select!.{ first, second };
        id
    }

    fn collect(task: Select![First, Second], &scope: Driver) -> RaceOutcome[A, B] {
        let { first, second } = task;
        let (a, b, code) = collect_pair[First, Second, A, B, Driver](first, second, &scope);
        race_outcome(a, b, code)
    }
}

forall A, B.
fn race_outcome(a: A, b: B, code: i32) -> RaceOutcome[A, B] {
    match code {
        1i32 => RaceOutcome::First.(a, b),
        2i32 => RaceOutcome::Second.(a, b),
        0i32 => RaceOutcome::Cancelled.(a, b),
        _ => RaceOutcome::Failed.(a, b, code),
    }
}

forall First, Second, A, B, Driver where PlanDriver[Driver], Plan[First, A, Driver], Plan[Second, B, Driver].
instance Plan[Join![First, Second], JoinOutcome[A, B], Driver] {
    fn stage(&task: Join![First, Second], &scope: Driver) -> usize {
        let { first, second } = task;
        let id = stage_pair[First, Second, A, B, Driver](&first, &second, &scope, Branch::Join);
        task = Join!.{ first, second };
        id
    }

    fn collect(task: Join![First, Second], &scope: Driver) -> JoinOutcome[A, B] {
        let { first, second } = task;
        let (a, b, code) = collect_pair[First, Second, A, B, Driver](first, second, &scope);
        match code {
            1i32 => JoinOutcome::Ready.(a, b),
            0i32 => JoinOutcome::Cancelled.(a, b),
            _ => JoinOutcome::Failed.(a, b, code),
        }
    }
}

use package::sequence::{Chain, Clock, Continuation!, HostedChain, Sequence!, StageDriver, StageHost,
    continuation, drive_sequence, host_sequence, remaining_budget, sequence};

export Chain;
export Clock;
export Continuation!;
export HostedChain;
export Sequence!;
export StageDriver;
export StageHost;
export continuation;
export drive_sequence;
export host_sequence;
export remaining_budget;
export sequence;

forall Task, Input, Output, Env.
struct Map! { task: Task, transform: closure[Env](Input) -> Output }

/// Transforms the outcome after the scope joins. The closure runs once,
/// including for a cancelled or failed outcome, and may own captured values.
forall Task, Input, Output, Env.
fn map(task: Task, transform: closure[Env](Input) -> Output) -> Map![Task, Input, Output, Env] {
    Map!.{ task, transform }
}

forall Task, Input, Output, Env, Driver where Plan[Task, Input, Driver].
instance Plan[Map![Task, Input, Output, Env], Output, Driver] {
    fn stage(&task: Map![Task, Input, Output, Env], &scope: Driver) -> usize {
        let { task: inner, transform } = task;
        let id = Plan[Task, Input, Driver]::stage(&inner, &scope);
        task = Map!.{ task: inner, transform };
        id
    }

    fn collect(task: Map![Task, Input, Output, Env], &scope: Driver) -> Output {
        let { task, transform } = task;
        transform(Plan[Task, Input, Driver]::collect(task, &scope))
    }
}

/// Selects the first timer and returns both payloads after they have joined.
forall A, B.
fn race(first: Sleep![A], second: Sleep![B])
    -> Map![Select![Sleep![A], Sleep![B]], RaceOutcome[Outcome[A], Outcome[B]], RaceOutcome[A, B], ()] {
    map(select(first, second), |result: RaceOutcome[Outcome[A], Outcome[B]]| match result {
        RaceOutcome::First(a, b) => RaceOutcome::First.(sleep_value(a), sleep_value(b)),
        RaceOutcome::Second(a, b) => RaceOutcome::Second.(sleep_value(a), sleep_value(b)),
        RaceOutcome::Cancelled(a, b) => RaceOutcome::Cancelled.(sleep_value(a), sleep_value(b)),
        RaceOutcome::Failed(a, b, code) => RaceOutcome::Failed.(sleep_value(a), sleep_value(b), code),
    })
}

forall T.
fn sleep_value(outcome: Outcome[T]) -> T {
    match outcome {
        Outcome::Ready(value) => value,
        Outcome::Cancelled(value) => value,
        Outcome::Failed(value, code) => value,
    }
}

forall Task.
struct Within! { selection: Select![Sleep![()], Task] }

/// Races a plan against a local timer. The outcome includes the inner
/// plan's result after it and the timer have joined.
forall Task.
fn within(ms: u64, task: Task) -> Within![Task] { Within!.{ selection: select(sleep(ms, ()), task) } }

forall Output.
exposed enum WithinOutcome {
    Completed(Output),
    TimedOut(Output),
    Cancelled(Output),
    Failed(Output, i32),
}

forall Task, Output, Driver where PlanDriver[Driver], Plan[Task, Output, Driver].
instance Plan[Within![Task], WithinOutcome[Output], Driver] {
    fn stage(&task: Within![Task], &scope: Driver) -> usize {
        let { selection: { first, second } } = task;
        let id = stage_pair[Sleep![()], Task, Outcome[()], Output, Driver](
            &first, &second, &scope, Branch::Select);
        task = Within!.{ selection: select(first, second) };
        id
    }

    fn collect(task: Within![Task], &scope: Driver) -> WithinOutcome[Output] {
        let { selection: { first, second } } = task;
        let (timer, outcome, code) = collect_pair[Sleep![()], Task, Outcome[()], Output, Driver](
            first, second, &scope);
        match race_outcome(timer, outcome, code) {
            RaceOutcome::First(timer, outcome) => WithinOutcome::TimedOut.(outcome),
            RaceOutcome::Second(timer, outcome) => WithinOutcome::Completed.(outcome),
            RaceOutcome::Cancelled(timer, outcome) => WithinOutcome::Cancelled.(outcome),
            RaceOutcome::Failed(timer, outcome, code) => WithinOutcome::Failed.(outcome, code),
        }
    }
}
