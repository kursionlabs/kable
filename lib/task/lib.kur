//! Owned task plans and outcomes. Drivers supply primitive operations.
use std::fmt::{Format, Writable, write_i64};
use std::option::Option;
use std::time::Duration;
use package::{driver, sequence};
export driver;
export sequence;
use package::driver::{Pair, PairKind, Plan, PlanDriver, Resolution};

/// The outcome a plan exposes independently of where it runs.
forall Task -> Output.
trait PlanOutput {}

/// Why a plan failed. Drivers preserve their native codes for startup and I/O.
exposed enum Failure {
    NotStarted,
    InvalidPlan,
    InvalidResult,
    Startup(i32),
    Operation(i32),
}

forall W where Writable[W].
instance Format[Failure, W] {
    fn format(value: Failure, out: W) -> (Failure, W) {
        let out = match value {
            Failure::NotStarted => Writable[W]::write_static(out, "scope never started"),
            Failure::InvalidPlan => Writable[W]::write_static(out, "invalid scope plan"),
            Failure::InvalidResult => Writable[W]::write_static(out, "invalid scope result"),
            Failure::Startup(code) => write_i64(Writable[W]::write_static(out, "startup error "), code as i64),
            Failure::Operation(code) => write_i64(Writable[W]::write_static(out, "operation error "), code as i64),
        };
        (value, out)
    }
}

/// The value an operation produces on success, or the reason it stopped.
forall T.
exposed enum Completion {
    Ready(T),
    Cancelled,
    Failed(Failure),
}

/// A source that builds a one-shot plan for its next item.
/// The plan returns (Source, StreamOutcome![Item]) after joining.
forall Source -> Next.
trait Stream {
    fn next(source: Source) -> Next;
}

/// A sequential writer that builds a one-shot plan for an owned item.
/// The joined plan returns (Writer, Item, Completion[()]) on every path.
/// Ready means the writer accepted the whole item.
forall Writer -> Item, Write.
trait Sink {
    fn write(writer: Writer, item: Item) -> Write;
}

/// The result of one pull. The plan returns the owned source alongside it.
forall Item.
exposed enum StreamOutcome! {
    Item(Item),
    End,
    Cancelled,
    Failed(Failure),
}

forall T.
struct Sleep! { duration: Duration, value: T, id: Option[usize] }

/// Returns the original value alongside the timer status after the scope joins.
forall T.
fn sleep(duration: Duration, value: T) -> Sleep![T] { Sleep!.{ duration, value, id: Option::None } }

forall First, Second.
struct Select! { first: First, second: Second, id: Option[usize] }

/// Starts both plans and selects the first to complete, including a plan
/// whose operation reports an error. The losing plan is cancelled and joined.
forall First, Second.
fn select(first: First, second: Second) -> Select![First, Second] { Select!.{ first, second, id: Option::None } }

forall First, Second.
struct Join! { first: First, second: Second, id: Option[usize] }

/// Returns both child outputs in input order alongside the join status,
/// including when the scope is cancelled or fails.
forall First, Second.
fn join(first: First, second: Second) -> Join![First, Second] { Join!.{ first, second, id: Option::None } }

/// The input that finished first in a selection.
exposed enum Side { First, Second }

forall T.
instance PlanOutput[Sleep![T] -> (T, Completion[()])] {}

forall First, Second, A, B where PlanOutput[First -> A], PlanOutput[Second -> B].
instance PlanOutput[Select![First, Second] -> (A, B, Completion[Side])] {}

forall First, Second, A, B where PlanOutput[First -> A], PlanOutput[Second -> B].
instance PlanOutput[Join![First, Second] -> (A, B, Completion[()])] {}

fn completion(result: Resolution) -> Completion[()] {
    match result {
        Resolution::Completed => Completion::Ready.(()),
        Resolution::Cancelled => Completion::Cancelled,
        Resolution::Failed(failure) => Completion::Failed.(failure),
        Resolution::First | Resolution::Second => Completion::Failed.(Failure::InvalidResult),
    }
}

forall T, Driver where PlanDriver[Driver].
instance Plan[Sleep![T], Driver -> (T, Completion[()])] {
    fn stage(&task: Sleep![T], &scope: Driver) -> Option[usize] {
        let { duration, value, id } = task;
        let id = PlanDriver[Driver]::timer(&scope, duration);
        task = Sleep!.{ duration, value, id };
        id
    }

    fn collect(task: Sleep![T], &scope: Driver) -> (T, Completion[()]) {
        let { duration, value, id } = task;
        (value, completion(PlanDriver[Driver]::result(&scope, id)))
    }
}

forall First, Second, A, B, Driver where PlanDriver[Driver], Plan[First, Driver -> A], Plan[Second, Driver -> B].
fn stage_pair(&first: First, &second: Second, &scope: Driver, kind: PairKind) -> Option[usize] {
    let a = Plan[First, Driver -> A]::stage(&first, &scope);
    let b = Plan[Second, Driver -> B]::stage(&second, &scope);
    PlanDriver[Driver]::pair(&scope, Pair.{ kind, first: a?, second: b? })
}

forall First, Second, A, B, Driver where PlanDriver[Driver], Plan[First, Driver -> A], Plan[Second, Driver -> B].
fn collect_pair(first: First, second: Second, &scope: Driver, id: Option[usize]) -> (A, B, Resolution) {
    let a = Plan[First, Driver -> A]::collect(first, &scope);
    let b = Plan[Second, Driver -> B]::collect(second, &scope);
    let result = PlanDriver[Driver]::result(&scope, id);
    (a, b, result)
}

forall First, Second, A, B, Driver where PlanDriver[Driver], Plan[First, Driver -> A], Plan[Second, Driver -> B].
instance Plan[Select![First, Second], Driver -> (A, B, Completion[Side])] {
    fn stage(&task: Select![First, Second], &scope: Driver) -> Option[usize] {
        let { first, second, id } = task;
        let id = stage_pair[First, Second, A, B, Driver](&first, &second, &scope, PairKind::Select);
        task = Select!.{ first, second, id };
        id
    }

    fn collect(task: Select![First, Second], &scope: Driver) -> (A, B, Completion[Side]) {
        let { first, second, id } = task;
        let (a, b, result) = collect_pair[First, Second, A, B, Driver](first, second, &scope, id);
        let status = match result {
            Resolution::First => Completion::Ready.(Side::First),
            Resolution::Second => Completion::Ready.(Side::Second),
            Resolution::Cancelled => Completion::Cancelled,
            Resolution::Failed(failure) => Completion::Failed.(failure),
            Resolution::Completed => Completion::Failed.(Failure::InvalidResult),
        };
        (a, b, status)
    }
}

forall First, Second, A, B, Driver where PlanDriver[Driver], Plan[First, Driver -> A], Plan[Second, Driver -> B].
instance Plan[Join![First, Second], Driver -> (A, B, Completion[()])] {
    fn stage(&task: Join![First, Second], &scope: Driver) -> Option[usize] {
        let { first, second, id } = task;
        let id = stage_pair[First, Second, A, B, Driver](&first, &second, &scope, PairKind::Join);
        task = Join!.{ first, second, id };
        id
    }

    fn collect(task: Join![First, Second], &scope: Driver) -> (A, B, Completion[()]) {
        let { first, second, id } = task;
        let (a, b, result) = collect_pair[First, Second, A, B, Driver](first, second, &scope, id);
        (a, b, completion(result))
    }
}

forall Task, Input, Output, Env.
struct Map! { task: Task, transform: closure[Env](Input) -> Output }

forall Task, Input, Output, Env where PlanOutput[Task -> Input].
instance PlanOutput[Map![Task, Input, Output, Env] -> Output] {}

forall Task, Input where PlanOutput[Task -> Input].
impl Task {
    /// Transforms the joined outcome, including on cancellation or failure.
    /// The closure runs once and can own captured values.
    forall Env, Mapped.
    fn map(self, transform: closure[Env](Input) -> Mapped) -> Map![Task, Input, Mapped, Env] {
        Map!.{ task: self, transform }
    }

    /// Races this plan against a local timer and returns the outcome after both join.
    fn within(self, duration: Duration)
        -> Map![Select![Sleep![()], Task], (((), Completion[()]), Input, Completion[Side]), (Input, DeadlineStatus), ()] {
        select(sleep(duration, ()), self).map(|result| {
            let ((unit, timer_status), outcome, status) = result;
            let deadline = match status {
                Completion::Ready(side) => match side {
                    Side::First => match timer_status {
                        Completion::Ready => DeadlineStatus::TimedOut,
                        Completion::Failed(failure) => DeadlineStatus::Failed.(failure),
                        Completion::Cancelled => DeadlineStatus::Failed.(Failure::InvalidResult),
                    },
                    Side::Second => DeadlineStatus::Completed,
                },
                Completion::Cancelled => DeadlineStatus::Cancelled,
                Completion::Failed(failure) => DeadlineStatus::Failed.(failure),
            };
            (outcome, deadline)
        })
    }
}

forall Task, Input, Output, Env, Driver where Plan[Task, Driver -> Input].
instance Plan[Map![Task, Input, Output, Env], Driver -> Output] {
    fn stage(&task: Map![Task, Input, Output, Env], &scope: Driver) -> Option[usize] {
        let { task: inner, transform } = task;
        let id = Plan[Task, Driver -> Input]::stage(&inner, &scope);
        task = Map!.{ task: inner, transform };
        id
    }

    fn collect(task: Map![Task, Input, Output, Env], &scope: Driver) -> Output {
        let { task, transform } = task;
        transform(Plan[Task, Driver -> Input]::collect(task, &scope))
    }
}

/// Reports how the local deadline race ended after the inner plan joined.
exposed enum DeadlineStatus {
    Completed,
    TimedOut,
    Cancelled,
    Failed(Failure),
}
