//! Owned task plans and outcomes. Drivers supply primitive operations.
use std::option::Option;
use package::scope::{Branch, Resolution, ScopeState!};

export Branch;
export Resolution;
export ScopeState!;

forall Driver.
trait PlanDriver {
    fn timer(&scope: Driver, ms: u64) -> Option[usize];
    fn pair(&scope: Driver, kind: Branch, first: usize, second: usize) -> Option[usize];
    /// Gets a node's result after the engine has joined.
    /// An absent ID reports staging failure.
    fn result(&scope: Driver, id: Option[usize]) -> Resolution;
}

/// The outcome a plan exposes independently of where it runs.
forall Task -> Output.
trait PlanOutput {}

/// Stages and collects a plan on a driver that supports it.
forall Task, Driver -> Output.
trait Plan {
    /// Registers this plan and returns its root if staging succeeded.
    fn stage(&task: Task, &scope: Driver) -> Option[usize];
    /// Consumes the plan and recovers its outcome, including after staging failure.
    fn collect(task: Task, &scope: Driver) -> Output;
}

forall T.
struct Sleep! { ms: u64, value: T, id: Option[usize] }

forall T.
fn sleep(ms: u64, value: T) -> Sleep![T] { Sleep!.{ ms, value, id: Option::None } }

forall First, Second.
struct Select! { first: First, second: Second, id: Option[usize] }

/// Starts both plans and selects the first to complete, including a plan
/// whose operation reports an error. The losing plan is cancelled and joined.
forall First, Second.
fn select(first: First, second: Second) -> Select![First, Second] { Select!.{ first, second, id: Option::None } }

forall First, Second.
struct Join! { first: First, second: Second, id: Option[usize] }

/// Starts both plans in the same scope and waits for both to complete.
forall First, Second.
fn join(first: First, second: Second) -> Join![First, Second] { Join!.{ first, second, id: Option::None } }

forall T.
exposed enum Outcome {
    Ready(T),
    Cancelled(T),
    Failed(T, i32),
}

/// Each branch returns both values in input order after the scope closes.
forall A, B.
exposed enum RaceOutcome {
    First(A, B),
    Second(A, B),
    Cancelled(A, B),
    Failed(A, B, i32),
}

/// Each branch carries both child outcomes, including children that completed
/// before a cancellation.
forall A, B.
exposed enum JoinOutcome {
    Ready(A, B),
    Cancelled(A, B),
    Failed(A, B, i32),
}

forall T.
instance PlanOutput[Sleep![T] -> Outcome[T]] {}

forall First, Second, A, B where PlanOutput[First -> A], PlanOutput[Second -> B].
instance PlanOutput[Select![First, Second] -> RaceOutcome[A, B]] {}

forall First, Second, A, B where PlanOutput[First -> A], PlanOutput[Second -> B].
instance PlanOutput[Join![First, Second] -> JoinOutcome[A, B]] {}

forall T, Driver where PlanDriver[Driver].
instance Plan[Sleep![T], Driver -> Outcome[T]] {
    fn stage(&task: Sleep![T], &scope: Driver) -> Option[usize] {
        let { ms, value, id } = task;
        let id = PlanDriver[Driver]::timer(&scope, ms);
        task = Sleep!.{ ms, value, id };
        id
    }

    fn collect(task: Sleep![T], &scope: Driver) -> Outcome[T] {
        let { ms, value, id } = task;
        match PlanDriver[Driver]::result(&scope, id) {
            Resolution::Completed => Outcome::Ready.(value),
            Resolution::Cancelled => Outcome::Cancelled.(value),
            Resolution::Failed(code) => Outcome::Failed.(value, code),
            Resolution::First | Resolution::Second => Outcome::Failed.(value, -1i32),
        }
    }
}

forall First, Second, A, B, Driver where PlanDriver[Driver], Plan[First, Driver -> A], Plan[Second, Driver -> B].
fn stage_pair(&first: First, &second: Second, &scope: Driver, kind: Branch) -> Option[usize] {
    let a = Plan[First, Driver -> A]::stage(&first, &scope);
    let b = Plan[Second, Driver -> B]::stage(&second, &scope);
    PlanDriver[Driver]::pair(&scope, kind, a?, b?)
}

forall First, Second, A, B, Driver where PlanDriver[Driver], Plan[First, Driver -> A], Plan[Second, Driver -> B].
fn collect_pair(first: First, second: Second, &scope: Driver, id: Option[usize]) -> (A, B, Resolution) {
    let a = Plan[First, Driver -> A]::collect(first, &scope);
    let b = Plan[Second, Driver -> B]::collect(second, &scope);
    let result = PlanDriver[Driver]::result(&scope, id);
    (a, b, result)
}

forall First, Second, A, B, Driver where PlanDriver[Driver], Plan[First, Driver -> A], Plan[Second, Driver -> B].
instance Plan[Select![First, Second], Driver -> RaceOutcome[A, B]] {
    fn stage(&task: Select![First, Second], &scope: Driver) -> Option[usize] {
        let { first, second, id } = task;
        let id = stage_pair[First, Second, A, B, Driver](&first, &second, &scope, Branch::Select);
        task = Select!.{ first, second, id };
        id
    }

    fn collect(task: Select![First, Second], &scope: Driver) -> RaceOutcome[A, B] {
        let { first, second, id } = task;
        let (a, b, result) = collect_pair[First, Second, A, B, Driver](first, second, &scope, id);
        match result {
            Resolution::First => RaceOutcome::First.(a, b),
            Resolution::Second => RaceOutcome::Second.(a, b),
            Resolution::Cancelled => RaceOutcome::Cancelled.(a, b),
            Resolution::Failed(code) => RaceOutcome::Failed.(a, b, code),
            Resolution::Completed => RaceOutcome::Failed.(a, b, -1i32),
        }
    }
}

forall First, Second, A, B, Driver where PlanDriver[Driver], Plan[First, Driver -> A], Plan[Second, Driver -> B].
instance Plan[Join![First, Second], Driver -> JoinOutcome[A, B]] {
    fn stage(&task: Join![First, Second], &scope: Driver) -> Option[usize] {
        let { first, second, id } = task;
        let id = stage_pair[First, Second, A, B, Driver](&first, &second, &scope, Branch::Join);
        task = Join!.{ first, second, id };
        id
    }

    fn collect(task: Join![First, Second], &scope: Driver) -> JoinOutcome[A, B] {
        let { first, second, id } = task;
        let (a, b, result) = collect_pair[First, Second, A, B, Driver](first, second, &scope, id);
        match result {
            Resolution::Completed => JoinOutcome::Ready.(a, b),
            Resolution::Cancelled => JoinOutcome::Cancelled.(a, b),
            Resolution::Failed(code) => JoinOutcome::Failed.(a, b, code),
            Resolution::First | Resolution::Second => JoinOutcome::Failed.(a, b, -1i32),
        }
    }
}

use package::sequence::{Chain, Clock, Continuation!, HostedChain, Sequence!, SequenceOutput, StageDriver, StageHost, StageResult,
    continuation, drive_sequence, host_sequence, remaining_budget, sequence};

export Chain;
export Clock;
export Continuation!;
export HostedChain;
export Sequence!;
export SequenceOutput;
export StageDriver;
export StageHost;
export StageResult;
export continuation;
export drive_sequence;
export host_sequence;
export remaining_budget;
export sequence;

forall Task, Input, Output, Env.
struct Map! { task: Task, transform: closure[Env](Input) -> Output }

/// Transforms the outcome after the scope joins. The closure runs once,
/// including for a cancelled or failed outcome, and may own captured values.
forall Task, Input, Output, Env where PlanOutput[Task -> Input].
fn map(task: Task, transform: closure[Env](Input) -> Output) -> Map![Task, Input, Output, Env] {
    Map!.{ task, transform }
}

forall Task, Input, Output, Env where PlanOutput[Task -> Input].
instance PlanOutput[Map![Task, Input, Output, Env] -> Output] {}

forall Task, Input where PlanOutput[Task -> Input].
impl Task {
    /// Transforms the outcome once after this plan has joined.
    forall Env, Mapped.
    fn map(self, transform: closure[Env](Input) -> Mapped) -> Map![Task, Input, Mapped, Env] {
        map(self, transform)
    }

    /// Gives this plan a local deadline in milliseconds.
    fn within(self, ms: u64)
        -> Map![Select![Sleep![()], Task], RaceOutcome[Outcome[()], Input], WithinOutcome[Input], ()] {
        within(ms, self)
    }
}

forall Task, Input, Output, Env, Driver where Plan[Task, Driver -> Input].
instance Plan[Map![Task, Input, Output, Env], Driver -> Output] {
    fn stage(&task: Map![Task, Input, Output, Env], &scope: Driver) -> Option[usize] {
        let { task: inner, transform } = task;
        let id = Plan[Task, Driver -> Input]::stage(&inner, &scope);
        task = Map!.{ task: inner, transform };
        id
    }

    fn collect(task: Map![Task, Input, Output, Env], &scope: Driver) -> Output {
        let { task, transform } = task;
        transform(Plan[Task, Driver -> Input]::collect(task, &scope))
    }
}

/// Selects the first timer and returns both payloads after they have joined.
forall A, B.
fn race(first: Sleep![A], second: Sleep![B])
    -> Map![Select![Sleep![A], Sleep![B]], RaceOutcome[Outcome[A], Outcome[B]], RaceOutcome[A, B], ()] {
    map(select(first, second), |result: RaceOutcome[Outcome[A], Outcome[B]]| match result {
        RaceOutcome::First(a, b) => RaceOutcome::First.(sleep_value(a), sleep_value(b)),
        RaceOutcome::Second(a, b) => RaceOutcome::Second.(sleep_value(a), sleep_value(b)),
        RaceOutcome::Cancelled(a, b) => RaceOutcome::Cancelled.(sleep_value(a), sleep_value(b)),
        RaceOutcome::Failed(a, b, code) => RaceOutcome::Failed.(sleep_value(a), sleep_value(b), code),
    })
}

forall T.
fn sleep_value(outcome: Outcome[T]) -> T {
    match outcome {
        Outcome::Ready(value) => value,
        Outcome::Cancelled(value) => value,
        Outcome::Failed(value, code) => value,
    }
}

forall Output.
exposed enum WithinOutcome {
    Completed(Output),
    TimedOut(Output),
    Cancelled(Output),
    Failed(Output, i32),
}

/// Races a plan against a local timer and returns its outcome after both join.
forall Task, Output where PlanOutput[Task -> Output].
fn within(ms: u64, task: Task)
    -> Map![Select![Sleep![()], Task], RaceOutcome[Outcome[()], Output], WithinOutcome[Output], ()] {
    map(select(sleep(ms, ()), task), |result| match result {
        RaceOutcome::First(timer, outcome) => WithinOutcome::TimedOut.(outcome),
        RaceOutcome::Second(timer, outcome) => WithinOutcome::Completed.(outcome),
        RaceOutcome::Cancelled(timer, outcome) => WithinOutcome::Cancelled.(outcome),
        RaceOutcome::Failed(timer, outcome, code) => WithinOutcome::Failed.(outcome, code),
    })
}
