//! Staging and collection for task drivers.
use std::option::Option;
use std::time::Duration;
use package::{Completion, Failure, PlanOutput};
use package::scope::{Branch, Pair, PairKind, Resolution, Resource, ScopeState!};

export Branch;
export Pair;
export PairKind;
export Resolution;
export Resource;
export ScopeState!;

impl Resolution {
    /// Converts a leaf or join resolution into its completion status.
    fn completion(self) -> Completion[()] {
        match self {
            Resolution::Completed => Completion::Ready.(()),
            Resolution::Cancelled => Completion::Cancelled,
            Resolution::Failed(failure) => Completion::Failed.(failure),
            Resolution::First | Resolution::Second => Completion::Failed.(Failure::InvalidResult),
        }
    }
}

forall Driver.
trait PlanDriver {
    fn timer(&scope: Driver, duration: Duration) -> Option[usize];
    fn pair(&scope: Driver, pair: Pair) -> Option[usize];
    /// Gets a node's result after the engine has joined.
    /// Preserves failures from the operation or the scope.
    fn result(&scope: Driver, id: Option[usize]) -> Resolution;
}

/// Stages and collects a plan on a driver that supports it.
forall Task, Driver -> Output.
trait Plan {
    /// Registers this plan and returns its root if staging succeeded.
    fn stage(&task: Task, &scope: Driver) -> Option[usize];
    /// Consumes the plan and recovers its outcome, including after staging failure.
    fn collect(task: Task, &scope: Driver) -> Output;
}

/// Owns a staged plan and its scope until collection.
forall Task, Driver.
struct Prepared! { task: Task, scope: Driver, root: Option[usize] }

/// Stages the plan and retains its state even when staging fails.
forall Task, Driver, Output where PlanOutput[Task -> Output], Plan[Task, Driver -> Output].
fn prepare(task: Task, scope: Driver) -> Prepared![Task, Driver] {
    let root = Plan[Task, Driver -> Output]::stage(&task, &scope);
    Prepared!.{ task, scope, root }
}

forall Task, Driver.
impl Prepared![Task, Driver] {
    /// Lends the scope and its staged root to the engine.
    forall Env, Value.
    fn with_scope(&self, body: closure[Env](&_: Driver, Option[usize]) -> Value) -> Value {
        let { task, scope, root } = self;
        let value = body(&scope, root);
        self = Prepared!.{ task, scope, root };
        value
    }

    /// Collects a joined or unsubmitted plan and returns the scope for teardown.
    forall Output where PlanOutput[Task -> Output], Plan[Task, Driver -> Output].
    fn collect(self) -> (Output, Driver) {
        let { task, scope, root } = self;
        let output = Plan[Task, Driver -> Output]::collect(task, &scope);
        (output, scope)
    }
}
