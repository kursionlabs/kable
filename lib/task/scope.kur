//! Engine-independent task selection and resource lifetime bookkeeping.
use package::Failure;
use std::collections::vec::OwnedVec!;
use std::option::Option;
use std::process::trap;

exposed enum PairKind { Select, Join }

exposed struct Pair {
    kind: PairKind,
    first: usize,
    second: usize,
}

enum Branch { Leaf, Pair(Pair) }

/// A resource whose lifetime can keep a scope pending.
exposed enum Resource { Leaf(usize), ParentTimer }

/// The outcome of a node after its scope joins.
exposed enum Resolution {
    Completed,
    First,
    Second,
    Cancelled,
    Failed(Failure),
}

enum Lifetime { Unstarted, Active, Retired }

struct Node {
    branch: Branch,
    parent: Option[usize],
    result: Option[Resolution],
    lifetime: Lifetime,
}

impl Node {
    fn reparent(self, parent: usize) -> Node {
        let { parent: old, ..rest } = self;
        Node.{ parent: Option::Some.(parent), ..rest }
    }

    fn resolve(self, result: Resolution) -> Node {
        let { result: old, ..rest } = self;
        Node.{ result: Option::Some.(result), ..rest }
    }
}

/// The engine reports logical completions and resource retirement separately.
/// A cancelled leaf can still own an in-flight engine request.
struct ScopeState! {
    nodes: OwnedVec![Node],
    stops: OwnedVec![usize],
    root: Option[usize],
    pending: usize,
    parent_timer: Lifetime,
}

impl ScopeState! {
    fn new() -> ScopeState! {
        ScopeState!.{
            nodes: OwnedVec!::new(), stops: OwnedVec!::new(),
            root: Option::None, pending: 0usize, parent_timer: Lifetime::Unstarted,
        }
    }

    /// Registers a leaf before the scope begins.
    fn add_leaf(&self) -> Option[usize] {
        add_branch(&self, Branch::Leaf)
    }

    /// Registers a pair of distinct, unattached children before the scope begins.
    fn add_pair(&self, pair: Pair) -> Option[usize] {
        add_branch(&self, Branch::Pair.(pair))
    }

    fn begin(&self, root: usize) -> bool {
        let { nodes, root: prior, ..rest } = self;
        let count = &nodes.len();
        var valid = prior.is_none() && root < count;
        var i = 0usize;
        while valid && i < count {
            let node = &nodes.at(i);
            valid = (node.parent.is_none()) == (i == root);
            i = i + 1usize;
        }
        let root = if valid { Option::Some.(root) } else { prior };
        self = ScopeState!.{ nodes, root, ..rest };
        valid
    }

    /// Tracks a resource after the engine starts it successfully.
    fn started(&self, resource: Resource) {
        &self.update_resource(resource, true);
    }

    /// Reports that a resource has retired. Use joined() to query scope completion.
    fn retired(&self, resource: Resource) {
        &self.update_resource(resource, false);
    }

    fn update_resource(&self, resource: Resource, starting: bool) {
        let { nodes, root, pending, parent_timer, ..rest } = self;
        let changed = if root.is_some() {
            match resource {
                Resource::Leaf(id) => update_leaf(&nodes, id, starting),
                Resource::ParentTimer => update_lifetime(&parent_timer, starting),
            }
        } else { false };
        let pending = if changed {
            if starting { pending + 1usize } else { pending - 1usize }
        } else { pending };
        self = ScopeState!.{ nodes, root, pending, parent_timer, ..rest };
    }

    fn pending(&self) -> bool {
        let { pending, ..rest } = self;
        self = ScopeState!.{ pending, ..rest };
        pending != 0usize
    }

    /// A scope joins when its root resolves and all resources retire.
    fn joined(&self) -> bool {
        let { nodes, root, pending, ..rest } = self;
        let joined = scope_joined(&nodes, root, pending);
        self = ScopeState!.{ nodes, root, pending, ..rest };
        joined
    }

    /// Reports a leaf's completion and returns true if it resolves the root.
    fn complete(&self, id: usize) -> bool {
        let { nodes, stops, root, ..rest } = self;
        var resolved = false;
        if root.is_some() && id < &nodes.len() {
            let leaf = &nodes.at(id);
            match leaf.branch {
                Branch::Leaf => { resolved = settle(&nodes, &stops, id); },
                _ => (),
            }
        }
        self = ScopeState!.{ nodes, stops, root, ..rest };
        resolved
    }

    fn cancel(&self) {
        let { nodes, stops, root, ..rest } = self;
        match root {
            Option::Some(root) => cancel_branch(&nodes, &stops, root),
            Option::None => (),
        };
        self = ScopeState!.{ nodes, stops, root, ..rest };
    }

    fn take_cancel(&self) -> Option[usize] {
        let { stops, ..rest } = self;
        let id = &stops.pop();
        self = ScopeState!.{ stops, ..rest };
        id
    }

    fn result(&self, id: usize) -> Option[Resolution] {
        let { nodes, root, pending, ..rest } = self;
        let result = if scope_joined(&nodes, root, pending) && id < &nodes.len() {
            (&nodes.at(id)).result
        } else { Option::None };
        self = ScopeState!.{ nodes, root, pending, ..rest };
        result
    }

    fn destroy(self) {
        let { nodes, stops, root, pending, parent_timer } = self;
        nodes.destroy(ignore_node);
        stops.destroy(ignore_id);
    }
}

fn add_branch(&scope: ScopeState!, branch: Branch) -> Option[usize] {
    let { nodes, root, ..rest } = scope;
    var nodes = nodes;
    let index = &nodes.len();
    let valid = if root.is_none() {
        match branch {
            Branch::Leaf => true,
            Branch::Pair(pair) => {
                if pair.first < index && pair.second < index && pair.first != pair.second {
                    let a = &nodes.at(pair.first);
                    let b = &nodes.at(pair.second);
                    let unattached = a.parent.is_none() && b.parent.is_none();
                    if unattached {
                        &nodes.set(pair.first, a.reparent(index));
                        &nodes.set(pair.second, b.reparent(index));
                    }
                    unattached
                } else { false }
            },
        }
    } else { false };
    if valid {
        nodes = nodes.push(Node.{
            branch, parent: Option::None, result: Option::None, lifetime: Lifetime::Unstarted,
        });
    }
    scope = ScopeState!.{ nodes, root, ..rest };
    if valid { Option::Some.(index) } else { Option::None }
}

fn scope_joined(&nodes: OwnedVec![Node], root: Option[usize], pending: usize) -> bool {
    if pending != 0usize { return false; }
    match root {
        Option::Some(id) => (&nodes.at(id)).result.is_some(),
        Option::None => false,
    }
}

fn update_leaf(&nodes: OwnedVec![Node], id: usize, starting: bool) -> bool {
    if id >= &nodes.len() { return false; }
    let node = &nodes.at(id);
    match node.branch {
        Branch::Leaf => {
            let { lifetime, ..rest } = node;
            let changed = update_lifetime(&lifetime, starting);
            if changed { &nodes.set(id, Node.{ lifetime, ..rest }); }
            changed
        },
        Branch::Pair => false,
    }
}

fn update_lifetime(&lifetime: Lifetime, starting: bool) -> bool {
    match lifetime {
        Lifetime::Unstarted => {
            if !starting { return false; }
            lifetime = Lifetime::Active;
            true
        },
        Lifetime::Active => {
            if starting { return false; }
            lifetime = Lifetime::Retired;
            true
        },
        Lifetime::Retired => false,
    }
}

fn ignore_node(node: Node) {}
fn ignore_id(id: usize) {}

fn cancel_branch(&nodes: OwnedVec![Node], &stops: OwnedVec![usize], root: usize) {
    // Follow the parent links to walk the subtree without using the call stack.
    var index = root;
    while true {
        let node = &nodes.at(index);
        var child = Option::None;
        if node.result.is_none() {
            &nodes.set(index, node.resolve(Resolution::Cancelled));
            match node.branch {
                Branch::Leaf => { stops = stops.push(index); },
                Branch::Pair(pair) => { child = Option::Some.(pair.first); },
            }
        }
        let next = match child {
            Option::Some(id) => Option::Some.(id),
            Option::None => next_sibling(&nodes, root, index),
        };
        match next {
            Option::Some(id) => { index = id; },
            Option::None => return,
        }
    }
}

fn next_sibling(&nodes: OwnedVec![Node], root: usize, start: usize) -> Option[usize] {
    var index = start;
    while index != root {
        let parent_id = (&nodes.at(index)).parent.unwrap();
        let pair = children(&nodes, parent_id);
        if index == pair.first { return Option::Some.(pair.second); }
        index = parent_id;
    }
    Option::None
}

fn children(&nodes: OwnedVec![Node], id: usize) -> Pair {
    match (&nodes.at(id)).branch {
        Branch::Pair(pair) => pair,
        Branch::Leaf => trap(),
    }
}

fn settle(&nodes: OwnedVec![Node], &stops: OwnedVec![usize], start: usize) -> bool {
    var index = start;
    var result = Resolution::Completed;
    while true {
        let node = &nodes.at(index);
        if node.result.is_some() { return false; }
        &nodes.set(index, node.resolve(result));
        let parent_id = match node.parent {
            Option::Some(parent_id) => parent_id,
            Option::None => return true,
        };

        let pair = children(&nodes, parent_id);
        let first = index == pair.first;
        let other = if first { pair.second } else { pair.first };
        match pair.kind {
            PairKind::Select => {
                cancel_branch(&nodes, &stops, other);
                result = if first { Resolution::First } else { Resolution::Second };
            },
            PairKind::Join => {
                if (&nodes.at(other)).result.is_none() { return false; }
                result = Resolution::Completed;
            },
        }
        index = parent_id;
    }
    false
}
