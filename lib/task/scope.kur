//! Engine-independent task selection and resource lifetime bookkeeping.
use std::collections::vec::{OwnedVec!, Popped!};
use std::option::Option;
use std::process::trap;

exposed enum PairKind { Select, Join }

exposed struct Pair {
    kind: PairKind,
    first: usize,
    second: usize,
}

exposed enum Branch { Leaf, Pair(Pair) }

/// The outcome of a node after its scope joins.
exposed enum Resolution {
    Completed,
    First,
    Second,
    Cancelled,
    Failed(i32),
}

struct Node {
    branch: Branch,
    parent: Option[usize],
    result: Option[Resolution],
}

impl Node {
    fn reparent(self, parent: usize) -> Node {
        let { parent: old, ..rest } = self;
        Node.{ parent: Option::Some.(parent), ..rest }
    }

    fn resolve(self, result: Resolution) -> Node {
        let { result: old, ..rest } = self;
        Node.{ result: Option::Some.(result), ..rest }
    }
}

/// The engine reports logical completions and resource retirement separately.
/// A cancelled leaf can still own an in-flight engine request.
struct ScopeState! {
    nodes: OwnedVec![Node],
    stops: OwnedVec![usize],
    root: Option[usize],
    pending: usize,
}

impl ScopeState! {
    fn new() -> ScopeState! {
        ScopeState!.{
            nodes: OwnedVec!::new(), stops: OwnedVec!::new(),
            root: Option::None, pending: 0usize,
        }
    }

    fn add(&self, branch: Branch) -> Option[usize] {
        let { nodes, stops, root, pending } = self;
        var nodes = nodes;
        let index = &nodes.len();
        let valid = if root.is_none() {
            match branch {
                Branch::Leaf => true,
                Branch::Pair(pair) => {
                    if pair.first < index && pair.second < index && pair.first != pair.second {
                        let a = &nodes.at(pair.first);
                        let b = &nodes.at(pair.second);
                        let unattached = a.parent.is_none() && b.parent.is_none();
                        if unattached {
                            &nodes.set(pair.first, a.reparent(index));
                            &nodes.set(pair.second, b.reparent(index));
                        }
                        unattached
                    } else { false }
                },
            }
        } else { false };
        if valid {
            nodes = nodes.push(Node.{ branch, parent: Option::None, result: Option::None });
        }
        self = ScopeState!.{ nodes, stops, root, pending };
        if valid { Option::Some.(index) } else { Option::None }
    }

    fn begin(&self, root: usize) -> bool {
        let { nodes, stops, root: prior, pending } = self;
        let count = &nodes.len();
        var valid = prior.is_none() && root < count;
        var i = 0usize;
        while valid && i < count {
            let node = &nodes.at(i);
            valid = (node.parent.is_none()) == (i == root);
            i = i + 1usize;
        }
        let root = if valid { Option::Some.(root) } else { prior };
        self = ScopeState!.{ nodes, stops, root, pending };
        valid
    }

    fn started(&self) {
        let { nodes, stops, root, pending } = self;
        self = ScopeState!.{ nodes, stops, root, pending: pending + 1usize };
    }

    fn retired(&self) -> bool {
        let { nodes, stops, root, pending } = self;
        let joined = pending == 1usize;
        let pending = if pending == 0usize { 0usize } else { pending - 1usize };
        self = ScopeState!.{ nodes, stops, root, pending };
        joined
    }

    fn pending(&self) -> bool {
        let { nodes, stops, root, pending } = self;
        self = ScopeState!.{ nodes, stops, root, pending };
        pending != 0usize
    }

    fn complete(&self, id: usize) -> bool {
        let { nodes, stops, root, pending } = self;
        var resolved = false;
        if root.is_some() && id < &nodes.len() {
            let leaf = &nodes.at(id);
            match leaf.branch {
                Branch::Leaf => { resolved = settle(&nodes, &stops, id); },
                _ => (),
            }
        }
        self = ScopeState!.{ nodes, stops, root, pending };
        resolved
    }

    fn cancel(&self) {
        let { nodes, stops, root, pending } = self;
        match root {
            Option::Some(root) => cancel_branch(&nodes, &stops, root),
            Option::None => (),
        };
        self = ScopeState!.{ nodes, stops, root, pending };
    }

    fn take_cancel(&self) -> Option[usize] {
        let { nodes, stops, root, pending } = self;
        let id = match &stops.pop() {
            Popped!::Item(id) => Option::Some.(id),
            Popped!::Empty => Option::None,
        };
        self = ScopeState!.{ nodes, stops, root, pending };
        id
    }

    fn result(&self, id: usize) -> Option[Resolution] {
        let { nodes, stops, root, pending } = self;
        let result = if root.is_some() && pending == 0usize && id < &nodes.len() {
            (&nodes.at(id)).result
        } else { Option::None };
        self = ScopeState!.{ nodes, stops, root, pending };
        result
    }

    fn destroy(self) {
        let { nodes, stops, root, pending } = self;
        nodes.destroy(ignore_node);
        stops.destroy(ignore_id);
    }
}

fn ignore_node(node: Node) {}
fn ignore_id(id: usize) {}

fn cancel_branch(&nodes: OwnedVec![Node], &stops: OwnedVec![usize], root: usize) {
    // Follow the parent links to walk the subtree without using the call stack.
    var index = root;
    while true {
        let node = &nodes.at(index);
        var child = Option::None;
        if node.result.is_none() {
            &nodes.set(index, node.resolve(Resolution::Cancelled));
            match node.branch {
                Branch::Leaf => { stops = stops.push(index); },
                Branch::Pair(pair) => { child = Option::Some.(pair.first); },
            }
        }
        let next = match child {
            Option::Some(id) => Option::Some.(id),
            Option::None => next_sibling(&nodes, root, index),
        };
        match next {
            Option::Some(id) => { index = id; },
            Option::None => return,
        }
    }
}

fn next_sibling(&nodes: OwnedVec![Node], root: usize, start: usize) -> Option[usize] {
    var index = start;
    while index != root {
        let parent_id = (&nodes.at(index)).parent.unwrap();
        let pair = children(&nodes, parent_id);
        if index == pair.first { return Option::Some.(pair.second); }
        index = parent_id;
    }
    Option::None
}

fn children(&nodes: OwnedVec![Node], id: usize) -> Pair {
    match (&nodes.at(id)).branch {
        Branch::Pair(pair) => pair,
        Branch::Leaf => trap(),
    }
}

fn settle(&nodes: OwnedVec![Node], &stops: OwnedVec![usize], start: usize) -> bool {
    var index = start;
    var result = Resolution::Completed;
    while true {
        let node = &nodes.at(index);
        if node.result.is_some() { return false; }
        &nodes.set(index, node.resolve(result));
        let parent_id = match node.parent {
            Option::Some(parent_id) => parent_id,
            Option::None => return true,
        };

        let pair = children(&nodes, parent_id);
        let first = index == pair.first;
        let other = if first { pair.second } else { pair.first };
        match pair.kind {
            PairKind::Select => {
                cancel_branch(&nodes, &stops, other);
                result = if first { Resolution::First } else { Resolution::Second };
            },
            PairKind::Join => {
                if (&nodes.at(other)).result.is_none() { return false; }
                result = Resolution::Completed;
            },
        }
        index = parent_id;
    }
    false
}
