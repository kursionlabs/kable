//! The linear server owns the event loop and its handler until shutdown joins
//! every connection. Native callbacks borrow their arguments for one call.
use async::{Completion, FileChunks!, OpenedFile!, Scope!, sleep};
use async::host::{HostedPlan!, prepare_hosted};
use http::{Method, Request!, Response!, encode_file_headers};
use std::alloc::heap::HeapAllocator;
use std::bytes::buffer::Buffer!;
use std::mem::{alloca, sizeof};
use std::option::{Option, Result};
use std::ptr::is_null;
use std::slice::Slice;
use task::{PlanOutput, Stream, StreamOutcome!};
use task::driver::Plan;

// Callers import this trait to bring the plan extension methods into scope.
export PlanOutput;

extern "C" fn kable_bind(port: u16,
    callback: unsafe fn(*u8, *u8, u16, u8, u8, *u8, usize, *u8, usize) -> i32,
    context: *u8, error: *i32) -> *u8;
extern "C" fn kable_port(server: *u8) -> u16;
extern "C" fn kable_write(client: *u8, bytes: *u8, len: usize) -> i32;
extern "C" fn kable_file_range(client: *u8, total: u64, offset: *u64, length: *u64) -> u16;
extern "C" fn kable_client_connection(client: *u8) -> *u8;
extern "C" fn kable_tcp_stream_write(connection: *u8, bytes: *u8, len: usize, idle_ms: u64,
    scope: *u8, root: usize, plan: *u8, finish: unsafe fn(*u8, *u8, u8) -> i32) -> i32;
extern "C" fn kable_tcp_stream_finish(connection: *u8, bytes: *u8, len: usize) -> i32;
extern "C" fn kable_schedule(client: *u8, scope: *u8, root: usize, plan: *u8,
    finish: unsafe fn(*u8, *u8, u8) -> i32, flags: u8) -> i32;
extern "C" fn kable_run(server: *u8) -> i32;
extern "C" fn kable_stop(server: *u8) -> ();

exposed enum Action! {
    Reply(Response!),
    Deferred(Deferred!),
    File(FileReply!),
}

struct FileReply! { file: OpenedFile!, content_type: Slice[u8, 'static] }

const STREAM_IDLE: u64 = 5000;

// The native HTTP host adds RESPONSE_ACTIVE when it can still send a reply.
const RESPONSE_ACTIVE: u8 = 1;
const RESPONSE_HEAD: u8 = 2;
const RESPONSE_HTTP10: u8 = 4;

/// Sends a measured file using one write at a time.
fn file_reply(file: OpenedFile!, content_type: Slice[u8, 'static]) -> Action! {
    Action!::File.(FileReply!.{ file, content_type })
}

impl Response! {
    /// Sends this response when the handler returns.
    fn reply(self) -> Action! { Action!::Reply.(self) }

    /// Sends this response after a request-scoped timer.
    fn after(self, ms: u64) -> Action! {
        sleep(ms, self).defer(|outcome, state| {
            let (response, status) = outcome;
            match state {
                RequestState::Cancelled => { response.destroy(); Option::None },
                RequestState::Active => {
                    let response = match status {
                        Completion::Ready => response,
                        Completion::Cancelled => { response.destroy(); Response!::rejected(408) },
                        Completion::Failed => { response.destroy(); Response!::rejected(500) },
                    };
                    Option::Some.(response.reply())
                },
            }
        })
    }
}

enum Handler {
    Immediate(fn(Request!) -> Response!),
    Deferred(fn(Request!) -> Action!),
}

struct Pending! { response: Response!, head: bool, http10: bool }
struct Deferred! { hosted: HostedPlan! }

exposed enum RequestState { Active, Cancelled }

forall Task, Output where PlanOutput[Task -> Output].
impl Task {
    /// Runs once after the plan joins, including when the request has ended.
    /// Return None when the request is cancelled or should close without a reply.
    forall Env where Plan[Task, Scope! -> Output].
    fn defer(self, finish: closure[Env](Output, RequestState) -> Option[Action!]) -> Action! {
        let hosted = prepare_hosted(self, |outcome, client, flags| {
            let active = (flags & RESPONSE_ACTIVE) != 0;
            let state = if active { RequestState::Active } else { RequestState::Cancelled };
            match finish(outcome, state) {
                Option::Some(action) => {
                    if active {
                        unsafe apply(client, action, (flags & RESPONSE_HEAD) != 0, (flags & RESPONSE_HTTP10) != 0)
                    } else {
                        unsafe discard_action(client, action);
                        0
                    }
                },
                Option::None => -1,
            }
        });
        Action!::Deferred.(Deferred!.{ hosted })
    }
}

unsafe fn write_response(client: *u8, pending: Pending!) -> i32 {
    let { response, head, http10 } = pending;
    let wire = response.encode(head, http10);
    let ptr = unsafe &wire.as_ptr();
    let len = &wire.len();
    let result = unsafe kable_write(client, ptr, len);
    wire.destroy();
    result
}

unsafe fn discard_action(client: *u8, action: Action!) {
    match action {
        Action!::Reply(response) => response.destroy(),
        Action!::File(reply) => {
            let { file, content_type } = reply;
            file.close();
        },
        Action!::Deferred(deferred) => {
            let { hosted } = deferred;
            unsafe hosted.discard(client);
        },
    }
}

unsafe fn schedule(client: *u8, deferred: Deferred!, head: bool, http10: bool) -> i32 {
    let { hosted } = deferred;
    let flags = (if head { RESPONSE_HEAD } else { 0 }) | (if http10 { RESPONSE_HTTP10 } else { 0 });
    let (status, handled) = unsafe hosted.submit(client, |scope, root, plan, finish| {
        unsafe kable_schedule(client, scope, root, plan, finish, flags)
    });
    status
}

unsafe fn apply(client: *u8, action: Action!, head: bool, http10: bool) -> i32 {
    match action {
        Action!::Reply(response) => unsafe write_response(client, Pending!.{ response, head, http10 }),
        Action!::Deferred(plan) => unsafe schedule(client, plan, head, http10),
        Action!::File(reply) => unsafe write_file(client, reply, head, http10),
    }
}

unsafe fn write_file(client: *u8, reply: FileReply!, head: bool, http10: bool) -> i32 {
    let { file, content_type } = reply;
    let total = &file.len();
    let offset = unsafe alloca[u64]();
    let length = unsafe alloca[u64]();
    let status = unsafe kable_file_range(client, total, offset, length);
    let start = unsafe *offset;
    let count = unsafe *length;
    let headers = encode_file_headers(status, content_type, start, count, total, http10);
    if head || count == 0 {
        file.close();
        let result = unsafe kable_write(client, unsafe &headers.as_ptr(), &headers.len());
        headers.destroy();
        return result;
    }
    let connection = unsafe kable_client_connection(client);
    unsafe write_then_next(connection, headers, file.chunks(start, count))
}

unsafe fn write_then_next(connection: *u8, bytes: Buffer!, stream: FileChunks!) -> i32 {
    let read = prepare_hosted(stream.next(), |result, raw, flags| {
        unsafe chunk_joined(raw, result)
    });

    // The transport starts the read after this write completes.
    let (status, handled) = unsafe read.submit(connection, |scope, root, plan, finish| {
        let status = unsafe kable_tcp_stream_write(connection, unsafe &bytes.as_ptr(), &bytes.len(),
            STREAM_IDLE, scope, root, plan, finish);
        bytes.destroy();
        status
    });
    status
}

unsafe fn chunk_joined(connection: *u8, result: (FileChunks!, StreamOutcome![Buffer!])) -> i32 {
    let (stream, outcome) = result;
    let bytes = match outcome {
        StreamOutcome!::Item(bytes) => bytes,
        StreamOutcome!::End | StreamOutcome!::Cancelled | StreamOutcome!::Failed => {
            stream.close();
            return -1;
        },
    };
    if &stream.remaining() == 0 {
        stream.close();
        let status = unsafe kable_tcp_stream_finish(connection, unsafe &bytes.as_ptr(), &bytes.len());
        bytes.destroy();
        return status;
    }
    unsafe write_then_next(connection, bytes, stream)
}

unsafe fn respond(context: *u8, client: *u8, status: u16, method: u8, http10: u8,
    target: *u8, target_len: usize, body: *u8, body_len: usize) -> i32 {
    let head = method == 2u8;
    let http10 = http10 != 0u8;
    if status != 0u16 {
        return unsafe write_response(client, Pending!.{ response: Response!::rejected(status), head, http10 });
    }
    let method = match method {
        1u8 => Method::Get,
        2u8 => Method::Head,
        3u8 => Method::Post,
        _ => Method::Other,
    };
    let request = Request!.{
        method,
        target: unsafe Buffer!::new_with_cap(target_len).push_n(target, target_len),
        body: unsafe Buffer!::new_with_cap(body_len).push_n(body, body_len),
    };
    let action = match unsafe *(unsafe (context as *Handler)) {
        Handler::Immediate(call) => Action!::Reply.(call(request)),
        Handler::Deferred(call) => call(request),
    };
    unsafe apply(client, action, head, http10)
}

struct Server! { raw: *u8, context: *u8 }

impl Server! {
    fn bind_local(port: u16, call: fn(Request!) -> Response!) -> Result[Server!, i32] {
        Server!::bind(port, Handler::Immediate.(call))
    }

    /// Binds handlers that can reply immediately or defer to a scoped plan.
    fn bind_async(port: u16, call: fn(Request!) -> Action!) -> Result[Server!, i32] {
        Server!::bind(port, Handler::Deferred.(call))
    }

    fn bind(port: u16, handler: Handler) -> Result[Server!, i32] {
        let context = HeapAllocator::alloc(sizeof[Handler]()).into_raw();
        unsafe *(unsafe (context as *Handler)) = handler;

        let scratch = Buffer!::new_zeroed(sizeof[i32]());
        let error = unsafe ((unsafe &scratch.as_ptr()) as *i32);
        let raw = unsafe kable_bind(port, respond, context, error);
        let status = unsafe *error;
        scratch.destroy();
        if is_null(raw) {
            HeapAllocator::drop(unsafe HeapAllocator::adopt_raw(context));
            Result::Err.(status)
        } else {
            Result::Ok.(Server!.{ raw, context })
        }
    }

    fn port(&self) -> u16 {
        let { raw, context } = self;
        let port = unsafe kable_port(raw);
        self = Server!.{ raw, context };
        port
    }

    /// Closes a bound server before running it.
    fn stop(self) {
        let { raw, context } = self;
        unsafe kable_stop(raw);
        HeapAllocator::drop(unsafe HeapAllocator::adopt_raw(context));
    }

    /// Runs until interrupted or a listener error shuts down the scope.
    fn run(self) -> Result[(), i32] {
        let { raw, context } = self;
        let status = unsafe kable_run(raw);
        HeapAllocator::drop(unsafe HeapAllocator::adopt_raw(context));
        if status == 0i32 { Result::Ok.(()) } else { Result::Err.(status) }
    }
}
