//! The linear server owns the event loop and its handler until shutdown joins
//! every connection. Native callbacks borrow their arguments for one call.
use async::{OpenedFile!, Outcome, Prepared!, Scope!, WithinOutcome, collect, prepare, sleep, within};
use http::{Method, Request!, Response!, encode_headers};
use std::alloc::heap::HeapAllocator;
use std::bytes::buffer::Buffer!;
use std::mem::sizeof;
use std::option::{Option, Result};
use std::ptr::is_null;
use std::slice::Slice;
use task::{Continuation!, HostedChain, Plan, PlanOutput, Sequence!, StageHost, StageResult, continuation, host_sequence};

// Callers import these traits to bring the plan extension methods into scope.
export Plan;
export PlanOutput;

extern "C" fn kable_bind(port: u16,
    callback: unsafe fn(*u8, *u8, u16, u8, u8, *u8, usize, *u8, usize) -> i32,
    context: *u8, error: *i32) -> *u8;
extern "C" fn kable_port(server: *u8) -> u16;
extern "C" fn kable_write(client: *u8, bytes: *u8, len: usize) -> i32;
extern "C" fn kable_send_file(client: *u8, headers: *u8, len: usize, fd: i32, length: u64) -> i32;
extern "C" fn kable_schedule(client: *u8, scope: *u8, root: usize, plan: *u8,
    finish: unsafe fn(*u8, *u8, u8, u8, u8) -> i32, head: u8, http10: u8) -> i32;
extern "C" fn kable_run(server: *u8) -> i32;
extern "C" fn kable_stop(server: *u8) -> ();

exposed enum Action! {
    Reply(Response!),
    Deferred(Deferred!),
    File(FileReply!),
}

struct FileReply! { file: OpenedFile!, content_type: Slice[u8, 'static] }

/// Sends a measured file using one write at a time.
fn file_reply(file: OpenedFile!, content_type: Slice[u8, 'static]) -> Action! {
    Action!::File.(FileReply!.{ file, content_type })
}

impl Response! {
    /// Sends this response when the handler returns.
    fn reply(self) -> Action! { Action!::Reply.(self) }

    /// Sends this response after a request-scoped timer.
    fn after(self, ms: u64) -> Action! {
        defer(sleep(ms, self), |outcome| match outcome {
            Outcome::Ready(response) => response,
            Outcome::Cancelled(response) => { response.destroy(); Response!::rejected(408) },
            Outcome::Failed(response, code) => { response.destroy(); Response!::rejected(500) },
        })
    }
}

enum Handler {
    Immediate(fn(Request!) -> Response!),
    Deferred(fn(Request!) -> Action!),
}

struct Pending! { response: Response!, head: bool, http10: bool }

struct Deferred! {
    plan: *u8, scope: *u8, root: usize,
    finish: unsafe fn(*u8, *u8, u8, u8, u8) -> i32,
}

forall Task, Output, Env.
struct DeferredPlan! {
    prepared: Prepared![Task],
    finish: closure[Env](Output, bool) -> Option[Action!],
}

/// Runs the plan in the request's scope. The continuation consumes its
/// outcome once, including on cancellation, so it can reclaim owned values.
forall Task, Output, Env where PlanOutput[Task -> Output], Plan[Task, Scope! -> Output].
fn defer(task: Task, reply: closure[Env](Output) -> Response!) -> Action! {
    defer_plan(task, |outcome: Output, active: bool| {
        let response = reply(outcome);
        if active {
            Option::Some.(Action!::Reply.(response))
        } else {
            response.destroy();
            Option::None
        }
    })
}

forall Task, Output where PlanOutput[Task -> Output], Plan[Task, Scope! -> Output].
impl Task {
    /// Defers a reply until this plan has joined within the request scope.
    forall Env.
    fn defer(self, reply: closure[Env](Output) -> Response!) -> Action! {
        defer(self, reply)
    }

    /// Replies with 504 if the local deadline wins. After the plan joins,
    /// discard consumes every outcome that will not be passed to reply.
    fn defer_within(self, ms: u64, reply: fn(Output) -> Response!, discard: fn(Output) -> ()) -> Action! {
        defer_timed(self, ms, |outcome| reply(outcome).reply(), discard)
    }

    /// Like defer_within, with a continuation that can return a file reply.
    fn defer_action_within(self, ms: u64, reply: fn(Output) -> Action!, discard: fn(Output) -> ()) -> Action! {
        defer_timed(self, ms, |outcome| reply(outcome), discard)
    }
}

forall Task, Output, Env where PlanOutput[Task -> Output], Plan[Task, Scope! -> Output], Copy[Env].
fn defer_timed(task: Task, ms: u64, reply: closure[Env](Output) -> Action!,
    discard: fn(Output) -> ()) -> Action! {
    defer_plan(within(ms, task), |result: WithinOutcome[Output], active: bool| {
        let (outcome, status) = match result {
            WithinOutcome::Completed(outcome) => (outcome, Option::None),
            WithinOutcome::TimedOut(outcome) => (outcome, Option::Some.(504)),
            WithinOutcome::Cancelled(outcome) => (outcome, Option::Some.(408)),
            WithinOutcome::Failed(outcome, code) => (outcome, Option::Some.(500)),
        };
        if active {
            let action = match status {
                Option::None => reply(outcome),
                Option::Some(code) => { discard(outcome); Response!::rejected(code).reply() },
            };
            Option::Some.(action)
        } else {
            discard(outcome);
            Option::None
        }
    })
}

struct RequestHost {}

forall Task, Output where PlanOutput[Task -> Output], Plan[Task, Scope! -> Output].
instance StageHost[Task, RequestHost, Action! -> Output] {
    fn schedule(task: Task, next: Continuation![Output, Action!]) -> Action! {
        defer_plan(task, |outcome: Output, active: bool| {
            let result = if active {
                StageResult::Joined.(outcome)
            } else {
                StageResult::Cancelled.(Option::Some.(outcome))
            };
            next.finish(result)
        })
    }
}

/// Drives a portable sequence under the current request's deadline.
forall Stages, Output, State where HostedChain[Stages, RequestHost, Action! -> Output].
fn defer_sequence(plan: Sequence![Stages], state: State, resume: fn(State, Option[Output]) -> Action!,
    cancel: fn(State, Option[Output]) -> ()) -> Action! {
    let next = continuation(state, resume, cancel);
    host_sequence[Stages, Output, RequestHost, Action!](plan, next)
}

forall Stages, Output where HostedChain[Stages, RequestHost, Action! -> Output].
impl Sequence![Stages] {
    /// Drives the sequence under the current request's deadline.
    forall State.
    fn defer(self, state: State, resume: fn(State, Option[Output]) -> Action!,
        cancel: fn(State, Option[Output]) -> ()) -> Action! {
        defer_sequence(self, state, resume, cancel)
    }
}

forall Task, Output, Env where PlanOutput[Task -> Output], Plan[Task, Scope! -> Output].
fn defer_plan(task: Task, finish: closure[Env](Output, bool) -> Option[Action!]) -> Action! {
    let prepared = prepare(task);
    let (scope, root) = unsafe &prepared.native();
    let plan = HeapAllocator::alloc(sizeof[DeferredPlan![Task, Output, Env]]()).into_raw();
    unsafe *(unsafe (plan as *DeferredPlan![Task, Output, Env])) = DeferredPlan!.{ prepared, finish };
    Action!::Deferred.(Deferred!.{ plan, scope, root, finish: finish_plan[Task, Output, Env] })
}

unsafe fn write_response(client: *u8, pending: Pending!) -> i32 {
    let { response, head, http10 } = pending;
    let wire = response.encode(head, http10);
    let ptr = unsafe &wire.as_ptr();
    let len = &wire.len();
    let result = unsafe kable_write(client, ptr, len);
    wire.destroy();
    result
}

forall Task, Output, Env where PlanOutput[Task -> Output], Plan[Task, Scope! -> Output].
unsafe fn finish_plan(raw: *u8, client: *u8, ready: u8, head: u8, http10: u8) -> i32 {
    let { prepared, finish } = unsafe *(unsafe (raw as *DeferredPlan![Task, Output, Env]));
    HeapAllocator::drop(unsafe HeapAllocator::adopt_raw(raw));
    match finish(collect(prepared), ready != 0u8) {
        Option::Some(action) => unsafe apply(client, action, head != 0u8, http10 != 0u8),
        Option::None => 0i32,
    }
}

unsafe fn schedule(client: *u8, deferred: Deferred!, head: bool, http10: bool) -> i32 {
    let { plan, scope, root, finish } = deferred;
    let head = if head { 1u8 } else { 0u8 };
    let http10 = if http10 { 1u8 } else { 0u8 };
    let status = unsafe kable_schedule(client, scope, root, plan, finish, head, http10);
    if status < 0i32 { unsafe finish(plan, client, 0u8, head, http10); }
    status
}

unsafe fn apply(client: *u8, action: Action!, head: bool, http10: bool) -> i32 {
    match action {
        Action!::Reply(response) => unsafe write_response(client, Pending!.{ response, head, http10 }),
        Action!::Deferred(plan) => unsafe schedule(client, plan, head, http10),
        Action!::File(reply) => unsafe write_file(client, reply, head, http10),
    }
}

unsafe fn write_file(client: *u8, reply: FileReply!, head: bool, http10: bool) -> i32 {
    let { file, content_type } = reply;
    let (fd, length) = unsafe file.into_parts();
    let headers = encode_headers(200, content_type, "", length, http10);
    let ptr = unsafe &headers.as_ptr();
    let len = &headers.len();
    let result = unsafe kable_send_file(client, ptr, len, fd, if head { 0 } else { length });
    headers.destroy();
    result
}

unsafe fn respond(context: *u8, client: *u8, status: u16, method: u8, http10: u8,
    target: *u8, target_len: usize, body: *u8, body_len: usize) -> i32 {
    let head = method == 2u8;
    let http10 = http10 != 0u8;
    if status != 0u16 {
        return unsafe write_response(client, Pending!.{ response: Response!::rejected(status), head, http10 });
    }
    let method = match method {
        1u8 => Method::Get,
        2u8 => Method::Head,
        3u8 => Method::Post,
        _ => Method::Other,
    };
    let request = Request!.{
        method,
        target: unsafe Buffer!::new_with_cap(target_len).push_n(target, target_len),
        body: unsafe Buffer!::new_with_cap(body_len).push_n(body, body_len),
    };
    let action = match unsafe *(unsafe (context as *Handler)) {
        Handler::Immediate(call) => Action!::Reply.(call(request)),
        Handler::Deferred(call) => call(request),
    };
    unsafe apply(client, action, head, http10)
}

struct Server! { raw: *u8, context: *u8 }

impl Server! {
    fn bind_local(port: u16, call: fn(Request!) -> Response!) -> Result[Server!, i32] {
        Server!::bind(port, Handler::Immediate.(call))
    }

    /// Binds handlers that can reply immediately or defer to a scoped plan.
    fn bind_async(port: u16, call: fn(Request!) -> Action!) -> Result[Server!, i32] {
        Server!::bind(port, Handler::Deferred.(call))
    }

    fn bind(port: u16, handler: Handler) -> Result[Server!, i32] {
        let context = HeapAllocator::alloc(sizeof[Handler]()).into_raw();
        unsafe *(unsafe (context as *Handler)) = handler;

        let scratch = Buffer!::new_zeroed(sizeof[i32]());
        let error = unsafe ((unsafe &scratch.as_ptr()) as *i32);
        let raw = unsafe kable_bind(port, respond, context, error);
        let status = unsafe *error;
        scratch.destroy();
        if is_null(raw) {
            HeapAllocator::drop(unsafe HeapAllocator::adopt_raw(context));
            Result::Err.(status)
        } else {
            Result::Ok.(Server!.{ raw, context })
        }
    }

    fn port(&self) -> u16 {
        let { raw, context } = self;
        let port = unsafe kable_port(raw);
        self = Server!.{ raw, context };
        port
    }

    /// Closes a bound server before running it.
    fn stop(self) {
        let { raw, context } = self;
        unsafe kable_stop(raw);
        HeapAllocator::drop(unsafe HeapAllocator::adopt_raw(context));
    }

    /// Runs until interrupted or a listener error shuts down the scope.
    fn run(self) -> Result[(), i32] {
        let { raw, context } = self;
        let status = unsafe kable_run(raw);
        HeapAllocator::drop(unsafe HeapAllocator::adopt_raw(context));
        if status == 0i32 { Result::Ok.(()) } else { Result::Err.(status) }
    }
}
