//! The linear server owns the event loop and its handler until shutdown joins
//! every connection. Native callbacks borrow their arguments for one call.
use std::fmt::Writer;
use async::Scope!;
use async::host::{HostedPlan!, prepare_handoff};
use http::{Body!, Method, Request!, RequestHead, Response!, ResponseBody!, ResponseFraming, validate_request_head};
use package::{body, response_stream, static_files};
use std::heap::HeapAllocator;
use std::buffer::Buffer!;
use std::cap::Exclusive!;
use std::mem::{alloca, sizeof};
use std::option::{Option, Result};
use std::ptr::is_null;
use std::str::Str;
use std::time::Duration;
use task::{Completion, Discard, PlanOutput, StreamOutcome, discard, discard_owned, sleep};
use task::driver::Plan;
use tcp::host;

export static_files;
export body;
export response_stream;

extern "C" fn kable_bind(port: u16,
    validate: unsafe fn(u8, u8, u32, u8, u8, u64, u64, *u8, usize, usize) -> u16,
    receive: unsafe fn(*u8, *u8) -> i32,
    context: *u8, error: *i32) -> *u8;
extern "C" fn kable_port(server: *u8) -> u16;
extern "C" fn kable_range_header(request: *u8, length: *usize) -> *u8;
extern "C" fn kable_client_connection(client: *u8) -> *u8;
extern "C" fn kable_client_request(client: *u8) -> *u8;
extern "C" fn kable_client_key(client: *u8) -> u64;
extern "C" fn kable_client_content_length(client: *u8) -> u64;
extern "C" fn kable_schedule(client: *u8, scope: *u8, root: usize, plan: *u8,
    finish: unsafe fn(*u8, *u8, u8) -> i32, flags: u8) -> i32;
extern "C" fn kable_request_feed(request: *u8, bytes: *u8, length: usize) -> u16;
extern "C" fn kable_request_is_json(request: *u8) -> u8;
extern "C" fn kable_request_eof(request: *u8) -> u16;
extern "C" fn kable_request_view(request: *u8, http10: *u8,
    target: *(*u8), target_len: *usize) -> u8;
extern "C" fn kable_release_request_head(request: *u8) -> ();
extern "C" fn kable_release_request(request: *u8) -> ();
extern "C" fn kable_run(server: *u8) -> i32;
extern "C" fn kable_stop(server: *u8) -> ();

exposed enum Action! {
    Reply(Response!),
    Deferred(HostedPlan!),
    /// Closes the connection without sending an HTTP response.
    Close,
}

const WRITE_TIMEOUT: u64 = 5000;

const RESPONSE_HEAD: u8 = 2;
const RESPONSE_HTTP10: u8 = 4;

// The parser returns zero for a complete request and HTTP codes for rejections.
const REQUEST_MORE: u16 = 1;
const REQUEST_TRUNCATED: u16 = 2;
const REQUEST_CLOSED: u16 = 3;
const REQUEST_HEADERS: u16 = 4;

/// Sends this response when the handler returns.
fn reply(response: Response!) -> Action! { Action!::Reply.(response) }

/// Sends this response after a request-scoped timer.
fn after(response: Response!, duration: Duration) -> Action! {
    sleep(duration).respond_owned(response, |response, status| {
        let code = match status {
            Completion::Ready => return response,
            TimedOut => 504,
            Cancelled => 408,
            Failed => 500,
        };
        response.destroy();
        Response!::rejected(code)
    })
}

instance Discard[Response!] {
    fn discard(response: Response!) { response.destroy(); }
}

forall R.
trait IntoAction { fn into_action(result: R) -> Action!; }

instance IntoAction[Response!] {
    fn into_action(response: Response!) -> Action! { reply(response) }
}

instance IntoAction[Action!] {
    fn into_action(action: Action!) -> Action! { action }
}

forall R.
struct Handler { call: fn(Request!) -> R }

struct Dispatch {
    data: *u8,
    call: unsafe fn(*u8, Request!) -> Action!,
    release: unsafe fn(*u8) -> (),
}

forall R where IntoAction[R].
unsafe fn simple_call(data: *u8, request: Request!) -> Action! {
    let { call } = unsafe *(unsafe (data as *Handler[R]));
    call(request).into_action()
}

unsafe fn free_data(data: *u8) { HeapAllocator::drop(unsafe HeapAllocator::adopt_raw(data)); }

unsafe fn release_handler(context: *u8) {
    let { data, call, release } = unsafe *(unsafe (context as *Dispatch));
    unsafe release(data);
    unsafe free_data(context);
}

forall Task, Output where PlanOutput[Task -> Output].
impl Task {
    /// Responds after join while the request is active. A skipped callback releases the output.
    forall R, Env where Copy[Env], IntoAction[R], Discard[Output], Plan[Task, Scope! -> Output].
    fn respond(self, finish: closure[Env](Output) -> R) -> Action! {
        self.respond_with(finish, discard[Output])
    }

    forall R, Env where Copy[Env], IntoAction[R], Plan[Task, Scope! -> Output].
    fn respond_with(self, finish: closure[Env](Output) -> R, cleanup: fn(Output) -> ()) -> Action! {
        self.respond_owned_with(cleanup, |release, output| finish(output), discard_reply[Output])
    }

    forall State, R, Env where Copy[Env], IntoAction[R], Discard[State], Discard[Output], Plan[Task, Scope! -> Output].
    fn respond_owned(self, state: State, finish: closure[Env](State, Output) -> R) -> Action! {
        self.respond_owned_with(state, finish, discard_owned[State, Output])
    }

    /// Transfers state and output exactly once, to the active request or to cleanup.
    forall State, R, Env where Copy[Env], IntoAction[R], Plan[Task, Scope! -> Output].
    fn respond_owned_with(self, state: State, finish: closure[Env](State, Output) -> R,
        cleanup: fn(State, Output) -> ()) -> Action! {
        let handoff = thunk::defer(state, finish, cleanup);
        let hosted = prepare_handoff(self, handoff, |handoff, output, client, flags| {
            let action = handoff.resume(output).into_action();
            unsafe apply(client, action, (flags & RESPONSE_HEAD) != 0, (flags & RESPONSE_HTTP10) != 0)
        }, |handoff, output| handoff.discard_with(output));
        Action!::Deferred.(hosted)
    }
}

forall Output.
fn discard_reply(cleanup: fn(Output) -> (), output: Output) { cleanup(output); }

unsafe fn write_wire(client: *u8, wire: Buffer!) -> i32 {
    unsafe kable_release_request(unsafe kable_client_request(client));
    unsafe host::write_final(unsafe kable_client_connection(client), wire, WRITE_TIMEOUT)
}

unsafe fn send_response(client: *u8, response: Response!, head: bool, http10: bool) -> i32 {
    let (response, body) = response.into_parts();
    match body {
        Buffered(bytes) => {
            var bytes = bytes;
            let length = &bytes.len() as u64;
            let headers = response.encode(ResponseFraming::Fixed.(length), http10);
            let wire = if head {
                bytes.destroy();
                headers
            } else { headers.put(bytes) };
            unsafe write_wire(client, wire)
        },
        Streamed(stream) => unsafe stream.send(client, response, head, http10),
    }
}

unsafe fn submit_request(client: *u8, plan: HostedPlan!, flags: u8) -> i32 {
    let submission = unsafe plan.submit(client, flags, kable_schedule);
    submission.unwrap_or_else(|rejection| rejection.scheduler_error)
}

unsafe fn apply(client: *u8, action: Action!, head: bool, http10: bool) -> i32 {
    match action {
        Reply(response) => unsafe send_response(client, response, head, http10),
        Deferred(plan) => {
            let flags = (if head { RESPONSE_HEAD } else { 0 }) | (if http10 { RESPONSE_HTTP10 } else { 0 });
            unsafe submit_request(client, plan, flags)
        },
        Close => { unsafe host::close(unsafe kable_client_connection(client)); 0 },
    }
}

unsafe fn validate_head(major: u8, minor: u8, host_count: u32, upgrade_or_connect: u8,
    expect: u8, content_length: u64, body_limit: u64, bytes: *u8, len: usize, target_len: usize) -> u16 {
    var exists 'k. (brand, access) = Exclusive!::fresh();
    // The parser lends these bytes until the callback returns.
    var bytes = if len == 0 { Str::empty(&access) }
        else { unsafe Str::from_raw_parts_branded(bytes, len, brand) };
    let head = RequestHead.{
        major, minor, host_count, content_length,
        target: bytes.take(target_len), host: bytes.skip(target_len),
        upgrade_or_connect: upgrade_or_connect != 0, expect: expect != 0,
    };
    let status = validate_request_head(&access, head, body_limit).unwrap_or(0);
    access.retire();
    status
}

unsafe fn receive(context: *u8, client: *u8) -> i32 {
    let raw = unsafe kable_client_connection(client);
    let plan = prepare_handoff(unsafe host::read(raw), context, |context, completion, client, flags| {
        let result = match completion {
            Completion::Ready => unsafe feed_request(raw, unsafe kable_client_request(client)),
            TimedOut | Cancelled => 408,
            Failed => return -1,
        };
        if result == REQUEST_MORE { return unsafe receive(context, client); }
        if result == REQUEST_CLOSED { return -1; }
        let status = if result == REQUEST_HEADERS { 0 } else if result == REQUEST_TRUNCATED { 400 } else { result };
        unsafe respond(context, client, status)
    }, |context, completion| completion.discard());
    unsafe submit_request(client, plan, 0)
}

unsafe fn feed_request(raw: *u8, request: *u8) -> u16 {
    match unsafe host::with_read_bytes(raw, |bytes, length| unsafe kable_request_feed(request, bytes, length)) {
        StreamOutcome::Item(result) => result,
        Eof => unsafe kable_request_eof(request),
        _ => REQUEST_CLOSED,
    }
}

unsafe fn respond(context: *u8, client: *u8, status: u16) -> i32 {
    let parser = unsafe kable_client_request(client);
    let version = unsafe alloca[u8]();
    let target = unsafe alloca[*u8]();
    let target_len = unsafe alloca[usize]();
    let method = unsafe kable_request_view(parser, version, target, target_len);
    let head = method == 2;
    let http10 = (unsafe *version) != 0;
    if status != 0 {
        return unsafe send_response(client, Response!::rejected(status), head, http10);
    }
    let method = match method {
        1 => Method::Get,
        2 => Method::Head,
        3 => Method::Post,
        _ => Method::Other,
    };
    let target_len = unsafe *target_len;
    let declared = unsafe kable_client_content_length(client);
    let length = if declared == u64::MAX { Option::None } else { Option::Some.(declared) };
    let request = Request!.{
        method,
        target: unsafe Buffer!::with_capacity(target_len).write_raw(unsafe *target, target_len),
        body: unsafe Body!::from_typed_request(unsafe kable_client_key(client), length,
            (unsafe kable_request_is_json(parser)) != 0),
    };
    unsafe kable_release_request_head(parser);
    let { data, call, release } = unsafe *(unsafe (context as *Dispatch));
    let action = unsafe call(data, request);
    unsafe apply(client, action, head, http10)
}

struct Server! { raw: *u8, context: *u8 }

impl Server! {
    /// Binds a handler that returns the action for each request.
    forall R where IntoAction[R].
    fn bind(port: u16, call: fn(Request!) -> R) -> Result[Server!, i32] {
        let context = HeapAllocator::alloc(sizeof[Handler[R]]()).into_raw();
        unsafe *(unsafe (context as *Handler[R])) = Handler.{ call };

        unsafe Server!::bind_context(port, context, simple_call[R], free_data)
    }

    /// Takes ownership of data on every path. The callbacks must agree on its type;
    /// release runs once, after the last joined request or after bind failure.
    unsafe fn bind_context(port: u16, data: *u8, call: unsafe fn(*u8, Request!) -> Action!,
        release: unsafe fn(*u8) -> ()) -> Result[Server!, i32] {
        let context = HeapAllocator::alloc(sizeof[Dispatch]()).into_raw();
        unsafe *(unsafe (context as *Dispatch)) = Dispatch.{ data, call, release };
        let error = unsafe alloca[i32]();
        let raw = unsafe kable_bind(port, validate_head, receive, context, error);
        if is_null(raw) {
            unsafe release_handler(context);
            Result::Err.(unsafe *error)
        } else {
            Result::Ok.(Server!.{ raw, context })
        }
    }

    fn port(&self) -> u16 {
        var { raw, context } = self;
        let port = unsafe kable_port(raw);
        self = Server!.{ raw, context };
        port
    }

    /// Closes a bound server before running it.
    fn stop(self) {
        var { raw, context } = self;
        unsafe kable_stop(raw);
        unsafe release_handler(context);
    }

    /// Runs until interrupted or a listener error shuts down the scope.
    fn run(self) -> Result[(), i32] {
        var { raw, context } = self;
        let status = unsafe kable_run(raw);
        unsafe release_handler(context);
        if status == 0i32 { Result::Ok.(()) } else { Result::Err.(status) }
    }
}
