//! The linear server owns the event loop and its handler until shutdown joins
//! every connection. Native callbacks borrow their arguments for one call.
use async::{FileChunks!, OpenedFile!, Scope!};
use async::host::{HostedPlan!, prepare_hosted};
use http::{Method, Request!, RequestHead, Response!, encode_file_headers, select_file_range, validate_request_head};
use std::heap::HeapAllocator;
use std::buffer::Buffer!;
use std::cap::Exclusive!;
use std::mem::{alloca, sizeof};
use std::option::{Option, Result};
use std::ptr::is_null;
use std::raw::Span;
use std::slice::Slice;
use std::time::Duration;
use task::{Completion, DeadlineStatus, PlanOutput, Sink, Stream, StreamOutcome, sleep};
use task::driver::Plan;
use tcp::Connection!;
use thunk::Thunk!;

extern "C" fn kable_bind(port: u16,
    validate: unsafe fn(u8, u8, u32, u8, u8, u64, u64, *u8, usize, usize) -> u16,
    receive: unsafe fn(*u8) -> i32,
    callback: unsafe fn(*u8, *u8, u16, u8, u8, *u8, usize, *u8, usize) -> i32,
    context: *u8, error: *i32) -> *u8;
extern "C" fn kable_port(server: *u8) -> u16;
extern "C" fn kable_range_header(client: *u8, length: *usize) -> *u8;
extern "C" fn kable_client_connection(client: *u8) -> *u8;
extern "C" fn kable_tcp_close(connection: *u8) -> ();
extern "C" fn kable_schedule(client: *u8, scope: *u8, root: usize, plan: *u8,
    finish: unsafe fn(*u8, *u8, u8) -> i32, flags: u8) -> i32;
extern "C" fn kable_receive_schedule(client: *u8, scope: *u8, root: usize, plan: *u8,
    finish: unsafe fn(*u8, *u8, u8) -> i32, flags: u8) -> i32;
extern "C" fn kable_receive_joined(client: *u8, timed_out: u8) -> i32;
extern "C" fn kable_run(server: *u8) -> i32;
extern "C" fn kable_stop(server: *u8) -> ();

exposed enum Action! {
    Reply(Response!),
    Deferred(HostedPlan!),
    File(FileReply!),
    /// Closes the connection without sending an HTTP response.
    Close,
}

struct FileReply! { file: OpenedFile!, content_type: Slice[u8, 'static] }

const WRITE_TIMEOUT: u64 = 5000;
const STREAM_IDLE: u64 = 5000;

// The native HTTP host adds RESPONSE_ACTIVE when it can still send a reply.
const RESPONSE_ACTIVE: u8 = 1;
const RESPONSE_HEAD: u8 = 2;
const RESPONSE_HTTP10: u8 = 4;

/// Sends a measured file using one write at a time.
fn file_reply(file: OpenedFile!, content_type: Slice[u8, 'static]) -> Action! {
    Action!::File.(FileReply!.{ file, content_type })
}

impl Response! {
    /// Sends this response when the handler returns.
    fn reply(self) -> Action! { Action!::Reply.(self) }

    /// Sends this response after a request-scoped timer.
    fn after(self, duration: Duration) -> Action! {
        sleep(duration).respond_with_owned(self, |response, status| {
            let code = match status {
                Completion::Ready => return response.reply(),
                Completion::Cancelled => 408,
                Completion::Failed => 500,
            };
            response.destroy();
            Response!::rejected(code).reply()
        }, discard_delayed_response).reply()
    }
}

fn discard_delayed_response(response: Response!, status: Completion[()]) { response.destroy(); }

struct Handler { call: fn(Request!) -> Action! }

forall Task, State, Output, Env.
struct ReplyBuilder! {
    task: Task,
    handoff: Thunk![State, Output, Action!, Env, fn(State, Output) -> ()],
    timeout: Option[Duration],
}

forall Task, Output where PlanOutput[Task -> Output].
impl Task {
    /// Uses `respond` for a completed plan while the request is active.
    /// Uses `discard` to release the joined outcome otherwise.
    /// The reply callback can capture copyable values, since it can be skipped.
    forall Env where Copy[Env].
    fn respond_with(self, respond: closure[Env](Output) -> Action!, discard: fn(Output) -> ())
        -> ReplyBuilder![Task, fn(Output) -> (), Output, (closure[Env](Output) -> Action!,)] {
        self.respond_with_owned(discard, |cleanup, outcome| respond(outcome), discard_reply[Output])
    }

    /// Transfers state and the joined outcome to `respond` or `discard`.
    /// Put owned values in `state` and capture copyable configuration in `respond`.
    forall State, Env where Copy[Env].
    fn respond_with_owned(self, state: State, respond: closure[Env](State, Output) -> Action!,
        discard: fn(State, Output) -> ()) -> ReplyBuilder![Task, State, Output, Env] {
        ReplyBuilder!.{ task: self, handoff: thunk::defer(state, respond, discard), timeout: Option::None }
    }
}

forall Output.
fn discard_reply(discard: fn(Output) -> (), outcome: Output) { discard(outcome); }

forall Task, State, Output, Env where Copy[Env], PlanOutput[Task -> Output], Plan[Task, Scope! -> Output].
impl ReplyBuilder![Task, State, Output, Env] {
    /// Sets a local deadline for the plan.
    fn within(self, duration: Duration) -> ReplyBuilder![Task, State, Output, Env] {
        let { timeout: previous, ..rest } = self;
        ReplyBuilder!.{ timeout: Option::Some.(duration), ..rest }
    }

    /// Returns a deferred action that runs after the plan joins.
    fn reply(self) -> Action! {
        let { task, handoff, timeout } = self;
        let hosted = match timeout {
            Option::Some(duration) => prepare_hosted(task.within(duration), |result, client, flags| {
                let (outcome, deadline) = result;
                unsafe finish_reply(handoff, outcome, deadline, client, flags)
            }),
            Option::None => prepare_hosted(task, |outcome, client, flags| {
                unsafe finish_reply(handoff, outcome, DeadlineStatus::Completed, client, flags)
            }),
        };
        Action!::Deferred.(hosted)
    }
}

forall State, Output, Env where Copy[Env].
unsafe fn finish_reply(handoff: Thunk![State, Output, Action!, Env, fn(State, Output) -> ()],
    outcome: Output, deadline: DeadlineStatus, client: *u8, flags: u8) -> i32 {
    if (flags & RESPONSE_ACTIVE) == 0 {
        handoff.discard_with(outcome);
        return -1;
    }
    let action = reply_action(handoff, outcome, deadline);
    unsafe apply(client, action, (flags & RESPONSE_HEAD) != 0, (flags & RESPONSE_HTTP10) != 0)
}

forall State, Output, Env where Copy[Env].
fn reply_action(handoff: Thunk![State, Output, Action!, Env, fn(State, Output) -> ()],
    outcome: Output, deadline: DeadlineStatus) -> Action! {
    let status = match deadline {
        DeadlineStatus::Completed => return handoff.resume(outcome),
        DeadlineStatus::TimedOut => 504,
        DeadlineStatus::Cancelled => 408,
        DeadlineStatus::Failed => 500,
    };
    handoff.discard_with(outcome);
    Response!::rejected(status).reply()
}

unsafe fn write_wire(client: *u8, wire: Buffer!) -> i32 {
    unsafe Connection!::write_final(unsafe kable_client_connection(client), wire, WRITE_TIMEOUT)
}

unsafe fn apply(client: *u8, action: Action!, head: bool, http10: bool) -> i32 {
    match action {
        Action!::Reply(response) => unsafe write_wire(client, response.encode(head, http10)),
        Action!::Deferred(plan) => {
            let flags = (if head { RESPONSE_HEAD } else { 0 }) | (if http10 { RESPONSE_HTTP10 } else { 0 });
            let submission = unsafe plan.submit(client, flags, kable_schedule);
            submission.unwrap_or_else(|rejection| rejection.scheduler_error)
        },
        Action!::File(reply) => unsafe write_file(client, reply, head, http10),
        Action!::Close => { unsafe kable_tcp_close(unsafe kable_client_connection(client)); 0 },
    }
}

unsafe fn write_file(client: *u8, reply: FileReply!, head: bool, http10: bool) -> i32 {
    let { file, content_type } = reply;
    let total = &file.len();
    let length = unsafe alloca[usize]();
    let range = unsafe kable_range_header(client, length);
    let exists 'k. (brand, access) = Exclusive!::fresh();
    // The span borrows the client's inline header bytes through range selection.
    let range = unsafe Span::from_raw_parts_branded(range, unsafe *length, brand);
    let (status, start, count) = select_file_range(&access, range, total);
    access.retire();
    let headers = encode_file_headers(status, content_type, start, count, total, http10);
    if head || count == 0 {
        file.close();
        return unsafe write_wire(client, headers);
    }
    let raw = unsafe kable_client_connection(client);
    let connection = match unsafe Connection!::begin_stream(raw, STREAM_IDLE) {
        Result::Ok(connection) => connection,
        Result::Err(error) => {
            headers.destroy();
            file.close();
            return error;
        },
    };
    unsafe write_then_next(connection, headers, file.chunks(start, count))
}

unsafe fn write_then_next(connection: Connection!, bytes: Buffer!, stream: FileChunks!) -> i32 {
    unsafe connection.submit_stream(
        |connection| connection.send(bytes),
        |result| unsafe write_joined(result, stream),
    )
}

unsafe fn write_joined(result: (Connection!, Completion[()]), stream: FileChunks!) -> i32 {
    let (connection, completion) = result;
    match completion {
        Completion::Ready => (),
        Completion::Cancelled | Completion::Failed => {
            stream.close();
            return unsafe connection.abort_stream();
        },
    }
    if &stream.remaining() == 0 {
        stream.close();
        return unsafe connection.finish_stream();
    }
    unsafe connection.submit_stream(
        |connection| stream.next().map(|chunk| (connection, chunk)),
        |result| unsafe chunk_joined(result),
    )
}

unsafe fn chunk_joined(result: (Connection!, (FileChunks!, StreamOutcome[Buffer!]))) -> i32 {
    let (connection, (stream, outcome)) = result;
    match outcome {
        StreamOutcome::Item(bytes) => unsafe write_then_next(connection, bytes, stream),
        _ => {
            stream.close();
            unsafe connection.abort_stream()
        },
    }
}

unsafe fn validate_head(major: u8, minor: u8, host_count: u32, upgrade_or_connect: u8,
    expect: u8, content_length: u64, body_limit: u64, bytes: *u8, len: usize, target_len: usize) -> u16 {
    let exists 'k. (brand, access) = Exclusive!::fresh();
    // The parser lends these bytes until the callback returns.
    let bytes = if len == 0 { Span::empty(&access) }
        else { unsafe Span::from_raw_parts_branded(bytes, len, brand) };
    let head = RequestHead.{
        major, minor, host_count, content_length,
        target: bytes.take(target_len), host: bytes.skip(target_len),
        upgrade_or_connect: upgrade_or_connect != 0, expect: expect != 0,
    };
    let status = validate_request_head(&access, head, body_limit).unwrap_or(0);
    access.retire();
    status
}

unsafe fn receive(client: *u8) -> i32 {
    let raw = unsafe kable_client_connection(client);
    let plan = prepare_hosted(unsafe Connection!::read_for_host(raw), |completion, client, flags| {
        if (flags & RESPONSE_ACTIVE) == 0 { return -1; }
        match completion {
            Completion::Ready => unsafe kable_receive_joined(client, 0),
            Completion::Cancelled => unsafe kable_receive_joined(client, 1),
            Completion::Failed => -1,
        }
    });
    let submission = unsafe plan.submit(client, 0, kable_receive_schedule);
    submission.unwrap_or_else(|rejection| rejection.scheduler_error)
}

unsafe fn respond(context: *u8, client: *u8, status: u16, method: u8, http10: u8,
    target: *u8, target_len: usize, body: *u8, body_len: usize) -> i32 {
    let head = method == 2u8;
    let http10 = http10 != 0u8;
    if status != 0u16 {
        return unsafe write_wire(client, Response!::rejected(status).encode(head, http10));
    }
    let method = match method {
        1u8 => Method::Get,
        2u8 => Method::Head,
        3u8 => Method::Post,
        _ => Method::Other,
    };
    let request = Request!.{
        method,
        target: unsafe Buffer!::new_with_cap(target_len).push_n(target, target_len),
        body: unsafe Buffer!::new_with_cap(body_len).push_n(body, body_len),
    };
    let { call } = unsafe *(unsafe (context as *Handler));
    unsafe apply(client, call(request), head, http10)
}

struct Server! { raw: *u8, context: *u8 }

impl Server! {
    /// Binds a handler that returns the action for each request.
    fn bind(port: u16, call: fn(Request!) -> Action!) -> Result[Server!, i32] {
        let context = HeapAllocator::alloc(sizeof[Handler]()).into_raw();
        unsafe *(unsafe (context as *Handler)) = Handler.{ call };

        let error = unsafe alloca[i32]();
        let raw = unsafe kable_bind(port, validate_head, receive, respond, context, error);
        if is_null(raw) {
            HeapAllocator::drop(unsafe HeapAllocator::adopt_raw(context));
            Result::Err.(unsafe *error)
        } else {
            Result::Ok.(Server!.{ raw, context })
        }
    }

    fn port(&self) -> u16 {
        let { raw, context } = self;
        let port = unsafe kable_port(raw);
        self = Server!.{ raw, context };
        port
    }

    /// Closes a bound server before running it.
    fn stop(self) {
        let { raw, context } = self;
        unsafe kable_stop(raw);
        HeapAllocator::drop(unsafe HeapAllocator::adopt_raw(context));
    }

    /// Runs until interrupted or a listener error shuts down the scope.
    fn run(self) -> Result[(), i32] {
        let { raw, context } = self;
        let status = unsafe kable_run(raw);
        HeapAllocator::drop(unsafe HeapAllocator::adopt_raw(context));
        if status == 0i32 { Result::Ok.(()) } else { Result::Err.(status) }
    }
}
