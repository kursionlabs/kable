//! Sends headers and file chunks on a connection with a response in progress.
use async::{FileChunks!, Scope!};
use std::buffer::Buffer!;
use task::{Completion, Sink, Stream, TransferStep};
use task::driver::Plan;
use tcp::{Connection!, host};

unsafe fn start(raw: *u8, connection: Connection!, chunks: FileChunks!, headers: Buffer!) -> i32 {
    unsafe write(raw, chunks, connection.send(headers))
}

forall Write where Plan[Write, Scope! -> (Connection!, Completion[()])].
unsafe fn write(raw: *u8, chunks: FileChunks!, plan: Write) -> i32 {
    unsafe host::submit_stream_plan(raw, plan, |result| {
        let (connection, completion) = result;
        match completion {
            Completion::Ready => unsafe read_next(raw, connection, chunks),
            _ => unsafe finish(connection, chunks, false),
        }
    })
}

unsafe fn read_next(raw: *u8, connection: Connection!, chunks: FileChunks!) -> i32 {
    if &chunks.remaining() == 0 { return unsafe finish(connection, chunks, true); }
    unsafe host::submit_stream_plan(raw, chunks.forward_next(connection), |result| {
        let (chunks, step) = result;
        match step {
            TransferStep::Send(plan) => unsafe write(raw, chunks, plan),
            End(connection, status) => unsafe finish(connection, chunks, false),
        }
    })
}

unsafe fn finish(connection: Connection!, chunks: FileChunks!, complete: bool) -> i32 {
    chunks.close();
    unsafe host::end_stream(connection, complete)
}
