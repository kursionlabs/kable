//! Serves regular files beneath the process working directory.
use std::fmt::Writer;
use async::{FileErrorKind, OpenedFile!, file_error_kind, open_file_beneath_cwd};
use http::{Method, Request!, Response!, ResponseHead, select_file_range};
use package::{Action!, kable_client_request, kable_range_header, reply, response_stream};
use std::buffer::Buffer!;
use std::cap::Exclusive!;
use std::mem::alloca;
use std::option::Option;
use std::raw::Span;
use std::slice::Slice;
use std::time::Duration;
use task::{Completion, PlanOutput};

/// Serves a request beneath the working directory. Keep that directory fixed while the server runs.
fn serve_from_cwd(request: Request!) -> Action! {
    var { method, target, body } = request;
    body.destroy();
    match method {
        Get | Head => (),
        _ => {
            target.destroy();
            return reply(Response!::method_not_allowed("GET, HEAD"));
        },
    }
    var path = match file_path(target) {
        Some(path) => path,
        None => return reply(Response!::rejected(400)),
    };
    var path = path;
    let content_type = path_type(&path);
    var exists 'k. (access, bytes, restore) = path.open();
    var file = open_file_beneath_cwd(&access, bytes);
    restore.restore(access).destroy();

    file.within(Duration::from_secs(2))
        .respond(|outcome| opened_file_reply(outcome, content_type))
}

fn opened_file_reply(outcome: Completion[OpenedFile!], content_type: Slice[u8, 'static]) -> Action! {
    let status = match outcome {
        Ready(file) => return file_reply(file, content_type),
        TimedOut => 504,
        Cancelled => 408,
        Failed(failure) => match file_error_kind(failure) {
            NotFound | NotADirectory | SymlinkLoop
                | CrossDevice | InvalidInput => 404,
            PermissionDenied | TooLarge => 403,
            Other => 500,
        },
    };
    reply(Response!::rejected(status))
}

fn file_reply(file: OpenedFile!, content_type: Slice[u8, 'static]) -> Action! {
    reply(response_stream::prepare(ResponseHead::new(200, content_type), file, |file, head, client| {
        var file = file;
        let total = &file.len();
        let length = unsafe alloca[usize]();
        let range = unsafe kable_range_header(unsafe kable_client_request(client), length);
        var exists 'k. (brand, access) = Exclusive!::fresh();
        let range = unsafe Span::from_raw_parts_branded(range, unsafe *length, brand);
        let (status, start, count) = select_file_range(&access, range, total);
        access.retire();
        (file.chunks(start, count), head.with_range(status, start, total), Option::Some.(count))
    }))
}

fn hex(byte: u8) -> Option[u8] {
    if byte >= b'0' && byte <= b'9' { return Option::Some.(byte - b'0'); }
    if byte >= b'a' && byte <= b'f' { return Option::Some.(byte - b'a' + 10); }
    if byte >= b'A' && byte <= b'F' { return Option::Some.(byte - b'A' + 10); }
    Option::None
}

fn file_path(target: Buffer!) -> Option[Buffer!] {
    var exists 'k. (access, bytes, restore) = target.open();
    let raw = Span::from_slice(bytes);
    var path = match raw.find_byte(&access, b'?', 0) {
        Some(end) => raw.take(end),
        None => raw,
    };
    var valid = path.len() > 0 && path.at(&access, 0) == b'/';
    var decoded = Buffer!::with_capacity(path.len());
    var last = b'/';
    var i: usize = 1;
    while valid && i < path.len() {
        var byte = path.at(&access, i);
        if byte == b'%' {
            if path.len() - i < 3 {
                valid = false;
            } else {
                let high = hex(path.at(&access, i + 1));
                let low = hex(path.at(&access, i + 2));
                valid = high.is_some() && low.is_some();
                if valid { byte = high.unwrap() * 16 + low.unwrap(); }
                i = i + 2;
            }
        }
        valid = valid && byte >= 32 && byte != 127 && byte != b'\\';
        if valid {
            decoded = decoded.write_byte(byte);
            last = byte;
        }
        i = i + 1;
    }
    restore.restore(access).destroy();
    if valid {
        Option::Some.(if last == b'/' { decoded.put("index.html") } else { decoded })
    } else {
        decoded.destroy();
        Option::None
    }
}

fn path_type(&path: Buffer!) -> Slice[u8, 'static] {
    var exists 'k. (access, bytes, restore) = path.open();
    let name = Span::from_slice(bytes);
    let suffix = match name.rfind_byte(&access, b'.') {
        Some(dot) => name.skip(dot),
        None => name.skip(name.len()),
    };
    let content_type =
        if suffix.is(&access, ".html") { "text/html; charset=utf-8" }
        else if suffix.is(&access, ".css") { "text/css; charset=utf-8" }
        else if suffix.is(&access, ".js") { "text/javascript; charset=utf-8" }
        else if suffix.is(&access, ".txt") { "text/plain; charset=utf-8" }
        else if suffix.is(&access, ".json") { "application/json" }
        else if suffix.is(&access, ".xml") { "application/xml" }
        else if suffix.is(&access, ".svg") { "image/svg+xml" }
        else if suffix.is(&access, ".png") { "image/png" }
        else if suffix.is(&access, ".jpg") || suffix.is(&access, ".jpeg") { "image/jpeg" }
        else if suffix.is(&access, ".gif") { "image/gif" }
        else if suffix.is(&access, ".webp") { "image/webp" }
        else if suffix.is(&access, ".ico") { "image/x-icon" }
        else { "application/octet-stream" };
    path = restore.restore(access);
    content_type
}
