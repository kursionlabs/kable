//! Sends a response from an owned byte stream.
use async::Scope!;
use async::host::prepare_hosted;
use http::{Response!, ResponseFraming, ResponseHead, encode_chunk};
use package::{kable_client_connection, kable_client_request, kable_release_request, submit_request, write_wire};
use std::buffer::Buffer!;
use std::heap::HeapAllocator;
use std::mem::sizeof;
use std::option::Option;
use std::slice::Slice;
use task::{Completion, Discard, Sink, Stream, StreamOutcome};
use task::driver::Plan;
use tcp::{Connection!, host};

const STREAM_IDLE: u64 = 5000;

extern "C" fn kable_client_input_complete(client: *u8) -> u8;

forall State, Source, Env.
struct PendingBody! {
    state: State,
    build: closure[Env](State, ResponseHead, *u8) -> (Source, ResponseHead, Option[u64]),
}

forall State, Source, Read, Env where Copy[Env], Discard[State], Discard[Source],
    Stream[Source -> Read], Plan[Read, Scope! -> (Source, StreamOutcome[Buffer!])].
fn prepare(head: ResponseHead, state: State,
    build: closure[Env](State, ResponseHead, *u8) -> (Source, ResponseHead, Option[u64])) -> Response! {
    let context = HeapAllocator::alloc(sizeof[PendingBody![State, Source, Env]]()).into_raw();
    unsafe *(unsafe (context as *PendingBody![State, Source, Env])) = PendingBody!.{ state, build };
    unsafe Response!::from_stream(head, context, start[State, Source, Read, Env], release[State, Source, Env])
}

forall State, Source, Env.
unsafe fn take(context: *u8) -> PendingBody![State, Source, Env] {
    let pending = unsafe *(unsafe (context as *PendingBody![State, Source, Env]));
    HeapAllocator::drop(unsafe HeapAllocator::adopt_raw(context));
    pending
}

forall State, Source, Env where Copy[Env], Discard[State].
unsafe fn release(context: *u8) {
    let { state, build } = unsafe take[State, Source, Env](context);
    state.discard();
}

impl Response! {
    /// Sends a known-length or EOF-terminated response from an owned source.
    forall Source, Read where Discard[Source], Stream[Source -> Read],
        Plan[Read, Scope! -> (Source, StreamOutcome[Buffer!])].
    fn stream(status: u16, content_type: Slice[u8, 'static], length: Option[u64], source: Source) -> Response! {
        prepare(ResponseHead::new(status, content_type), source, |source, head, client| (source, head, length))
    }
}

fn complete(framing: ResponseFraming) -> bool {
    match framing { Fixed(length) => length == 0, _ => false }
}

enum ResponseStep! {
    Send(ResponseFraming, Buffer!),
    Finish(bool),
}

fn frame(framing: ResponseFraming, outcome: StreamOutcome[Buffer!]) -> ResponseStep! {
    let bytes = match outcome {
        StreamOutcome::Item(bytes) => bytes,
        Eof => return match framing {
            Chunked => ResponseStep!::Send.(ResponseFraming::Fixed.(0), Buffer!::new().push_static("0\r\n\r\n")),
            CloseDelimited => ResponseStep!::Finish.(true),
            Fixed => ResponseStep!::Finish.(false),
        },
        _ => return ResponseStep!::Finish.(false),
    };
    match framing {
        Fixed(remaining) => {
            let length = &bytes.len() as u64;
            if length > remaining {
                bytes.destroy();
                ResponseStep!::Finish.(false)
            } else { ResponseStep!::Send.(ResponseFraming::Fixed.(remaining - length), bytes) }
        },
        Chunked => ResponseStep!::Send.(framing, encode_chunk(bytes)),
        CloseDelimited => ResponseStep!::Send.(framing, bytes),
    }
}

forall State, Source, Read, Env where Copy[Env], Discard[Source], Stream[Source -> Read],
    Plan[Read, Scope! -> (Source, StreamOutcome[Buffer!])].
unsafe fn start(context: *u8, client: *u8, response: ResponseHead, head: bool, http10: bool) -> i32 {
    let { state, build } = unsafe take[State, Source, Env](context);
    let (source, response, length) = build(state, response, client);
    let framing = match length {
        Some(length) => ResponseFraming::Fixed.(length),
        None => if http10 { ResponseFraming::CloseDelimited } else { ResponseFraming::Chunked },
    };
    let headers = response.encode(framing, http10);
    if head || complete(framing) {
        source.discard();
        return unsafe write_wire(client, headers);
    }
    let raw = unsafe kable_client_connection(client);
    let input_complete = (unsafe kable_client_input_complete(client)) != 0;
    let connection = match unsafe host::begin_stream(raw, STREAM_IDLE, input_complete) {
        Ok(connection) => connection,
        Err(error) => {
            source.discard();
            headers.destroy();
            return error;
        },
    };
    unsafe write(client, connection, source, framing, headers)
}

forall Task, Output, Env where Plan[Task, Scope! -> Output].
unsafe fn submit(client: *u8, task: Task, resume: closure[Env](Output) -> i32) -> i32 {
    let hosted = prepare_hosted(task, |outcome, host, flags| resume(outcome));
    unsafe submit_request(client, hosted, 0)
}

forall Source, Read where Discard[Source], Stream[Source -> Read],
    Plan[Read, Scope! -> (Source, StreamOutcome[Buffer!])].
unsafe fn write(client: *u8, connection: Connection!, source: Source, framing: ResponseFraming, bytes: Buffer!) -> i32 {
    unsafe submit(client, connection.send(bytes), |result| {
        let (connection, completion) = result;
        match completion {
            Completion::Ready => unsafe read_next(client, connection, source, framing),
            _ => unsafe finish(client, connection, source, false),
        }
    })
}

forall Source, Read where Discard[Source], Stream[Source -> Read],
    Plan[Read, Scope! -> (Source, StreamOutcome[Buffer!])].
unsafe fn read_next(client: *u8, connection: Connection!, source: Source, framing: ResponseFraming) -> i32 {
    if complete(framing) { return unsafe finish(client, connection, source, true); }
    unsafe submit(client, source.next(), |result| {
        let (source, outcome) = result;
        match frame(framing, outcome) {
            Send(framing, bytes) => unsafe write(client, connection, source, framing, bytes),
            Finish(complete) => unsafe finish(client, connection, source, complete),
        }
    })
}

forall Source where Discard[Source].
unsafe fn finish(client: *u8, connection: Connection!, source: Source, complete: bool) -> i32 {
    source.discard();
    unsafe kable_release_request(unsafe kable_client_request(client));
    unsafe host::end_stream(connection, complete)
}
