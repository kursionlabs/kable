//! Request validation and ownership, and HTTP response serialization.
use std::ascii::{is_digit, to_lower};
use std::buffer::Buffer!;
use std::cmp::min;
use std::option::Option;
use std::raw::Span;
use std::slice::{ReadBytes, Slice, StaticRead};

exposed enum Method { Other, Get, Head, Post }

forall 'k.
exposed struct RequestHead {
    major: u8,
    minor: u8,
    host_count: u32,
    host: Span['k],
    upgrade_or_connect: bool,
    target: Span['k],
    expect: bool,
    content_length: u64,
}

/// Checks the request before reading its body and returns any rejection status.
forall C, 'k where ReadBytes[C, Span['k]].
fn validate_request_head(&access: C, head: RequestHead['k], body_limit: u64) -> Option[u16] {
    let { major, minor, host_count, host, upgrade_or_connect, target, expect, content_length } = head;
    if major != 1 || minor > 1 { return Option::Some.(505); }
    if host_count > 1 || (minor == 1 && host_count == 0) || (host_count == 1 && !valid_host(&access, host)) {
        return Option::Some.(400);
    }
    if upgrade_or_connect { return Option::Some.(501); }
    if target.byte_or_zero(&access, 0) != b'/' || target.find_byte(&access, b'#', 0).is_some() {
        return Option::Some.(400);
    }
    if expect { return Option::Some.(417); }
    if content_length > body_limit { return Option::Some.(413); }
    Option::None
}

forall C, 'k where ReadBytes[C, Span['k]].
fn valid_host(&access: C, host: Span['k]) -> bool {
    let host = skip_header_space(&access, host);
    if host.is_empty() { return false; }
    var i = 0;
    while i < host.len() {
        let byte = host.at(&access, i);
        if header_space(byte) { return skip_header_space(&access, host.skip(i)).is_empty(); }
        if byte < b'!' || byte > b'~' || byte == b',' { return false; }
        i = i + 1;
    }
    true
}

/// The read capability for one request body.
struct Body! { key: u64, length: Option[u64] }

impl Body! {
    /// The server supplies the unique key of its live request.
    unsafe fn from_request(key: u64, length: Option[u64]) -> Body! { Body!.{ key, length } }

    /// Returns the original declared Content-Length, if present.
    fn content_length(&self) -> Option[u64] {
        let { key, length } = self;
        self = Body!.{ key, length };
        length
    }

    /// Identifies the host that can drive this body.
    fn request_key(&self) -> u64 {
        let { key, length } = self;
        self = Body!.{ key, length };
        key
    }

    fn destroy(self) { let { key, length } = self; }
}

exposed struct Request! {
    method: Method,
    target: Buffer!,
    body: Body!,
}

impl Request! {
    /// Checks the request path before the query string.
    fn path_is(&self, path: Slice[u8, 'static]) -> bool {
        let { method, target, body } = self;
        let exists 'k. (access, bytes, restore) = target.open();
        let raw = Span::from_slice(bytes);
        let raw = match raw.find_byte(&access, b'?', 0usize) {
            Some(end) => raw.take(end),
            None => raw,
        };
        let matches = raw.is(&access, path);
        self = Request!.{ method, target: restore.restore(access), body };
        matches
    }

    fn destroy(self) {
        let { method, target, body } = self;
        target.destroy();
        body.destroy();
    }
}

struct Response! {
    status: u16,
    content_type: Slice[u8, 'static],
    allow: Slice[u8, 'static],
    body: Buffer!,
}

fn reason(status: u16) -> Slice[u8, 'static] {
    match status {
        200u16 => "OK",
        206 => "Partial Content",
        400u16 => "Bad Request",
        403 => "Forbidden",
        404u16 => "Not Found",
        405u16 => "Method Not Allowed",
        408u16 => "Request Timeout",
        413u16 => "Content Too Large",
        416 => "Range Not Satisfiable",
        417u16 => "Expectation Failed",
        431u16 => "Request Header Fields Too Large",
        501u16 => "Not Implemented",
        504u16 => "Gateway Timeout",
        505u16 => "HTTP Version Not Supported",
        _ => "Internal Server Error",
    }
}

impl Response! {
    fn destroy(self) {
        let { status, content_type, allow, body } = self;
        body.destroy();
    }

    fn ok(body: Buffer!) -> Response! {
        Response!::bytes(body, "application/octet-stream")
    }

    fn bytes(body: Buffer!, content_type: Slice[u8, 'static]) -> Response! {
        Response!.{ status: 200, content_type, allow: "", body }
    }

    fn text(status: u16, text: Slice[u8, 'static]) -> Response! {
        Response!.{
            status, content_type: "text/plain; charset=utf-8", allow: "",
            body: Buffer!::new().push_static(text),
        }
    }

    fn method_not_allowed(allow: Slice[u8, 'static]) -> Response! {
        let { status, content_type, allow: empty, body } =
            Response!::text(405u16, "Method Not Allowed\n");
        Response!.{ status, content_type, allow, body }
    }

    fn rejected(status: u16) -> Response! {
        Response!.{
            status, content_type: "text/plain; charset=utf-8", allow: "",
            body: Buffer!::new().push_static(reason(status)).push_static("\n"),
        }
    }

    fn encode(self, head: bool, http10: bool) -> Buffer! {
        let { status, content_type, allow, body } = self;
        let length = &body.len();
        let wire = encode_headers(status, content_type, allow, length as u64, http10);
        if head {
            body.destroy();
            wire
        } else {
            wire.push_buffer(body)
        }
    }
}

fn encode_headers(status: u16, content_type: Slice[u8, 'static], allow: Slice[u8, 'static],
    length: u64, http10: bool) -> Buffer! {
    let wire = header_fields(status, content_type, length, http10);
    let wire = if allow.is_empty() { wire }
        else { wire.push_static("Allow: ").push_static(allow).push_static("\r\n") };
    wire.push_static("\r\n")
}

fn header_space(byte: u8) -> bool { byte == b' ' || byte == b'\t' }

forall C, 'k where ReadBytes[C, Span['k]].
fn skip_header_space(&access: C, bytes: Span['k]) -> Span['k] {
    var start = 0;
    while header_space(bytes.byte_or_zero(&access, start)) { start = start + 1; }
    bytes.skip(start)
}

// Saturate oversized positions while continuing to validate the decimal digits.
forall C, 'k where ReadBytes[C, Span['k]].
fn decimal_prefix(&access: C, bytes: Span['k]) -> (u64, usize) {
    var number = 0;
    var count = 0;
    var byte = bytes.byte_or_zero(&access, count);
    while is_digit(byte) {
        let digit = (byte - b'0') as u64;
        number = if number > (u64::MAX - digit) / 10 { u64::MAX } else { number * 10 + digit };
        count = count + 1;
        byte = bytes.byte_or_zero(&access, count);
    }
    (number, count)
}

/// Selects the status, offset, and length for a file and an eligible Range value.
/// An empty or unsupported header selects the whole file.
forall C, 'k where ReadBytes[C, Span['k]].
fn select_file_range(&access: C, header: Span['k], total: u64) -> (u16, u64, u64) {
    let whole = (200u16, 0u64, total);
    let header = skip_header_space(&access, header);
    var end = header.len();
    while end > 0 && header_space(header.at(&access, end - 1)) { end = end - 1; }
    let unit: Slice[u8, 'static] = "bytes=";
    if end < unit.len() { return whole; }
    let static_access = StaticRead::new();
    var i = 0;
    while i < unit.len() {
        if to_lower(header.at(&access, i)) != unit.byte_or_zero(&static_access, i) { return whole; }
        i = i + 1;
    }

    let positions = skip_header_space(&access, header.slice(unit.len(), end));
    let (first, digits) = decimal_prefix(&access, positions);
    if positions.byte_or_zero(&access, digits) != b'-' { return whole; }
    let suffix = digits == 0;
    let rest = positions.skip(digits + 1);
    let last = if !suffix && rest.is_empty() { u64::MAX } else {
        let (last, digits) = decimal_prefix(&access, rest);
        if digits == 0 || digits != rest.len() || (!suffix && last < first) { return whole; }
        last
    };

    if suffix && last != 0 && total == 0 { return whole; }
    if (suffix && last == 0) || first >= total { return (416, 0, 0); }
    if suffix {
        let length = min(last, total);
        (206, total - length, length)
    } else {
        (206, first, min(last, total - 1) - first + 1)
    }
}

fn encode_file_headers(status: u16, content_type: Slice[u8, 'static], offset: u64,
    length: u64, total: u64, http10: bool) -> Buffer! {
    let content_type = if status == 416 { "text/plain; charset=utf-8" } else { content_type };
    let wire = header_fields(status, content_type, length, http10)
        .push_static("Accept-Ranges: bytes\r\n");
    let wire = match status {
        206 => wire.push_static("Content-Range: bytes ")
            .push_u64(offset).push_static("-").push_u64(offset + length - 1)
            .push_static("/").push_u64(total).push_static("\r\n"),
        416 => wire.push_static("Content-Range: bytes */").push_u64(total).push_static("\r\n"),
        _ => wire,
    };
    wire.push_static("\r\n")
}

fn header_fields(status: u16, content_type: Slice[u8, 'static], length: u64, http10: bool) -> Buffer! {
    let version = if http10 { "HTTP/1.0 " } else { "HTTP/1.1 " };
    Buffer!::new().push_static(version)
        .push_usize(status as usize).push_static(" ").push_static(reason(status))
        .push_static("\r\nContent-Type: ").push_static(content_type)
        .push_static("\r\nContent-Length: ").push_u64(length)
        .push_static("\r\nConnection: close\r\n")
}
