//! Scoped TCP reads and writes on a listener's event loop.
use async::Scope!;
use async::host::{HostedPlan!, prepare_hosted};
use std::heap::HeapAllocator;
use std::buffer::Buffer!;
use std::mem::{alloca, sizeof};
use std::option::{Option, Result};
use std::ptr::{is_null, null};
use task::{Completion, Failure, PlanOutput, Sink, Stream, StreamOutcome};
use task::driver::Plan;

extern "C" fn kable_tcp_bind(port: u16, context: *u8,
    callback: unsafe fn(*u8, *u8, u8, *u8, usize, i32) -> i32, error: *i32) -> *u8;
extern "C" fn kable_tcp_port(listener: *u8) -> u16;
extern "C" fn kable_tcp_run(listener: *u8) -> i32;
extern "C" fn kable_tcp_stop(listener: *u8) -> ();
extern "C" fn kable_tcp_close(connection: *u8) -> ();
extern "C" fn kable_tcp_start_scoped_read(connection: *u8, loop: *u8,
    ready: unsafe fn(*u8) -> (), context: *u8) -> i32;
extern "C" fn kable_tcp_stop_scoped_read(connection: *u8) -> u8;
extern "C" fn kable_tcp_read_result(connection: *u8, bytes: *(*u8), len: *usize, error: *i32) -> u8;
extern "C" fn kable_tcp_new_scoped_write(connection: *u8, bytes: *u8, len: usize) -> *u8;
extern "C" fn kable_tcp_start_scoped_write(request: *u8, loop: *u8,
    ready: unsafe fn(*u8) -> (), context: *u8) -> i32;
extern "C" fn kable_tcp_stop_scoped_write(request: *u8) -> u8;
extern "C" fn kable_tcp_collect_scoped_write(request: *u8) -> i32;
extern "C" fn kable_tcp_schedule(connection: *u8, scope: *u8, root: usize, plan: *u8,
    finish: unsafe fn(*u8, *u8, u8) -> i32, flags: u8) -> i32;
extern "C" fn kable_tcp_finish_begin(connection: *u8, write_ms: u64) -> i32;
extern "C" fn kable_tcp_stream_begin(connection: *u8, idle_ms: u64) -> i32;
extern "C" fn kable_tcp_stream_end(connection: *u8) -> i32;

struct Connection! { raw: *u8 }

forall State, Output.
struct OperationPlan! {
    state: State,
    prepare: fn(&_: State) -> *u8,
    start: unsafe fn(*u8, *u8, unsafe fn(*u8) -> (), *u8) -> i32,
    stop: unsafe fn(*u8) -> u8,
    finish: fn(State, *u8, Completion[()]) -> Output,
    context: *u8,
    id: Option[usize],
}

forall State, Output.
instance PlanOutput[OperationPlan![State, Output] -> Output] {}

forall State, Output.
instance Plan[OperationPlan![State, Output], Scope! -> Output] {
    fn stage(&task: OperationPlan![State, Output], &scope: Scope!) -> Option[usize] {
        let { state, prepare, start, stop, finish, context, id } = task;
        let context = prepare(&state);
        let id = unsafe &scope.add_operation(context, start, stop);
        task = OperationPlan!.{ state, prepare, start, stop, finish, context, id };
        id
    }

    fn collect(task: OperationPlan![State, Output], &scope: Scope!) -> Output {
        let { state, prepare, start, stop, finish, context, id } = task;
        finish(state, context, (&scope.result(id)).completion())
    }
}

fn prepare_read(&connection: Connection!) -> *u8 {
    let { raw } = connection;
    connection = Connection!.{ raw };
    raw
}

fn finish_read(connection: Connection!, context: *u8, completion: Completion[()]) -> (Connection!, StreamOutcome[Buffer!]) {
    let outcome = match completion {
        Completion::Ready => unsafe read_result(context),
        Completion::Cancelled => StreamOutcome::Cancelled,
        Completion::Failed(failure) => StreamOutcome::Failed.(failure),
    };
    (connection, outcome)
}

fn finish_host_read(connection: Connection!, context: *u8, completion: Completion[()]) -> Completion[()] {
    let { raw } = connection;
    completion
}

forall Output.
fn read_plan(connection: Connection!, finish: fn(Connection!, *u8, Completion[()]) -> Output)
    -> OperationPlan![Connection!, Output] {
    OperationPlan!.{
        state: connection, prepare: prepare_read, start: kable_tcp_start_scoped_read,
        stop: kable_tcp_stop_scoped_read, finish, context: null(), id: Option::None,
    }
}

fn prepare_write(&state: (Connection!, Buffer!)) -> *u8 {
    let ({ raw }, bytes) = state;
    let request = unsafe kable_tcp_new_scoped_write(raw, unsafe &bytes.as_ptr(), &bytes.len());
    state = (Connection!.{ raw }, bytes);
    request
}

fn finish_write(state: (Connection!, Buffer!), request: *u8, completion: Completion[()])
    -> (Connection!, Buffer!, Completion[()]) {
    let (connection, bytes) = state;
    // Collection frees the native request on every outcome.
    let status = unsafe kable_tcp_collect_scoped_write(request);
    let completion = completion.and_then(|unit| {
        if status < 0 { Completion::Failed.(Failure::Operation.(status)) } else { Completion::Ready.(unit) }
    });
    (connection, bytes, completion)
}

unsafe fn read_result(raw: *u8) -> StreamOutcome[Buffer!] {
    let data = unsafe alloca[*u8]();
    let len = unsafe alloca[usize]();
    let status = unsafe alloca[i32]();
    let event = unsafe kable_tcp_read_result(raw, data, len, status);
    match event {
        1u8 => {
            let bytes = unsafe *data;
            let length = unsafe *len;
            let chunk = unsafe Buffer!::new_with_cap(length).push_n(bytes, length);
            StreamOutcome::Item.(chunk)
        },
        3u8 => StreamOutcome::Eof,
        _ => StreamOutcome::Failed.(Failure::Operation.(unsafe *status)),
    }
}

enum Action! {
    Scoped(HostedPlan!),
    Close(Connection!),
}

forall Task, Output where PlanOutput[Task -> Output].
impl Task {
    /// Runs a plan on the connection's listener and resumes after it joins.
    forall Env where Plan[Task, Scope! -> Output].
    fn defer_tcp(self, resume: closure[Env](Output) -> Action!) -> Action! {
        let hosted = prepare_hosted(self, |outcome, connection, flags| unsafe apply(connection, resume(outcome)));
        Action!::Scoped.(hosted)
    }
}

impl Connection! {
    /// Runs a read for the host, which borrows the native bytes on join.
    /// The host keeps the connection valid and owns it through collection.
    unsafe fn read_for_host(raw: *u8) -> OperationPlan![Connection!, Completion[()]] {
        read_plan(Connection!.{ raw }, finish_host_read)
    }

    /// Takes the host's connection for one write, then half-closes and drains.
    /// The host lends a live connection with no other owner. The plan owns
    /// the buffer until the write joins.
    unsafe fn write_final(raw: *u8, bytes: Buffer!, write_ms: u64) -> i32 {
        let status = unsafe kable_tcp_finish_begin(raw, write_ms);
        if status < 0 {
            bytes.destroy();
            return status;
        }
        let connection = Connection!.{ raw };
        unsafe connection.submit_stream(
            |connection| connection.send(bytes),
            |result| {
                let (connection, completion) = result;
                match completion {
                    Completion::Ready => unsafe connection.finish_stream(),
                    Completion::Cancelled | Completion::Failed => unsafe connection.abort_stream(),
                }
            },
        )
    }

    /// Begins a response on the host's idle connection. The host must keep
    /// the pointer valid until the response finishes and give it one owner.
    unsafe fn begin_stream(raw: *u8, idle_ms: u64) -> Result[Connection!, i32] {
        let status = unsafe kable_tcp_stream_begin(raw, idle_ms);
        if status < 0 { Result::Err.(status) }
        else { Result::Ok.(Connection!.{ raw }) }
    }

    /// Submits one stage of a response. The builder transfers ownership of the
    /// connection into the plan. The callback also receives rejected outcomes.
    forall Task, Output, BuildEnv, ResumeEnv where Plan[Task, Scope! -> Output].
    unsafe fn submit_stream(self, build: closure[BuildEnv](Connection!) -> Task,
        resume: closure[ResumeEnv](Output) -> i32) -> i32 {
        let { raw } = self;
        let task = build(Connection!.{ raw });
        let plan = prepare_hosted(task, |outcome, host, flags| resume(outcome));
        let submission = unsafe plan.submit(raw, 0, kable_tcp_schedule);
        submission.unwrap_or_else(|rejection| rejection.scheduler_error)
    }

    /// Returns the connection to the host for half-close and drain.
    unsafe fn finish_stream(self) -> i32 {
        let { raw } = self;
        unsafe kable_tcp_stream_end(raw)
    }

    /// Returns ownership to the host. The caller must return the failure
    /// status to that host so it closes the response.
    unsafe fn abort_stream(self) -> i32 {
        let { raw } = self;
        -1
    }

    /// Closes the connection when the listener handles the returned action.
    fn close(self) -> Action! { Action!::Close.(self) }
}

instance Stream[Connection! -> OperationPlan![Connection!, (Connection!, StreamOutcome[Buffer!])]] {
    /// Plans one read. EOF hands back the connection with its write side available.
    fn next(source: Connection!) -> OperationPlan![Connection!, (Connection!, StreamOutcome[Buffer!])] {
        read_plan(source, finish_read)
    }
}

instance Sink[Connection! -> Buffer!, OperationPlan![(Connection!, Buffer!), (Connection!, Buffer!, Completion[()])]] {
    /// Returns the connection and buffer after the write joins. Cancelling an
    /// in-flight write closes the socket. An interrupted write may be partial.
    fn write(connection: Connection!, bytes: Buffer!)
        -> OperationPlan![(Connection!, Buffer!), (Connection!, Buffer!, Completion[()])] {
        OperationPlan!.{
            state: (connection, bytes), prepare: prepare_write, start: kable_tcp_start_scoped_write,
            stop: kable_tcp_stop_scoped_write, finish: finish_write, context: null(), id: Option::None,
        }
    }
}

struct Handler { accept: fn(Connection!) -> Action! }

unsafe fn dispatch(context: *u8, raw: *u8, kind: u8, bytes: *u8, len: usize, code: i32) -> i32 {
    if kind != 0 {
        unsafe kable_tcp_close(raw);
        return 0;
    }
    let { accept } = unsafe *(unsafe (context as *Handler));
    unsafe apply(raw, accept(Connection!.{ raw }))
}

unsafe fn apply(connection: *u8, action: Action!) -> i32 {
    match action {
        Action!::Scoped(plan) => {
            let submission = unsafe plan.submit(connection, 0, kable_tcp_schedule);
            submission.unwrap_or_else(|rejection| rejection.continuation_status)
        },
        Action!::Close(connection) => {
            let { raw } = connection;
            unsafe kable_tcp_close(raw);
            0i32
        },
    }
}

struct Listener! { raw: *u8, context: *u8 }

impl Listener! {
    /// Calls accept once per connection. Use defer_tcp to run its scoped plans.
    fn bind_connections(port: u16, accept: fn(Connection!) -> Action!) -> Result[Listener!, i32] {
        let context = HeapAllocator::alloc(sizeof[Handler]()).into_raw();
        unsafe *(unsafe (context as *Handler)) = Handler.{ accept };

        let scratch = Buffer!::new_zeroed(sizeof[i32]());
        let error = unsafe ((unsafe &scratch.as_ptr()) as *i32);
        let raw = unsafe kable_tcp_bind(port, context, dispatch, error);
        let status = unsafe *error;
        scratch.destroy();
        if is_null(raw) {
            HeapAllocator::drop(unsafe HeapAllocator::adopt_raw(context));
            Result::Err.(status)
        } else {
            Result::Ok.(Listener!.{ raw, context })
        }
    }

    fn port(&self) -> u16 {
        let { raw, context } = self;
        let port = unsafe kable_tcp_port(raw);
        self = Listener!.{ raw, context };
        port
    }

    /// Closes a listener before entering the event loop.
    fn stop(self) {
        let { raw, context } = self;
        unsafe kable_tcp_stop(raw);
        HeapAllocator::drop(unsafe HeapAllocator::adopt_raw(context));
    }

    /// Runs until shutdown, joining all connections before releasing the handler.
    fn run(self) -> Result[(), i32] {
        let { raw, context } = self;
        let status = unsafe kable_tcp_run(raw);
        HeapAllocator::drop(unsafe HeapAllocator::adopt_raw(context));
        if status == 0i32 { Result::Ok.(()) } else { Result::Err.(status) }
    }
}
