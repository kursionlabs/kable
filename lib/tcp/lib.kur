//! Scoped TCP reads and writes on a listener's event loop.
use async::Scope!;
use async::host::{HostedPlan!, prepare_hosted};
use std::alloc::heap::HeapAllocator;
use std::bytes::buffer::Buffer!;
use std::mem::{alloca, sizeof};
use std::option::{Option, Result};
use std::ptr::{is_null, null};
use task::{Completion, PlanOutput, Sink, Stream, StreamOutcome!};
use task::driver::{Plan, Resolution};

extern "C" fn kable_tcp_bind(port: u16, context: *u8,
    callback: unsafe fn(*u8, *u8, u8, *u8, usize, i32) -> i32, error: *i32) -> *u8;
extern "C" fn kable_tcp_port(listener: *u8) -> u16;
extern "C" fn kable_tcp_run(listener: *u8) -> i32;
extern "C" fn kable_tcp_stop(listener: *u8) -> ();
extern "C" fn kable_tcp_read(connection: *u8, ms: u64, timed: u8) -> i32;
extern "C" fn kable_tcp_write(connection: *u8, bytes: *u8, len: usize, ms: u64, timed: u8) -> i32;
extern "C" fn kable_tcp_close(connection: *u8) -> ();
extern "C" fn kable_tcp_attach(connection: *u8, state: *u8, dispose: unsafe fn(*u8) -> ()) -> ();
extern "C" fn kable_tcp_attachment(connection: *u8) -> *u8;
extern "C" fn kable_tcp_start_scoped_read(connection: *u8, loop: *u8,
    ready: unsafe fn(*u8) -> (), context: *u8) -> i32;
extern "C" fn kable_tcp_stop_scoped_read(connection: *u8) -> u8;
extern "C" fn kable_tcp_read_result(connection: *u8, bytes: *(*u8), len: *usize, error: *i32) -> u8;
extern "C" fn kable_tcp_new_scoped_write(connection: *u8, bytes: *u8, len: usize) -> *u8;
extern "C" fn kable_tcp_start_scoped_write(request: *u8, loop: *u8,
    ready: unsafe fn(*u8) -> (), context: *u8) -> i32;
extern "C" fn kable_tcp_stop_scoped_write(request: *u8) -> u8;
extern "C" fn kable_tcp_collect_scoped_write(request: *u8) -> i32;
extern "C" fn kable_tcp_schedule(connection: *u8, scope: *u8, root: usize, plan: *u8,
    finish: unsafe fn(*u8, *u8, u8) -> i32) -> i32;

struct Connection! { raw: *u8 }
struct Read! { connection: Connection!, deadline: Option[u64] }
struct NextRead! { connection: Connection!, id: Option[usize] }
struct WritePlan! { connection: Connection!, bytes: Buffer!, request: *u8, id: Option[usize] }

instance PlanOutput[NextRead! -> (Connection!, StreamOutcome![Buffer!])] {}

instance Plan[NextRead!, Scope! -> (Connection!, StreamOutcome![Buffer!])] {
    fn stage(&task: NextRead!, &scope: Scope!) -> Option[usize] {
        let { connection: { raw }, id } = task;
        let id = unsafe &scope.add_operation(raw, kable_tcp_start_scoped_read, kable_tcp_stop_scoped_read);
        task = NextRead!.{ connection: Connection!.{ raw }, id };
        id
    }

    fn collect(task: NextRead!, &scope: Scope!) -> (Connection!, StreamOutcome![Buffer!]) {
        let { connection: { raw }, id } = task;
        let outcome = match &scope.result(id) {
            Resolution::Completed => unsafe read_result(raw),
            Resolution::Cancelled => StreamOutcome!::Cancelled,
            Resolution::Failed(status) => StreamOutcome!::Failed.(status),
            Resolution::First | Resolution::Second => StreamOutcome!::Failed.(-1),
        };
        (Connection!.{ raw }, outcome)
    }
}

instance PlanOutput[WritePlan! -> (Connection!, Buffer!, Completion[()])] {}

instance Plan[WritePlan!, Scope! -> (Connection!, Buffer!, Completion[()])] {
    fn stage(&task: WritePlan!, &scope: Scope!) -> Option[usize] {
        let { connection: { raw }, bytes, request, id } = task;
        let request = unsafe kable_tcp_new_scoped_write(raw, unsafe &bytes.as_ptr(), &bytes.len());
        let id = unsafe &scope.add_operation(request, kable_tcp_start_scoped_write, kable_tcp_stop_scoped_write);
        task = WritePlan!.{ connection: Connection!.{ raw }, bytes, request, id };
        id
    }

    fn collect(task: WritePlan!, &scope: Scope!) -> (Connection!, Buffer!, Completion[()]) {
        let { connection, bytes, request, id } = task;
        let status = unsafe kable_tcp_collect_scoped_write(request);
        let completion = match &scope.result(id) {
            Resolution::Completed => {
                if status < 0 { Completion::Failed.(status) } else { Completion::Ready.(()) }
            },
            Resolution::Cancelled => Completion::Cancelled,
            Resolution::Failed(code) => Completion::Failed.(code),
            Resolution::First | Resolution::Second => Completion::Failed.(-1),
        };
        (connection, bytes, completion)
    }
}

unsafe fn read_result(raw: *u8) -> StreamOutcome![Buffer!] {
    let data = unsafe alloca[*u8]();
    let len = unsafe alloca[usize]();
    let status = unsafe alloca[i32]();
    let event = unsafe kable_tcp_read_result(raw, data, len, status);
    match event {
        1u8 => {
            let bytes = unsafe *data;
            let length = unsafe *len;
            StreamOutcome!::Item.(unsafe Buffer!::new_with_cap(length).push_n(bytes, length))
        },
        3u8 => StreamOutcome!::End,
        _ => StreamOutcome!::Failed.(unsafe *status),
    }
}

/// Plans a read of the next available chunk of bytes.
fn read(connection: Connection!) -> Read! { Read!.{ connection, deadline: Option::None } }

/// Sets the read deadline relative to the time the read begins.
fn timeout(ms: u64, task: Read!) -> Read! {
    let { connection, deadline } = task;
    Read!.{ connection, deadline: Option::Some.(ms) }
}

exposed enum Event! {
    Connected(Connection!),
    Bytes(Connection!, Buffer!),
    TimedOut(Connection!),
    End(Connection!),
    Cancelled(Connection!),
    Failed(Connection!, i32),
}

enum Action! {
    Wait(Read!),
    Write(Buffer!, Read!),
    Scoped(HostedPlan!),
    Close(Connection!),
}

/// Runs a plan on the connection's listener and resumes after it joins.
forall Task, Output, Env where PlanOutput[Task -> Output], Plan[Task, Scope! -> Output].
fn defer(task: Task, resume: closure[Env](Output) -> Action!) -> Action! {
    let hosted = prepare_hosted(task, |outcome, connection, flags| unsafe apply(connection, resume(outcome)));
    Action!::Scoped.(hosted)
}

fn wait(task: Read!) -> Action! { Action!::Wait.(task) }

/// Writes one chunk, then starts the next read on the same connection.
fn write(bytes: Buffer!, next: Read!) -> Action! {
    Action!::Write.(bytes, next)
}

fn close(connection: Connection!) -> Action! { Action!::Close.(connection) }

impl Connection! {
    /// Plans a read of the next available chunk of bytes.
    fn read(self) -> Read! { read(self) }

    /// Closes the connection when the listener handles the returned action.
    fn close(self) -> Action! { close(self) }
}

instance Stream[Connection! -> NextRead!] {
    /// Plans one read. EOF hands back the connection with its write side available.
    fn next(source: Connection!) -> NextRead! { NextRead!.{ connection: source, id: Option::None } }
}

instance Sink[Connection! -> Buffer!, WritePlan!] {
    /// Returns the connection and buffer after the write joins. Cancelling an
    /// in-flight write closes the socket. An interrupted write may be partial.
    fn write(connection: Connection!, bytes: Buffer!) -> WritePlan! {
        WritePlan!.{ connection, bytes, request: null(), id: Option::None }
    }
}

impl Read! {
    /// Sets the deadline relative to the time the read begins.
    fn timeout(self, ms: u64) -> Read! { timeout(ms, self) }

    /// Returns an action that starts this read.
    fn wait(self) -> Action! { wait(self) }
}

enum Handler {
    Connections(fn(Connection!) -> Action!),
    Events(fn(Event!) -> Action!),
}

forall State.
struct StatefulHandler {
    start: fn() -> State,
    handle: fn(State, Event!) -> (State, Action!),
    finish: fn(State) -> (),
}

forall State.
struct Session! { state: State, finish: fn(State) -> () }

unsafe fn make_event(raw: *u8, kind: u8, bytes: *u8, len: usize, code: i32) -> Event! {
    let connection = Connection!.{ raw };
    match kind {
        0u8 => Event!::Connected.(connection),
        1u8 => Event!::Bytes.(connection, unsafe Buffer!::new_with_cap(len).push_n(bytes, len)),
        2u8 => Event!::TimedOut.(connection),
        3u8 => Event!::End.(connection),
        4u8 => Event!::Cancelled.(connection),
        _ => Event!::Failed.(connection, code),
    }
}

unsafe fn dispatch(context: *u8, raw: *u8, kind: u8, bytes: *u8, len: usize, code: i32) -> i32 {
    let handler = unsafe *(unsafe (context as *Handler));
    let action = match handler {
        Handler::Connections(accept) => {
            let connection = Connection!.{ raw };
            if kind == 0 { accept(connection) } else { connection.close() }
        },
        Handler::Events(handle) => handle(unsafe make_event(raw, kind, bytes, len, code)),
    };
    unsafe apply(raw, action)
}

forall State.
unsafe fn finish_session(raw: *u8) {
    let { state, finish } = unsafe *(unsafe (raw as *Session![State]));
    HeapAllocator::drop(unsafe HeapAllocator::adopt_raw(raw));
    finish(state);
}

forall State.
unsafe fn dispatch_stateful(context: *u8, connection: *u8, kind: u8,
    bytes: *u8, len: usize, code: i32) -> i32 {
    let { start, handle, finish } = unsafe *(unsafe (context as *StatefulHandler[State]));
    let event = unsafe make_event(connection, kind, bytes, len, code);
    let raw = if kind == 0u8 {
        let raw = HeapAllocator::alloc(sizeof[Session![State]]()).into_raw();
        unsafe *(unsafe (raw as *Session![State])) = Session!.{ state: start(), finish };
        unsafe kable_tcp_attach(connection, raw, finish_session[State]);
        raw
    } else {
        // Connected installs the attachment before any later event can run.
        unsafe kable_tcp_attachment(connection)
    };
    let session = unsafe (raw as *Session![State]);
    let { state, finish } = unsafe *session;
    let (state, action) = handle(state, event);
    // Native callbacks are serialized. Restore ownership before starting the
    // action, including actions whose scheduling can fail synchronously.
    unsafe *session = Session!.{ state, finish };
    unsafe apply(connection, action)
}

unsafe fn apply(connection: *u8, action: Action!) -> i32 {
    match action {
        Action!::Wait(next) => unsafe submit(next, Option::None),
        Action!::Write(bytes, next) => unsafe submit(next, Option::Some.(bytes)),
        Action!::Scoped(plan) => {
            let (status, handled) = unsafe plan.submit(connection, |scope, root, plan, finish| {
                unsafe kable_tcp_schedule(connection, scope, root, plan, finish)
            });
            handled
        },
        Action!::Close(connection) => {
            let { raw } = connection;
            unsafe kable_tcp_close(raw);
            0i32
        },
    }
}

unsafe fn submit(next: Read!, output: Option[Buffer!]) -> i32 {
    let { connection, deadline } = next;
    let { raw } = connection;
    let (ms, timed) = match deadline {
        Option::Some(ms) => (ms, 1u8),
        Option::None => (0u64, 0u8),
    };
    match output {
        Option::None => unsafe kable_tcp_read(raw, ms, timed),
        Option::Some(bytes) => {
            let ptr = unsafe &bytes.as_ptr();
            let len = &bytes.len();
            let status = unsafe kable_tcp_write(raw, ptr, len, ms, timed);
            bytes.destroy();
            status
        },
    }
}

struct Listener! { raw: *u8, context: *u8 }

impl Listener! {
    /// Calls accept once per connection. Drive subsequent reads and writes
    /// with defer. An event-based read closes the connection when its event arrives.
    fn bind_connections(port: u16, accept: fn(Connection!) -> Action!) -> Result[Listener!, i32] {
        Listener!::bind_handler(port, Handler::Connections.(accept))
    }

    fn bind_local(port: u16, handle: fn(Event!) -> Action!) -> Result[Listener!, i32] {
        Listener!::bind_handler(port, Handler::Events.(handle))
    }

    fn bind_handler(port: u16, handler: Handler) -> Result[Listener!, i32] {
        let context = HeapAllocator::alloc(sizeof[Handler]()).into_raw();
        unsafe *(unsafe (context as *Handler)) = handler;
        unsafe Listener!::bind(port, context, dispatch)
    }

    /// Starts one state value per connection. Each event transfers it to the
    /// handler and takes it back with the next action. The finalizer consumes
    /// the last returned state after the socket and pending operations close.
    forall State.
    fn bind_stateful(port: u16, start: fn() -> State,
        handle: fn(State, Event!) -> (State, Action!),
        finish: fn(State) -> ()) -> Result[Listener!, i32] {
        let context = HeapAllocator::alloc(sizeof[StatefulHandler[State]]()).into_raw();
        unsafe *(unsafe (context as *StatefulHandler[State])) =
            StatefulHandler.{ start, handle, finish };
        unsafe Listener!::bind(port, context, dispatch_stateful[State])
    }

    unsafe fn bind(port: u16, context: *u8,
        callback: unsafe fn(*u8, *u8, u8, *u8, usize, i32) -> i32) -> Result[Listener!, i32] {
        let scratch = Buffer!::new_zeroed(sizeof[i32]());
        let error = unsafe ((unsafe &scratch.as_ptr()) as *i32);
        let raw = unsafe kable_tcp_bind(port, context, callback, error);
        let status = unsafe *error;
        scratch.destroy();
        if is_null(raw) {
            HeapAllocator::drop(unsafe HeapAllocator::adopt_raw(context));
            Result::Err.(status)
        } else {
            Result::Ok.(Listener!.{ raw, context })
        }
    }

    fn port(&self) -> u16 {
        let { raw, context } = self;
        let port = unsafe kable_tcp_port(raw);
        self = Listener!.{ raw, context };
        port
    }

    /// Closes a listener before entering the event loop.
    fn stop(self) {
        let { raw, context } = self;
        unsafe kable_tcp_stop(raw);
        HeapAllocator::drop(unsafe HeapAllocator::adopt_raw(context));
    }

    /// Runs until shutdown, joining all connections before releasing the handler.
    fn run(self) -> Result[(), i32] {
        let { raw, context } = self;
        let status = unsafe kable_tcp_run(raw);
        HeapAllocator::drop(unsafe HeapAllocator::adopt_raw(context));
        if status == 0i32 { Result::Ok.(()) } else { Result::Err.(status) }
    }
}
