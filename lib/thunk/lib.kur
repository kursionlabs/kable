//! Delayed calls and resumable computations with explicit ownership.

/// Releases an owned value when its caller stops using it.
forall T.
trait Discard {
    fn discard(value: T) -> ();
}

/// Function form of `.discard()` for callbacks.
forall T where Discard[T].
fn discard(value: T) { value.discard(); }

instance Discard[()] {
    fn discard(value: ()) {}
}

forall A, B where Discard[A], Discard[B].
instance Discard[(A, B)] {
    fn discard(value: (A, B)) {
        let (first, second) = value;
        first.discard();
        second.discard();
    }
}

forall A, B, C where Discard[A], Discard[B], Discard[C].
instance Discard[(A, B, C)] {
    fn discard(value: (A, B, C)) {
        let (first, second, third) = value;
        first.discard();
        second.discard();
        third.discard();
    }
}

/// An owned call that runs once when resumed.
forall State, Input, Output, Env, Cleanup.
struct Thunk! {
    state: State,
    evaluate: closure[Env](State, Input) -> Output,
    cleanup: Cleanup,
}

/// Stores state for a call that can receive different inputs on resume and discard.
forall State, Input, Output, Env, Context where Copy[Env].
fn defer(state: State, evaluate: closure[Env](State, Input) -> Output, cleanup: fn(State, Context) -> ())
    -> Thunk![State, Input, Output, Env, fn(State, Context) -> ()] {
    Thunk!.{ state, evaluate, cleanup }
}

forall State, Input, Output, Env, Cleanup where Copy[Cleanup].
impl Thunk![State, Input, Output, Env, Cleanup] {
    fn resume(self, input: Input) -> Output {
        let { state, evaluate, cleanup } = self;
        evaluate(state, input)
    }
}

forall State, Input, Output, Env, Context where Copy[Env].
impl Thunk![State, Input, Output, Env, fn(State, Context) -> ()] {
    fn discard_with(self, context: Context) {
        let { state, evaluate, cleanup } = self;
        cleanup(state, context);
    }
}

/// Stores a delayed call whose state implements `Discard`.
forall State, Output, Env where Copy[Env], Discard[State].
fn delay(state: State, evaluate: closure[Env](State) -> Output)
    -> Thunk![State, (), Output, (closure[Env](State) -> Output,), fn(State) -> ()] {
    delay_with(state, evaluate, discard[State])
}

/// Stores a delayed call with explicit cleanup for its state.
forall State, Output, Env where Copy[Env].
fn delay_with(state: State, evaluate: closure[Env](State) -> Output, cleanup: fn(State) -> ())
    -> Thunk![State, (), Output, (closure[Env](State) -> Output,), fn(State) -> ()] {
    Thunk!.{ state, evaluate: |state, unit| evaluate(state), cleanup }
}

forall State, Output, Env, Cleanup where Copy[Cleanup].
impl Thunk![State, (), Output, Env, Cleanup] {
    fn force(self) -> Output { self.resume(()) }
}

forall State, Input, Output, Env where Copy[Env].
impl Thunk![State, Input, Output, Env, fn(State) -> ()] {
    fn discard(self) {
        let { state, evaluate, cleanup } = self;
        cleanup(state);
    }
}

/// A finished computation or the owned state for another step.
forall Next, Output.
exposed enum Step {
    Done(Output),
    Suspended(Next),
}

/// An owned state whose type determines the input and output of one step.
forall State -> Input, Output.
trait Resumable {
    /// Runs one step and transfers ownership of the result to the caller.
    fn resume(state: State, input: Input) -> Step[State, Output];
}

/// An owned computation paused until its caller supplies the next input.
forall State, Input, Output, Env.
struct Suspension! {
    state: State,
    step: closure[Env](State, Input) -> Step[State, Output],
    cleanup: fn(State) -> (),
}

/// Stores the first step's state and uses `Discard` to release abandoned state.
forall State, Input, Output, Env where Copy[Env], Discard[State].
fn suspend(state: State, step: closure[Env](State, Input) -> Step[State, Output])
    -> Suspension![State, Input, Output, Env] {
    suspend_with(state, step, discard[State])
}

/// Stores the first step's state with explicit cleanup.
forall State, Input, Output, Env where Copy[Env].
fn suspend_with(state: State, step: closure[Env](State, Input) -> Step[State, Output], cleanup: fn(State) -> ())
    -> Suspension![State, Input, Output, Env] {
    Suspension!.{ state, step, cleanup }
}

forall State, Input, Output, Env where Copy[Env].
instance Resumable[Suspension![State, Input, Output, Env] -> Input, Output] {
    fn resume(suspension: Suspension![State, Input, Output, Env], input: Input)
        -> Step[Suspension![State, Input, Output, Env], Output] {
        let { state, step, cleanup } = suspension;
        match step(state, input) {
            Done(output) => Step::Done.(output),
            Suspended(state) => Step::Suspended.(Suspension!.{ state, step, cleanup }),
        }
    }
}

forall State, Input, Output, Env where Copy[Env].
instance Discard[Suspension![State, Input, Output, Env]] {
    fn discard(suspension: Suspension![State, Input, Output, Env]) {
        let { state, step, cleanup } = suspension;
        cleanup(state);
    }
}
