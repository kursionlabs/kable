use async::run_sequence;
use std::buffer::Buffer!;
use std::io::print_buffer;
use std::option::Option;
use std::process::trap;
use task::{Completion, PlanOutput, Sleep!, sleep};
use task::sequence::sequence;

fn append(suffix: Buffer!, prior: (Buffer!, Completion[()])) -> Option[Sleep![Buffer!]] {
    let (bytes, status) = prior;
    match status {
        Completion::Ready => (),
        _ => { bytes.destroy(); suffix.destroy(); trap(); },
    }
    Option::Some.(sleep(150u64, bytes.push_buffer(suffix)))
}

fn stop(state: Buffer!, prior: (Buffer!, Completion[()])) -> Option[Sleep![Buffer!]] {
    let (bytes, status) = prior;
    bytes.destroy();
    state.destroy();
    match status { Completion::Ready => (), _ => trap() };
    print_buffer(f"Stopped after the first result and reclaimed both buffers.\n");
    Option::None
}

fn discard(state: Buffer!, prior: Option[(Buffer!, Completion[()])]) {
    state.destroy();
    match prior {
        Option::Some(outcome) => {
            let (bytes, status) = outcome;
            bytes.destroy();
            match status { Completion::Cancelled => (), _ => trap() };
            print_buffer(f"Deadline reclaimed the first result and the pending state.\n");
        },
        Option::None => {
            print_buffer(f"Reclaimed the last adapter's state without starting it.\n");
        },
    }
}

fn expect_stop(result: Option[(Buffer!, Completion[()])]) {
    match result {
        Option::None => (),
        Option::Some(outcome) => { let (bytes, status) = outcome; bytes.destroy(); trap(); },
    }
}

fn check_chain(budget: Option[u64], should_finish: bool) {
    let plan = sequence(sleep(65u64, Buffer!::new().push_static("first")))
        .then_owned(Buffer!::new().push_static("second"),
            |state, prior| append(state, prior), discard);
    let result = run_sequence(plan, budget);
    match result {
        Option::Some(outcome) => {
            let (bytes, status) = outcome;
            let length = &bytes.len();
            bytes.destroy();
            let ready = match status {
                Completion::Ready => true,
                Completion::Cancelled => false,
                Completion::Failed => trap(),
            };
            if length != 11usize || ready != should_finish { trap(); }
        },
        Option::None => trap(),
    }
}

fn main() -> i32 {
    let plan = sequence(sleep(0u64, 7u32).map(|outcome| outcome))
        .then(|outcome| Option::Some.(sleep(0u64, outcome)));
    let result = run_sequence(plan, Option::None);
    match result {
        Option::Some(outcome) => {
            let ((value, first), second) = outcome;
            match first { Completion::Ready => (), _ => trap() };
            match second { Completion::Ready => (), _ => trap() };
            if value != 7 { trap(); }
        },
        Option::None => trap(),
    }

    check_chain(Option::None, true);
    check_chain(Option::Some.(180u64), false);
    print_buffer(f"The second stage used the original deadline.\n");

    let plan = sequence(sleep(0u64, Buffer!::new()))
        .then_owned(Buffer!::new(), |state, prior| stop(state, prior), discard)
        .then_owned(Buffer!::new(), |state, prior| append(state, prior), discard);
    let result = run_sequence(plan, Option::None);
    expect_stop(result);

    let plan = sequence(sleep(30_000u64, Buffer!::new()))
        .then_owned(Buffer!::new(), |state, prior| append(state, prior), discard)
        .then_owned(Buffer!::new(), |state, prior| append(state, prior), discard);
    let result = run_sequence(plan, Option::Some.(10u64));
    expect_stop(result);
    0i32
}
