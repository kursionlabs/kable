use async::run_sequence;
use std::buffer::Buffer!;
use std::io::print_buffer;
use std::option::Option;
use std::process::trap;
use std::time::Duration;
use task::{Completion, Map!, PlanOutput, Sleep!, sleep};
use task::sequence::{SequenceOutcome, sequence};

fn wait_with_buffer(duration: Duration, bytes: Buffer!) -> Map![Sleep!, Completion[()], (Buffer!, Completion[()]), (Buffer!,)] {
    sleep(duration).map(|status| (bytes, status))
}

fn resume(state: Buffer!, prior: (Buffer!, Completion[()]), delay: Option[Duration])
    -> Option[Map![Sleep!, Completion[()], (Buffer!, Completion[()]), (Buffer!,)]] {
    let (bytes, status) = prior;
    match status {
        Completion::Ready => (),
        _ => { bytes.destroy(); state.destroy(); trap(); },
    }
    match delay {
        Option::Some(duration) => Option::Some.(wait_with_buffer(duration, bytes.push_buffer(state))),
        Option::None => {
            bytes.destroy();
            state.destroy();
            print_buffer(f"Stopped after the first result and reclaimed both buffers.\n");
            Option::None
        },
    }
}

fn discard(state: Buffer!, prior: Option[(Buffer!, Completion[()])]) {
    state.destroy();
    match prior {
        Option::Some(outcome) => {
            let (bytes, status) = outcome;
            bytes.destroy();
            match status { Completion::Cancelled => (), _ => trap() };
            print_buffer(f"Deadline reclaimed the first result and the pending state.\n");
        },
        Option::None => {
            print_buffer(f"Reclaimed the last adapter's state without starting it.\n");
        },
    }
}

fn check_early_end(result: SequenceOutcome[(Buffer!, Completion[()])], cancelled: bool) {
    match result {
        SequenceOutcome::Stopped => { if cancelled { trap(); } },
        SequenceOutcome::Cancelled => { if !cancelled { trap(); } },
        SequenceOutcome::Finished(outcome) => { let (bytes, status) = outcome; bytes.destroy(); trap(); },
    }
}

fn check_chain(budget: Option[Duration], should_finish: bool) {
    let delay = Option::Some.(Duration::from_millis(150));
    let plan = sequence(wait_with_buffer(Duration::from_millis(65), Buffer!::new().push_static("first")))
        .then_owned(Buffer!::new().push_static("second"),
            |state, prior| resume(state, prior, delay), discard);
    let result = run_sequence(plan, budget);
    match result {
        SequenceOutcome::Finished(outcome) => {
            let (bytes, status) = outcome;
            let length = &bytes.len();
            bytes.destroy();
            let ready = match status {
                Completion::Ready => true,
                Completion::Cancelled => false,
                Completion::Failed => trap(),
            };
            if length != 11usize || ready != should_finish { trap(); }
        },
        SequenceOutcome::Stopped | SequenceOutcome::Cancelled => trap(),
    }
}

fn main() -> i32 {
    let plan = sequence(sleep(Duration::from_nanos(0)).map(|status| (7u32, status)))
        .then(|outcome| Option::Some.(sleep(Duration::from_nanos(0)).map(|status| (outcome, status))));
    let result = run_sequence(plan, Option::None);
    match result {
        SequenceOutcome::Finished(outcome) => {
            let ((value, first), second) = outcome;
            match first { Completion::Ready => (), _ => trap() };
            match second { Completion::Ready => (), _ => trap() };
            if value != 7 { trap(); }
        },
        SequenceOutcome::Stopped | SequenceOutcome::Cancelled => trap(),
    }

    check_chain(Option::None, true);
    check_chain(Option::Some.(Duration::from_millis(180)), false);
    print_buffer(f"The second stage used the original deadline.\n");

    let delay = Option::Some.(Duration::from_millis(150));
    let plan = sequence(wait_with_buffer(Duration::from_nanos(0), Buffer!::new()))
        .then_owned(Buffer!::new(), |state, prior| resume(state, prior, Option::None), discard)
        .then_owned(Buffer!::new(), |state, prior| resume(state, prior, delay), discard);
    let result = run_sequence(plan, Option::None);
    check_early_end(result, false);

    let plan = sequence(wait_with_buffer(Duration::from_secs(30), Buffer!::new()))
        .then_owned(Buffer!::new(), |state, prior| resume(state, prior, delay), discard)
        .then_owned(Buffer!::new(), |state, prior| resume(state, prior, delay), discard);
    let result = run_sequence(plan, Option::Some.(Duration::from_millis(10)));
    check_early_end(result, true);
    0i32
}
