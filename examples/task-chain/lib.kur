use async::run_sequence;
use std::buffer::Buffer!;
use std::io::print_buffer;
use std::option::Option;
use std::process::trap;
use std::time::Duration;
use task::{Completion, PlanOutput, sleep};
use task::sequence::SequenceOutcome;

fn append(state: Buffer!, prior: (Buffer!, Completion[()])) -> Buffer! {
    let (bytes, status) = prior;
    match status {
        Ready => bytes.push_buffer(state),
        _ => { bytes.destroy(); state.destroy(); trap(); },
    }
}

fn stop(state: Buffer!, prior: (Buffer!, Completion[()])) {
    let (bytes, status) = prior;
    bytes.destroy();
    state.destroy();
    match status { Ready => (), _ => trap() };
    print_buffer(f"Stopped after the first result and reclaimed both buffers.\n");
}

fn discard(state: Buffer!, prior: Option[(Buffer!, Completion[()])]) {
    state.destroy();
    match prior {
        Some(outcome) => {
            let (bytes, status) = outcome;
            bytes.destroy();
            match status { Cancelled => (), _ => trap() };
            print_buffer(f"Deadline reclaimed the first result and the pending state.\n");
        },
        None => {
            print_buffer(f"Reclaimed the last adapter's state without starting it.\n");
        },
    }
}

fn check_early_end(budget: Option[Duration]) {
    let cancelled = budget.is_some();
    let delay = if cancelled { Duration::from_secs(30) } else { Duration::from_nanos(0) };
    let bytes = Buffer!::new();
    let first = sleep(delay).map(|status| (bytes, status));
    let plan = first
        .then_owned(Buffer!::new(), |state, prior| {
            if !cancelled {
                stop(state, prior);
                return Option::None;
            }
            let bytes = append(state, prior);
            Option::Some.(sleep(Duration::from_millis(150)).map(|status| (bytes, status)))
        }, discard)
        .then_owned(Buffer!::new(), |state, prior| {
            let bytes = append(state, prior);
            Option::Some.(sleep(Duration::from_millis(150)).map(|status| (bytes, status)))
        }, discard);
    match run_sequence(plan, budget) {
        Stopped => { if cancelled { trap(); } },
        Cancelled => { if !cancelled { trap(); } },
        Finished(outcome) => { let (bytes, status) = outcome; bytes.destroy(); trap(); },
    }
}

fn check_chain(budget: Option[Duration], should_finish: bool) {
    let bytes = Buffer!::new().push_static("first");
    let first = sleep(Duration::from_millis(65)).map(|status| (bytes, status));
    let plan = first
        .then_state(Buffer!::new().push_static("second"), |state, prior| {
            let bytes = append(state, prior);
            Option::Some.(sleep(Duration::from_millis(150)).map(|status| (bytes, status)))
        });
    let result = run_sequence(plan, budget);
    match result {
        Finished(outcome) => {
            let (bytes, status) = outcome;
            let length = &bytes.len();
            bytes.destroy();
            let ready = match status {
                Ready => true,
                Cancelled => false,
                _ => trap(),
            };
            if length != 11usize || ready != should_finish { trap(); }
        },
        Stopped | Cancelled => trap(),
    }
}

fn main() -> i32 {
    let plan = sleep(Duration::from_nanos(0)).map(|status| (7u32, status))
        .then(|outcome| Option::Some.(sleep(Duration::from_nanos(0)).map(|status| (outcome, status))));
    let result = run_sequence(plan, Option::None);
    match result {
        Finished(outcome) => {
            let ((value, first), second) = outcome;
            match first { Ready => (), _ => trap() };
            match second { Ready => (), _ => trap() };
            if value != 7 { trap(); }
        },
        Stopped | Cancelled => trap(),
    }

    check_chain(Option::None, true);
    check_chain(Option::Some.(Duration::from_millis(180)), false);
    print_buffer(f"The second stage used the original deadline.\n");

    check_early_end(Option::None);
    check_early_end(Option::Some.(Duration::from_millis(10)));
    0i32
}
