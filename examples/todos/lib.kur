//! An in-memory todo API. A POST reads JSON, updates the shared list, then replies.
use http::{Request!, Response!};
use std::collections::vec::OwnedVec!;
use json::{Array!, Json!, Object!, Text!, Serializable, Deserializable, decode_as};
use std::io::{eprint, print};
use std::option::{Option, Result};
use task::Discard;
use web::{App!, AppAction!, JsonBody};

struct Todos! { titles: OwnedVec![Text!] }

instance Discard[Todos!] {
    fn discard(todos: Todos!) {
        let { titles } = todos;
        titles.destroy_with(Text!::destroy);
    }
}

struct NewTodo! { title: Text! }
struct Todo! { id: usize, title: Text! }

instance Deserializable[NewTodo!] {
    fn deserialize(doc: Json!) -> Option[NewTodo!] {
        var title = doc.take_field("title")?.into_string()?;
        if &title.len() == 0 { title.destroy(); return Option::None; }
        Option::Some.(NewTodo!.{ title })
    }
}

instance Discard[NewTodo!] {
    fn discard(todo: NewTodo!) { todo.title.destroy(); }
}

instance Serializable[Todo!] {
    fn serialize(todo: Todo!) -> Json! {
        let { id, title } = todo;
        Object!::new().field("id", id).field("title", title).value()
    }
}

fn insert(&todos: Todos!, todo: NewTodo!) -> usize {
    &todos.titles.push(todo.title);
    &todos.titles.len()
}

fn created(id: usize) -> Response! {
    let body = Object!::new().field("id", id).encode();
    Response!::buffered(201, "application/json", body)
}

fn create(request: Request!) -> AppAction![Todos!] {
    request.json(decode_as[NewTodo!])
        .update(insert)
        .reply_with(created)
}

fn list(&todos: Todos!, request: Request!) -> Response! {
    request.destroy();
    var items = Array!::new();
    var index = 0usize;
    while index < &todos.titles.len() {
        let title = &todos.titles.update(index, |&text| &text.clone()).unwrap();
        &items.push(Todo!.{ id: index + 1, title });
        index = index + 1;
    }
    Response!::bytes(items.encode(), "application/json")
}

fn main() -> i32 {
    let app = App!::new(Todos!.{ titles: OwnedVec!::new[Text!]() })
        .get("/todos", list)
        .post("/todos", create);
    var server = match app.bind(0) {
        Ok(server) => server,
        Err(code) => { eprint(f"todos: bind failed ({code})\n"); return 1; },
    };
    let port = &server.port();
    if print(f"Listening on http://127.0.0.1:{port}\n").is_err() { server.stop(); return 1; }
    if server.run().is_ok() { 0 } else { 1 }
}
