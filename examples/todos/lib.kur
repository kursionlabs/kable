//! An in-memory todo API. A POST reads JSON, updates the shared list, then replies.
use http::{Request!, Response!};
use std::buffer::Buffer!;
use std::collections::vec::OwnedVec!;
use json::{Array!, Json!, Object!, Text!, decode};
use std::io::{eprint, print};
use std::option::{Option, Result};
use task::Discard;
use web::{App!, AppAction!, JsonBody};

struct Todos! { titles: OwnedVec![Text!] }

instance Discard[Todos!] {
    fn discard(todos: Todos!) {
        let { titles } = todos;
        titles.destroy_with(Text!::destroy);
    }
}

instance Discard[Text!] {
    fn discard(text: Text!) { text.destroy(); }
}

fn decode_title(input: Buffer!) -> Option[Text!] {
    var title = decode(input).ok()
        .and_then(|doc| doc.take_field("title"))
        .and_then(|field| field.into_string())?;
    if &title.len() > 0 { Option::Some.(title) } else { title.destroy(); Option::None }
}

fn insert(&todos: Todos!, title: Text!) -> usize {
    &todos.titles.push(title);
    &todos.titles.len()
}

fn created(id: usize) -> Response! {
    let body = Object!::new().field("id", Json!::uint(id)).value().encode();
    Response!::buffered(201, "application/json", body)
}

fn create(request: Request!) -> AppAction![Todos!] {
    request.json(decode_title)
        .update(insert)
        .reply_with(created)
}

fn list(&todos: Todos!, request: Request!) -> Response! {
    request.destroy();
    var items = Array!::new();
    var index = 0usize;
    while index < &todos.titles.len() {
        let title = &todos.titles.update(index, |&text| &text.clone()).unwrap();
        let todo = Object!::new().field("id", Json!::uint(index + 1)).field("title", title.value());
        &items.push(todo.value());
        index = index + 1;
    }
    Response!::bytes(items.value().encode(), "application/json")
}

fn main() -> i32 {
    let app = App!::new(Todos!.{ titles: OwnedVec!::new[Text!]() })
        .get("/todos", list)
        .post("/todos", create);
    var server = match app.bind(0) {
        Ok(server) => server,
        Err(code) => { eprint(f"todos: bind failed ({code})\n"); return 1; },
    };
    let port = &server.port();
    if print(f"Listening on http://127.0.0.1:{port}\n").is_err() { server.stop(); return 1; }
    if server.run().is_ok() { 0 } else { 1 }
}
