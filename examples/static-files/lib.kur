use server::{Server!, static_files};
use std::io::{eprint_buffer, print_buffer};
use std::option::{Option, Result};
use std::parse::parse_u64;
use std::process::Args;
use std::slice::StaticRead;

extern "C" fn uv_chdir(path: *u8) -> i32;

fn usage() -> i32 {
    eprint_buffer(f"usage: static-files ROOT [PORT]\n");
    2
}

fn main(args: Args) -> i32 {
    if args.len() < 2 || args.len() > 3 { return usage(); }
    let port = match args.bytes(2) {
        Option::None => 8080,
        Option::Some(bytes) => {
            let access = StaticRead::new();
            match parse_u64(&access, bytes) {
                Option::Some(port) => {
                    if port > 65535 { return usage(); }
                    port as u16
                },
                Option::None => return usage(),
            }
        },
    };
    let root = args.get(1).unwrap();
    let status = unsafe uv_chdir(root.as_ptr());
    if status < 0 {
        eprint_buffer(f"static-files: cannot enter the document root (libuv error {status})\n");
        return 1;
    }

    let server = match Server!::bind(port, static_files::serve_from_cwd) {
        Result::Ok(server) => server,
        Result::Err(code) => {
            eprint_buffer(f"static-files: cannot listen (libuv error {code})\n");
            return 1;
        },
    };
    let port = &server.port();
    if print_buffer(f"Listening on http://127.0.0.1:{port}\n").is_err() {
        server.stop();
        return 1;
    }
    match server.run() {
        Result::Ok(unit) => 0,
        Result::Err(code) => {
            eprint_buffer(f"static-files: server stopped (libuv error {code})\n");
            1
        },
    }
}
