use async::{read_file, run_with_deadline};
use std::buffer::Buffer!;
use std::io::{eprint_buffer, print_buffer};
use std::option::Option;
use std::parse::parse_u64;
use std::process::Args;
use std::slice::StaticRead;
use std::time::Duration;
use task::{Completion, Discard, join};

fn print_pair(left: Completion[Buffer!], right: Completion[Buffer!]) -> i32 {
    let first = match left {
        Ready(first) => first,
        Failed(failure) => {
            right.discard();
            eprint_buffer(f"async-read: first file failed ({failure})\n");
            return 1;
        },
        TimedOut | Cancelled => { right.discard(); return 1; },
    };
    match right {
        Ready(second) => {
            if print_buffer(first.push_buffer(second)).is_err() { 1 } else { 0 }
        },
        Failed(failure) => {
            first.destroy();
            eprint_buffer(f"async-read: second file failed ({failure})\n");
            1
        },
        TimedOut | Cancelled => { first.destroy(); 1 },
    }
}

fn usage() -> i32 {
    eprint_buffer(f"usage: async-read LEFT RIGHT [DEADLINE_MS]\n");
    2i32
}

fn main(args: Args) -> i32 {
    if args.len() < 3usize || args.len() > 4usize { return usage(); }
    var access = StaticRead::new();
    let left = match args.bytes(1usize) {
        Some(path) => path,
        None => return usage(),
    };
    let right = match args.bytes(2usize) {
        Some(path) => path,
        None => return usage(),
    };
    let deadline = match args.bytes(3usize) {
        Some(value) => match parse_u64(&access, value) {
            Some(ms) => Duration::from_millis(ms),
            None => return usage(),
        },
        None => Duration::from_secs(5),
    };
    let plan = join(read_file(&access, left, 65_536usize), read_file(&access, right, 65_536usize));
    let (left, right, status) = run_with_deadline(plan, deadline);
    match status {
        Ready => print_pair(left, right),
        TimedOut | Cancelled => {
            (left, right).discard();
            eprint_buffer(f"async-read: deadline expired\n");
            1i32
        },
        Failed(failure) => {
            (left, right).discard();
            eprint_buffer(f"async-read: scope failed ({failure})\n");
            1i32
        },
    }
}
