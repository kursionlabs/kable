use async::{read_file, run_with_deadline};
use std::buffer::Buffer!;
use std::io::{eprint_buffer, print_buffer};
use std::option::Option;
use std::parse::parse_u64;
use std::process::Args;
use std::slice::StaticRead;
use task::{Completion, join};

fn discard(result: Completion[Buffer!]) {
    match result {
        Completion::Ready(bytes) => bytes.destroy(),
        Completion::Cancelled => (),
        Completion::Failed(code) => (),
    }
}

fn print_pair(left: Completion[Buffer!], right: Completion[Buffer!]) -> i32 {
    match left {
        Completion::Ready(first) => match right {
            Completion::Ready(second) => {
                if print_buffer(first.push_buffer(second)).is_err() { 1i32 } else { 0i32 }
            },
            Completion::Failed(code) => {
                first.destroy();
                eprint_buffer(f"async-read: second file failed (libuv error {code})\n");
                1i32
            },
            Completion::Cancelled => { first.destroy(); 1i32 },
        },
        Completion::Failed(code) => {
            discard(right);
            eprint_buffer(f"async-read: first file failed (libuv error {code})\n");
            1i32
        },
        Completion::Cancelled => { discard(right); 1i32 },
    }
}

fn usage() -> i32 {
    eprint_buffer(f"usage: async-read LEFT RIGHT [DEADLINE_MS]\n");
    2i32
}

fn main(args: Args) -> i32 {
    if args.len() < 3usize || args.len() > 4usize { return usage(); }
    let access = StaticRead::new();
    let left = match args.bytes(1usize) {
        Option::Some(path) => path,
        Option::None => return usage(),
    };
    let right = match args.bytes(2usize) {
        Option::Some(path) => path,
        Option::None => return usage(),
    };
    let deadline = match args.bytes(3usize) {
        Option::Some(value) => match parse_u64(&access, value) {
            Option::Some(ms) => ms,
            Option::None => return usage(),
        },
        Option::None => 5000u64,
    };
    let plan = join(read_file(&access, left, 65_536usize), read_file(&access, right, 65_536usize));
    let (left, right, status) = run_with_deadline(plan, deadline);
    match status {
        Completion::Ready => print_pair(left, right),
        Completion::Cancelled => {
            discard(left);
            discard(right);
            eprint_buffer(f"async-read: deadline expired\n");
            1i32
        },
        Completion::Failed(code) => {
            discard(left);
            discard(right);
            eprint_buffer(f"async-read: scope failed (libuv error {code})\n");
            1i32
        },
    }
}
