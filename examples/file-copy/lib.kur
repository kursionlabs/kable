use async::{FileChunks!, OutputFile!, Runner!, create_file, open_file, with_runner};
use std::io::eprint_buffer;
use std::option::{Option, Result};
use std::parse::parse_u64;
use std::process::Args;
use std::slice::{Slice, StaticRead};
use std::time::Duration;
use task::{Completion, Sink, Stream, StreamOutcome!};

fn transfer(&runner: Runner!, &source: FileChunks!, &destination: OutputFile!, deadline: Option[Duration]) -> bool {
    while &source.remaining() != 0 {
        let (next, outcome) = &runner.run(source.next(), Option::None);
        source = next;
        let bytes = match outcome {
            StreamOutcome!::Item(bytes) => bytes,
            StreamOutcome!::End => { eprint_buffer(f"file-copy: source ended early\n"); return false; },
            StreamOutcome!::Cancelled => { eprint_buffer(f"file-copy: read cancelled\n"); return false; },
            StreamOutcome!::Failed(failure) => {
                eprint_buffer(f"file-copy: read failed ({failure})\n");
                return false;
            },
        };
        let (file, bytes, outcome) = &runner.run(destination.write(bytes), deadline);
        destination = file;
        bytes.destroy();
        match outcome {
            Completion::Ready => (),
            Completion::Cancelled => {
                let count = &destination.position();
                eprint_buffer(f"file-copy: write cancelled after {count} bytes\n");
                return false;
            },
            Completion::Failed(failure) => {
                let count = &destination.position();
                eprint_buffer(f"file-copy: write failed after {count} bytes ({failure})\n");
                return false;
            },
        }
    }
    true
}

fn copy(&runner: Runner!, source: Slice[u8, 'static], destination: Slice[u8, 'static], deadline: Option[Duration]) -> i32 {
    let access = StaticRead::new();
    let input = match &runner.run(open_file(&access, source), Option::None) {
        Completion::Ready(file) => file,
        Completion::Cancelled => { eprint_buffer(f"file-copy: source open cancelled\n"); return 1; },
        Completion::Failed(failure) => { eprint_buffer(f"file-copy: opening source failed ({failure})\n"); return 1; },
    };
    let destination = match &runner.run(create_file(&access, destination), Option::None) {
        Completion::Ready(file) => file,
        Completion::Cancelled => {
            input.close();
            eprint_buffer(f"file-copy: destination creation cancelled\n");
            return 1;
        },
        Completion::Failed(failure) => {
            input.close();
            eprint_buffer(f"file-copy: creating destination failed ({failure})\n");
            return 1;
        },
    };
    let size = &input.len();
    let source = input.chunks(0, size);
    let copied = transfer(&runner, &source, &destination, deadline);
    source.close();
    match destination.close() {
        Result::Ok(unit) => if copied { 0 } else { 1 },
        Result::Err(code) => { eprint_buffer(f"file-copy: closing destination failed ({code})\n"); 1 },
    }
}

fn usage() -> i32 {
    eprint_buffer(f"usage: file-copy SOURCE DESTINATION [WRITE_DEADLINE_MS]\n");
    2
}

fn main(args: Args) -> i32 {
    if args.len() < 3 || args.len() > 4 { return usage(); }
    let access = StaticRead::new();
    let source = args.bytes(1).unwrap();
    let destination = args.bytes(2).unwrap();
    let deadline = match args.bytes(3) {
        Option::None => Option::None,
        Option::Some(value) => match parse_u64(&access, value) {
            Option::Some(ms) => Option::Some.(Duration::from_millis(ms)),
            Option::None => return usage(),
        },
    };
    with_runner(|&runner| copy(&runner, source, destination, deadline))
}
