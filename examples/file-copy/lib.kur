use async::{FileChunks!, OutputFile!, Runner!, create_file, open_file, with_runner};
use std::io::eprint;
use std::option::{Option, Result};
use std::parse::parse_u64;
use std::process::Args;
use std::str::{StaticRead, Str};
use std::time::Duration;
use task::{Completion, Sink, Stream, TransferStep};

fn transfer(&runner: Runner!, &source: FileChunks!, &destination: OutputFile!, deadline: Option[Duration]) -> bool {
    while &source.remaining() != 0 {
        let (next, step) = &runner.run(source.forward_next(destination));
        source = next;
        let write = match step {
            Send(write) => write,
            End(file, outcome) => {
                destination = file;
                eprint(match outcome {
                    Ready => f"file-copy: source ended early\n",
                    TimedOut => f"file-copy: read timed out\n",
                    Cancelled => f"file-copy: read cancelled\n",
                    Failed(failure) => f"file-copy: read failed ({failure})\n",
                });
                return false;
            },
        };
        var (file, outcome) = match deadline {
            Some(duration) => &runner.run_with_deadline(write, duration),
            None => &runner.run(write),
        };
        let count = &file.position();
        destination = file;
        match outcome {
            Ready => (),
            TimedOut | Cancelled => {
                eprint(f"file-copy: write timed out after {count} bytes\n");
                return false;
            },
            Failed(failure) => {
                eprint(f"file-copy: write failed after {count} bytes ({failure})\n");
                return false;
            },
        }
    }
    true
}

fn copy(&runner: Runner!, source: Str['static], destination: Str['static], deadline: Option[Duration]) -> i32 {
    var access = StaticRead::new();
    var input = match &runner.run(open_file(&access, source)) {
        Ready(file) => file,
        TimedOut | Cancelled => { eprint(f"file-copy: source open cancelled\n"); return 1; },
        Failed(failure) => { eprint(f"file-copy: opening source failed ({failure})\n"); return 1; },
    };
    var destination = match &runner.run(create_file(&access, destination)) {
        Ready(file) => file,
        TimedOut | Cancelled => {
            input.close();
            eprint(f"file-copy: destination creation cancelled\n");
            return 1;
        },
        Failed(failure) => {
            input.close();
            eprint(f"file-copy: creating destination failed ({failure})\n");
            return 1;
        },
    };
    let size = &input.len();
    var source = input.chunks(0, size);
    let copied = transfer(&runner, &source, &destination, deadline);
    source.close();
    match destination.close() {
        Ok(unit) => if copied { 0 } else { 1 },
        Err(code) => { eprint(f"file-copy: closing destination failed ({code})\n"); 1 },
    }
}

fn usage() -> i32 {
    eprint(f"usage: file-copy SOURCE DESTINATION [WRITE_DEADLINE_MS]\n");
    2
}

fn main(args: Args) -> i32 {
    if args.len() < 3 || args.len() > 4 { return usage(); }
    var access = StaticRead::new();
    let source = args.bytes(1).unwrap();
    let destination = args.bytes(2).unwrap();
    let deadline = match args.bytes(3) {
        None => Option::None,
        Some(value) => match parse_u64(&access, value) {
            Some(ms) => Option::Some.(Duration::from_millis(ms)),
            None => return usage(),
        },
    };
    with_runner(|&runner| copy(&runner, source, destination, deadline))
}
