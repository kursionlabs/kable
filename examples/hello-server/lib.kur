use http::{Request!, Response!};
use server::{Action!, Server!, after, reply};
use std::io::{eprint_buffer, print_buffer};
use std::option::Result;
use std::time::Duration;

fn hello(request: Request!) -> Action! {
    var request = request;
    let delayed = &request.path_is("/delay");
    request.destroy();

    if delayed {
        after(Response!::text(200, "done\n"), Duration::from_secs(1))
    } else {
        reply(Response!::text(200, "Hello from Kable!\n"))
    }
}

fn main() -> i32 {
    var server = match Server!::bind(0, hello) {
        Ok(server) => server,
        Err(code) => {
            eprint_buffer(f"hello-server: cannot listen (libuv error {code})\n");
            return 1;
        },
    };
    let port = &server.port();
    if print_buffer(f"Listening on http://127.0.0.1:{port}\n").is_err() {
        server.stop();
        return 1;
    }
    match server.run() {
        Ok(unit) => 0,
        Err(code) => {
            eprint_buffer(f"hello-server: server stopped (libuv error {code})\n");
            1
        },
    }
}
