use std::buffer::Buffer!;
use std::io::{eprint_buffer, print_buffer};
use std::option::{Option, Result};
use std::raw::Span;
use std::time::Duration;
use task::{Completion, PlanOutput, Sink, Stream, StreamOutcome};
use tcp::{Action!, Connection!, Listener!};
use thunk::{Discard, Resumable, Step};

struct Session! { pending: Buffer!, retried: bool }

impl Session! {
    fn new(pending: Buffer!) -> Session! {
        Session!.{ pending, retried: false }
    }
}

enum Lines! {
    Complete(Buffer!, Buffer!),
    TooLong(Buffer!),
}

fn start(connection: Connection!) -> Action! {
    read_line(connection, Session!::new(Buffer!::new()))
}

fn discard_line(pending: Buffer!) {
    let length = &pending.len();
    pending.destroy();
    eprint_buffer(f"Closed session with {length} buffered bytes.\n");
}

instance Resumable[Session! -> Buffer!, Lines!] {
    fn resume(session: Session!, bytes: Buffer!) -> Step[Session!, Lines!] {
        let { pending, retried } = session;
        let pending = pending.push_buffer(bytes);
        let exists 'k. (access, bytes, restore) = pending.open();
        let span = Span::from_slice(bytes);
        match span.rfind_byte(&access, b'\n') {
            None => {
                let pending = restore.restore(access);
                if &pending.len() > 16384 { Step::Done.(Lines!::TooLong.(pending)) }
                else { Step::Suspended.(Session!::new(pending)) }
            },
            Some(index) => {
                let end = index + 1;
                let complete = Buffer!::new_with_cap(end).push_bytes(&access, span.take(end));
                let rest = span.skip(end);
                let tail = Buffer!::new_with_cap(rest.len()).push_bytes(&access, rest);
                restore.restore(access).destroy();
                Step::Done.(Lines!::Complete.(complete, tail))
            },
        }
    }
}

instance Discard[Session!] {
    fn discard(session: Session!) {
        let { pending, retried } = session;
        discard_line(pending);
    }
}

fn close_session(connection: Connection!, session: Session!) -> Action! {
    session.discard();
    connection.close()
}

fn read_line(connection: Connection!, session: Session!) -> Action! {
    connection.next_within(Duration::from_secs(1)).defer_tcp_owned(session, |session, result| {
        let (connection, outcome) = result;
        let bytes = match outcome {
            StreamOutcome::Item(bytes) => bytes,
            TimedOut => return retry_read(connection, session),
            _ => return close_session(connection, session),
        };
        match session.resume(bytes) {
            Suspended(next) => read_line(connection, next),
            Done(lines) => write_lines(connection, lines),
        }
    }, discard_read)
}

fn discard_read(session: Session!, outcome: StreamOutcome[Buffer!]) {
    outcome.discard();
    eprint_buffer(f"Discarded a read for a closing session.\n");
    session.discard();
}

fn retry_read(connection: Connection!, session: Session!) -> Action! {
    let { pending, retried } = session;
    let session = Session!.{ pending, retried: true };
    if retried { return close_session(connection, session); }
    eprint_buffer(f"Retrying idle read.\n");
    read_line(connection, session)
}

fn write_lines(connection: Connection!, lines: Lines!) -> Action! {
    let (complete, tail) = match lines {
        Complete(complete, tail) => (complete, tail),
        TooLong(pending) => {
            discard_line(pending);
            return connection.close();
        },
    };
    connection.send(complete).defer_tcp_state(Session!::new(tail), |session, result| {
        let (connection, status) = result;
        match status {
            Completion::Ready => read_line(connection, session),
            _ => close_session(connection, session),
        }
    })
}

fn main() -> i32 {
    let listener = match Listener!::bind_connections(0, start) {
        Ok(listener) => listener,
        Err(code) => {
            eprint_buffer(f"tcp-session: cannot listen (libuv error {code})\n");
            return 1i32;
        },
    };
    let port = &listener.port();
    if print_buffer(f"Listening on 127.0.0.1:{port}\n").is_err() {
        listener.stop();
        return 1i32;
    }
    match listener.run() {
        Ok(unit) => 0i32,
        Err(code) => {
            eprint_buffer(f"tcp-session: listener stopped (libuv error {code})\n");
            1i32
        },
    }
}
