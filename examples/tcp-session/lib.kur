use std::buffer::Buffer!;
use std::io::{eprint_buffer, print_buffer};
use std::option::{Option, Result};
use std::raw::Span;
use std::time::Duration;
use task::{Completion, DeadlineStatus, PlanOutput, Stream};
use tcp::{Action!, Connection!, Listener!};
use thunk::{Resumable, Step};

struct LineReader! { pending: Buffer! }

enum Lines! {
    Complete(Buffer!, Buffer!),
    TooLong(Buffer!),
}

fn start(connection: Connection!) -> Action! {
    read_line(connection, LineReader!.{ pending: Buffer!::new() }, false)
}

fn discard_line(pending: Buffer!) {
    let length = &pending.len();
    pending.destroy();
    eprint_buffer(f"Closed session with {length} buffered bytes.\n");
}

instance Resumable[LineReader! -> Buffer!, Lines!] {
    fn resume(reader: LineReader!, bytes: Buffer!) -> Step[LineReader!, Lines!] {
        let { pending } = reader;
        let pending = pending.push_buffer(bytes);
        let exists 'k. (access, bytes, restore) = pending.open();
        let span = Span::from_slice(bytes);
        match span.rfind_byte(&access, b'\n') {
            Option::None => {
                let pending = restore.restore(access);
                if &pending.len() > 16384 { Step::Done.(Lines!::TooLong.(pending)) }
                else { Step::Suspended.(LineReader!.{ pending }) }
            },
            Option::Some(index) => {
                let end = index + 1;
                let complete = Buffer!::new_with_cap(end).push_bytes(&access, span.take(end));
                let rest = span.skip(end);
                let tail = Buffer!::new_with_cap(rest.len()).push_bytes(&access, rest);
                restore.restore(access).destroy();
                Step::Done.(Lines!::Complete.(complete, tail))
            },
        }
    }

    fn discard(reader: LineReader!) {
        let { pending } = reader;
        discard_line(pending);
    }
}

fn close_session(connection: Connection!, reader: LineReader!) -> Action! {
    reader.discard();
    connection.close()
}

fn read_line(connection: Connection!, reader: LineReader!, retried: bool) -> Action! {
    connection.next().within(Duration::from_secs(1)).defer_tcp(|result| read_finished(result, reader, retried))
}

fn read_finished(result: ((Connection!, Completion[Option[Buffer!]]), DeadlineStatus),
    reader: LineReader!, retried: bool) -> Action! {
    let ((connection, outcome), deadline) = result;
    let chunk = match outcome {
        Completion::Ready(chunk) => chunk,
        Completion::Cancelled => {
            let retry = match deadline { DeadlineStatus::TimedOut => !retried, _ => false };
            if retry {
                eprint_buffer(f"Retrying idle read.\n");
                return read_line(connection, reader, true);
            }
            Option::None
        },
        Completion::Failed => Option::None,
    };
    let bytes = match chunk {
        Option::Some(bytes) => bytes,
        Option::None => return close_session(connection, reader),
    };
    match deadline {
        DeadlineStatus::Completed => (),
        _ => {
            bytes.destroy();
            return close_session(connection, reader);
        },
    }
    match reader.resume(bytes) {
        Step::Suspended(next) => read_line(connection, next, false),
        Step::Done(lines) => write_lines(connection, lines),
    }
}

fn write_lines(connection: Connection!, lines: Lines!) -> Action! {
    let (complete, tail) = match lines {
        Lines!::Complete(complete, tail) => (complete, tail),
        Lines!::TooLong(pending) => {
            discard_line(pending);
            return connection.close();
        },
    };
    let reader = LineReader!.{ pending: tail };
    connection.send(complete).defer_tcp(|result| {
        let (connection, status) = result;
        match status {
            Completion::Ready => read_line(connection, reader, false),
            Completion::Cancelled | Completion::Failed => close_session(connection, reader),
        }
    })
}

fn main() -> i32 {
    let listener = match Listener!::bind_connections(0, start) {
        Result::Ok(listener) => listener,
        Result::Err(code) => {
            eprint_buffer(f"tcp-session: cannot listen (libuv error {code})\n");
            return 1i32;
        },
    };
    let port = &listener.port();
    if print_buffer(f"Listening on 127.0.0.1:{port}\n").is_err() {
        listener.stop();
        return 1i32;
    }
    match listener.run() {
        Result::Ok(unit) => 0i32,
        Result::Err(code) => {
            eprint_buffer(f"tcp-session: listener stopped (libuv error {code})\n");
            1i32
        },
    }
}
