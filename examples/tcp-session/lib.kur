use std::buffer::Buffer!;
use std::io::{eprint_buffer, print_buffer};
use std::option::{Option, Result};
use std::raw::Span;
use std::time::Duration;
use task::{Completion, DeadlineStatus, PlanOutput, Sink, Stream, StreamOutcome!};
use tcp::{Action!, Connection!, Listener!, defer};

fn start(connection: Connection!) -> Action! {
    read_line(connection, Buffer!::new(), false)
}

fn close_session(connection: Connection!, pending: Buffer!) -> Action! {
    let length = &pending.len();
    pending.destroy();
    eprint_buffer(f"Closed session with {length} buffered bytes.\n");
    connection.close()
}

fn read_line(connection: Connection!, pending: Buffer!, retried: bool) -> Action! {
    defer(connection.next().within(Duration::from_secs(1)), |result| read_finished(result, pending, retried))
}

fn read_finished(result: ((Connection!, StreamOutcome![Buffer!]), DeadlineStatus),
    pending: Buffer!, retried: bool) -> Action! {
    let ((connection, outcome), deadline) = result;
    match outcome {
        StreamOutcome!::Item(bytes) => match deadline {
            DeadlineStatus::Completed => receive(connection, pending.push_buffer(bytes)),
            _ => { bytes.destroy(); close_session(connection, pending) },
        },
        StreamOutcome!::Cancelled => match deadline {
            DeadlineStatus::TimedOut => {
                if retried { return close_session(connection, pending); }
                eprint_buffer(f"Retrying idle read.\n");
                read_line(connection, pending, true)
            },
            _ => close_session(connection, pending),
        },
        StreamOutcome!::End | StreamOutcome!::Failed => close_session(connection, pending),
    }
}

fn receive(connection: Connection!, pending: Buffer!) -> Action! {
    let exists 'k. (access, bytes, restore) = pending.open();
    let span = Span::from_slice(bytes);
    match span.rfind_byte(&access, b'\n') {
        Option::None => {
            let pending = restore.restore(access);
            if &pending.len() > 16384 { close_session(connection, pending) }
            else { read_line(connection, pending, false) }
        },
        Option::Some(index) => {
            let end = index + 1;
            let complete = Buffer!::new_with_cap(end).push_bytes(&access, span.take(end));
            let tail = span.skip(end);
            let pending = Buffer!::new_with_cap(tail.len()).push_bytes(&access, tail);
            restore.restore(access).destroy();
            defer(connection.write(complete), |result| {
                let (connection, bytes, status) = result;
                bytes.destroy();
                match status {
                    Completion::Ready => read_line(connection, pending, false),
                    Completion::Cancelled | Completion::Failed => close_session(connection, pending),
                }
            })
        },
    }
}

fn main() -> i32 {
    let listener = match Listener!::bind_connections(0, start) {
        Result::Ok(listener) => listener,
        Result::Err(code) => {
            eprint_buffer(f"tcp-session: cannot listen (libuv error {code})\n");
            return 1i32;
        },
    };
    let port = &listener.port();
    if print_buffer(f"Listening on 127.0.0.1:{port}\n").is_err() {
        listener.stop();
        return 1i32;
    }
    match listener.run() {
        Result::Ok(unit) => 0i32,
        Result::Err(code) => {
            eprint_buffer(f"tcp-session: listener stopped (libuv error {code})\n");
            1i32
        },
    }
}
