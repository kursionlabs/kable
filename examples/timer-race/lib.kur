use async::{Completion, PlanOutput, RaceOutcome, WithinOutcome, join, run, run_with_deadline,
    select, sleep};
use std::bytes::buffer::Buffer!;
use std::io::print_buffer;
use std::process::trap;

fn main() -> i32 {
    let (value, status) = run(sleep(0u64, 7u32));
    match status {
        Completion::Ready => { if value != 7u32 { return 1i32; } },
        _ => return 1i32,
    }

    let owned = Buffer!::new().push_static("owned by the slower task");
    let result = run(select(sleep(20, ()), sleep(100, owned)));
    match result {
        RaceOutcome::First(unit, cancelled) => {
            if !reclaim_cancelled(cancelled) { return 1; }
            print_buffer(f"First timer won. Reclaimed the slower task's buffer.\n");
        },
        RaceOutcome::Second(unit, ready) => { reclaim_cancelled(ready); return 1i32; },
        RaceOutcome::Cancelled(unit, cancelled) => { reclaim_cancelled(cancelled); return 1i32; },
        RaceOutcome::Failed(unit, recovered, code) => { reclaim_cancelled(recovered); return 1i32; },
    }

    let owned = Buffer!::new().push_static("owned by the first task");
    let waiting = select(sleep(30_000, owned), sleep(60_000, ()));
    let result = run_with_deadline(waiting, 10);
    match result {
        RaceOutcome::Cancelled(cancelled, unit) => {
            if !reclaim_cancelled(cancelled) { return 1; }
            print_buffer(f"Parent deadline cancelled both timers.\n");
        },
        RaceOutcome::First(ready, unit) => { reclaim_cancelled(ready); return 1i32; },
        RaceOutcome::Second(cancelled, unit) => { reclaim_cancelled(cancelled); return 1i32; },
        RaceOutcome::Failed(recovered, unit, code) => { reclaim_cancelled(recovered); return 1i32; },
    }
    if !check_join() || !check_nested_deadline() || !check_select() || !check_map() ||
        !check_within() { return 1i32; }
    0i32
}

fn check_within() -> bool {
    let owned = Buffer!::new().push_static("owned");
    let plan = join(sleep(30_000, owned).within(10), sleep(25u64, 7u8));
    let (limited, sibling, status) = run(plan);
    let local_expired = reclaim_limited_buffer(limited, true);
    if !local_expired || !ready(status) || !is_ready(sibling, 7u8) { return false; }

    let owned = Buffer!::new().push_static("owned");
    let result = run_with_deadline(sleep(30_000, owned).within(20_000), 10);
    if !reclaim_limited_buffer(result, false) { return false; }

    let result = run(sleep(0, 8u8).within(30_000));
    match result {
        WithinOutcome::Completed(outcome) => {
            if !is_ready(outcome, 8u8) { return false; }
            print_buffer(f"Local deadline left its sibling running; parent cancellation stayed distinct.\n");
            true
        },
        _ => false,
    }
}

fn reclaim_limited_buffer(result: WithinOutcome[(Buffer!, Completion[()])], local: bool) -> bool {
    let (outcome, expected) = match result {
        WithinOutcome::TimedOut(outcome) => (outcome, local),
        WithinOutcome::Cancelled(outcome) => (outcome, !local),
        WithinOutcome::Completed(outcome) => (outcome, false),
        WithinOutcome::Failed(outcome, code) => (outcome, false),
    };
    let (bytes, status) = outcome;
    let length = &bytes.len();
    bytes.destroy();
    expected && cancelled(status) && length == 5usize
}

fn label(outcome: (Buffer!, Completion[()]), suffix: Buffer!) -> (Buffer!, bool) {
    let (bytes, status) = outcome;
    match status {
        Completion::Ready => (bytes.push_buffer(suffix), true),
        Completion::Cancelled => (bytes.push_buffer(suffix), false),
        Completion::Failed => { bytes.destroy(); suffix.destroy(); trap() },
    }
}

fn check_map() -> bool {
    let winner_label = Buffer!::new().push_static("-win");
    let loser_label = Buffer!::new().push_static("-lose");
    let first = sleep(0, Buffer!::new().push_static("a")).map(|result| label(result, winner_label));
    let second = sleep(30_000, Buffer!::new().push_static("b")).map(|result| label(result, loser_label));
    let result = run(select(first, second));
    let (a, b, first_won) = match result {
        RaceOutcome::First(a, b) => (a, b, true),
        RaceOutcome::Second(a, b) => (a, b, false),
        RaceOutcome::Cancelled(a, b) => (a, b, false),
        RaceOutcome::Failed(a, b, code) => (a, b, false),
    };
    let (first, ready) = a;
    let (second, loser_ready) = b;
    let valid = first_won && ready && !loser_ready && &first.len() == 5usize && &second.len() == 6usize;
    first.destroy();
    second.destroy();
    if !valid { return false; }

    let suffix = Buffer!::new().push_static("cancelled");
    let task = sleep(30_000, Buffer!::new()).map(|outcome| label(outcome, suffix));
    let (bytes, ready) = run_with_deadline(task, 0);
    let valid = !ready && &bytes.len() == 9usize;
    bytes.destroy();
    if valid { print_buffer(f"Mapped the winning and cancelled outcomes with owned closures.\n"); }
    valid
}

fn check_select() -> bool {
    let slow = join(sleep(0u64, 1u8), sleep(30_000u64, 2u8));
    let result = run(select(slow, sleep(10u64, 3u8)));
    match result {
        RaceOutcome::Second(loser, winner) => {
            let (first, pending, status) = loser;
            let reclaimed = cancelled(status) && is_ready(first, 1) && is_cancelled(pending, 2);
            if !reclaimed || !is_ready(winner, 3u8) { return false; }
            print_buffer(f"Select cancelled the unfinished part of a losing join.\n");
            true
        },
        _ => false,
    }
}

fn check_join() -> bool {
    let winner = select(sleep(30_000, 1u8), sleep(1, 2u8));
    let plan = join(winner, sleep(10u64, 3u8));
    let (winner, timer, status) = run(plan);
    let second_won = match winner {
        RaceOutcome::Second(a, b) => is_cancelled(a, 1) && is_ready(b, 2),
        _ => false,
    };
    if !ready(status) || !second_won || !is_ready(timer, 3) { return false; }
    print_buffer(f"Join waited for the race and the other timer.\n");
    true
}

fn check_nested_deadline() -> bool {
    let slow = join(sleep(30_000u64, 2u8), select(sleep(60_000, 3u8), sleep(60_000, 4u8)));
    let owned = Buffer!::new().push_static("ready");
    let plan = join(sleep(0u64, owned), slow);
    let (first, nested, status) = run_with_deadline(plan, 10);
    let (timer, race, nested_status) = nested;
    let race_cancelled = match race {
        RaceOutcome::Cancelled(a, b) => is_cancelled(a, 3) && is_cancelled(b, 4),
        _ => false,
    };
    let (buffer, first_status) = first;
    let length = &buffer.len();
    buffer.destroy();
    if !ready(first_status) || length != 5 || !cancelled(status) || !cancelled(nested_status)
        || !is_cancelled(timer, 2) || !race_cancelled { return false; }
    print_buffer(f"Parent deadline kept the ready result and cancelled the nested waits.\n");
    true
}

fn ready(status: Completion[()]) -> bool {
    match status { Completion::Ready => true, _ => false }
}

fn cancelled(status: Completion[()]) -> bool {
    match status { Completion::Cancelled => true, _ => false }
}

fn is_ready(result: (u8, Completion[()]), expected: u8) -> bool {
    let (value, status) = result;
    ready(status) && value == expected
}

fn reclaim_cancelled(result: (Buffer!, Completion[()])) -> bool {
    let (buffer, status) = result;
    buffer.destroy();
    cancelled(status)
}

fn is_cancelled(result: (u8, Completion[()]), expected: u8) -> bool {
    let (value, status) = result;
    cancelled(status) && value == expected
}
