use async::{JoinOutcome, Outcome, RaceOutcome, WithinOutcome, join, map, race, run, select, sleep,
    timeout, within};
use std::bytes::buffer::Buffer!;
use std::io::print_buffer;
use std::process::trap;

fn main() -> i32 {
    let ready: Outcome[u32] = run(sleep(0u64, 7u32));
    match ready {
        Outcome::Ready(value) => { if value != 7u32 { return 1i32; } },
        _ => return 1i32,
    }

    let owned = Buffer!::new().push_static("owned by the slower task");
    let result: RaceOutcome[(), Buffer!] = run(race(sleep(20u64, ()), sleep(100u64, owned)));
    match result {
        RaceOutcome::First(unit, cancelled) => {
            cancelled.destroy();
            print_buffer(f"First timer won. Reclaimed the slower task's buffer.\n");
        },
        RaceOutcome::Second(unit, ready) => { ready.destroy(); return 1i32; },
        RaceOutcome::Cancelled(unit, cancelled) => { cancelled.destroy(); return 1i32; },
        RaceOutcome::Failed(unit, recovered, code) => { recovered.destroy(); return 1i32; },
    }

    let owned = Buffer!::new().push_static("owned by the first task");
    let waiting = race(sleep(30_000u64, owned), sleep(60_000u64, ()));
    let result: RaceOutcome[Buffer!, ()] = timeout(10u64, waiting);
    match result {
        RaceOutcome::Cancelled(cancelled, unit) => {
            cancelled.destroy();
            print_buffer(f"Parent deadline cancelled both timers.\n");
        },
        RaceOutcome::First(ready, unit) => { ready.destroy(); return 1i32; },
        RaceOutcome::Second(cancelled, unit) => { cancelled.destroy(); return 1i32; },
        RaceOutcome::Failed(recovered, unit, code) => { recovered.destroy(); return 1i32; },
    }
    if !check_join() || !check_nested_deadline() || !check_select() || !check_map() ||
        !check_within() { return 1i32; }
    0i32
}

fn check_within() -> bool {
    let owned = Buffer!::new().push_static("owned");
    let plan = join(within(10u64, sleep(30_000u64, owned)), sleep(25u64, 7u8));
    let result: JoinOutcome[WithinOutcome[Outcome[Buffer!]], Outcome[u8]] = run(plan);
    let (limited, sibling, joined) = match result {
        JoinOutcome::Ready(limited, sibling) => (limited, sibling, true),
        JoinOutcome::Cancelled(limited, sibling) => (limited, sibling, false),
        JoinOutcome::Failed(limited, sibling, code) => (limited, sibling, false),
    };
    let local_expired = reclaim_limited_buffer(limited, true);
    if !local_expired || !joined || !is_ready(sibling, 7u8) { return false; }

    let owned = Buffer!::new().push_static("owned");
    let result: WithinOutcome[Outcome[Buffer!]] =
        timeout(10u64, within(20_000u64, sleep(30_000u64, owned)));
    if !reclaim_limited_buffer(result, false) { return false; }

    let result: WithinOutcome[Outcome[u8]] = run(within(30_000u64, sleep(0u64, 8u8)));
    match result {
        WithinOutcome::Completed(outcome) => {
            if !is_ready(outcome, 8u8) { return false; }
            print_buffer(f"Local deadline left its sibling running; parent cancellation stayed distinct.\n");
            true
        },
        _ => false,
    }
}

fn reclaim_limited_buffer(result: WithinOutcome[Outcome[Buffer!]], local: bool) -> bool {
    let (outcome, expected) = match result {
        WithinOutcome::TimedOut(outcome) => (outcome, local),
        WithinOutcome::Cancelled(outcome) => (outcome, !local),
        WithinOutcome::Completed(outcome) => (outcome, false),
        WithinOutcome::Failed(outcome, code) => (outcome, false),
    };
    let (bytes, cancelled) = match outcome {
        Outcome::Cancelled(bytes) => (bytes, true),
        Outcome::Ready(bytes) => (bytes, false),
        Outcome::Failed(bytes, code) => (bytes, false),
    };
    let length = &bytes.len();
    bytes.destroy();
    expected && cancelled && length == 5usize
}

fn label(outcome: Outcome[Buffer!], suffix: Buffer!) -> (Buffer!, bool) {
    match outcome {
        Outcome::Ready(bytes) => (bytes.push_buffer(suffix), true),
        Outcome::Cancelled(bytes) => (bytes.push_buffer(suffix), false),
        Outcome::Failed(bytes, code) => { bytes.destroy(); suffix.destroy(); trap() },
    }
}

fn check_map() -> bool {
    let winner_label = Buffer!::new().push_static("-win");
    let loser_label = Buffer!::new().push_static("-lose");
    let first = map(sleep(0u64, Buffer!::new().push_static("a")),
        |result: Outcome[Buffer!]| label(result, winner_label));
    let second = map(sleep(30_000u64, Buffer!::new().push_static("b")),
        |result: Outcome[Buffer!]| label(result, loser_label));
    let result: RaceOutcome[(Buffer!, bool), (Buffer!, bool)] = run(select(first, second));
    let (a, b, first_won) = match result {
        RaceOutcome::First(a, b) => (a, b, true),
        RaceOutcome::Second(a, b) => (a, b, false),
        RaceOutcome::Cancelled(a, b) => (a, b, false),
        RaceOutcome::Failed(a, b, code) => (a, b, false),
    };
    let (first, ready) = a;
    let (second, loser_ready) = b;
    let valid = first_won && ready && !loser_ready && &first.len() == 5usize && &second.len() == 6usize;
    first.destroy();
    second.destroy();
    if !valid { return false; }

    let suffix = Buffer!::new().push_static("cancelled");
    let task = map(sleep(30_000u64, Buffer!::new()),
        |outcome: Outcome[Buffer!]| label(outcome, suffix));
    let (bytes, ready): (Buffer!, bool) = timeout(0u64, task);
    let valid = !ready && &bytes.len() == 9usize;
    bytes.destroy();
    if valid { print_buffer(f"Mapped the winning and cancelled outcomes with owned closures.\n"); }
    valid
}

fn check_select() -> bool {
    let slow = join(sleep(0u64, 1u8), sleep(30_000u64, 2u8));
    let result: RaceOutcome[JoinOutcome[Outcome[u8], Outcome[u8]], Outcome[u8]] =
        run(select(slow, sleep(10u64, 3u8)));
    match result {
        RaceOutcome::Second(loser, winner) => {
            let reclaimed = match loser {
                JoinOutcome::Cancelled(ready, pending) => {
                    let cancelled = match pending {
                        Outcome::Cancelled(value) => value == 2u8,
                        _ => false,
                    };
                    is_ready(ready, 1u8) && cancelled
                },
                _ => false,
            };
            if !reclaimed || !is_ready(winner, 3u8) { return false; }
            print_buffer(f"Select cancelled the unfinished part of a losing join.\n");
            true
        },
        _ => false,
    }
}

fn check_join() -> bool {
    let winner = race(sleep(30_000u64, 1u8), sleep(1u64, 2u8));
    let plan = join(winner, sleep(10u64, 3u8));
    let result: JoinOutcome[RaceOutcome[u8, u8], Outcome[u8]] = run(plan);
    match result {
        JoinOutcome::Ready(winner, timer) => {
            let second_won = match winner {
                RaceOutcome::Second(a, b) => a == 1u8 && b == 2u8,
                _ => false,
            };
            if !second_won || !is_ready(timer, 3u8) { return false; }
            print_buffer(f"Join waited for the race and the other timer.\n");
            true
        },
        _ => false,
    }
}

fn check_nested_deadline() -> bool {
    let slow = join(sleep(30_000u64, 2u8), race(sleep(60_000u64, 3u8), sleep(60_000u64, 4u8)));
    let owned = Buffer!::new().push_static("ready");
    let plan = join(sleep(0u64, owned), slow);
    let result: JoinOutcome[Outcome[Buffer!], JoinOutcome[Outcome[u8], RaceOutcome[u8, u8]]] =
        timeout(10u64, plan);
    match result {
        JoinOutcome::Cancelled(first, nested) => {
            let nested_cancelled = match nested {
                JoinOutcome::Cancelled(timer, race) => {
                    let timer_cancelled = match timer {
                        Outcome::Cancelled(value) => value == 2u8,
                        _ => false,
                    };
                    let race_cancelled = match race {
                        RaceOutcome::Cancelled(a, b) => a == 3u8 && b == 4u8,
                        _ => false,
                    };
                    timer_cancelled && race_cancelled
                },
                _ => false,
            };
            if !reclaim_ready_buffer(first) || !nested_cancelled { return false; }
            print_buffer(f"Parent deadline kept the ready result and cancelled the nested waits.\n");
            true
        },
        JoinOutcome::Ready(first, nested) => { reclaim_ready_buffer(first); false },
        JoinOutcome::Failed(first, nested, code) => { reclaim_ready_buffer(first); false },
    }
}

fn reclaim_ready_buffer(result: Outcome[Buffer!]) -> bool {
    let (buffer, ready) = match result {
        Outcome::Ready(buffer) => (buffer, true),
        Outcome::Cancelled(buffer) => (buffer, false),
        Outcome::Failed(buffer, code) => (buffer, false),
    };
    let length = &buffer.len();
    buffer.destroy();
    ready && length == 5usize
}

fn is_ready(result: Outcome[u8], expected: u8) -> bool {
    match result {
        Outcome::Ready(value) => value == expected,
        _ => false,
    }
}
