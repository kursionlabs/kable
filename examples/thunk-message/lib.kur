use std::fmt::Writer;
use std::buffer::Buffer!;
use std::io::{Error, Input!, eprint, print, stdin};
use std::option::{Option, Result};
use std::process::Args;
use std::str::StaticRead;
use thunk::{Discard, Resumable, Step, delay, suspend};

instance Discard[Buffer!] {
    fn discard(bytes: Buffer!) { bytes.destroy(); }
}

fn read_line(body: Buffer!, line: Buffer!) -> Step[Buffer!, Buffer!] {
    var exists 'k. (access, bytes, restore) = line.open();
    let terminator = bytes.as_str().is(&access, ".");
    let line = restore.restore(access);
    if terminator {
        line.destroy();
        Step::Done.(body)
    } else {
        Step::Suspended.(body.put(line).write_byte(b'\n'))
    }
}

forall Reader where Resumable[Reader -> Buffer!, Buffer!], Discard[Reader].
fn read_message(&input: Input!, pending: Reader) -> Result[Option[Buffer!], Error] {
    let line = match &input.read_line() {
        Ok(line) => line,
        Err(error) => { pending.discard(); return Result::Err.(error); },
    };
    let line = match line {
        Some(line) => line,
        None => { pending.discard(); return Result::Ok.(Option::None); },
    };
    match pending.resume(line) {
        Done(body) => Result::Ok.(Option::Some.(body)),
        Suspended(next) => read_message(&input, next),
    }
}

fn main(args: Args) -> i32 {
    var access = StaticRead::new();
    let check = args.len() == 2 && args.bytes(1).unwrap().is(&access, "--check");
    if args.len() != 1 && !check {
        eprint("usage: thunk-message [--check]\n");
        return 2;
    }

    var input = match stdin() {
        Ok(input) => input,
        Err(error) => { eprint(f"thunk-message: {error}\n"); return 1; },
    };
    let first = suspend(Buffer!::new(), |body, line| read_line(body, line));
    let result = read_message(&input, first);
    let closed = input.finish().map(|ahead| ahead.destroy());
    let body = match result {
        Ok(message) => match message {
            Some(body) => body,
            None => { eprint("thunk-message: expected a line containing only '.'\n"); return 1; },
        },
        Err(error) => { eprint(f"thunk-message: {error}\n"); return 1; },
    };

    match closed {
        Ok(unit) => (),
        Err(error) => { body.destroy(); eprint(f"thunk-message: {error}\n"); return 1; },
    };

    let output = delay(body, |body| {
        var body = body;
        let length = &body.len();
        f"Message ({length} bytes)\n".put(body)
    });
    if check {
        output.discard();
        return 0;
    }
    match print(output.force()) {
        Ok(unit) => 0,
        Err(error) => { eprint(f"thunk-message: {error}\n"); 1 },
    }
}
