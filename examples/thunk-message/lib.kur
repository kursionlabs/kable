use std::buffer::Buffer!;
use std::io::{Error, Input!, eprint, eprint_buffer, print_buffer, stdin};
use std::option::{Option, Result};
use std::process::Args;
use std::slice::StaticRead;
use thunk::{Resumable, Step, delay, suspend};

fn read_line(body: Buffer!, line: Buffer!) -> Step[Buffer!, Buffer!] {
    let exists 'k. (access, bytes, restore) = line.open();
    let terminator = bytes.is(&access, ".");
    let line = restore.restore(access);
    if terminator {
        line.destroy();
        Step::Done.(body)
    } else {
        Step::Suspended.(body.push_buffer(line).push_byte(b'\n'))
    }
}

forall Reader where Resumable[Reader -> Buffer!, Buffer!].
fn read_message(&input: Input!, pending: Reader) -> Result[Option[Buffer!], Error] {
    let line = match &input.read_line() {
        Result::Ok(line) => line,
        Result::Err(error) => { pending.discard(); return Result::Err.(error); },
    };
    let line = match line {
        Option::Some(line) => line,
        Option::None => { pending.discard(); return Result::Ok.(Option::None); },
    };
    match pending.resume(line) {
        Step::Done(body) => Result::Ok.(Option::Some.(body)),
        Step::Suspended(next) => read_message(&input, next),
    }
}

fn main(args: Args) -> i32 {
    let access = StaticRead::new();
    let check = args.len() == 2 && args.bytes(1).unwrap().is(&access, "--check");
    if args.len() != 1 && !check {
        eprint("usage: thunk-message [--check]\n");
        return 2;
    }

    let input = match stdin() {
        Result::Ok(input) => input,
        Result::Err(error) => { eprint_buffer(f"thunk-message: {error}\n"); return 1; },
    };
    let first = suspend(Buffer!::new(), |body, line| read_line(body, line), Buffer!::destroy);
    let result = read_message(&input, first);
    input.finish().destroy();
    let body = match result {
        Result::Ok(message) => match message {
            Option::Some(body) => body,
            Option::None => { eprint("thunk-message: expected a line containing only '.'\n"); return 1; },
        },
        Result::Err(error) => { eprint_buffer(f"thunk-message: {error}\n"); return 1; },
    };

    let output = delay(body, |body| {
        let length = &body.len();
        f"Message ({length} bytes)\n".push_buffer(body)
    }, Buffer!::destroy);
    if check {
        output.discard();
        return 0;
    }
    match print_buffer(output.force()) {
        Result::Ok(unit) => 0,
        Result::Err(error) => { eprint_buffer(f"thunk-message: {error}\n"); 1 },
    }
}
