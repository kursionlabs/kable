use async::{FileOutcome!, Outcome, RaceOutcome, read_file, select, sleep};
use http::{Method, Request!, Response!};
use server::{Action!, Server!, defer, defer_next};
use std::bytes::buffer::Buffer!;
use std::io::{eprint_buffer, print_buffer};
use std::option::Result;
use std::raw::Span;
use std::slice::StaticRead;

fn file_response(outcome: FileOutcome!) -> Response! {
    match outcome {
        FileOutcome!::Read(bytes) => Response!::ok(bytes),
        FileOutcome!::Cancelled => {
            eprint_buffer(f"File request cancelled.\n");
            Response!::rejected(408u16)
        },
        FileOutcome!::Failed(code) => Response!::rejected(500u16),
    }
}

fn discard_file(outcome: FileOutcome!) {
    match outcome {
        FileOutcome!::Read(bytes) => bytes.destroy(),
        FileOutcome!::Cancelled => (),
        FileOutcome!::Failed(code) => (),
    }
}

fn timed_response(outcome: RaceOutcome[FileOutcome!, Outcome[()]]) -> Response! {
    match outcome {
        RaceOutcome::First(file, timer) => file_response(file),
        RaceOutcome::Second(file, timer) => {
            discard_file(file);
            Response!::rejected(504u16)
        },
        RaceOutcome::Cancelled(file, timer) => file_response(file),
        RaceOutcome::Failed(file, timer, code) => {
            discard_file(file);
            Response!::rejected(500u16)
        },
    }
}

fn cancel_first(target: Buffer!, outcome: FileOutcome!) {
    target.destroy();
    discard_file(outcome);
    eprint_buffer(f"Sequence cancelled before the second read.\n");
}

fn cancel_second(first: Buffer!, outcome: FileOutcome!) {
    let length = &first.len();
    first.destroy();
    discard_file(outcome);
    eprint_buffer(f"Sequence cancelled with {length} bytes from the first read.\n");
}

fn finish_second(first: Buffer!, outcome: FileOutcome!) -> Action! {
    let response = match outcome {
        FileOutcome!::Read(second) => Response!::ok(first.push_buffer(second)),
        FileOutcome!::Cancelled => { first.destroy(); Response!::rejected(408u16) },
        FileOutcome!::Failed(code) => { first.destroy(); Response!::rejected(500u16) },
    };
    Action!::Reply.(response)
}

fn finish_first(target: Buffer!, outcome: FileOutcome!) -> Action! {
    target.destroy();
    match outcome {
        FileOutcome!::Read(first) => {
            let access = StaticRead::new();
            defer_next(read_file(&access, "footer.txt", 65_536usize), first, finish_second, cancel_second)
        },
        FileOutcome!::Cancelled => Action!::Reply.(Response!::rejected(408u16)),
        FileOutcome!::Failed(code) => Action!::Reply.(Response!::rejected(500u16)),
    }
}

fn handle(request: Request!) -> Action! {
    let { method, target, body } = request;
    body.destroy();
    let exists 'k. (access, bytes, restore) = target.open();
    let path = Span::from_slice(bytes);
    let health = path.is(&access, "/health");
    let file = path.is(&access, "/file");
    let timed = path.is(&access, "/file-with-timeout");
    let sequence = path.is(&access, "/file-sequence");
    let target = restore.restore(access);
    match method {
        Method::Get | Method::Head => (),
        _ => {
            target.destroy();
            return Action!::Reply.(Response!::method_not_allowed("GET, HEAD"));
        },
    }
    if file || timed || sequence {
        let access = StaticRead::new();
        let task = read_file(&access, "example.txt", 65_536usize);
        if sequence { return defer_next(task, target, finish_first, cancel_first); }
        if timed {
            return defer(select(task, sleep(1000u64, ())),
                |outcome: RaceOutcome[FileOutcome!, Outcome[()]]| {
                    target.destroy();
                    timed_response(outcome)
                });
        }
        return defer(task, |outcome: FileOutcome!| {
            target.destroy();
            file_response(outcome)
        });
    }
    target.destroy();
    if health { Action!::Reply.(Response!::text(200u16, "ok\n")) }
    else { Action!::Reply.(Response!::rejected(404u16)) }
}

fn main() -> i32 {
    let server = match Server!::bind_async(0u16, handle) {
        Result::Ok(server) => server,
        Result::Err(code) => {
            eprint_buffer(f"http-file: cannot listen (libuv error {code})\n");
            return 1i32;
        },
    };
    let port = &server.port();
    if print_buffer(f"Listening on http://127.0.0.1:{port}\n").is_err() {
        server.stop();
        return 1i32;
    }
    match server.run() {
        Result::Ok(unit) => 0i32,
        Result::Err(code) => {
            eprint_buffer(f"http-file: server stopped (libuv error {code})\n");
            1i32
        },
    }
}
