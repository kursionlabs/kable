use async::{Completion, DeadlineStatus, read_file};
use http::{Method, Request!, Response!};
use package::{file_join, file_sequence};
use server::{Action!, PlanOutput, RequestState, Server!};
use std::bytes::buffer::Buffer!;
use std::io::{eprint_buffer, print_buffer};
use std::option::{Option, Result};
use std::slice::StaticRead;

const FILE_LIMIT: usize = 65_536;

fn serve_file(timed: bool) -> Action! {
    let access = StaticRead::new();
    let file = read_file(&access, "example.txt", FILE_LIMIT);
    if timed {
        return file.within(1000).defer(|outcome, state| {
            timed_reply(outcome, state, file_response, discard_file)
        });
    }
    file.defer(|outcome, state| {
        let response = file_response(outcome);
        match state {
            RequestState::Active => Option::Some.(response.reply()),
            RequestState::Cancelled => { response.destroy(); Option::None },
        }
    })
}

forall Output.
fn timed_reply(result: (Output, DeadlineStatus), state: RequestState,
    reply: fn(Output) -> Response!, discard: fn(Output) -> ()) -> Option[Action!] {
    let (outcome, deadline) = result;
    match state {
        RequestState::Cancelled => { discard(outcome); return Option::None; },
        RequestState::Active => (),
    }
    let status = match deadline {
        DeadlineStatus::Completed => return Option::Some.(reply(outcome).reply()),
        DeadlineStatus::TimedOut => 504,
        DeadlineStatus::Cancelled => 408,
        DeadlineStatus::Failed => 500,
    };
    discard(outcome);
    Option::Some.(Response!::rejected(status).reply())
}

fn file_response(outcome: Completion[Buffer!]) -> Response! {
    match outcome {
        Completion::Ready(bytes) => Response!::ok(bytes),
        Completion::Cancelled => {
            eprint_buffer(f"File request cancelled.\n");
            Response!::rejected(408)
        },
        Completion::Failed(code) => Response!::rejected(500),
    }
}

fn discard_file(outcome: Completion[Buffer!]) {
    match outcome {
        Completion::Ready(bytes) => bytes.destroy(),
        Completion::Cancelled => (),
        Completion::Failed(code) => (),
    }
}

fn append_file(first: Buffer!, second: Completion[Buffer!]) -> Response! {
    match second {
        Completion::Ready(bytes) => Response!::ok(first.push_buffer(bytes)),
        Completion::Cancelled => { first.destroy(); Response!::rejected(408) },
        Completion::Failed(code) => { first.destroy(); Response!::rejected(500) },
    }
}

enum Route { File, TimedFile, FileJoin, FileSequence, Health, Missing }

fn route(&request: Request!) -> Route {
    if &request.path_is("/file") { return Route::File; }
    if &request.path_is("/file-with-timeout") { return Route::TimedFile; }
    if &request.path_is("/file-join") { return Route::FileJoin; }
    if &request.path_is("/file-sequence") { return Route::FileSequence; }
    if &request.path_is("/health") { return Route::Health; }
    Route::Missing
}

fn handle(request: Request!) -> Action! {
    let route = route(&request);
    let { method, target, body } = request;
    target.destroy();
    body.destroy();

    match method {
        Method::Get | Method::Head => (),
        _ => { return Response!::method_not_allowed("GET, HEAD").reply(); },
    }
    match route {
        Route::File => serve_file(false),
        Route::TimedFile => serve_file(true),
        Route::FileJoin => file_join::serve(),
        Route::FileSequence => file_sequence::serve(),
        Route::Health => Response!::text(200, "ok\n").reply(),
        Route::Missing => Response!::rejected(404).reply(),
    }
}

fn main() -> i32 {
    let server = match Server!::bind_async(0, handle) {
        Result::Ok(server) => server,
        Result::Err(code) => {
            eprint_buffer(f"http-file: cannot listen (libuv error {code})\n");
            return 1;
        },
    };
    let port = &server.port();
    if print_buffer(f"Listening on http://127.0.0.1:{port}\n").is_err() {
        server.stop();
        return 1;
    }
    match server.run() {
        Result::Ok(unit) => 0,
        Result::Err(code) => {
            eprint_buffer(f"http-file: server stopped (libuv error {code})\n");
            1
        },
    }
}
