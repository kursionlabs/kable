use async::{FileOutcome!, WithinOutcome, read_file};
use http::{Method, Request!, Response!};
use package::{file_join, file_sequence};
use server::{Action!, Plan, PlanOutput, Server!};
use std::bytes::buffer::Buffer!;
use std::io::{eprint_buffer, print_buffer};
use std::option::Result;
use std::slice::StaticRead;

const FILE_LIMIT: usize = 65_536usize;

fn serve_file(timed: bool) -> Action! {
    let access = StaticRead::new();
    let file = read_file(&access, "example.txt", FILE_LIMIT);
    if !timed { return file.defer(|outcome| file_response(outcome)); }

    file.within(1000u64).defer(|outcome| match outcome {
        WithinOutcome::Completed(file) => file_response(file),
        WithinOutcome::TimedOut(file) => {
            discard_file(file);
            Response!::rejected(504u16)
        },
        WithinOutcome::Cancelled(file) => file_response(file),
        WithinOutcome::Failed(file, code) => {
            discard_file(file);
            Response!::rejected(500u16)
        },
    })
}

fn file_response(outcome: FileOutcome!) -> Response! {
    match outcome {
        FileOutcome!::Read(bytes) => Response!::ok(bytes),
        FileOutcome!::Cancelled => {
            eprint_buffer(f"File request cancelled.\n");
            Response!::rejected(408u16)
        },
        FileOutcome!::Failed(code) => Response!::rejected(500u16),
    }
}

fn discard_file(outcome: FileOutcome!) {
    match outcome {
        FileOutcome!::Read(bytes) => bytes.destroy(),
        FileOutcome!::Cancelled => (),
        FileOutcome!::Failed(code) => (),
    }
}

fn append_file(first: Buffer!, second: FileOutcome!) -> Response! {
    match second {
        FileOutcome!::Read(bytes) => Response!::ok(first.push_buffer(bytes)),
        FileOutcome!::Cancelled => { first.destroy(); Response!::rejected(408u16) },
        FileOutcome!::Failed(code) => { first.destroy(); Response!::rejected(500u16) },
    }
}

enum Route { File, TimedFile, FileJoin, FileSequence, Health, Missing }

fn route(&request: Request!) -> Route {
    if &request.path_is("/file") { return Route::File; }
    if &request.path_is("/file-with-timeout") { return Route::TimedFile; }
    if &request.path_is("/file-join") { return Route::FileJoin; }
    if &request.path_is("/file-sequence") { return Route::FileSequence; }
    if &request.path_is("/health") { return Route::Health; }
    Route::Missing
}

fn handle(request: Request!) -> Action! {
    let route = route(&request);
    let { method, target, body } = request;
    target.destroy();
    body.destroy();

    match method {
        Method::Get | Method::Head => (),
        _ => { return Response!::method_not_allowed("GET, HEAD").reply(); },
    }
    match route {
        Route::File => serve_file(false),
        Route::TimedFile => serve_file(true),
        Route::FileJoin => file_join::serve(),
        Route::FileSequence => file_sequence::serve(),
        Route::Health => Response!::text(200u16, "ok\n").reply(),
        Route::Missing => Response!::rejected(404u16).reply(),
    }
}

fn main() -> i32 {
    let server = match Server!::bind_async(0u16, handle) {
        Result::Ok(server) => server,
        Result::Err(code) => {
            eprint_buffer(f"http-file: cannot listen (libuv error {code})\n");
            return 1i32;
        },
    };
    let port = &server.port();
    if print_buffer(f"Listening on http://127.0.0.1:{port}\n").is_err() {
        server.stop();
        return 1i32;
    }
    match server.run() {
        Result::Ok(unit) => 0i32,
        Result::Err(code) => {
            eprint_buffer(f"http-file: server stopped (libuv error {code})\n");
            1i32
        },
    }
}
