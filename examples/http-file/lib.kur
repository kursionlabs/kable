use async::{FileOutcome!, ReadFile!, WithinOutcome, read_file, within};
use http::{Method, Request!, Response!};
use server::{Action!, Plan, Server!, defer_sequence};
use std::bytes::buffer::Buffer!;
use std::io::{eprint_buffer, print_buffer};
use std::option::{Option, Result};
use std::raw::Span;
use std::slice::StaticRead;
use task::{Map!, map, sequence};

fn file_response(outcome: FileOutcome!) -> Response! {
    match outcome {
        FileOutcome!::Read(bytes) => Response!::ok(bytes),
        FileOutcome!::Cancelled => {
            eprint_buffer(f"File request cancelled.\n");
            Response!::rejected(408u16)
        },
        FileOutcome!::Failed(code) => Response!::rejected(500u16),
    }
}

fn discard_file(outcome: FileOutcome!) {
    match outcome {
        FileOutcome!::Read(bytes) => bytes.destroy(),
        FileOutcome!::Cancelled => (),
        FileOutcome!::Failed(code) => (),
    }
}

fn timed_response(outcome: WithinOutcome[FileOutcome!]) -> Response! {
    match outcome {
        WithinOutcome::Completed(file) => file_response(file),
        WithinOutcome::TimedOut(file) => {
            discard_file(file);
            Response!::rejected(504u16)
        },
        WithinOutcome::Cancelled(file) => file_response(file),
        WithinOutcome::Failed(file, code) => {
            discard_file(file);
            Response!::rejected(500u16)
        },
    }
}

fn cancel_first(unit: (), outcome: Option[FileOutcome!]) {
    match outcome {
        Option::Some(file) => discard_file(file),
        Option::None => (),
    }
    eprint_buffer(f"Sequence cancelled before the second read.\n");
}

fn cancel_sequence(unit: (), outcome: Option[(Buffer!, FileOutcome!)]) {
    match outcome {
        Option::Some(result) => {
            let (first, file) = result;
            let length = &first.len();
            first.destroy();
            discard_file(file);
            eprint_buffer(f"Sequence cancelled with {length} bytes from the first read.\n");
        },
        Option::None => (),
    }
}

fn finish_sequence(unit: (), result: Option[(Buffer!, FileOutcome!)]) -> Action! {
    let (first, outcome) = match result {
        Option::Some(files) => files,
        Option::None => return Action!::Reply.(Response!::rejected(500u16)),
    };
    let response = match outcome {
        FileOutcome!::Read(second) => Response!::ok(first.push_buffer(second)),
        FileOutcome!::Cancelled => { first.destroy(); Response!::rejected(408u16) },
        FileOutcome!::Failed(code) => { first.destroy(); Response!::rejected(500u16) },
    };
    Action!::Reply.(response)
}

fn next_file(unit: (), outcome: FileOutcome!)
    -> Option[Map![ReadFile!, FileOutcome!, (Buffer!, FileOutcome!), (Buffer!,)]] {
    match outcome {
        FileOutcome!::Read(first) => {
            let access = StaticRead::new();
            let footer = read_file(&access, "footer.txt", 65_536usize);
            Option::Some.(map(footer, |file| (first, file)))
        },
        FileOutcome!::Cancelled => Option::None,
        FileOutcome!::Failed(code) => Option::None,
    }
}

fn handle(request: Request!) -> Action! {
    let { method, target, body } = request;
    body.destroy();
    let exists 'k. (access, bytes, restore) = target.open();
    let path = Span::from_slice(bytes);
    let health = path.is(&access, "/health");
    let file = path.is(&access, "/file");
    let timed = path.is(&access, "/file-with-timeout");
    let sequence_path = path.is(&access, "/file-sequence");
    restore.restore(access).destroy();
    match method {
        Method::Get | Method::Head => (),
        _ => {
            return Action!::Reply.(Response!::method_not_allowed("GET, HEAD"));
        },
    }
    if file || timed || sequence_path {
        let access = StaticRead::new();
        let task = read_file(&access, "example.txt", 65_536usize);
        if sequence_path {
            let plan = sequence(task).then_owned((), next_file, cancel_first);
            return defer_sequence(plan, (), finish_sequence, cancel_sequence);
        }
        if timed {
            return within(1000u64, task).defer(|outcome| timed_response(outcome));
        }
        return task.defer(|outcome| file_response(outcome));
    }
    if health { Action!::Reply.(Response!::text(200u16, "ok\n")) }
    else { Action!::Reply.(Response!::rejected(404u16)) }
}

fn main() -> i32 {
    let server = match Server!::bind_async(0u16, handle) {
        Result::Ok(server) => server,
        Result::Err(code) => {
            eprint_buffer(f"http-file: cannot listen (libuv error {code})\n");
            return 1i32;
        },
    };
    let port = &server.port();
    if print_buffer(f"Listening on http://127.0.0.1:{port}\n").is_err() {
        server.stop();
        return 1i32;
    }
    match server.run() {
        Result::Ok(unit) => 0i32,
        Result::Err(code) => {
            eprint_buffer(f"http-file: server stopped (libuv error {code})\n");
            1i32
        },
    }
}
