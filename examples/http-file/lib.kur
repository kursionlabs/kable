use async::{read_file, run};
use http::{Method, Request!, Response!};
use package::{file_join, file_sequence};
use server::{Action!, Server!, reply};
use std::buffer::Buffer!;
use std::io::{eprint_buffer, print_buffer};
use std::option::Result;
use std::process::Args;
use std::slice::{Slice, StaticRead};
use std::time::Duration;
use task::{Completion, Discard, PlanOutput, join};

const FILE_LIMIT: usize = 65_536;

fn serve_file(timed: bool) -> Action! {
    var access = StaticRead::new();
    let file = read_file(&access, "example.txt", FILE_LIMIT);
    if timed {
        return file.within(Duration::from_secs(1))
            .respond(|outcome| file_response(outcome));
    }
    file.respond_with(|outcome| file_response(outcome), discard_plain_file)
}

fn close_after_read() -> Action! {
    var access = StaticRead::new();
    read_file(&access, "example.txt", FILE_LIMIT)
        .respond(|outcome| { outcome.discard(); Action!::Close })
}

fn file_response(outcome: Completion[Buffer!]) -> Response! {
    match outcome {
        Ready(bytes) => Response!::ok(bytes),
        TimedOut => Response!::rejected(504),
        Cancelled => {
            eprint_buffer(f"File request cancelled.\n");
            Response!::rejected(408)
        },
        Failed(code) => Response!::rejected(500),
    }
}

fn discard_plain_file(outcome: Completion[Buffer!]) {
    match outcome {
        Ready(bytes) => bytes.destroy(),
        Cancelled => { eprint_buffer(f"File request cancelled.\n"); },
        TimedOut | Failed => (),
    }
}

enum Route { File, TimedFile, FileJoin, FileSequence, TimedSequence, Close, CloseAfterRead, Health, Missing }

fn route(&request: Request!) -> Route {
    if &request.path_is("/file") { return Route::File; }
    if &request.path_is("/file-with-timeout") { return Route::TimedFile; }
    if &request.path_is("/file-join") { return Route::FileJoin; }
    if &request.path_is("/file-sequence") { return Route::FileSequence; }
    if &request.path_is("/file-sequence-with-timeout") { return Route::TimedSequence; }
    if &request.path_is("/close") { return Route::Close; }
    if &request.path_is("/close-after-read") { return Route::CloseAfterRead; }
    if &request.path_is("/health") { return Route::Health; }
    Route::Missing
}

fn handle(request: Request!) -> Action! {
    var request = request;
    let route = route(&request);
    let { method, target, body } = request;
    target.destroy();
    body.destroy();

    match method {
        Get | Head => (),
        _ => { return reply(Response!::method_not_allowed("GET, HEAD")); },
    }
    match route {
        File => serve_file(false),
        TimedFile => serve_file(true),
        FileJoin => file_join::serve(),
        FileSequence => file_sequence::load().respond(|outcome| file_response(outcome)),
        TimedSequence => file_sequence::load().within(Duration::from_secs(1))
            .respond(|outcome| file_response(outcome)),
        Close => Action!::Close,
        CloseAfterRead => close_after_read(),
        Health => reply(Response!::text(200, "ok\n")),
        Missing => reply(Response!::rejected(404)),
    }
}

fn print_page(outcome: Completion[Buffer!]) -> i32 {
    match outcome {
        Ready(bytes) => if print_buffer(bytes).is_ok() { 0 } else { 1 },
        _ => {
            eprint_buffer(f"http-file: could not read page and footer\n");
            1
        },
    }
}

fn main(args: Args) -> i32 {
    if args.len() == 2 {
        var access = StaticRead::new();
        let arg = args.bytes(1).unwrap();
        if arg.is(&access, "--read-page") { return print_page(run(file_sequence::load())); }
        if arg.is(&access, "--join-pages") {
            let (first, second, status) = run(join(file_sequence::load(), file_sequence::load()));
            return match status {
                Ready => {
                    let first_status = print_page(first);
                    let second_status = print_page(second);
                    if first_status == 0 && second_status == 0 { 0 } else { 1 }
                },
                _ => { (first, second).discard(); 1 },
            };
        }
    }
    if args.len() != 1 {
        eprint_buffer(f"usage: http-file [--read-page | --join-pages]\n");
        return 2;
    }
    var server = match Server!::bind(0, handle) {
        Ok(server) => server,
        Err(code) => {
            eprint_buffer(f"http-file: cannot listen (libuv error {code})\n");
            return 1;
        },
    };
    let port = &server.port();
    if print_buffer(f"Listening on http://127.0.0.1:{port}\n").is_err() {
        server.stop();
        return 1;
    }
    match server.run() {
        Ok(unit) => 0,
        Err(code) => {
            eprint_buffer(f"http-file: server stopped (libuv error {code})\n");
            1
        },
    }
}
