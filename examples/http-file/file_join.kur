//! Reads two independent files under one local deadline.
use async::{FileOutcome!, JoinOutcome, WithinOutcome, join, read_file};
use http::Response!;
use package::{FILE_LIMIT, append_file, discard_file};
use server::{Action!, Plan, PlanOutput};
use std::slice::StaticRead;

fn serve() -> Action! {
    let access = StaticRead::new();
    let first = read_file(&access, "example.txt", FILE_LIMIT);
    let second = read_file(&access, "footer.txt", FILE_LIMIT);

    join(first, second).within(1000u64).defer(|outcome| match outcome {
        WithinOutcome::Completed(files) => joined_response(files),
        WithinOutcome::TimedOut(files) => reject_join(files, 504u16),
        WithinOutcome::Cancelled(files) => reject_join(files, 408u16),
        WithinOutcome::Failed(files, code) => reject_join(files, 500u16),
    })
}

fn joined_response(files: JoinOutcome[FileOutcome!, FileOutcome!]) -> Response! {
    match files {
        JoinOutcome::Ready(first, second) => file_response(first, second),
        JoinOutcome::Cancelled(first, second) => reject_files(first, second, 408u16),
        JoinOutcome::Failed(first, second, code) => reject_files(first, second, 500u16),
    }
}

fn file_response(first: FileOutcome!, second: FileOutcome!) -> Response! {
    match first {
        FileOutcome!::Read(left) => append_file(left, second),
        FileOutcome!::Cancelled => { discard_file(second); Response!::rejected(408u16) },
        FileOutcome!::Failed(code) => { discard_file(second); Response!::rejected(500u16) },
    }
}

fn reject_join(files: JoinOutcome[FileOutcome!, FileOutcome!], status: u16) -> Response! {
    let (first, second) = match files {
        JoinOutcome::Ready(first, second) => (first, second),
        JoinOutcome::Cancelled(first, second) => (first, second),
        JoinOutcome::Failed(first, second, code) => (first, second),
    };
    reject_files(first, second, status)
}

fn reject_files(first: FileOutcome!, second: FileOutcome!, status: u16) -> Response! {
    discard_file(first);
    discard_file(second);
    Response!::rejected(status)
}
