//! Reads two independent files under one local deadline.
use std::fmt::Writer;
use async::read_file;
use package::{FILE_LIMIT, file_response};
use server::Action!;
use std::slice::StaticRead;
use std::time::Duration;
use task::{Completion, PlanOutput, zip};

fn serve() -> Action! {
    var access = StaticRead::new();
    let first = read_file(&access, "example.txt", FILE_LIMIT);
    let second = read_file(&access, "footer.txt", FILE_LIMIT);

    zip(first, second).within(Duration::from_secs(1)).respond(|outcome| {
        file_response(outcome.and_then(|pair| {
            let (page, footer) = pair;
            Completion::Ready.(page.put(footer))
        }))
    })
}
