//! Reads two independent files under one local deadline.
use async::read_file;
use http::Response!;
use package::{FILE_LIMIT, append_file};
use server::Action!;
use std::buffer::Buffer!;
use std::slice::StaticRead;
use std::time::Duration;
use task::{Completion, Discard, PlanOutput, join};

fn serve() -> Action! {
    let access = StaticRead::new();
    let first = read_file(&access, "example.txt", FILE_LIMIT);
    let second = read_file(&access, "footer.txt", FILE_LIMIT);

    join(first, second)
        .respond(|files| joined_response(files).reply())
        .within(Duration::from_secs(1))
        .reply()
}

fn joined_response(files: (Completion[Buffer!], Completion[Buffer!], Completion[()])) -> Response! {
    let (first, second, status) = files;
    match status {
        Ready => file_response(first, second),
        TimedOut => reject_files(first, second, 504),
        Cancelled => reject_files(first, second, 408),
        Failed => reject_files(first, second, 500),
    }
}

fn file_response(first: Completion[Buffer!], second: Completion[Buffer!]) -> Response! {
    match first {
        Ready(left) => append_file(left, second),
        TimedOut => { second.discard(); Response!::rejected(504) },
        Cancelled => { second.discard(); Response!::rejected(408) },
        Failed(code) => { second.discard(); Response!::rejected(500) },
    }
}

fn reject_files(first: Completion[Buffer!], second: Completion[Buffer!], status: u16) -> Response! {
    (first, second).discard();
    Response!::rejected(status)
}
