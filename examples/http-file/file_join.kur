//! Reads two independent files under one local deadline.
use async::{Completion, JoinOutcome, join, read_file};
use http::Response!;
use package::{FILE_LIMIT, append_file, discard_file, timed_reply};
use server::{Action!, PlanOutput};
use std::bytes::buffer::Buffer!;
use std::slice::StaticRead;

fn serve() -> Action! {
    let access = StaticRead::new();
    let first = read_file(&access, "example.txt", FILE_LIMIT);
    let second = read_file(&access, "footer.txt", FILE_LIMIT);

    join(first, second).within(1000).defer(|outcome, state| {
        timed_reply(outcome, state, joined_response, discard_join)
    })
}

fn joined_response(files: JoinOutcome[Completion[Buffer!], Completion[Buffer!]]) -> Response! {
    match files {
        JoinOutcome::Ready(first, second) => file_response(first, second),
        JoinOutcome::Cancelled(first, second) => reject_files(first, second, 408),
        JoinOutcome::Failed(first, second, code) => reject_files(first, second, 500),
    }
}

fn file_response(first: Completion[Buffer!], second: Completion[Buffer!]) -> Response! {
    match first {
        Completion::Ready(left) => append_file(left, second),
        Completion::Cancelled => { discard_file(second); Response!::rejected(408) },
        Completion::Failed(code) => { discard_file(second); Response!::rejected(500) },
    }
}

fn discard_join(files: JoinOutcome[Completion[Buffer!], Completion[Buffer!]]) {
    let (first, second) = match files {
        JoinOutcome::Ready(first, second) => (first, second),
        JoinOutcome::Cancelled(first, second) => (first, second),
        JoinOutcome::Failed(first, second, code) => (first, second),
    };
    discard_file(first);
    discard_file(second);
}

fn reject_files(first: Completion[Buffer!], second: Completion[Buffer!], status: u16) -> Response! {
    discard_file(first);
    discard_file(second);
    Response!::rejected(status)
}
