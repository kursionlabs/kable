//! Chooses a footer from the first file's contents and appends it.
use async::read_file;
use http::Response!;
use package::{FILE_LIMIT, append_file};
use server::Action!;
use std::buffer::Buffer!;
use std::io::eprint_buffer;
use std::option::Option;
use std::raw::Span;
use std::slice::{Slice, StaticRead};
use task::{Completion, Discard, PlanOutput};

fn serve() -> Action! {
    let access = StaticRead::new();
    let first = read_file(&access, "example.txt", FILE_LIMIT);
    first.respond_with(|outcome| read_footer(outcome), discard_first).reply()
}

fn read_footer(outcome: Completion[Buffer!]) -> Action! {
    let first = match outcome {
        Completion::Ready(first) => first,
        _ => return Response!::rejected(500).reply(),
    };
    let path = footer_path(&first);
    let access = StaticRead::new();
    read_file(&access, path, FILE_LIMIT)
        .respond_with_owned(first, |first, footer| append_file(first, footer).reply(), discard_footer)
        .reply()
}

fn discard_first(outcome: Completion[Buffer!]) {
    outcome.discard();
    eprint_buffer(f"Sequence cancelled before the second read.\n");
}

fn discard_footer(first: Buffer!, footer: Completion[Buffer!]) {
    let length = &first.len();
    (first, footer).discard();
    eprint_buffer(f"Sequence cancelled with {length} bytes from the first read.\n");
}

fn footer_path(&first: Buffer!) -> Slice[u8, 'static] {
    let exists 'k. (access, bytes, restore) = first.open();
    let text = Span::from_slice(bytes);
    let line = match text.find_byte(&access, b'\n', 0) {
        Option::Some(end) => text.take(end),
        Option::None => text,
    };
    let path = if line.is(&access, "footer: detailed") { "footer-detailed.txt" } else { "footer.txt" };
    first = restore.restore(access);
    path
}
