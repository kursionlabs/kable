//! Chooses a footer from the first file's contents and appends it.
use std::fmt::Writer;
use async::{Task!, read_file};
use package::FILE_LIMIT;
use std::buffer::Buffer!;
use std::io::eprint;
use std::str::{StaticRead, Str};
use task::{Completion, PlanOutput};

fn load() -> Task![Buffer!] {
    var access = StaticRead::new();
    read_file(&access, "example.txt", FILE_LIMIT).map(|outcome| {
        match outcome {
            Completion::Cancelled => {
                eprint(f"Sequence cancelled before the second read.\n");
                Completion::Cancelled
            },
            Ready(bytes) => Completion::Ready.(bytes),
            TimedOut => Completion::TimedOut,
            Failed(failure) => Completion::Failed.(failure),
        }
    }).and_then(|first| {
        var first = first;
        let path = footer_path(&first);
        var access = StaticRead::new();
        read_file(&access, path, FILE_LIMIT).map(|outcome| append_footer(first, outcome))
    })
}

fn append_footer(first: Buffer!, footer: Completion[Buffer!]) -> Completion[Buffer!] {
    match footer {
        Ready(bytes) => Completion::Ready.(first.put(bytes)),
        Cancelled => {
            var first = first;
            let length = &first.len();
            first.destroy();
            eprint(f"Sequence cancelled with {length} bytes from the first read.\n");
            Completion::Cancelled
        },
        TimedOut => { first.destroy(); Completion::TimedOut },
        Failed(failure) => { first.destroy(); Completion::Failed.(failure) },
    }
}

fn footer_path(&first: Buffer!) -> Str['static] {
    var exists 'k. (access, bytes, restore) = first.open();
    let text = bytes.as_str();
    let line = match text.find_byte(&access, b'\n', 0) {
        Some(end) => text.take(end),
        None => text,
    };
    let path = if line.is(&access, "footer: detailed") { "footer-detailed.txt" } else { "footer.txt" };
    first = restore.restore(access);
    path
}
