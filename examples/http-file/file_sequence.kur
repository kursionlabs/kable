//! Chooses a footer from the first file's contents and appends it.
use async::{Completion, read_file};
use http::Response!;
use package::{FILE_LIMIT, append_file, discard_file};
use server::{Action!, PlanOutput, RequestState};
use std::bytes::buffer::Buffer!;
use std::io::eprint_buffer;
use std::option::Option;
use std::raw::Span;
use std::slice::{Slice, StaticRead};

fn serve() -> Action! {
    let access = StaticRead::new();
    let first = read_file(&access, "example.txt", FILE_LIMIT);
    first.defer(|outcome, state| read_footer(outcome, state))
}

fn read_footer(outcome: Completion[Buffer!], state: RequestState) -> Option[Action!] {
    match state {
        RequestState::Cancelled => {
            discard_file(outcome);
            eprint_buffer(f"Sequence cancelled before the second read.\n");
            return Option::None;
        },
        RequestState::Active => (),
    }
    match outcome {
        Completion::Ready(first) => {
            let path = footer_path(&first);
            let access = StaticRead::new();
            let footer = read_file(&access, path, FILE_LIMIT);
            Option::Some.(footer.defer(|outcome, state| finish_footer(first, outcome, state)))
        },
        Completion::Cancelled | Completion::Failed => Option::Some.(Response!::rejected(500).reply()),
    }
}

fn finish_footer(first: Buffer!, footer: Completion[Buffer!], state: RequestState) -> Option[Action!] {
    match state {
        RequestState::Active => Option::Some.(append_file(first, footer).reply()),
        RequestState::Cancelled => {
            let length = &first.len();
            first.destroy();
            discard_file(footer);
            eprint_buffer(f"Sequence cancelled with {length} bytes from the first read.\n");
            Option::None
        },
    }
}

fn footer_path(&first: Buffer!) -> Slice[u8, 'static] {
    let exists 'k. (access, bytes, restore) = first.open();
    let text = Span::from_slice(bytes);
    let line = match text.find_byte(&access, b'\n', 0) {
        Option::Some(end) => text.take(end),
        Option::None => text,
    };
    let path = if line.is(&access, "footer: detailed") { "footer-detailed.txt" } else { "footer.txt" };
    first = restore.restore(access);
    path
}
