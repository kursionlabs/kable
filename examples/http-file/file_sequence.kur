//! Chooses a footer from the first file's contents and appends it.
use async::{FileOutcome!, read_file};
use http::Response!;
use package::{FILE_LIMIT, append_file, discard_file};
use server::{Action!, PlanOutput};
use std::bytes::buffer::Buffer!;
use std::io::eprint_buffer;
use std::option::Option;
use std::raw::Span;
use std::slice::{Slice, StaticRead};
use task::sequence;

fn serve() -> Action! {
    let access = StaticRead::new();
    let first = read_file(&access, "example.txt", FILE_LIMIT);
    sequence(first)
        .then_owned((), |unit, outcome| match outcome {
            FileOutcome!::Read(first) => {
                let path = footer_path(&first);
                let footer = read_file(&access, path, FILE_LIMIT);
                Option::Some.(footer.map(|file| (first, file)))
            },
            FileOutcome!::Cancelled => Option::None,
            FileOutcome!::Failed(code) => Option::None,
        }, cancel_first)
        .defer((), finish_sequence, cancel_sequence)
}

fn cancel_first(unit: (), outcome: Option[FileOutcome!]) {
    match outcome {
        Option::Some(file) => discard_file(file),
        Option::None => (),
    }
    eprint_buffer(f"Sequence cancelled before the second read.\n");
}

fn cancel_sequence(unit: (), outcome: Option[(Buffer!, FileOutcome!)]) {
    match outcome {
        Option::Some(result) => {
            let (first, file) = result;
            let length = &first.len();
            first.destroy();
            discard_file(file);
            eprint_buffer(f"Sequence cancelled with {length} bytes from the first read.\n");
        },
        Option::None => (),
    }
}

fn finish_sequence(unit: (), result: Option[(Buffer!, FileOutcome!)]) -> Action! {
    let (first, outcome) = match result {
        Option::Some(files) => files,
        Option::None => return Response!::rejected(500).reply(),
    };
    append_file(first, outcome).reply()
}

fn footer_path(&first: Buffer!) -> Slice[u8, 'static] {
    let exists 'k. (access, bytes, restore) = first.open();
    let text = Span::from_slice(bytes);
    let line = match text.find_byte(&access, b'\n', 0) {
        Option::Some(end) => text.take(end),
        Option::None => text,
    };
    let path = if line.is(&access, "footer: detailed") { "footer-detailed.txt" } else { "footer.txt" };
    first = restore.restore(access);
    path
}
