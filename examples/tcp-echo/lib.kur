use std::io::{eprint_buffer, print_buffer};
use std::option::Result;
use std::time::Duration;
use task::{Completion, DeadlineStatus, PlanOutput, Stream};
use tcp::{Action!, Connection!, Listener!, ReadOutcome!, timed_read_outcome};

fn read_next(connection: Connection!) -> Action! {
    connection.next().within(Duration::from_secs(1))
        .defer_tcp(|result| read_finished(timed_read_outcome(result)))
}

fn read_finished(result: (Connection!, ReadOutcome!)) -> Action! {
    let (connection, outcome) = result;
    match outcome {
        ReadOutcome!::Chunk(bytes) => return connection.send(bytes).within(Duration::from_secs(1))
            .defer_tcp(|result| write_finished(result)),
        ReadOutcome!::TimedOut => { eprint_buffer(f"Read deadline expired.\n"); },
        ReadOutcome!::Cancelled => { eprint_buffer(f"Cancelled connection on shutdown.\n"); },
        ReadOutcome!::Eof | ReadOutcome!::Failed => (),
    };
    connection.close()
}

fn write_finished(result: ((Connection!, Completion[()]), DeadlineStatus)) -> Action! {
    let ((connection, status), deadline) = result;
    match deadline {
        DeadlineStatus::Completed => (),
        _ => return connection.close(),
    }
    match status {
        Completion::Ready => read_next(connection),
        Completion::Cancelled | Completion::Failed => connection.close(),
    }
}

fn main() -> i32 {
    let listener = match Listener!::bind_connections(0, read_next) {
        Result::Ok(listener) => listener,
        Result::Err(code) => {
            eprint_buffer(f"tcp-echo: cannot listen (libuv error {code})\n");
            return 1i32;
        },
    };
    let port = &listener.port();
    if print_buffer(f"Listening on 127.0.0.1:{port}\n").is_err() {
        listener.stop();
        return 1i32;
    }
    match listener.run() {
        Result::Ok(unit) => 0i32,
        Result::Err(code) => {
            eprint_buffer(f"tcp-echo: listener stopped (libuv error {code})\n");
            1i32
        },
    }
}
