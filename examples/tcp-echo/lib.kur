use async::{PlanOutput, Stream, StreamOutcome!, WithinOutcome};
use std::bytes::buffer::Buffer!;
use std::io::{eprint_buffer, print_buffer};
use std::option::Result;
use tcp::{Action!, Connection!, Event!, Listener!, WriteOutcome!, defer};

fn read_next(connection: Connection!) -> Action! {
    defer(connection.next().within(1000), |result| read_finished(result))
}

fn read_finished(result: WithinOutcome[(Connection!, StreamOutcome![Buffer!])]) -> Action! {
    let (joined, active) = match result {
        WithinOutcome::Completed(joined) => (joined, true),
        WithinOutcome::TimedOut(joined) => {
            eprint_buffer(f"Read deadline expired.\n");
            (joined, false)
        },
        WithinOutcome::Cancelled(joined) => {
            eprint_buffer(f"Cancelled connection on shutdown.\n");
            (joined, false)
        },
        WithinOutcome::Failed(joined, code) => (joined, false),
    };
    let (connection, outcome) = joined;
    match outcome {
        StreamOutcome!::Item(bytes) => {
            if active { return defer(connection.write_plan(bytes).within(1000), |result| write_finished(result)); }
            bytes.destroy();
            connection.close()
        },
        StreamOutcome!::End | StreamOutcome!::Cancelled | StreamOutcome!::Failed => connection.close(),
    }
}

fn write_finished(result: WithinOutcome[WriteOutcome!]) -> Action! {
    let (outcome, active) = match result {
        WithinOutcome::Completed(outcome) => (outcome, true),
        WithinOutcome::TimedOut(outcome) => (outcome, false),
        WithinOutcome::Cancelled(outcome) => (outcome, false),
        WithinOutcome::Failed(outcome, code) => (outcome, false),
    };
    match outcome {
        WriteOutcome!::Written(connection, bytes) => {
            bytes.destroy();
            if active { read_next(connection) } else { connection.close() }
        },
        WriteOutcome!::Cancelled(connection, bytes) => { bytes.destroy(); connection.close() },
        WriteOutcome!::Failed(connection, bytes, code) => { bytes.destroy(); connection.close() },
    }
}

fn echo(event: Event!) -> Action! {
    match event {
        Event!::Connected(connection) => read_next(connection),
        Event!::Bytes(connection, bytes) => { bytes.destroy(); connection.close() },
        Event!::TimedOut(connection) => {
            eprint_buffer(f"Read deadline expired.\n");
            connection.close()
        },
        Event!::End(connection) => connection.close(),
        Event!::Cancelled(connection) => {
            eprint_buffer(f"Cancelled connection on shutdown.\n");
            connection.close()
        },
        Event!::Failed(connection, code) => connection.close(),
    }
}

fn main() -> i32 {
    let listener = match Listener!::bind_local(0u16, echo) {
        Result::Ok(listener) => listener,
        Result::Err(code) => {
            eprint_buffer(f"tcp-echo: cannot listen (libuv error {code})\n");
            return 1i32;
        },
    };
    let port = &listener.port();
    if print_buffer(f"Listening on 127.0.0.1:{port}\n").is_err() {
        listener.stop();
        return 1i32;
    }
    match listener.run() {
        Result::Ok(unit) => 0i32,
        Result::Err(code) => {
            eprint_buffer(f"tcp-echo: listener stopped (libuv error {code})\n");
            1i32
        },
    }
}
