use std::buffer::Buffer!;
use std::io::{eprint_buffer, print_buffer};
use std::option::{Option, Result};
use std::time::Duration;
use task::{Completion, DeadlineStatus, PlanOutput, Sink, Stream};
use tcp::{Action!, Connection!, Listener!};

fn read_next(connection: Connection!) -> Action! {
    connection.next().within(Duration::from_secs(1)).defer_tcp(|result| read_finished(result))
}

fn read_finished(result: ((Connection!, Completion[Option[Buffer!]]), DeadlineStatus)) -> Action! {
    let ((connection, outcome), deadline) = result;
    let active = match deadline {
        DeadlineStatus::Completed => true,
        DeadlineStatus::TimedOut => {
            eprint_buffer(f"Read deadline expired.\n");
            false
        },
        DeadlineStatus::Cancelled => {
            eprint_buffer(f"Cancelled connection on shutdown.\n");
            false
        },
        DeadlineStatus::Failed => false,
    };
    match outcome {
        Completion::Ready(chunk) => match chunk {
            Option::Some(bytes) => {
                if active {
                    return connection.write(bytes).within(Duration::from_secs(1))
                        .defer_tcp(|result| write_finished(result));
                }
                bytes.destroy();
            },
            Option::None => (),
        },
        Completion::Cancelled | Completion::Failed => (),
    };
    connection.close()
}

fn write_finished(result: ((Connection!, Buffer!, Completion[()]), DeadlineStatus)) -> Action! {
    let ((connection, bytes, status), deadline) = result;
    bytes.destroy();
    match deadline {
        DeadlineStatus::Completed => match status {
            Completion::Ready => read_next(connection),
            _ => connection.close(),
        },
        _ => connection.close(),
    }
}

fn main() -> i32 {
    let listener = match Listener!::bind_connections(0, read_next) {
        Result::Ok(listener) => listener,
        Result::Err(code) => {
            eprint_buffer(f"tcp-echo: cannot listen (libuv error {code})\n");
            return 1i32;
        },
    };
    let port = &listener.port();
    if print_buffer(f"Listening on 127.0.0.1:{port}\n").is_err() {
        listener.stop();
        return 1i32;
    }
    match listener.run() {
        Result::Ok(unit) => 0i32,
        Result::Err(code) => {
            eprint_buffer(f"tcp-echo: listener stopped (libuv error {code})\n");
            1i32
        },
    }
}
