use http::{Method, Request!, Response!};
use server::{Action!, Server!, after, reply};
use std::io::{eprint, print};
use std::option::{Option, Result};
use std::process::Args;
use std::str::{StaticRead, Str};
use std::parse::parse_u64;
use std::time::Duration;
use task::{Completion, Failure, PlanOutput};

fn handle(request: Request!) -> Action! {
    var request = request;
    let method = request.method;
    if &request.path_is("/echo") {
        match method {
            Post => return request.into_body().collect(1024 * 1024).respond(|outcome| {
                let status = match outcome {
                    Completion::Ready(bytes) => return reply(Response!::ok(bytes)),
                    TimedOut | Cancelled => 408,
                    Failed(failure) => match failure {
                        LimitExceeded => 413,
                        Failure::Operation(code) => {
                            if code < 0 { return Action!::Close; }
                            if code == 400 { 400 } else { 500 }
                        },
                        _ => 500,
                    },
                };
                reply(Response!::rejected(status))
            }),
            _ => {
                request.destroy();
                return reply(Response!::method_not_allowed("POST"));
            },
        }
    }

    let home = &request.path_is("/");
    let health = &request.path_is("/health");
    let delay = &request.path_is("/delay");
    request.destroy();
    if home || health || delay {
        match method {
            Get | Head => {
                if delay {
                    return after(Response!::text(200, "done\n"), Duration::from_secs(1));
                }
                let message = if home { "Kable\n" } else { "ok\n" };
                reply(Response!::text(200, message))
            },
            _ => reply(Response!::method_not_allowed("GET, HEAD")),
        }
    } else {
        reply(Response!::text(404, "Not Found\n"))
    }
}

fn parse_port(bytes: Str['static]) -> Option[u16] {
    var access = StaticRead::new();
    let port = parse_u64(&access, bytes)?;
    if port <= 65535 { Option::Some.(port as u16) } else { Option::None }
}

fn usage() -> i32 {
    eprint("usage: kable [PORT]\n");
    2i32
}

fn main(args: Args) -> i32 {
    if args.len() > 2usize { return usage(); }
    let port = match args.bytes(1usize) {
        None => 8080u16,
        Some(bytes) => match parse_port(bytes) {
            Some(port) => port,
            None => return usage(),
        },
    };
    var server = match Server!::bind(port, handle) {
        Ok(server) => server,
        Err(code) => {
            eprint(f"kable: cannot listen (libuv error {code})\n");
            return 1i32;
        },
    };
    let port = &server.port();
    if print(f"Listening on http://127.0.0.1:{port}\n").is_err() {
        server.stop();
        return 1i32;
    }
    match server.run() {
        Ok(unit) => 0i32,
        Err(code) => {
            eprint(f"kable: server stopped (libuv error {code})\n");
            1i32
        },
    }
}
