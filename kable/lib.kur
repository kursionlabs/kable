use http::{Method, Request!, Response!};
use server::{Action!, Server!, after, body, reply};
use std::buffer::Buffer!;
use std::io::{eprint_buffer, print_buffer};
use std::option::{Option, Result};
use std::process::Args;
use std::raw::Span;
use std::slice::{ReadBytes, Slice, StaticRead};
use std::time::Duration;
use task::{Completion, Failure, PlanOutput};

fn handle(request: Request!) -> Action! {
    let { method, target, body } = request;
    var exists 'k. (access, bytes, restore) = target.open();
    let target = Span::from_slice(bytes);
    let path = match target.find_byte(&access, b'?', 0) {
        Some(end) => target.take(end),
        None => target,
    };
    let home = path.is(&access, "/");
    let health = path.is(&access, "/health");
    let echo = path.is(&access, "/echo");
    let delay = path.is(&access, "/delay");
    restore.restore(access).destroy();

    if echo {
        match method {
            Post => return body::collect(body, 1024 * 1024).respond(|outcome| {
                let status = match outcome {
                    Completion::Ready(bytes) => return reply(Response!::ok(bytes)),
                    TimedOut | Cancelled => 408,
                    Failed(failure) => match failure {
                        Failure::Operation(code) => {
                            if code < 0 { return Action!::Close; }
                            if code == 400 || code == 413 { code as u16 } else { 500 }
                        },
                        _ => 500,
                    },
                };
                reply(Response!::rejected(status))
            }).reply(),
            _ => {
                body.destroy();
                return reply(Response!::method_not_allowed("POST"));
            },
        }
    }

    body.destroy();
    if home || health || delay {
        match method {
            Get | Head => {
                if delay {
                    return after(Response!::text(200, "done\n"), Duration::from_secs(1));
                }
                let message = if home { "Kable\n" } else { "ok\n" };
                reply(Response!::text(200, message))
            },
            _ => reply(Response!::method_not_allowed("GET, HEAD")),
        }
    } else {
        reply(Response!::text(404, "Not Found\n"))
    }
}

fn parse_port(bytes: Slice[u8, 'static]) -> Option[u16] {
    if bytes.is_empty() { return Option::None; }
    var access = StaticRead::new();
    var port = 0u32;
    var i = 0usize;
    while i < bytes.len() {
        let digit = match ReadBytes[StaticRead, Slice[u8, 'static]]::get(&access, bytes, i) {
            Some(digit) => digit,
            None => return Option::None,
        };
        if digit < b'0' || digit > b'9' { return Option::None; }
        port = port * 10u32 + ((digit - b'0') as u32);
        if port > 65535u32 { return Option::None; }
        i = i + 1usize;
    }
    Option::Some.(port as u16)
}

fn usage() -> i32 {
    eprint_buffer(Buffer!::new().push_static("usage: kable [PORT]\n"));
    2i32
}

fn main(args: Args) -> i32 {
    if args.len() > 2usize { return usage(); }
    let port = match args.bytes(1usize) {
        None => 8080u16,
        Some(bytes) => match parse_port(bytes) {
            Some(port) => port,
            None => return usage(),
        },
    };
    var server = match Server!::bind(port, handle) {
        Ok(server) => server,
        Err(code) => {
            eprint_buffer(f"kable: cannot listen (libuv error {code})\n");
            return 1i32;
        },
    };
    let port = &server.port();
    if print_buffer(f"Listening on http://127.0.0.1:{port}\n").is_err() {
        server.stop();
        return 1i32;
    }
    match server.run() {
        Ok(unit) => 0i32,
        Err(code) => {
            eprint_buffer(f"kable: server stopped (libuv error {code})\n");
            1i32
        },
    }
}
